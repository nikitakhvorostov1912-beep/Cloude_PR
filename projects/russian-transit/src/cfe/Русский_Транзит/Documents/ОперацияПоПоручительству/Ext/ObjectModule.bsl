
// Доработка START {td-spec-v1: дефолт ВидОперации = ДДПАвто для новых документов} {2026-04-27}
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт

	Если НЕ ЗначениеЗаполнено(ВидОперации) Тогда
		ВидОперации = Перечисления.ВидыОперацийПоручительства.ДДПАвто;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаКопирования(ОбъектКопирования)

	// При копировании документа ВидОперации сбрасывается в ДДПАвто (ручное создание).
	// Тип-файл документ можно создавать только через АРМ ЗагрузкаРееструТД.
	ВидОперации = Перечисления.ВидыОперацийПоручительства.ДДПАвто;

КонецПроцедуры
// Доработка END

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Доработка START {Аудит 2026-04-04: ОбменДанными.Загрузка перенесён в начало}
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Доработка END

	// Доработка START {td-spec-v1: страховка дефолта ВидОперации} {2026-04-27}
	Если НЕ ЗначениеЗаполнено(ВидОперации) Тогда
		ВидОперации = Перечисления.ВидыОперацийПоручительства.ДДПАвто;
	КонецЕсли;
	// Доработка END

	// Доработка START {SS-9 2026-04-20}: при ПометкаУдаления не вызывать исРасчет —
	// при группировке документы-доноры помечаются на удаление, каждая запись
	// провоцировала полный пересчёт (5 SQL × 200 доноров = 1000 лишних обращений).
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	// Доработка END

	// Доработка START {Исправление расчёта ОбеспечениеИтог и РасстояниеИтог} {2026-04-01}
	УстановитьСтатус();
	ОбеспечениеИтог = 0;

	// Доработка START {CRITICAL #8: Кеш курсов валют — вынос ПолучитьПоследнее из цикла} {2026-04-09}
	КешКурсов = Новый Соответствие;
	// Доработка END

	Для Каждого СтрокаТЧ Из ДанныеДокументов Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Валюта) Тогда
			Валюта = СтрокаТЧ.Валюта;
		Иначе
			Валюта = ВалютаОбеспечения;
		КонецЕсли;

		// Доработка START {CRITICAL #8: Проверка кеша перед обращением к регистру} {2026-04-09}
		// Доработка START {H-CALC-3 2026-04-20}: курс=0 или отсутствует — не молчим, а сообщаем
		// (ранее EUR-сумма считалась как рублёвая без уведомления, тихо искажая итоговое обеспечение).
		КурсВалюты = КешКурсов.Получить(Валюта);
		Если КурсВалюты = Неопределено Тогда
			Отбор = Новый Структура("Валюта", Валюта);
			ЗаписьКурса = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Дата, Отбор);
			КурсВалюты = ?(ЗаписьКурса = Неопределено, Неопределено, ЗаписьКурса.Курс);
			Если КурсВалюты = Неопределено ИЛИ КурсВалюты = 0 Тогда
				Если ЗначениеЗаполнено(Валюта) И Валюта <> ВалютаОбеспечения Тогда
					ОбщегоНазначения.СообщитьПользователю(
						"Курс валюты «" + Строка(Валюта) + "» на дату "
						+ Формат(Дата, "ДЛФ=DD")
						+ " не найден. Итог обеспечения рассчитан без конверсии — проверьте регистр КурсыВалют.");
					ЗаписьЖурналаРегистрации(
						"ОперацияПоПоручительству.КурсНеНайден",
						УровеньЖурналаРегистрации.Предупреждение,,
						Ссылка,
						"Валюта=" + Строка(Валюта) + ", Дата=" + Формат(Дата, "ДЛФ=DD"));
				КонецЕсли;
				КурсВалюты = 1;
			КонецЕсли;
			КешКурсов.Вставить(Валюта, КурсВалюты);
		КонецЕсли;
		// Доработка END
		// Доработка END

		ОбеспечениеИтог = ОбеспечениеИтог + СтрокаТЧ.СуммаОбеспечения * КурсВалюты;
	КонецЦикла;

	// Доработка START {Аудит 2026-04-04: fallback на СуммаОбеспечения когда ДанныеДокументов пуста}
	Если ОбеспечениеИтог = 0 И СуммаОбеспечения > 0 Тогда
		ОбеспечениеИтог = СуммаОбеспечения;
	КонецЕсли;
	// Доработка END

	// Доработка START {Задача 3: РасстояниеИтог = MAX по всем документам группы} {2026-04-09}
	МаксРасстояние = 0;
	Для Каждого СтрДД Из ДанныеДокументов Цикл
		Если СтрДД.Расстояние > МаксРасстояние Тогда
			МаксРасстояние = СтрДД.Расстояние;
		КонецЕсли;
	КонецЦикла;
	Если МаксРасстояние > 0 Тогда
		РасстояниеИтог = МаксРасстояние;
	Иначе
		РасстояниеИтог = Расстояние;
	КонецЕсли;
	// Доработка END

	// Доработка START {Аудит качества: Отказ при ошибке расчёта — документ НЕ должен сохраняться с нулевой ценой} {2026-04-09}
	Попытка
		исРасчет.ОбновитьЦеныНаСервере(ЭтотОбъект);
		Оплата = ОплатыУслуг.Итог("Сумма") + ОплатыУслуг.Итог("СуммаКодов") + ДополнительныеУслуги.Итог("Сумма");
	Исключение
		ЗаписьЖурналаРегистрации("ОперацияПоПоручительству.РасчётЦен",
			УровеньЖурналаРегистрации.Ошибка,,
			Ссылка,
			ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю("Ошибка расчёта цен: " + ОписаниеОшибки());
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	// Доработка END
	// Доработка END
	
	//Если РежимЗаписи = РежимЗаписиДокумента.Проведение тогда 
	ПроверитьЗаполнениеДокумента(Отказ,РежимЗаписи);
	
	Если Отказ = Ложь тогда 
		
		// Доработка START {Аудит 2026-04-04: удалён неиспользуемый НайтиПоРеквизиту через точку}
		// Доработка END
		
		НаборЗаписей = РегистрыСведений.ПрочитанныеДекларации.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			Ошибка = СформироватьТекстОшибок(Ссылка);
			Если Ошибка = "" тогда
				НаборЗаписей[0].ПрочитаноСОшибкой = Ложь;  
				НаборЗаписей[0].Ошибка = "";   
			Иначе
				НаборЗаписей[0].Ошибка = Ошибка;   
			КонецЕсли;	
		КонецЕсли;
		НаборЗаписей.Записать();
	КонецЕсли;
	//КонецЕсли;
	
	Если Отказ Тогда
		Возврат;                
	КонецЕсли;
	
	// Доработка START {Аудит 2026-04-04: убрана мутация СуммаОбеспечения, убрана переменная Бабулево}
	Менеджер = Пользователи.ТекущийПользователь();
	// Доработка END
	
	
	
КонецПроцедуры

Функция СформироватьТекстОшибок(Док);
	
	ТекстОшибки = "Не удалось записать по причине: ";
	
	Если Док.Перевозчик = справочники.Перевозчики.ПустаяСсылка() тогда
		ТекстОшибки = ТекстОшибки + "не заполнен перевозчик, ";
	КонецЕсли;	
	
	Если Док.Декларант = справочники.пользователи.ПустаяСсылка()
		ИЛИ Док.Декларант = справочники.Декларанты.ПустаяСсылка() тогда
		ТекстОшибки = ТекстОшибки + "не заполнен декларант, ";
	КонецЕсли;
	
	Если Док.Принципал = справочники.Принципалы.ПустаяСсылка() тогда
		ТекстОшибки = ТекстОшибки + "не заполнен принципал, ";
	КонецЕсли;	
	
	Если Док.Контрагент = справочники.Контрагенты.ПустаяСсылка() тогда
		ТекстОшибки = ТекстОшибки + "не заполнен контрагент, ";
	КонецЕсли;
	
	Если Док.ПунктОтправления = справочники.ТаможенныеПункты.ПустаяСсылка() тогда
		ТекстОшибки = ТекстОшибки + "не заполнен пункт отправления, ";
	КонецЕсли; 
	
	Если Док.ПунктНазначения = справочники.ТаможенныеПункты.ПустаяСсылка() тогда
		ТекстОшибки = ТекстОшибки + "не заполнен пункт назначения, ";
	КонецЕсли; 
	
	Если Док.СуммаОбеспечения = 0 тогда
		ТекстОшибки = ТекстОшибки + "не заполнена сумма обеспечения, ";
	КонецЕсли; 
	
	// Доработка START {Аудит 2026-04-04: исправлено сравнение с менеджером + текст ошибки}
	Если НЕ ЗначениеЗаполнено(Док.ОсновноеТС) Тогда
		ТекстОшибки = ТекстОшибки + "не заполнено основное ТС, ";
	КонецЕсли;
	// Доработка END       
	
	Длина = СтрДлина(ТекстОшибки);
	
	Если СтрДлина(ТекстОшибки) > 32 тогда 
		ТекстОшибок = Лев(ТекстОшибки, Длина-2) + ".";
	Иначе 
		ТекстОшибок = "";  
	КонецЕсли;
	
	Возврат ТекстОшибок;
	
КонецФункции

Функция УстановитьСтатус()
	СписокРеквизитов = Новый СписокЗначений;
	
	СписокРеквизитов.Добавить("Оплата"				, "Оплата");
	СписокРеквизитов.Добавить("Перевозчик"			, "Перевозчик");
	СписокРеквизитов.Добавить("Организация"			, "Организация");
	СписокРеквизитов.Добавить("СтатусТранзита"		, "СтатусТранзита");
	СписокРеквизитов.Добавить("СуммаОбеспечения"    , "СуммаОбеспечения");
	СписокРеквизитов.Добавить("ПунктНазначения"		, "Пункт назначения");
	СписокРеквизитов.Добавить("ПунктОтправления"	, "Пункт отправления");
	СписокРеквизитов.Добавить("ОсновноеТС"			, "Номер авто (ОсновноеТС)");
	СписокРеквизитов.Добавить("Контрагент"			, "Заказчик (контрагент)");
	
	МассивСтатусов = Новый Массив;
	Для каждого Эл Из СписокРеквизитов Цикл
		
		ПроверяемыйРек 				= ЭтотОбъект[Эл.Значение];
		ПроверяемыйРекНаименование 	= Эл.Представление;
		
		Если НЕ ЗначениеЗаполнено(ПроверяемыйРек) Тогда
			Если ПроверяемыйРекНаименование = "Заказчик (контрагент)" Тогда
				МассивСтатусов.Добавить("НеИдентифицирован");
			ИначеЕсли ПроверяемыйРекНаименование = "Оплата" Тогда
				МассивСтатусов.Добавить("Не рассчитан");
			Иначе 
				МассивСтатусов.Добавить("Требует ручной корректировки");
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	Если МассивСтатусов.Количество() = 0 И Не СтатусОперации = Перечисления.СтатусыОпераций.Аннулирован 
		И НЕ СтатусОперации = Перечисления.СтатусыОпераций.ГотовоКОплате
		И НЕ СтатусОперации = Перечисления.СтатусыОпераций.Завершен Тогда 
		// FIXME: hardcode — "Менеджер обмена" захардкожен. Перенести в настройки (константу или регистр сведений).
		// Оставлено функциональным, чтобы не ломать текущую логику определения статуса при автообмене.
		Если Менеджер = Справочники.Пользователи.НайтиПоНаименованию("Менеджер обмена") Тогда
			СтатусОперации = Перечисления.СтатусыОпераций.Обработан;
		Иначе
			СтатусОперации = Перечисления.СтатусыОпераций.ГотовоКОплате;
		КонецЕсли;
	ИначеЕсли НЕ МассивСтатусов.Найти("НеИдентифицирован") = Неопределено Тогда
		СтатусОперации = Перечисления.СтатусыОпераций.НеИдентифицирован;
	ИначеЕсли Не МассивСтатусов.Найти("Требует ручной корректировки") = Неопределено Тогда
		СтатусОперации = Перечисления.СтатусыОпераций.ТребуетРучнойКорректировки; 	
	ИначеЕсли Не МассивСтатусов.Найти("Не рассчитан") = Неопределено Тогда	
		СтатусОперации = Перечисления.СтатусыОпераций.НеРассчитан;	
	// Доработка START {Аудит 2026-04-04: убрано обращение через точку от Ссылка}
	ИначеЕсли ОплатыУслуг.Количество() > 0 Тогда
		Если ОплатыУслуг[0].Сумма = 0 Тогда
			СтатусОперации = Перечисления.СтатусыОпераций.НеРассчитан;
		КонецЕсли;
	КонецЕсли;
	// Доработка END
КонецФункции	

Процедура ПроверитьЗаполнениеДокумента(Отказ, РежимЗаписи)
	
	// Доработка START {Аудит 2026-04-04: ИЛИ→И — условие было всегда истинным}
	Если (СтатусОперации <> Перечисления.СтатусыОпераций.Обработан
		И СтатусОперации <> Перечисления.СтатусыОпераций.ГотовоКОплате)
		ИЛИ ПометкаУдаления
		ИЛИ РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
	// Доработка END
		Возврат;
	КонецЕсли;
	
	// Доработка START {Задача 15: автозаполнение обязательных реквизитов перед проверкой} {2026-04-13}
	Если КоличествоCMR = 0 И КодыCMR.Количество() > 0 Тогда
		КоличествоCMR = КодыCMR.Количество();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ВалютаОплаты) Тогда
		ВалютаОплаты = исОбщийМодульСервер.ВалютаРегламентированногоУчета();
	КонецЕсли;
	// Доработка END

	СписокРеквизитов = Новый СписокЗначений;

	СписокРеквизитов.Добавить("Оплата"				, "Оплата");
	СписокРеквизитов.Добавить("ВалютаОплаты"		, "Валюта оформления");
	СписокРеквизитов.Добавить("Контрагент"			, "Заказчик (контрагент)");
	СписокРеквизитов.Добавить("Принципал"			, "Принципал");
	СписокРеквизитов.Добавить("Организация"			, "Организация");
	// Доработка START {Задача 15: УслугаОрганизации убрана — справочник пуст, проверка всегда блокировала} {2026-04-13}
	// СписокРеквизитов.Добавить("УслугаОрганизации"	, "Услуга организации");
	// Доработка END
	СписокРеквизитов.Добавить("ОсновноеТС"			, "Номер авто (ОсновноеТС)");
	СписокРеквизитов.Добавить("КоличествоCMR"		, "Количество CMR");
	СписокРеквизитов.Добавить("ПунктОтправления"	, "Пункт отправления");
	СписокРеквизитов.Добавить("ПунктНазначения"		, "Пункт назначения");
	СписокРеквизитов.Добавить("Перевозчик"			, "Перевозчик");
	
	
	Если ДополнительныеУслуги.Количество() > 0 Тогда
		Для каждого СтрД Из ДополнительныеУслуги Цикл
			
			Если ЗначениеЗаполнено(СтрД.ДополнительнаяУслуга) И СтрД.Сумма = 0 Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Не заполнена сумма в табличной части ""Дополнительные услуги"" для " + СокрЛП(СтрД.ДополнительнаяУслуга) + " (строка " + СтрД.НомерСтроки + ")";
				Сообщение.Поле = "ДополнительныеУслуги[" + (СтрД.НомерСтроки-1) + "].Сумма";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				
				Отказ = Истина;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	
	Для каждого Эл Из СписокРеквизитов Цикл
		
		ПроверяемыйРек 				= ЭтотОбъект[Эл.Значение];
		ПроверяемыйРекНаименование 	= Эл.Представление;
		
		Если НЕ ЗначениеЗаполнено(ПроверяемыйРек) Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не заполнен реквизит: " + СокрЛП(ПроверяемыйРекНаименование);
			Сообщение.Поле 	= Эл.Значение;
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Доработка START {Задача 15: убрана проверка СтранаТС — реквизит не существует} {2026-04-13}
	// Проверка СтранаТС отключена: реквизит отсутствует в справочнике ТранспортныеСредства.
	// Доработка END
	
	// Доработка START {Задача 15: страна перевозчика — предупреждение, не блокировка} {2026-04-13}
	Попытка
		Если ЗначениеЗаполнено(Перевозчик)
			И НЕ ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Перевозчик, "СтранаРегистрации")) Тогда
			ОбщегоНазначения.СообщитьПользователю("Внимание: не заполнена страна регистрации перевозчика");
		КонецЕсли;
	Исключение
		// Реквизит СтранаРегистрации может отсутствовать — пропускаем
	КонецПопытки;
	// Доработка END
	
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	// регистр АгентскиеБонусы 
	Движения.АгентскиеБонусы.Записывать = Истина;
	Движение = Движения.АгентскиеБонусы.Добавить();
	Движение.Период = Дата;
