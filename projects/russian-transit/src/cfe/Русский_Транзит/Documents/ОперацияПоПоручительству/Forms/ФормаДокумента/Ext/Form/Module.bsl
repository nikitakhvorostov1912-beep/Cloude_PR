Процедура АннулироватьЗавершение(Результат, Параметры) Экспорт

	// Доработка START {Аудит 2026-04-04: проверка статуса ДО присвоения, а не после}
	Если Результат = КодВозвратаДиалога.Да Тогда

		ТекСтатус = Объект.СтатусТранзита;
		Объект.СтатусТранзита = ПредопределенноеЗначение("Перечисление.СтатусыТранзита.АннулированоСпециалистом");
	// Доработка END
		ДокументУспешноАннулирован 	= Истина;
		Попытка
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);		
			Если НЕ Записать(ПараметрыЗаписи) Тогда
				ДокументУспешноАннулирован 	= Ложь;
			КонецЕсли;
		Исключение
			ДокументУспешноАннулирован 		= Ложь;
		КонецПопытки;
		
		Если ДокументУспешноАннулирован Тогда
			ПоказатьОповещениеПользователя("Документ АННУЛИРОВАН.", ПолучитьНавигационнуюСсылку(Объект.Ссылка), Объект.Ссылка, БиблиотекаКартинок.Информация32);
		Иначе
			Объект.СтатусТранзита 			= ТекСтатус;
			
			Если Объект.Ссылка.Пустая() Тогда
				ПоказатьОповещениеПользователя("Документ НЕ АННУЛИРОВАН.",,, БиблиотекаКартинок.Информация32);
			Иначе
				ПоказатьОповещениеПользователя("Документ НЕ АННУЛИРОВАН.", ПолучитьНавигационнуюСсылку(Объект.Ссылка), Объект.Ссылка, БиблиотекаКартинок.Информация32);
			КонецЕсли; 
		КонецЕсли;
		
		УправлениеВидимостью();	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТребуетсяСогласование(ТекстПредупреждения)
	
	Если Объект.СтатусТранзита <> Перечисления.СтатусыТранзита.ТранзитЗавершен ИЛИ Объект.ПометкаУдаления ИЛИ (НЕ ЗначениеЗаполнено(Объект.Контрагент)) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Если ЗначениеЗаполнено(Объект.Дата) Тогда
	//	ДокОб = РеквизитФормыВЗначение("Объект");
	//	Если НЕ ДокОб.ТребуетсяПереОформлениеДокумента() Тогда
	//		Возврат Ложь;
	//	КонецЕсли;
	//КонецЕсли;
	
	Если ТекстПредупреждения <> "" Тогда
		ТекстПредупреждения = "Необходимо согласование оформления:" + ТекстПредупреждения;
	КонецЕсли;
	
	Возврат (ТекстПредупреждения <> "");
	
КонецФункции

Функция ЗаполненыВспомогательныеДанныеДляРасчетаЦен(ТекстСообщения)
	
	Если НЕ ЗначениеЗаполнено(Объект.Расстояние) Тогда
		ТекстСообщения = "Не заполнено расстояние между таможенными пунктами";
		Возврат Ложь;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Оплата) Тогда
		ТекстСообщения = "Не заполнена сумма оплаты";
		Возврат Ложь;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ТекстСообщения = "Не заполнен контрагент";
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура УправлениеВидимостью(Исправления = Ложь)
	
	ФормаТолькоНаПросмотр = ЭтаФорма.ТолькоПросмотр;
	
	ДокументВСтатусеЗавершен 					= (Объект.СтатусТранзита = ПредопределенноеЗначение("Перечисление.СтатусыТранзита.ТранзитЗавершен") И (НЕ Объект.ПометкаУдаления));
	ДокументВСтатусеАннулирован 				= (Объект.СтатусТранзита = ПредопределенноеЗначение("Перечисление.СтатусыТранзита.АннулированоСпециалистом"));
	ЗапрещеноРедактированиеПоУмолчанию			= ((ДокументВСтатусеЗавершен ИЛИ ДокументВСтатусеАннулирован) );
	
	Если РольДоступна("ПолныеПрава") Тогда
		 ПолноправныйПользователь = Истина;
	 Иначе
		 ПолноправныйПользователь = Ложь;
	КонецЕсли;
	
	Если ПолноправныйПользователь Тогда
		ДоступноРедактированиеНеточностей 		= ЗапрещеноРедактированиеПоУмолчанию;
		Элементы.ФормаЗавершитьТранзит.Доступность= (НЕ ДокументВСтатусеЗавершен);
	Иначе
		ДоступноРедактированиеНеточностей 		= (ДокументВСтатусеЗавершен );
		Элементы.ФормаЗавершитьТранзит.Доступность= ((НЕ (ДокументВСтатусеАннулирован ИЛИ ДокументВСтатусеЗавершен)) И (НЕ ФормаТолькоНаПросмотр));
	КонецЕсли;
	
	Если ДокументВСтатусеЗавершен И (НЕ Исправления) Тогда
		Элементы.ФормаЗавершитьТранзит.Пометка 		= Истина;
		Элементы.ФормаЗавершитьТранзит.Доступность 	= Ложь;
		Элементы.кАннулировать.Пометка 				= Ложь;
	ИначеЕсли ДокументВСтатусеАннулирован И (НЕ Исправления) Тогда 
		Элементы.ФормаЗавершитьТранзит.Пометка 		= Ложь;
		Элементы.кАннулировать.Пометка 				= Истина;
		Элементы.кАннулировать.Доступность			= Ложь;
	ИначеЕсли Исправления Тогда
		Элементы.ФормаЗавершитьТранзит.Пометка 		= Ложь; 
		Элементы.ФормаЗавершитьТранзит.Доступность 	= Истина;
		Элементы.кАннулировать.Пометка 				= Ложь;
		Элементы.кАннулировать.Доступность			= Истина;	
	КонецЕсли;
	
	// Доработка START {Редизайн формы: 5 вкладок} {2026-04-09}
	ЗапретРедактирования = (ДокументВСтатусеАннулирован ИЛИ ДокументВСтатусеЗавершен) И (НЕ Исправления);
	Элементы.ГруппаШапкаСтрока1.ТолькоПросмотр = ЗапретРедактирования;
	Элементы.ГруппаШапкаСтрока2.ТолькоПросмотр = ЗапретРедактирования;
	Элементы.ГруппаИтоги.ТолькоПросмотр = ЗапретРедактирования;
	Элементы.Вкладки.ТолькоПросмотр = ЗапретРедактирования;
	Элементы.ПодвалДокумента.ТолькоПросмотр = ЗапретРедактирования;
	// Доработка END
	
	Элементы.ОбновитьЦены.Доступность = НЕ (ДокументВСтатусеАннулирован ИЛИ ДокументВСтатусеЗавершен) ИЛИ Исправления;
	
	// Доработка START {FR-008: 3-я аналитика спеццен} {2026-04-09}
	Если Объект.СпецЦены Тогда
		Элементы.СубконтоСпецЦены.Доступность = Истина;
		Элементы.СубконтоСпецЦены2.Доступность = Истина;
		Элементы.СубконтоСпецЦены3.Доступность = Истина;
	Иначе
		Элементы.СубконтоСпецЦены.Доступность = Ложь;
		Элементы.СубконтоСпецЦены2.Доступность = Ложь;
		Элементы.СубконтоСпецЦены3.Доступность = Ложь;
	КонецЕсли;
	// Доработка END

	//пТекущийСтатусДокумента = "Статус документа: " + ВРЕГ(Объект.СтатусТранзита) +
	//?(ЗначениеЗаполнено(Объект.Дата), ", оформлен " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy"), "");
	//Элементы.НадписьСтатусДокумента.Заголовок = пТекущийСтатусДокумента;
	
КонецПроцедуры

#Область КомандныйИнтерфейс
&НаКлиенте
Процедура ЗавершитьТранзит(Команда)
	
	ТекстПредупреждения = "";
	Если ТребуетсяСогласование(ТекстПредупреждения) Тогда
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	
	Если НЕ ЗаполненыВспомогательныеДанныеДляРасчетаЦен(ТекстПредупреждения) Тогда
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
				
	ТекСтатус					= Объект.СтатусТранзита;
	Объект.СтатусТранзита 		= ПредопределенноеЗначение("Перечисление.СтатусыТранзита.ТранзитЗавершен");
	
	ДокументУспешноОформлен 	= Истина;
	
	ПервичноеОформление			= (НЕ ЗначениеЗаполнено(Объект.Дата));
	
	Попытка
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);		
		Если НЕ Записать(ПараметрыЗаписи) Тогда                       
			ДокументУспешноОформлен = Ложь;
		КонецЕсли;
	Исключение
		ДокументУспешноОформлен 	= Ложь;
	КонецПопытки;
	
	Если ДокументУспешноОформлен Тогда
		ПоказатьОповещениеПользователя("Документ ОФОРМЛЕН.", ПолучитьНавигационнуюСсылку(Объект.Ссылка), Объект.Ссылка, БиблиотекаКартинок.Информация32);
	Иначе
		Объект.СтатусТранзита 			= ТекСтатус;
		
		Если Объект.Ссылка.Пустая() Тогда
			ПоказатьОповещениеПользователя("Документ НЕ ОФОРМЛЕН.",,, БиблиотекаКартинок.Информация32);
		Иначе
			ПоказатьОповещениеПользователя("Документ НЕ ОФОРМЛЕН.", ПолучитьНавигационнуюСсылку(Объект.Ссылка), Объект.Ссылка, БиблиотекаКартинок.Информация32);
		КонецЕсли; 
	КонецЕсли;
	
	УправлениеВидимостью();
	
	Если ПервичноеОформление Тогда
		
		УспешноеПервичноеОформление = (Объект.СтатусТранзита = ПредопределенноеЗначение("Перечисление.СтатусыТранзита.ТранзитРазрешен")
		И ЗначениеЗаполнено(Объект.Дата));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Аннулировать(Команда)
	
	Оповещение = Новый ОписаниеОповещения("АннулироватьЗавершение", ЭтаФорма);
	Текст = "Аннулировать?";
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, 10, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьТариф(Команда)
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыОткрытия.Вставить("СпецЦены", Объект.СпецЦены);
	ПараметрыОткрытия.Вставить("СубконтоСпецЦены", Объект.СубконтоСпецЦены);
	ПараметрыОткрытия.Вставить("СубконтоСпецЦены2", Объект.СубконтоСпецЦены2);

	ОткрытьФорму("Обработка.УстановкаЦенКонтрагентов.Форма.ФормаУпр",
		ПараметрыОткрытия,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура Редактировать(Команда)
	ВнестиИзменения = Истина;
	
	УправлениеВидимостью(ВнестиИзменения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеУслугиВалютаЦеныПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ДополнительныеУслуги.ТекущиеДанные;
	Отбор = Новый Структура("Валюта", ТекущаяСтрока.ВалютаЦены);
	КурсВалюты = ПолучитьКурсНаСервере(Объект.Дата, Отбор);
	Если КурсВалюты = Неопределено Тогда
		КурсВалюты = 1;
	КонецЕсли;
	ТекущаяСтрока.Сумма = КурсВалюты * ТекущаяСтрока.СуммаВВалютеЦены;
КонецПроцедуры

&НаКлиенте
Процедура АгентскоеВознаграждениеПроцентПриИзменении(Элемент)
	Объект.АгентскоеВознаграждениеСумма = Объект.Оплата * Объект.АгентскоеВознаграждениеПроцент / 100;
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеУслугиСуммаВВалютеЦеныПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ДополнительныеУслуги.ТекущиеДанные;
	Отбор = Новый Структура("Валюта", ТекущаяСтрока.ВалютаЦены);
	КурсВалюты = ПолучитьКурсНаСервере(Объект.Дата, Отбор);
	Если КурсВалюты = Неопределено Тогда
		КурсВалюты = 1;
	КонецЕсли;
	Если ТекущаяСтрока.СуммаВВалютеЦены <> 0 Тогда
		ТекущаяСтрока.Сумма = КурсВалюты * ТекущаяСтрока.СуммаВВалютеЦены; 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КодыCMRЦенаПриИзменении(Элемент)
	Объект.СуммаОбеспечения = 0 ;	
	Для Каждого Строка ИЗ Объект.КодыCMR Цикл
		Валюта = ВалютаРубль();
		Если Строка.Валюта <> Валюта Тогда
			Отбор = Новый Структура("Валюта", Строка.Валюта);
			КурсВалюты = ПолучитьКурсНаСервере(Объект.Дата,Отбор);
			Если КурсВалюты = Неопределено Тогда
				КурсВалюты = 1;	
			КонецЕсли;
			Объект.СуммаОбеспечения = Объект.СуммаОбеспечения + (Строка.Цена * КурсВалюты);
		Иначе 
			Объект.СуммаОбеспечения = Объект.СуммаОбеспечения + Строка.Цена;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ВалютаРубль()

	Возврат Справочники.Валюты.НайтиПоНаименованию("RUB");

КонецФункции // ВалютаРубль()

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		НастройкиСпецЦен = ОпределитьНастройкиСпецЦенКонтрагента(Объект.Контрагент);
		Объект.СпецЦены = НастройкиСпецЦен.СпецЦены;
		Объект.СубконтоСпецЦены = НастройкиСпецЦен.СубконтоСпецЦены;
		Объект.СубконтоСпецЦены2 = НастройкиСпецЦен.СубконтоСпецЦены2;

		Элементы.СубконтоСпецЦены.Доступность = Объект.СпецЦены;
		Элементы.СубконтоСпецЦены2.Доступность = Объект.СпецЦены;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьНастройкиСпецЦенКонтрагента(Контрагент)

	Результат = Новый Структура("СпецЦены, СубконтоСпецЦены, СубконтоСпецЦены2",
		Ложь, 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.СпецЦены КАК СпецЦены,
	|	ТИПЗНАЧЕНИЯ(Т.СубконтоСпецЦены) КАК ТипСубконто1,
	|	ТИПЗНАЧЕНИЯ(Т.СубконтоСпецЦены2) КАК ТипСубконто2
	|ИЗ
	|	РегистрСведений.ТарифныеСеткиОбеспечения.СрезПоследних(
	|		, Контрагент = &Контрагент И СпецЦены = ИСТИНА) КАК Т";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Результат.СпецЦены = Истина;
	Результат.СубконтоСпецЦены = ТипСубконтоВЧисло(Выборка.ТипСубконто1);
	Результат.СубконтоСпецЦены2 = ТипСубконтоВЧисло(Выборка.ТипСубконто2);

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ТипСубконтоВЧисло(ТипСубконто)

	Если ТипСубконто = Тип("СправочникСсылка.ТаможенныеПункты") Тогда
		Возврат 1; // Пункт
	ИначеЕсли ТипСубконто = Тип("СправочникСсылка.ТранспортныеСредства") Тогда
		Возврат 2; // Т/С
	ИначеЕсли ТипСубконто = Тип("СправочникСсылка.Паромы") Тогда
		Возврат 3; // Паром
	КонецЕсли;

	Возврат 0;

КонецФункции

&НаКлиенте
Процедура СпецЦеныПриИзменении(Элемент)

	// Доработка START {FR-008: 3-я аналитика спеццен} {2026-04-09}
	Если Объект.СпецЦены Тогда
		Элементы.СубконтоСпецЦены.Доступность = Истина;
		Элементы.СубконтоСпецЦены2.Доступность = Истина;
		Элементы.СубконтоСпецЦены3.Доступность = Истина;
	Иначе
		Элементы.СубконтоСпецЦены.Доступность = Ложь;
		Элементы.СубконтоСпецЦены2.Доступность = Ложь;
		Элементы.СубконтоСпецЦены3.Доступность = Ложь;
	КонецЕсли;
