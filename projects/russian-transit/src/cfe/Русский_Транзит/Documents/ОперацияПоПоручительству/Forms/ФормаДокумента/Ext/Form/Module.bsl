&НаСервере
Функция ПолучитьПараметрыКомандыВнешнегоОтчета(Ссылка)
    Запрос = новый Запрос;
    Запрос.УстановитьПараметр("Ссылка",Ссылка);
    Запрос.Текст =
    "ВЫБРАТЬ
    |   ТаблицаКоманды.Ссылка,
    |   ТаблицаКоманды.Идентификатор,
    |   ТаблицаКоманды.ВариантЗапуска,
    |   ТаблицаКоманды.Представление КАК Представление,
    |   ТаблицаКоманды.ПоказыватьОповещение,
    |   ТаблицаКоманды.Модификатор
    |ИЗ
    |   Справочник.ДополнительныеОтчетыИОбработки.Команды КАК ТаблицаКоманды
    |ГДЕ
    |   ТаблицаКоманды.Скрыть = ЛОЖЬ
    |   И ТаблицаКоманды.Ссылка = &Ссылка
    |
    |УПОРЯДОЧИТЬ ПО
    |   Представление";

    Результат = Запрос.Выполнить().Выбрать();

    Если Результат.Количество() = 0 Тогда
        возврат Неопределено;
    Иначе
        Результат.Следующий();
        ВыполняемаяКоманда = Новый Структура(
        "Ссылка, Представление,
        |Идентификатор, ВариантЗапуска, ПоказыватьОповещение,
        |Модификатор, ОбъектыНазначения, ЭтоОтчет, Вид");

        ЗаполнитьЗначенияСвойств(ВыполняемаяКоманда,Результат);

        Возврат ВыполняемаяКоманда;
    КонецЕсли;
Конецфункции 

&НаКлиенте
Процедура ЗапускМоегоОтчета(Отчет) 
		
	ВыполняемаяКоманда = ПолучитьПараметрыКомандыВнешнегоОтчета(Отчет);
	//Теперь заполним недостающие поля команды:
	
	ВыполняемаяКоманда.ЭтоОтчет = Истина;
	ВыполняемаяКоманда.Вид      = ВидОтчета;
	//Создадим структуру с параметрами запуска нашего отчета:
	
	ПараметрыОбработки = Новый Структура("ИдентификаторКоманды, ДополнительнаяОбработкаСсылка, ИмяФормы, КлючСессии, ПользовательскиеНастройки, СформироватьПриОткрытии");
	ПараметрыОбработки.ИдентификаторКоманды          = ВыполняемаяКоманда.Идентификатор;
	ПараметрыОбработки.ДополнительнаяОбработкаСсылка = ВыполняемаяКоманда.Ссылка;
	ПараметрыОбработки.ИмяФормы                      = Неопределено;
	ПараметрыОбработки.КлючСессии                    = ВыполняемаяКоманда.Ссылка.УникальныйИдентификатор();
	ПараметрыОбработки.СформироватьПриОткрытии       = Истина;          
	
	ИмяОбработки_ = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяКоманда.Ссылка);
	
	Форма = ПолучитьФорму("ВнешнийОтчет."+ ИмяОбработки_ +".Форма");
	КомпоновщикНастроекКомпоновкиДанных = Форма.Отчет.КомпоновщикНастроек;
	ПользовательскиеНастройки = КомпоновщикНастроекКомпоновкиДанных.ПользовательскиеНастройки;       
	
	
	ОтборКонтрагент = ПолучитьОтборПользовательскойНастройки(КомпоновщикНастроекКомпоновкиДанных, ПользовательскиеНастройки, "ссылка");   
	Если ОтборКонтрагент <> Неопределено тогда
		ОтборКонтрагент.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборКонтрагент.ПравоеЗначение = Объект.Контрагент;
		ОтборКонтрагент.Использование  = Истина;     
	КонецЕсли;   
	
	ОтборДоговор = ПолучитьОтборПользовательскойНастройки(КомпоновщикНастроекКомпоновкиДанных, ПользовательскиеНастройки, "Договор");
	Если ОтборДоговор <> Неопределено тогда
		ОтборДоговор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборДоговор.Использование  = ложь;     
	КонецЕсли;   
	
	ОтборСтатус = ПолучитьОтборПользовательскойНастройки(КомпоновщикНастроекКомпоновкиДанных, ПользовательскиеНастройки, "Статус");
	Если ОтборСтатус <> Неопределено тогда
		ОтборСтатус.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборСтатус.Использование  = ложь;     
	КонецЕсли;  
	
	ОтборДекларант = ПолучитьОтборПользовательскойНастройки(КомпоновщикНастроекКомпоновкиДанных, ПользовательскиеНастройки, "Декларант");
	Если ОтборДекларант <> Неопределено тогда
		ОтборДекларант.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборДекларант.Использование  = Истина;     
		ОтборДекларант.ПравоеЗначение = Объект.Декларант;
	КонецЕсли;  
	
	
	ПараметрыОбработки.ПользовательскиеНастройки = ПользовательскиеНастройки;
	//Получим форму отчета с учетом параметров и откроем ее:
	
	Форма = ПолучитьФорму("ВнешнийОтчет."+ ИмяОбработки_ +".Форма",ПараметрыОбработки);
	ОткрытьФорму(Форма);   
	
КонецПроцедуры   

&НаКлиенте
Функция ПолучитьОтборПользовательскойНастройки(Компоновщик, ПользовательскиеНастройки, ИмяПоля)
    Поле = новый ПолеКомпоновкиДанных(ИмяПоля);

    ИдентификаторОтбора = Неопределено;
    Для Каждого Элемент из Компоновщик.Настройки.Отбор.Элементы Цикл
        Если Элемент.ЛевоеЗначение = Поле Тогда
            ИдентификаторОтбора = Элемент.ИдентификаторПользовательскойНастройки;
        КонецЕсли;
    КонецЦикла;

    возврат ПользовательскиеНастройки.Элементы.Найти(ИдентификаторОтбора);
КонецФункции

&НаКлиенте
Процедура УстановитьПараметрПользовательскойНастройки(ПользовательскиеНастройки, ИмяНастройки, Параметр)

    ПолеКомпановкиПараметр = Новый ПараметрКомпоновкиДанных(ИмяНастройки);
    ЭлементОтбора = Неопределено;

    Для Каждого Элемент Из ПользовательскиеНастройки.Элементы Цикл
        Если ТипЗнч(Элемент) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") и Элемент.Параметр = ПолеКомпановкиПараметр Тогда
            Элемент.Значение = Параметр.Значение;
            Элемент.Использование = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	//ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Доработка START {Задача 13: заполнить ТипУчета для строк где он пуст (старые документы)} {2026-04-12}
	ЗаполнитьТипУчетаИзКонтрагентаНаСервере();
	// Доработка END
КонецПроцедуры


#КонецОбласти



// Доработка START {Убрана привязка документа к шапочному СтатусТранзита} {2026-04-10}
// После перехода на группировку документов (1 документ = N ЭТД в ТЧ ДанныеДокументов)
// единый СтатусТранзита в шапке не имеет смысла - каждая строка ТЧ имеет свой статус.
// Удалены: АннулироватьЗавершение, ТребуетсяСогласование, ЗавершитьТранзит, Аннулировать, Редактировать.
// Удалены кнопки ФормаЗавершитьТранзит, ФормаРедактировать, кАннулировать и команды в Form.xml.
// Логика блокировки формы по статусу в УправлениеВидимостью также снята.
// Доработка END

Функция ЗаполненыВспомогательныеДанныеДляРасчетаЦен(ТекстСообщения)
	
	Если НЕ ЗначениеЗаполнено(Объект.Расстояние) Тогда
		ТекстСообщения = "Не заполнено расстояние между таможенными пунктами";
		Возврат Ложь;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Оплата) Тогда
		ТекстСообщения = "Не заполнена сумма оплаты";
		Возврат Ложь;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ТекстСообщения = "Не заполнен контрагент";
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура УправлениеВидимостью(Исправления = Ложь)

	// Доработка START {Убрана блокировка формы по шапочному СтатусТранзита} {2026-04-10}
	// После перехода на группировку документов статус транзита перенесён в ТЧ ДанныеДокументов.
	// Единая блокировка формы по завершённому/аннулированному статусу больше не имеет смысла:
	// каждая строка ТЧ имеет собственный статус, а шапочного СтатусТранзита больше нет.
	// Параметр Исправления оставлен для обратной совместимости вызовов, но не используется.
	ФормаТолькоНаПросмотр = ЭтаФорма.ТолькоПросмотр;

	Элементы.ОбновитьЦены.Доступность = НЕ ФормаТолькоНаПросмотр;
	// Доработка END

	// Доработка START {СпецЦены: поле СпецСетка видимо только при включённом флаге} {2026-04-12}
	Элементы.СпецСетка.Видимость = Объект.СпецЦены;
	// Доработка END

	// Доработка START {Задача 15: фильтрация СпецСетка по контрагенту документа} {2026-04-13}
	// СеткиСпецЦен подчинён Контрагентам (Owner) — показываем только сетки текущего контрагента.
	МассивОтбора = Новый Массив;
	МассивОтбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец", Объект.Контрагент));
	Элементы.СпецСетка.ПараметрыВыбора = Новый ФиксированныйМассив(МассивОтбора);
	// Доработка END

КонецПроцедуры

#Область КомандныйИнтерфейс

// Доработка START {Удалены обработчики ЗавершитьТранзит/Аннулировать после перехода на группировку} {2026-04-10}
// Документ теперь группирует N ЭТД в ТЧ ДанныеДокументов — единый статус документа не имеет смысла.
// Статусы транзита хранятся и редактируются построчно в ТЧ ДанныеДокументов.СтатусТранзита.
// Доработка END

&НаКлиенте
Процедура ИзменитьТариф(Команда)
	// Доработка START {Упрощение СпецЦены: убраны параметры СубконтоСпецЦены* из команды открытия} {2026-04-11}
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыОткрытия.Вставить("СпецЦены", Объект.СпецЦены);
	// Доработка END

	ОткрытьФорму("Обработка.УстановкаЦенКонтрагентов.Форма.ФормаУпр",
		ПараметрыОткрытия,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

// Доработка START {СпецЦены: удалена форма-пикер, теперь одно поле СпецСетка (справочник)} {2026-04-12}
// Доработка END

&НаКлиенте
Процедура ДополнительныеУслугиВалютаЦеныПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ДополнительныеУслуги.ТекущиеДанные;
	Отбор = Новый Структура("Валюта", ТекущаяСтрока.ВалютаЦены);
	КурсВалюты = ПолучитьКурсНаСервере(Объект.Дата, Отбор);
	Если КурсВалюты = Неопределено Тогда
		КурсВалюты = 1;
	КонецЕсли;
	ТекущаяСтрока.Сумма = КурсВалюты * ТекущаяСтрока.СуммаВВалютеЦены;
КонецПроцедуры

&НаКлиенте
Процедура АгентскоеВознаграждениеПроцентПриИзменении(Элемент)
	Объект.АгентскоеВознаграждениеСумма = Объект.Оплата * Объект.АгентскоеВознаграждениеПроцент / 100;
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеУслугиСуммаВВалютеЦеныПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ДополнительныеУслуги.ТекущиеДанные;
	Отбор = Новый Структура("Валюта", ТекущаяСтрока.ВалютаЦены);
	КурсВалюты = ПолучитьКурсНаСервере(Объект.Дата, Отбор);
	Если КурсВалюты = Неопределено Тогда
		КурсВалюты = 1;
	КонецЕсли;
	Если ТекущаяСтрока.СуммаВВалютеЦены <> 0 Тогда
		ТекущаяСтрока.Сумма = КурсВалюты * ТекущаяСтрока.СуммаВВалютеЦены; 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КодыCMRЦенаПриИзменении(Элемент)
	Объект.СуммаОбеспечения = 0 ;	
	Для Каждого Строка ИЗ Объект.КодыCMR Цикл
		Валюта = ВалютаРубль();
		Если Строка.Валюта <> Валюта Тогда
			Отбор = Новый Структура("Валюта", Строка.Валюта);
			КурсВалюты = ПолучитьКурсНаСервере(Объект.Дата,Отбор);
			Если КурсВалюты = Неопределено Тогда
				КурсВалюты = 1;	
			КонецЕсли;
			Объект.СуммаОбеспечения = Объект.СуммаОбеспечения + (Строка.Цена * КурсВалюты);
		Иначе 
			Объект.СуммаОбеспечения = Объект.СуммаОбеспечения + Строка.Цена;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ВалютаРубль()

	Возврат Справочники.Валюты.НайтиПоНаименованию("RUB");

КонецФункции // ВалютаРубль()

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	// Доработка START {СпецЦены: при смене контрагента сбрасываем спец-сетку} {2026-04-12}
	Объект.СпецСетка = Неопределено;
	// Доработка END

	// Доработка START {Задача 13: обновить ТипУчета во всех строках ТЧ при смене контрагента} {2026-04-12}
	НовыйТипУчета = ПолучитьТипУчетаКонтрагента(Объект.Контрагент);
	Для Каждого СтрокаТЧ Из Объект.ДанныеДокументов Цикл
		СтрокаТЧ.ТипУчета = НовыйТипУчета;
	КонецЦикла;
	// Доработка END

КонецПроцедуры

&НаКлиенте
Процедура СпецЦеныПриИзменении(Элемент)

	// Доработка START {СпецЦены: видимость поля СпецСетка} {2026-04-12}
	Элементы.СпецСетка.Видимость = Объект.СпецЦены;
	Если НЕ Объект.СпецЦены Тогда
		Объект.СпецСетка = Неопределено;
	КонецЕсли;
	// Доработка END

КонецПроцедуры

// Доработка START {Задача 13: Фильтрация CMR по выбранной строке ДДП} {2026-04-12}
&НаКлиенте
Процедура ФильтрCMRПоДДП(Команда)
	ТекущиеДанные = Элементы.ДанныеДокументов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НомерДДП = ТекущиеДанные.НомерГТД;
	Если ЗначениеЗаполнено(НомерДДП) Тогда
		Элементы.КодыCMR.ОтборСтрок = Новый ФиксированнаяСтруктура("НомерДополнения", НомерДДП);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сбросить(Команда)
	Элементы.КодыCMR.ОтборСтрок = Неопределено;
КонецПроцедуры
// Доработка END

// Доработка START {Задача 13: ТипУчета в ТЧ ДанныеДокументов} {2026-04-12}
&НаКлиенте
Процедура ДанныеДокументовТипУчетаПриИзменении(Элемент)
	// ТипУчета изменён вручную — значение уже записано в строку ТЧ.
	// При следующем расчёте исРасчет будет использовать построчный ТипУчета.
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТипУчетаКонтрагента(Контрагент)
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ТипУчета");
КонецФункции

&НаСервере
Процедура ЗаполнитьТипУчетаИзКонтрагентаНаСервере()
	Контрагент = Объект.Контрагент;
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	ТипУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ТипУчета");
	Для Каждого СтрокаТЧ Из Объект.ДанныеДокументов Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ТипУчета) Тогда
			СтрокаТЧ.ТипУчета = ТипУчета;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
