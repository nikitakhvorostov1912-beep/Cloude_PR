Функция ПолучитьКурсНаСервере(Дата,Отбор)
	
	// FRAGILE: НайтиПоНаименованию хрупкий — при переименовании валюты код сломается. TODO: заменить на НайтиПоКоду("643")
	Если Отбор.Валюта <> Справочники.Валюты.НайтиПоНаименованию("RUB") Тогда
		Возврат РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Дата, Отбор).Курс; 
	Иначе 
		Возврат 1;
	КонецЕсли;
	
КонецФункции // ПолучитьКурсНаСервере()


