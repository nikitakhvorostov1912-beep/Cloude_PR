#Область ОбновлениеЦен

&НаКлиенте
Процедура ОбновитьЦены(Команда)
	
	Тариф = ПроверитьТарифыЗаказчика();
	Если Тариф тогда
		ОбновитьЦеныВызовСервера();
		Объект.Оплата = Объект.ОплатыУслуг.Итог("Сумма") + Объект.ОплатыУслуг.Итог("СуммаКодов") + Объект.ДополнительныеУслуги.Итог("Сумма");
		Если Объект.АгентскоеВознаграждениеПроцент <> 0 Тогда
			Объект.АгентскоеВознаграждениеСумма = Объект.АгентскоеВознаграждениеПроцент * Объект.Оплата / 100;	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьТарифыЗаказчика()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТарифныеСеткиОбеспеченияСрезПоследних.Период КАК Период,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.Контрагент КАК Контрагент,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.Договор КАК Договор,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.АналитикаСумм КАК АналитикаСумм,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.СпецЦены КАК СпецЦены,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.КлючАналитик КАК КлючАналитик,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.Цена КАК Цена,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.ВидРасчета КАК ВидРасчета,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.ИндивидуальныйРасчет КАК ИндивидуальныйРасчет,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.Валюта КАК Валюта,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.Ответственный КАК Ответственный,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.ДатаУстановки КАК ДатаУстановки
		|ИЗ
		|	РегистрСведений.ТарифныеСеткиОбеспечения.СрезПоследних(
		|			&МоментВремени,
		|			Контрагент = &Контрагент
		|				И СпецЦены = &СпецЦены) КАК ТарифныеСеткиОбеспеченияСрезПоследних";
	
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("МоментВремени", Объект.Дата);
	Запрос.УстановитьПараметр("СпецЦены", Объект.СпецЦены);
	
	Результат = Запрос.Выполнить();
		
    Если Результат.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("У контрагента не заполнена тарифная сетка!");
		Возврат Ложь;
	Иначе 
		Возврат Истина;
	Конецесли;
	
КонецФункции	
// Доработка START {БезКонтекста — не использует данные формы} {2026-04-02}
&НаСервереБезКонтекста
