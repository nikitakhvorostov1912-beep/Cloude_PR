&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.Список.КоманднаяПанель;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Доработка START {TD-spec v1: условное оформление + автомиграция ВидОперации} {2026-04-23}
	Расш1_УстановитьУсловноеОформление();
	РусскийТранзитОбновлениеИБ.ВыполнитьМиграциюЕслиНужно();
	// Доработка END
КонецПроцедуры

// Доработка START {TD-spec v1: фильтр-чипы и условное оформление} {2026-04-23}

&НаСервере
Процедура Расш1_УстановитьУсловноеОформление()

	Расш1_УО = Список.КомпоновщикНастроек.Настройки.УсловноеОформление;

	ЭлементДДП = Расш1_УО.Элементы.Добавить();
	Расш1_ДобавитьОтборПоВидуОперации(ЭлементДДП, ПредопределенноеЗначение("Перечисление.ВидыОперацийПоручительства.ДДПАвто"));
	ЭлементДДП.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(173, 216, 230));

	ЭлементТД = Расш1_УО.Элементы.Добавить();
	Расш1_ДобавитьОтборПоВидуОперации(ЭлементТД, ПредопределенноеЗначение("Перечисление.ВидыОперацийПоручительства.ТДФайл"));
	ЭлементТД.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(144, 238, 144));

	ЭлементПусто = Расш1_УО.Элементы.Добавить();
	ОтборПусто = ЭлементПусто.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПусто.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидОперации");
	ОтборПусто.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ОтборПусто.Использование = Истина;
	ЭлементПусто.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 248, 196));

КонецПроцедуры

&НаКлиенте
Процедура Расш1_ФильтрБезТипа(Команда)

	Отбор = Список.КомпоновщикНастроек.Настройки.Отбор;
	Расш1_УдалитьОтборПоВидуОперации(Отбор);

	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидОперации");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура Расш1_ДобавитьОтборПоВидуОперации(ЭлементОформления, ВидОперации)

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидОперации");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ВидОперации;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

&НаКлиенте
Процедура Расш1_ФильтрВсе(Команда)
	Расш1_ОчиститьФильтрВидаОперации();
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ФильтрДДПАвто(Команда)
	Расш1_УстановитьФильтрВидаОперации(ПредопределенноеЗначение("Перечисление.ВидыОперацийПоручительства.ДДПАвто"));
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ФильтрТДФайл(Команда)
	Расш1_УстановитьФильтрВидаОперации(ПредопределенноеЗначение("Перечисление.ВидыОперацийПоручительства.ТДФайл"));
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ОчиститьФильтрВидаОперации()

	Отбор = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	Расш1_УдалитьОтборПоВидуОперации(Отбор);

	Отбор = Список.КомпоновщикНастроек.Настройки.Отбор;
	Расш1_УдалитьОтборПоВидуОперации(Отбор);

КонецПроцедуры

&НаКлиенте
Процедура Расш1_УстановитьФильтрВидаОперации(ВидОперации)

	Отбор = Список.КомпоновщикНастроек.Настройки.Отбор;
	Расш1_УдалитьОтборПоВидуОперации(Отбор);

	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидОперации");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ВидОперации;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура Расш1_УдалитьОтборПоВидуОперации(Отбор)

	Удалить = Новый Массив;
	Для Каждого Элемент Из Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидОперации") Тогда
			Удалить.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Элемент Из Удалить Цикл
		Отбор.Элементы.Удалить(Элемент);
	КонецЦикла;

КонецПроцедуры

// Доработка END



