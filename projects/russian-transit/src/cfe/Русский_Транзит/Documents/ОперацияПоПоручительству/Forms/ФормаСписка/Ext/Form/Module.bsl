	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Доработка START {TD-spec v1: условное оформление + автомиграция ВидОперации} {2026-04-23}
	// Расш1_УстановитьУсловноеОформление();
	РусскийТранзитОбновлениеИБ.ВыполнитьМиграциюЕслиНужно();
	// Доработка END
КонецПроцедуры

// Доработка START {TD-spec v1: фильтр-чипы и условное оформление} {2026-04-23}

&НаСервере
Процедура Расш1_УстановитьУсловноеОформление()

	Расш1_УО = Список.КомпоновщикНастроек.Настройки.УсловноеОформление;

	ЭлементДДП = Расш1_УО.Элементы.Добавить();
	Расш1_ДобавитьОтборПоВидуОперации(ЭлементДДП, ПредопределенноеЗначение("Перечисление.ВидыОперацийПоручительства.ДДПАвто"));
	ЭлементДДП.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(173, 216, 230));

	ЭлементТД = Расш1_УО.Элементы.Добавить();
	Расш1_ДобавитьОтборПоВидуОперации(ЭлементТД, ПредопределенноеЗначение("Перечисление.ВидыОперацийПоручительства.ТДФайл"));
	ЭлементТД.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(144, 238, 144));

	ЭлементПусто = Расш1_УО.Элементы.Добавить();
	ОтборПусто = ЭлементПусто.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПусто.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидОперации");
	ОтборПусто.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ОтборПусто.Использование = Истина;
	ЭлементПусто.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 248, 196));

КонецПроцедуры

&НаСервереБезКонтекста
Процедура Расш1_ДобавитьОтборПоВидуОперации(ЭлементОформления, ВидОперации)

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидОперации");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ВидОперации;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

// Доработка {Расш1-rewrite фильтры 2026-05-04}: переписано через ПолучитьНастройки/ЗагрузитьНастройки.
// Старая реализация модифицировала Список.КомпоновщикНастроек.Настройки.Отбор напрямую —
// это базовые настройки разработчика, и они не применяются к динамическому списку
// без перезагрузки настроек в компоновщик. Правильный паттерн:
//   1) ПолучитьНастройки() — получить объединённые настройки (база + фикс + пользователь)
//   2) Изменить Отбор
//   3) ЗагрузитьНастройки(...) — компоновщик пересоздаст пользовательские настройки и применит к списку

&НаКлиенте
Процедура Расш1_ФильтрВсе(Команда)
	Расш1_ПрименитьФильтрВидаОперации(Неопределено, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ФильтрДДПАвто(Команда)
	Расш1_ПрименитьФильтрВидаОперации(
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПоручительства.ДДПАвто"),
		Истина);
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ФильтрТДФайл(Команда)
	Расш1_ПрименитьФильтрВидаОперации(
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПоручительства.ТДФайл"),
		Истина);
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ФильтрБезТипа(Команда)
	// "Без типа" — отбор по пустой ссылке (после миграции таких ОПП быть не должно, но кнопка работает).
	Расш1_ПрименитьФильтрВидаОперации(
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПоручительства.ПустаяСсылка"),
		Истина);
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПрименитьФильтрВидаОперации(Значение, Использовать)
	// ПолучитьНастройки/ЗагрузитьНастройки — серверные методы, нужен серверный контекст.
	Расш1_ПрименитьФильтрВидаОперацииНаСервере(Значение, Использовать);
КонецПроцедуры

&НаСервере
Процедура Расш1_ПрименитьФильтрВидаОперацииНаСервере(Значение, Использовать)

	Настройки = Список.КомпоновщикНастроек.ПолучитьНастройки();

	// Удалить старые отборы по ВидОперации
	Удалить = Новый Массив;
	Для Каждого Элемент Из Настройки.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Строка(Элемент.ЛевоеЗначение) = "ВидОперации" Тогда
			Удалить.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Удалить Цикл
		Настройки.Отбор.Элементы.Удалить(Элемент);
	КонецЦикла;

	Если Использовать Тогда
		НовыйЭлемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидОперации");
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НовыйЭлемент.ПравоеЗначение = Значение;
		НовыйЭлемент.Использование = Истина;
	КонецЕсли;

	Список.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);

КонецПроцедуры

// Доработка END



