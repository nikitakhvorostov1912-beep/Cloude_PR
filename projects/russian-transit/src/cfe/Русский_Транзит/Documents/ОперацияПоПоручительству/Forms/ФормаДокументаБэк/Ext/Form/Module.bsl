
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)   
	
	
	Объект.ВалютаДокумента =  справочники.Валюты.НайтиПоНаименованию("RUB");
    Объект.РежимОформления = перечисления.РежимыОформления.Транзит;
КонецПроцедуры     

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьСтатус();	
КонецПроцедуры

// Доработка START {Аудит 2026-04-04: исправлен вызов пустаяСсылка() у перечисления + убран НайтиПоНаименованию}
Процедура ОбновитьСтатус()
	Если ЗначениеЗаполнено(Объект.СтатусОперации) Тогда
		Элементы.НадписьСтатусДокумента.Заголовок = "Статус документа: " + Объект.СтатусОперации;
	КонецЕсли;
КонецПроцедуры
// Доработка END	

#Область ОбновлениеЦен

&НаКлиенте
Процедура ОбновитьЦены(Команда)
	
	ОбновитьЦеныВызовСервера();
	Объект.Оплата = Объект.ОплатыУслуг.Итог("Сумма") + Объект.ОплатыУслуг.Итог("СуммаКодов");	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЦеныВызовСервера()

	 исРасчет.ОбновитьЦеныНаСервере(Объект);

КонецПроцедуры

&НаСервере
Процедура ПунктОтправленияПриИзмененииНаСервере()
	Если ЗначениеЗаполнено(Объект.ПунктНазначения) Тогда
		Объект.Расстояние = исРасчет.РассчитатьРасстояниеМеждуПунктами(Объект.ПунктНазначения, Объект.ПунктОтправления);		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПунктОтправленияПриИзменении(Элемент)
	ПунктОтправленияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПунктНазначенияПриИзмененииНаСервере()
	Если ЗначениеЗаполнено(Объект.ПунктОтправления) Тогда
		Объект.Расстояние = исРасчет.РассчитатьРасстояниеМеждуПунктами(Объект.ПунктНазначения, Объект.ПунктОтправления);		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПунктНазначенияПриИзменении(Элемент)
	ПунктНазначенияПриИзмененииНаСервере();
КонецПроцедуры

// Доработка START {Запись вручную введённого расстояния в регистр} {2026-04-10}
// При изменении поля Расстояние в документе: если значение > 0 и оба пункта заполнены,
// сохраняем в регистр РасстоянияМеждуТаможеннымиПунктами, чтобы при следующих загрузках
// из API это расстояние подставлялось автоматически через исРасчет.РассчитатьРасстояниеМеждуПунктами.
&НаКлиенте
Процедура РасстояниеПриИзменении(Элемент)
	Если Объект.Расстояние > 0
		И ЗначениеЗаполнено(Объект.ПунктОтправления)
		И ЗначениеЗаполнено(Объект.ПунктНазначения) Тогда
		СохранитьРасстояниеВРегистрНаСервере(
			Объект.ПунктОтправления,
			Объект.ПунктНазначения,
			Объект.Расстояние);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьРасстояниеВРегистрНаСервере(ПунктОтправления, ПунктНазначения, Расстояние)
	НаборЗаписей = РегистрыСведений.РасстоянияМеждуТаможеннымиПунктами.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПунктОтправления.Установить(ПунктОтправления);
	НаборЗаписей.Отбор.ПунктНазначения.Установить(ПунктНазначения);
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.ПунктОтправления = ПунктОтправления;
	НоваяЗапись.ПунктНазначения = ПунктНазначения;
	НоваяЗапись.Расстояние = Расстояние;
	Попытка
		НаборЗаписей.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(
			"ОперацияПоПоручительству.СохранениеРасстояния",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка сохранения расстояния " + Строка(ПунктОтправления)
				+ " -> " + Строка(ПунктНазначения) + " = " + Расстояние
				+ ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
// Доработка END

