		Если ЗначениеЗаполнено(пПринципалCustomsTransit) Тогда
			пПринципал	= пПринципалCustomsTransit.ПринципалУстановкиЦен;
		Иначе
			пПринципал 	= ?(ТипЗнч(СтруктураДанных.Принципал) = ТИП("СправочникСсылка.Принципал"), СтруктураДанных.Принципал.ПринципалУстановкиЦен, СтруктураДанных.Принципал);
		КонецЕсли;
	Иначе
		пПринципал 		= ?(ТипЗнч(СтруктураДанных.Принципал) = ТИП("СправочникСсылка.Принципал"), СтруктураДанных.Принципал.ПринципалУстановкиЦен, СтруктураДанных.Принципал);
	КонецЕсли;
	СтруктураДанных.Вставить("ПринципалУстановкиЦен", пПринципал);
	
