Функция ОкруглитьЦену(Цена, Кратность) Экспорт
	
	пОтноситЦена 	= Цена / Кратность;
	пЦелОтноситЦена = Цел(пОтноситЦена);
	
	Если пОтноситЦена = пЦелОтноситЦена Тогда
		Возврат Цена;
	Иначе
		Если Цена < ((пЦелОтноситЦена * Кратность) + (Кратность / 2)) Тогда
			Возврат (пЦелОтноситЦена * Кратность);
		Иначе
			Возврат (пЦелОтноситЦена * Кратность) + Кратность;
		КонецЕсли;
	КонецЕсли;
		
	Возврат 0;
		
КонецФункции

Функция ПолучитьСтоимостьДополнительнойУслуги(СтруктураДанных) Экспорт
	
	СтруктураДанных.Вставить("СуммаВВалютеЦены"	, 0);
	СтруктураДанных.Вставить("ВалютаЦены"		, Неопределено);
	
	Если НЕ (ЗначениеЗаполнено(СтруктураДанных.Принципал)
				И ЗначениеЗаполнено(СтруктураДанных.Контрагент)
				И ЗначениеЗаполнено(СтруктураДанных.УслугаОрганизации)) Тогда
		Возврат 0;
	КонецЕсли;
	
	//пПринципал 		= ?(ТипЗнч(СтруктураДанных.Принципал) = ТИП("СправочникСсылка.Принципал"), СтруктураДанных.Принципал.ПринципалУстановкиЦен, СтруктураДанных.Принципал);
	
	Если СтруктураДанных.УслугаДокумента = Справочники.УслугиОрганизации.Т1 Тогда //для Т1 решили использовать всегда цены из принципала "Customs Transit"
		пПринципалCustomsTransit = ПринципалМашиныCustomsTransit();
		Если ЗначениеЗаполнено(пПринципалCustomsTransit) Тогда
			пПринципал	= пПринципалCustomsTransit.ПринципалУстановкиЦен;
		Иначе
			пПринципал 	= ?(ТипЗнч(СтруктураДанных.Принципал) = ТИП("СправочникСсылка.Принципал"), СтруктураДанных.Принципал.ПринципалУстановкиЦен, СтруктураДанных.Принципал);
		КонецЕсли;
	Иначе
		пПринципал 		= ?(ТипЗнч(СтруктураДанных.Принципал) = ТИП("СправочникСсылка.Принципал"), СтруктураДанных.Принципал.ПринципалУстановкиЦен, СтруктураДанных.Принципал);
	КонецЕсли;
	
	пВалютаОплаты		= СтруктураДанных.ВалютаОплаты;
	пВалюаРегл			= ВалютаРегламентированногоУчета();
	Если НЕ ЗначениеЗаполнено(пВалютаОплаты) Тогда
		пВалютаОплаты 	= пВалюаРегл;
	КонецЕсли;
	
	пТипКурсаВалют		= СтруктураДанных.ТипКурсаВалют;
	Если НЕ ЗначениеЗаполнено(пТипКурсаВалют) Тогда
		Если СтруктураДанных.СтранаОформления = Справочники.СтранаОформления.Россия Тогда
			пТипКурсаВалют	= Перечисления.ТипыКурсовВалют.ЦБ_РФ; //этот функционал задействован для клиентов РФ
		Иначе
			пТипКурсаВалют	= Перечисления.ТипыКурсовВалют.НБ_РБ;
		КонецЕсли;
	КонецЕсли;
	
	пОплатаВРублях 		= (пВалютаОплаты = ВалютаРоссийскийРубль());
	пОплатаВГрн			= (пВалютаОплаты = пВалюаРегл);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенообразованиеДополнительныеУслугиСрезПоследних.ЦенаУслуги,
		|	ЦенообразованиеДополнительныеУслугиСрезПоследних.Валюта
		|ИЗ
		|	РегистрСведений.ЦенообразованиеДополнительныеУслуги.СрезПоследних(
		|			&Дата,
		|			Принципал = &Принципал
		|				И Контрагент = &Контрагент
		|				И УслугаОрганизации = &УслугаОрганизации) КАК ЦенообразованиеДополнительныеУслугиСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата"				, СтруктураДанных.Дата);
	Запрос.УстановитьПараметр("Контрагент"			, СтруктураДанных.Контрагент);
	Запрос.УстановитьПараметр("Принципал"			, пПринципал);
	Запрос.УстановитьПараметр("УслугаОрганизации"	, СтруктураДанных.УслугаОрганизации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		пТекЦена = Выборка.ЦенаУслуги;
		
		СтруктураДанных.Вставить("СуммаВВалютеЦены"	, пТекЦена);
		СтруктураДанных.Вставить("ВалютаЦены"		, Выборка.Валюта);
		
		Если пВалютаОплаты <> Выборка.Валюта Тогда
			Если пОплатаВРублях Тогда
				пТекЦена	= ОкруглитьЦену(ПересчитатьПоТипуКурсаВалют(пТекЦена, Выборка.Валюта, пВалютаОплаты, пТипКурсаВалют, СтруктураДанных.Дата), 5);
			Иначе
				пТекЦена	= ПересчитатьПоТипуКурсаВалют(пТекЦена, Выборка.Валюта, пВалютаОплаты, пТипКурсаВалют, СтруктураДанных.Дата);
			КонецЕсли;
		КонецЕсли;
					
		// в гривнах цена без копеек
		Если пОплатаВГрн Тогда
			пТекЦена		= Окр(пТекЦена);
		КонецЕсли;
		
		Возврат пТекЦена;
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьСписокРеквизитовДляКонтроляПереоформления() Экспорт
	
	СписокКлючевыхРеквизитов 	= Новый СписокЗначений;
	
	МетаданныеДокументаМашина 	= Метаданные.Документы.Машина;
	СписокРеквизитовМашины 		= ПолучитьСписокРеквизитовМашиныДляИзмененийЭТД();
	
	Для каждого ЭлСРМ Из СписокРеквизитовМашины Цикл
		
		пРек = ЭлСРМ.Значение;
		пТип = ЭлСРМ.Представление;

		Если НЕ ОбщегоНазначения.ЕстьРеквизитДокумента(пРек, МетаданныеДокументаМашина) Тогда
			 Продолжить;
		КонецЕсли;
		
		Если пТип = "менять статус" Тогда
			СписокКлючевыхРеквизитов.Добавить(пРек, пТип);
		КонецЕсли;
		
	КонецЦикла;
	
	СписокКлючевыхРеквизитов.Добавить("Статус"			, "менять статус");
	СписокКлючевыхРеквизитов.Добавить("ПометкаУдаления"	, "менять статус");
	
	Возврат СписокКлючевыхРеквизитов;
	
КонецФункции
