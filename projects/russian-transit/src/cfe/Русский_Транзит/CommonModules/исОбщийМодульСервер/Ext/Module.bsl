				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ ВремВТ";
				
				Если пПринципал.Евросоюз И пТипУслуги = Перечисления.ТипыУслугОрганизации.T1 Тогда
					ппСтраныНачалаТранзита = пСтраныНачалаТранзита;
				Иначе
					ппСтраныНачалаТранзита = Новый Массив;
					ппСтраныНачалаТранзита.Добавить(Справочники.ГруппыСтран.ПустаяСсылка());
				КонецЕсли;
				
				Запрос.УстановитьПараметр("Дата"						, пДата);
				Запрос.УстановитьПараметр("Принципал"					, пПринципал);
				Запрос.УстановитьПараметр("УслугаОрганизации"			, пТипУслуги);
				Запрос.УстановитьПараметр("ГруппаСтранНачалаТранзита"	, ппСтраныНачалаТранзита);
				Запрос.УстановитьПараметр("ГруппаКлиентов"				, пТекГруппаКлиентов);
				Запрос.УстановитьПараметр("МассивГруппКодовУКТЗЕД"		, МассивГруппКодовУКТЗЕД);
				Запрос.УстановитьПараметр("ГруппаКодовУКТЗЕД"			, пГруппаКодовУКТЗЕД);
				Запрос.УстановитьПараметр("СпецЦены"					, пСпецЦены);
				
				МасРезультат = Запрос.ВыполнитьПакет();
				
				ВыборкаКлюч = МасРезультат[2].Выбрать();
				Если ВыборкаКлюч.Следующий() Тогда
					пРасстояние = СтруктураДанных.Расстояние;
					Если ВыборкаКлюч.ИспользоватьДополнительнуюАналитику
							И ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.Расстояние 
							И пРасстояние = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					пКоличествоПунктов = СтруктураДанных.КоличествоТаможенныхПунктов;
					Если ВыборкаКлюч.ИспользоватьДополнительнуюАналитику
							И ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.КоличествоТаможенныхПунктов 
							И пКоличествоПунктов = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					пАналитикаСумм = Неопределено;
					
					ВыборкаМаксимумСуммОбеспечения = МасРезультат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Если ВыборкаМаксимумСуммОбеспечения.Следующий() Тогда
						Если пСуммаОбеспечения > ВыборкаМаксимумСуммОбеспечения.ЗначениеАналитики Тогда  // если сумма больше максимального значения в сетке, то цену не считаем (индивидуальный расчет)
							Продолжить;
						Иначе
							ВыборкаСуммОбеспечения = ВыборкаМаксимумСуммОбеспечения.Выбрать();
							Пока ВыборкаСуммОбеспечения.Следующий() Цикл
								Если пСуммаОбеспечения > ВыборкаСуммОбеспечения.ЗначениеАналитики Тогда
									Прервать;
								КонецЕсли;
								пАналитикаСумм = ВыборкаСуммОбеспечения.АналитикаСумм;
							КонецЦикла;
						КонецЕсли;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(пАналитикаСумм) Тогда
						
						СтруктураПоиска = Новый Структура;
						СтруктураПоиска.Вставить("АналитикаСумм", пАналитикаСумм);
						
						Если ВыборкаКлюч.ИспользоватьДополнительнуюАналитику Тогда
							ВыборкаДопАналитики = МасРезультат[4].Выбрать();
							пДопАналитика = Неопределено;
							
							Если ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.Расстояние Тогда
								Пока ВыборкаДопАналитики.Следующий() Цикл
									Если пРасстояние > ВыборкаДопАналитики.ЗначениеАналитики Тогда
										Прервать;
									КонецЕсли;
									пДопАналитика = ВыборкаДопАналитики.ДополнительнаяАналитика;
								КонецЦикла;	
							ИначеЕсли ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.КоличествоТаможенныхПунктов Тогда
								Если ВыборкаДопАналитики.НайтиСледующий(Новый Структура("ЗначениеАналитики", пКоличествоПунктов)) Тогда
									пДопАналитика = ВыборкаДопАналитики.ДополнительнаяАналитика;
								КонецЕсли;
							ИначеЕсли ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.АдминистративныйОкруг Тогда
								Если ВыборкаДопАналитики.НайтиСледующий(Новый Структура("ЗначениеАналитики", СтруктураДанных.АдминистративныйОкруг)) Тогда
									пДопАналитика = ВыборкаДопАналитики.ДополнительнаяАналитика;
								КонецЕсли;
							ИначеЕсли ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.Страна Тогда
								Если ВыборкаДопАналитики.НайтиСледующий(Новый Структура("ЗначениеАналитики", СтруктураДанных.СтранаОформления)) Тогда
									пДопАналитика = ВыборкаДопАналитики.ДополнительнаяАналитика;
								КонецЕсли;
							КонецЕсли;
							
							СтруктураПоиска.Вставить("ДополнительнаяАналитика", пДопАналитика);
						КонецЕсли;
						
						ВыборкаЦен = МасРезультат[5].Выбрать();
						Если ВыборкаЦен.НайтиСледующий(СтруктураПоиска) Тогда
							пТекСумма = 0;
							Если ВыборкаЦен.ВидРасчета = Перечисления.ВидыРасчетаЦен.Число Тогда
								пТекСумма = ВыборкаЦен.Цена;
							ИначеЕсли ВыборкаЦен.ВидРасчета = Перечисления.ВидыРасчетаЦен.Процент Тогда
								Если СтруктураДанных.ВалютаОбеспечения <> ВыборкаЦен.Валюта Тогда
									пСуммаОбеспеченияВал	= ПересчитатьПоТипуКурсаВалют(пСуммаОбеспечения, СтруктураДанных.ВалютаОбеспечения, ВыборкаЦен.Валюта, Перечисления.ТипыКурсовВалют.НБУ, пДата);
								Иначе
									пСуммаОбеспеченияВал 	= пСуммаОбеспечения;
								КонецЕсли;
								
								пТекСумма = Окр(пСуммаОбеспеченияВал * ВыборкаЦен.Цена / 100, 2);
							КонецЕсли;
								
							Если ЗначениеЗаполнено(ВыборкаЦен.МинимальнаяЦена) И ЗначениеЗаполнено(пТекСумма)
									И пТекСумма < ВыборкаЦен.МинимальнаяЦена Тогда
								пТекСумма = ВыборкаЦен.МинимальнаяЦена;
							КонецЕсли;
							
							пСуммаПринципала = пСуммаПринципала + пТекСумма;
						КонецЕсли;
						
					КонецЕсли;
					
					ВыборкаКодовУКТВЭД = МасРезультат[6].Выбрать();
					Если ВыборкаКодовУКТВЭД.Количество() <> 1 Тогда
						СтруктураДанных.Вставить("ГруппаКодовУКТВЭД", Справочники.ГруппыКодовУКТЗЕД.ПустаяСсылка());
					Иначе
						ВыборкаКодовУКТВЭД.Следующий();
						СтруктураДанных.Вставить("ГруппаКодовУКТВЭД", ВыборкаКодовУКТВЭД.ГруппаКодовУКТЗЕД);
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли пТипУслуги = Перечисления.ТипыУслугОрганизации.ЭТД Тогда
			
				КодыCMR 						= СтруктураДанных.КодыCMR;
				КоличествоCMR					= КодыCMR.Количество();
				КоличествоКодов 				= КодыCMR.Итог("КоличествоКодов");
				
				Если КоличествоCMR = 0 Тогда
					Продолжить;
				КонецЕсли;

				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЦенообразованиеУслугиСрезПоследних.ЦенаЗаПервуюCMR КАК ЦенаЗаПервуюCMR,
					|	ЦенообразованиеУслугиСрезПоследних.ЦенаЗаДополнительнуюCMR КАК ЦенаЗаДополнительнуюCMR,
					|	ЦенообразованиеУслугиСрезПоследних.ЦенаЗаДополнительныйКод,
					|	ЦенообразованиеУслугиСрезПоследних.КоличествоБесплатныхКодов
					|ИЗ
					|	РегистрСведений.ЦенообразованиеУслуги.СрезПоследних(
					|			&Дата,
					|			Принципал = &Принципал
					|				И Контрагент = &ГруппаКлиентов
					|				И УслугаОрганизации = &УслугаОрганизации) КАК ЦенообразованиеУслугиСрезПоследних";
				
				Запрос.УстановитьПараметр("Дата"				, пДата);
				Запрос.УстановитьПараметр("УслугаОрганизации"	, пТипУслуги);
				Запрос.УстановитьПараметр("Принципал"			, пПринципал);
				Запрос.УстановитьПараметр("ГруппаКлиентов"		, ТекущаяГруппаКлиентовПринципала("ЦенообразованиеУслуги", пТипУслуги, пПринципал, пДата, СтруктураДанных));
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() Тогда
							
					ЦенаЗаПервуюCMR 			= Выборка.ЦенаЗаПервуюCMR;	
