Процедура ЗаписатьРасстояниеМеждуТаможеннымиПунктами(СтруктураПараметров, пРасстояние) Экспорт
	
	пПО = СтруктураПараметров.ПунктОтправления;
	пПН = СтруктураПараметров.ПунктНазначения;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	1 КАК Приоритет,
		|	РасстояниеМеждуТаможеннымиПунктами.ПунктОтправления,
		|	РасстояниеМеждуТаможеннымиПунктами.ПунктНазначения
		|ПОМЕСТИТЬ ВремВТ
		|ИЗ
		|	РегистрСведений.РасстояниеМеждуТаможеннымиПунктами КАК РасстояниеМеждуТаможеннымиПунктами
		|ГДЕ
		|	РасстояниеМеждуТаможеннымиПунктами.ПунктОтправления = &ПунктОтправления
		|	И РасстояниеМеждуТаможеннымиПунктами.ПунктНазначения = &ПунктНазначения
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	2,
		|	РасстояниеМеждуТаможеннымиПунктами.ПунктОтправления,
		|	РасстояниеМеждуТаможеннымиПунктами.ПунктНазначения
		|ИЗ
		|	РегистрСведений.РасстояниеМеждуТаможеннымиПунктами КАК РасстояниеМеждуТаможеннымиПунктами
		|ГДЕ
		|	РасстояниеМеждуТаможеннымиПунктами.ПунктОтправления = &ПунктНазначения
		|	И РасстояниеМеждуТаможеннымиПунктами.ПунктНазначения = &ПунктОтправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВремВТ.ПунктОтправления,
		|	ВремВТ.ПунктНазначения
		|ИЗ
		|	ВремВТ КАК ВремВТ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВремВТ.Приоритет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВремВТ";
	
	Запрос.УстановитьПараметр("ПунктНазначения"	, пПН);
	Запрос.УстановитьПараметр("ПунктОтправления", пПО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		пРег_ПО = Выборка.ПунктОтправления;
		пРег_ПН = Выборка.ПунктНазначения;
	Иначе
		пРег_ПО = пПО;
		пРег_ПН = пПН;
	КонецЕсли;
	
	НабЗап = РегистрыСведений.РасстояниеМеждуТаможеннымиПунктами.СоздатьНаборЗаписей();
	НабЗап.Отбор.ПунктОтправления.Установить(пРег_ПО);
	НабЗап.Отбор.ПунктНазначения.Установить(пРег_ПН);
	
	НовЗап = НабЗап.Добавить();
	НовЗап.ПунктОтправления 	= пРег_ПО;
	НовЗап.ПунктНазначения 		= пРег_ПН;
	НовЗап.Расстояние 			= пРасстояние;
	
	НовЗап.ДатаЗаписи 			= ТекущаяДатаСеанса();
	НовЗап.Ответственный 		= ПараметрыСеанса.ТекущийПользователь;
	            
	Попытка
		НабЗап.Записать();
	Исключение
	    Сообщить("Не удалось сохранить расстояние между " + СокрЛП(пРег_ПО) + " и " + СокрЛП(пРег_ПН) + ": " + ОписаниеОшибки());
	КонецПопытки;
		
КонецПроцедуры 

Функция СотрудникСогласования(СтруктураПараметров) Экспорт
	
	пДействие = СтруктураПараметров.Действие;
	
	Если пДействие = Перечисления.ДействияПередОформленииМашин.СогласованиеСДиректором Тогда
		Возврат Директор();
	ИначеЕсли пДействие = Перечисления.ДействияПередОформленииМашин.СогласованиеСРуководителемТаможенногоОтдела Тогда
		Возврат РуководительТаможенногоОтдела();
	ИначеЕсли пДействие = Перечисления.ДействияПередОформленииМашин.СогласованиеСМенеджером Тогда
		Возврат СтруктураПараметров.Менеджер;
	КонецЕсли;
	
	Возврат Справочники.Пользователи.ПустаяСсылка();
		
КонецФункции

Функция ВернутьТекстУслуги(ДанныеЗаполнения, ЭТД=Ложь, НоменклатураДокумента=Неопределено, ТипУслуги=Неопределено, ОсновныеУслуги=Истина) Экспорт
	
	ТекстУслуги = "";
	
	МетаданныеДокумента = ДанныеЗаполнения.Метаданные();
			
	пДетализацияЦенПоУслугамВСчетах = (ТипУслуги <> Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтранаОформления"	, ДанныеЗаполнения.СтранаОформления);
	Запрос.УстановитьПараметр("Принципал"			, ДанныеЗаполнения.Принципал);
	Запрос.УстановитьПараметр("УслугаОрганизации"	, ДанныеЗаполнения.УслугаОрганизации);
	Запрос.УстановитьПараметр("Организация"			, ДанныеЗаполнения.Организация);
	
	Если пДетализацияЦенПоУслугамВСчетах Тогда
		
		Если ОсновныеУслуги Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТекстыУслугДляДетализированныхСчетов.ТекстУслуги КАК ТекстУслуги,
			|	ВЫБОР
			|		КОГДА ТекстыУслугДляДетализированныхСчетов.Ссылка.Принципал = &Принципал
			|				И ТекстыУслугДляДетализированныхСчетов.Ссылка.Организация = &Организация
			|			ТОГДА 1
			|		КОГДА ТекстыУслугДляДетализированныхСчетов.Ссылка.Принципал = &Принципал
			|				И ТекстыУслугДляДетализированныхСчетов.Ссылка.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ТОГДА 2
			|		КОГДА ТекстыУслугДляДетализированныхСчетов.Ссылка.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
			|				И ТекстыУслугДляДетализированныхСчетов.Ссылка.Организация = &Организация
			|			ТОГДА 3
			|		КОГДА ТекстыУслугДляДетализированныхСчетов.Ссылка.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
			|				И ТекстыУслугДляДетализированныхСчетов.Ссылка.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ТОГДА 4
			|		ИНАЧЕ 10
			|	КОНЕЦ КАК Приоритет
			|ПОМЕСТИТЬ ГотовВТ
			|ИЗ
			|	Справочник.ТекстыУслуг.ТекстыУслугДляДетализированныхСчетов КАК ТекстыУслугДляДетализированныхСчетов
			|ГДЕ
			|	НЕ ТекстыУслугДляДетализированныхСчетов.Ссылка.ПометкаУдаления
			|	И ТекстыУслугДляДетализированныхСчетов.Ссылка.СтранаОформления = &СтранаОформления
			|	И ТекстыУслугДляДетализированныхСчетов.Услуга = &ТипУслуги
			|	И ТекстыУслугДляДетализированныхСчетов.Ссылка.УслугаОрганизации = &УслугаОрганизации
			|	И ВЫБОР
			|			КОГДА ТекстыУслугДляДетализированныхСчетов.Ссылка.Принципал = &Принципал
			|					ИЛИ ТекстыУслугДляДетализированныхСчетов.Ссылка.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ
			|	И ВЫБОР
			|			КОГДА ТекстыУслугДляДетализированныхСчетов.Ссылка.Организация = &Организация
			|					ИЛИ ТекстыУслугДляДетализированныхСчетов.Ссылка.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ
			|	И ТекстыУслугДляДетализированныхСчетов.ТекстУслуги <> """"
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТекстыУслуг.ТекстУслуги,
			|	ВЫБОР
			|		КОГДА ТекстыУслуг.Принципал = &Принципал
			|				И ТекстыУслуг.Организация = &Организация
			|			ТОГДА 5
			|		КОГДА ТекстыУслуг.Принципал = &Принципал
			|				И ТекстыУслуг.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ТОГДА 6
			|		КОГДА ТекстыУслуг.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
			|				И ТекстыУслуг.Организация = &Организация
			|			ТОГДА 7
			|		КОГДА ТекстыУслуг.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
			|				И ТекстыУслуг.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ТОГДА 8
			|		ИНАЧЕ 10
			|	КОНЕЦ
			|ИЗ
			|	Справочник.ТекстыУслуг КАК ТекстыУслуг
			|ГДЕ
			|	НЕ ТекстыУслуг.ПометкаУдаления
			|	И ТекстыУслуг.СтранаОформления = &СтранаОформления
			|	И ТекстыУслуг.УслугаОрганизации = &УслугаОрганизации
			|	И ВЫБОР
			|			КОГДА ТекстыУслуг.Принципал = &Принципал
			|					ИЛИ ТекстыУслуг.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ
			|	И ВЫБОР
			|			КОГДА ТекстыУслуг.Организация = &Организация
			|					ИЛИ ТекстыУслуг.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ
			|	И ТекстыУслуг.ТекстУслуги <> """"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ГотовВТ.ТекстУслуги
			|ИЗ
			|	ГотовВТ КАК ГотовВТ
			|
			|УПОРЯДОЧИТЬ ПО
			|	ГотовВТ.Приоритет
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ГотовВТ";
							
		Иначе
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.ТекстУслуги КАК ТекстУслуги,
			|	ВЫБОР
			|		КОГДА ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Принципал = &Принципал
			|				И ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Организация = &Организация
			|			ТОГДА 1
			|		КОГДА ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Принципал = &Принципал
			|				И ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ТОГДА 2
			|		КОГДА ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
			|				И ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Организация = &Организация
			|			ТОГДА 3
			|		КОГДА ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
			|				И ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ТОГДА 4
			|		ИНАЧЕ 10
			|	КОНЕЦ КАК Приоритет
			|ПОМЕСТИТЬ ГотовВТ
			|ИЗ
			|	Справочник.ТекстыУслуг.ТекстыДопУслугДляДетализированныхСчетов КАК ТекстыУслугТекстыДопУслугДляДетализированныхСчетов
			|ГДЕ
			|	НЕ ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.ПометкаУдаления
			|	И ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.СтранаОформления = &СтранаОформления
			|	И ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Услуга = &ТипУслуги
			|	И ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.УслугаОрганизации = &УслугаОрганизации
			|	И ВЫБОР
			|			КОГДА ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Принципал = &Принципал
			|					ИЛИ ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ
			|	И ВЫБОР
			|			КОГДА ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Организация = &Организация
			|					ИЛИ ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.Ссылка.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ
			|	И ТекстыУслугТекстыДопУслугДляДетализированныхСчетов.ТекстУслуги <> """"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ГотовВТ.ТекстУслуги
			|ИЗ
			|	ГотовВТ КАК ГотовВТ
			|
			|УПОРЯДОЧИТЬ ПО
			|	ГотовВТ.Приоритет
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ГотовВТ";
							
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ТипУслуги", ТипУслуги);
		
	Иначе
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ТекстыУслуг.ТекстУслуги,
		|	ВЫБОР
		|		КОГДА ТекстыУслуг.Принципал = &Принципал
		|				И ТекстыУслуг.Организация = &Организация
		|			ТОГДА 1
		|		КОГДА ТекстыУслуг.Принципал = &Принципал
		|				И ТекстыУслуг.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			ТОГДА 2
		|		КОГДА ТекстыУслуг.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
		|				И ТекстыУслуг.Организация = &Организация
		|			ТОГДА 3
		|		КОГДА ТекстыУслуг.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
		|				И ТекстыУслуг.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			ТОГДА 4
		|		ИНАЧЕ 5
		|	КОНЕЦ КАК Приоритет
		|ИЗ
		|	Справочник.ТекстыУслуг КАК ТекстыУслуг
		|ГДЕ
		|	НЕ ТекстыУслуг.ПометкаУдаления
		|	И ТекстыУслуг.СтранаОформления = &СтранаОформления
		|	И ТекстыУслуг.УслугаОрганизации = &УслугаОрганизации
		|	И ВЫБОР
		|			КОГДА ТекстыУслуг.Принципал = &Принципал
		|					ИЛИ ТекстыУслуг.Принципал = ЗНАЧЕНИЕ(Справочник.Принципал.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА ТекстыУслуг.Организация = &Организация
		|					ИЛИ ТекстыУслуг.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|	И ТекстыУслуг.ТекстУслуги <> """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ТекстУслуги = СокрЛП(Выборка.ТекстУслуги);
	КонецЕсли;
	
	Если ДанныеЗаполнения <> Неопределено Тогда
		
		СоответствиеРеквизитов = Новый Соответствие;
		
		Если МетаданныеДокумента.ТабличныеЧасти.Найти("ДополнительныеУслуги") <> Неопределено 
				И ДанныеЗаполнения.СтранаОформления = Справочники.СтранаОформления.Евросоюз
				И ДанныеЗаполнения.ДополнительныеУслуги.Количество() > 0 Тогда
			ТекстУслуги = СтрЗаменить(ТекстУслуги, "<ТегДополнительныеУслуги_Начало>", "");
			ТекстУслуги = СтрЗаменить(ТекстУслуги, "<ТегДополнительныеУслуги_Конец>", "");
		Иначе
			ПозДУ_Н = Найти(ТекстУслуги, "<ТегДополнительныеУслуги_Начало>");
			ПозДУ_К = Найти(ТекстУслуги, "<ТегДополнительныеУслуги_Конец>");
			
			Если (ПозДУ_Н > 0 И ПозДУ_К > 0) И ПозДУ_К > ПозДУ_Н Тогда
				ТекстУслуги = СтрЗаменить(ТекстУслуги, Сред(ТекстУслуги, ПозДУ_Н, (ПозДУ_К - ПозДУ_Н + СтрДлина("<ТегДополнительныеУслуги_Конец>"))), "");
			КонецЕсли;
		КонецЕсли;
		
		КоличествоСимволовШаблона 	= СтрДлина(ТекстУслуги);
		пСимволРеквизита 			= 0;
		
		Для К = 1 По КоличествоСимволовШаблона Цикл
			
			пСимв = Сред(ТекстУслуги,К,1);
			Если пСимв = "<" Тогда 
				пСимволРеквизита = К + 1;
			ИначеЕсли пСимв = ">" Тогда
				кСимволРеквизита = К;
				
				Если пСимволРеквизита <> 0 Тогда
					пИмяРеквизита = Сред(ТекстУслуги, пСимволРеквизита, кСимволРеквизита - пСимволРеквизита);
						
					пЗначениеРеквизита = "";
					Если ЕстьРеквизитДокумента(пИмяРеквизита, МетаданныеДокумента) Тогда
						пЗначениеРеквизита = ДанныеЗаполнения[пИмяРеквизита];
						Если пИмяРеквизита = "Номенклатура" И ЕстьРеквизитДокумента("ДополнительноеТС", МетаданныеДокумента) Тогда
							пЗначениеРеквизитаДопТС = ДанныеЗаполнения["ДополнительноеТС"];
							Если ЗначениеЗаполнено(пЗначениеРеквизитаДопТС) Тогда
								пЗначениеРеквизита = СокрЛП(пЗначениеРеквизита) + "/" + СокрЛП(пЗначениеРеквизитаДопТС);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
					Если ТипЗнч(пЗначениеРеквизита) = Тип("Число") Тогда
						пЗначениеРеквизитаФормат = Формат(пЗначениеРеквизита, "ЧН=0");
					ИначеЕсли ТипЗнч(пЗначениеРеквизита) = Тип("Дата") Тогда
						пЗначениеРеквизитаФормат = Формат(пЗначениеРеквизита, "ДФ=dd.MM.yyyy");
					Иначе
						пЗначениеРеквизитаФормат = СокрЛП(пЗначениеРеквизита);
					КонецЕсли;
					
					СоответствиеРеквизитов.Вставить("<" + пИмяРеквизита + ">", пЗначениеРеквизитаФормат);
				КонецЕсли;
				пСимволРеквизита = 0;
			КонецЕсли;
			
		КонецЦикла; 
				
		Для каждого ЭлСоответствия Из СоответствиеРеквизитов Цикл
			ТекстУслуги = СтрЗаменить(ТекстУслуги, ЭлСоответствия.Ключ, ЭлСоответствия.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.ДоговорКонтрагента) И ДанныеЗаполнения.ДоговорКонтрагента.ДобавлятьВСчетаНомераCMR И ЗначениеЗаполнено(ДанныеЗаполнения.НомераCMR) Тогда
		ТекстУслуги = ТекстУслуги + " (CMR: " + СокрЛП(ДанныеЗаполнения.НомераCMR) + ")";
	КонецЕсли;
		
	Возврат СокрЛП(ТекстУслуги);
	
КонецФункции  

// Позволяет определить есть ли среди реквизитов шапки документа
// реквизит с переданным именем.
//
// Параметры: 
//  ИмяРеквизита - строковое имя искомого реквизита, 
//  МетаданныеДокумента - объект описания метаданных документа, среди реквизитов которого производится поиск.
//
// Возвращаемое значение:
//  Истина - нашли реквизит с таким именем, Ложь - не нашли.
//
Функция ЕстьРеквизитДокумента(ИмяРеквизита, МетаданныеДокумента) Экспорт
					
	пЕстьРеквизит = (МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) <> Неопределено);
	Если пЕстьРеквизит Тогда
		Возврат Истина;
	КонецЕсли;
	
	пЕстьСтандартныйРеквизит = Ложь;
	пМетаСтандартныеРеквизиты = МетаданныеДокумента.СтандартныеРеквизиты;
	
	Для каждого пСтРек Из пМетаСтандартныеРеквизиты Цикл
		Если пСтРек.Имя = ИмяРеквизита Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;
	
КонецФункции // ЕстьРеквизитДокумента()


Функция ДоступныеУслугиПоСтранеОформления(пСтранаОформления, пПринципал=Неопределено) Экспорт
	
	СЗ = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(пСтранаОформления) Тогда
		Запрос = Новый Запрос;
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УслугиОрганизацииУслуги.Ссылка КАК Услуга,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ УслугиОрганизацииУслуги.УслугаОрганизации) КАК КоличествоТиповУслуг
			|ПОМЕСТИТЬ ДоступныеУслугиВТ
			|ИЗ
			|	Справочник.УслугиОрганизации.Услуги КАК УслугиОрганизацииУслуги
			|ГДЕ
			|	НЕ УслугиОрганизацииУслуги.Ссылка.ПометкаУдаления
			|	И УслугиОрганизацииУслуги.УслугаОрганизации В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				СтранаОформленияУслуги.УслугаОрганизации
			|			ИЗ
			|				Справочник.СтранаОформления.Услуги КАК СтранаОформленияУслуги
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Принципал.Услуги КАК ПринципалУслуги
			|				ПО СтранаОформленияУслуги.УслугаОрганизации = ПринципалУслуги.УслугаОрганизации
			|					И (ПринципалУслуги.Ссылка = &Принципал)
			|			ГДЕ
			|				СтранаОформленияУслуги.Ссылка = &СтранаОформления)
			|
			|СГРУППИРОВАТЬ ПО
			|	УслугиОрганизацииУслуги.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УслугиОрганизацииУслуги.Ссылка КАК Услуга,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ УслугиОрганизацииУслуги.УслугаОрганизации) КАК КоличествоТиповУслуг
			|ПОМЕСТИТЬ ВсеУслугиВТ
			|ИЗ
			|	Справочник.УслугиОрганизации.Услуги КАК УслугиОрганизацииУслуги
			|ГДЕ
			|	НЕ УслугиОрганизацииУслуги.Ссылка.ПометкаУдаления
			|
			|СГРУППИРОВАТЬ ПО
			|	УслугиОрганизацииУслуги.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДоступныеУслугиВТ.Услуга
			|ИЗ
			|	ДоступныеУслугиВТ КАК ДоступныеУслугиВТ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВсеУслугиВТ КАК ВсеУслугиВТ
			|		ПО ДоступныеУслугиВТ.Услуга = ВсеУслугиВТ.Услуга
			|			И ДоступныеУслугиВТ.КоличествоТиповУслуг = ВсеУслугиВТ.КоличествоТиповУслуг";
		
		Запрос.УстановитьПараметр("СтранаОформления", пСтранаОформления);
		
		Если НЕ ЗначениеЗаполнено(пПринципал) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Принципал.Услуги КАК ПринципалУслуги
			|				ПО СтранаОформленияУслуги.УслугаОрганизации = ПринципалУслуги.УслугаОрганизации
			|					И (ПринципалУслуги.Ссылка = &Принципал)", "");
		Иначе
			Запрос.УстановитьПараметр("Принципал", пПринципал);
		КонецЕсли;
		
		Запрос.Текст = ТекстЗапроса;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СЗ.Добавить(Выборка.Услуга, СокрЛП(Выборка.Услуга));
		КонецЦикла;
	КонецЕсли;
	
	СЗ.СортироватьПоПредставлению();
	
	Возврат СЗ;
	
КонецФункции 
Функция ПринципалМашиныРусскийТранзит() Экспорт

	Возврат Справочники.Принципал.НайтиПоКоду("000000019");  //"Русский Транзит"
							
КонецФункции

#Область РеестрНомеровГарантий

Функция СгенерироватьНомерГарантии(СтруктураПараметров) Экспорт
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Успешно"				, Истина);
	СтруктураДанных.Вставить("ТекстПредупреждения"	, "");
	СтруктураДанных.Вставить("НомерГарантии"		, "");
	
	РежимТранзита = "01";
	
	пТекДата 	= ТекущаяДатаСеанса();
	пНачалоГода = НачалоГода(пТекДата);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеестрНомеровГарантий.ПорядковыйНомер КАК ПорядковыйНомер
		|ИЗ
		|	РегистрСведений.РеестрНомеровГарантий КАК РеестрНомеровГарантий
		|ГДЕ
		|	РеестрНомеровГарантий.ДатаСоздания >= &НачалоГодаНомеров
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядковыйНомер УБЫВ";
	
	Запрос.УстановитьПараметр("НачалоГодаНомеров", пНачалоГода);
		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		пМаксНомер = Выборка.ПорядковыйНомер + 1;
	Иначе
		пМаксНомер = 1;
	КонецЕсли;

	//ФОРМАТ номера гарантии
	//1 поле - постоянное - ETG (3 знака)
	//2 поле - порядковый номер гарантии - 6-ти значный номер (000001), которое по порядку присваивает сама программа 1С (6 знаков)
	//3 поле - постоянная величина - 01 (режим транзита) ( в дальнейшем могут добавляться варианты 02,03 и т.д.) (2 знака)
	//4 поле - дата выдачи гарантии - формируется программой 1С  в формате   гг.мм.число   (20210415) (8 знаков)
	//общий формат выглядит так:  ETG-000001-01-20210415 (3+1+6+1+2+1+8=22 знака)
	//с начала года обнуляются
	
	Если пМаксНомер > 999999 Тогда
		
		СтруктураДанных.Вставить("Успешно"				, Ложь);
		СтруктураДанных.Вставить("ТекстПредупреждения"	, "Превышен максимально допустимый порядковый номер гарантии 999999. Обратитесь к администратору программы.");
		
	Иначе
		
		пФорматМаксНомер = Формат(пМаксНомер, "ЧГ=0");
		
		Пока СтрДлина(пФорматМаксНомер) < 6 Цикл
			пФорматМаксНомер = "0" + пФорматМаксНомер;
		КонецЦикла;
		
		пНомерГарантии = "ETG-" + пФорматМаксНомер + "-" + РежимТранзита + "-" + Формат(пТекДата, "ДФ=yyyyMMdd");
		
		НабЗап = РегистрыСведений.РеестрНомеровГарантий.СоздатьНаборЗаписей();
		НабЗап.Отбор.НомерГарантии.Установить(пНомерГарантии);
		
		НовЗап = НабЗап.Добавить();
		НовЗап.НомерГарантии 	= пНомерГарантии;
		НовЗап.ДокументМашина 	= СтруктураПараметров.ДокументМашина;
		НовЗап.ПорядковыйНомер 	= пМаксНомер;
		НовЗап.ДатаСоздания 	= пТекДата;
		НовЗап.Пользователь 	= ПараметрыСеанса.ТекущийПользователь;
		
		Попытка
			НабЗап.Записать();
			СтруктураДанных.НомерГарантии = пНомерГарантии;
		Исключение
			СтруктураДанных.Вставить("Успешно"				, Ложь);
			СтруктураДанных.Вставить("ТекстПредупреждения"	, "Не удалось сгенерировать номер гарантии: " + ОписаниеОшибки() + Символы.ПС + "Обратитесь к администратору программы");
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат СтруктураДанных;
		
КонецФункции

#КонецОбласти























