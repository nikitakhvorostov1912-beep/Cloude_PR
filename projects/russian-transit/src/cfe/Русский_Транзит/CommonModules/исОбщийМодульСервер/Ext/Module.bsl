Функция ДопустимаНулеваяЦена(ТипУслуги, СтруктураДанных) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ТипУслуги) Тогда
		Возврат Истина;
	КонецЕсли;
	
	пОрганизация = СтруктураДанных.Организация;
	
	////ЭтоОрганизацияEETG = (ЗначениеЗаполнено(пОрганизация) 
	////						И пОрганизация = Справочники.Организации.НайтиПоКоду("000000006") 
	////						И Найти(ВРег(пОрганизация.Наименование), "EETG") > 0);
	//ЭтоОрганизацияРусскийТранзит = (ЗначениеЗаполнено(пОрганизация) 
	//						И пОрганизация = Справочники.Организации.НайтиПоКоду("000000007") 
	//						И Найти(ВРег(пОрганизация.Наименование), "РУССКИЙ ТРАНЗИТ") > 0);
							
	Если ТипУслуги = Перечисления.ТипыУслугОрганизации.ЭПИ Тогда
		
		//Если СтруктураДанных.ТипыУслуг.Найти(Перечисления.ТипыУслугОрганизации.ЭПИГарантия, "Услуга") <> Неопределено
		//		И СтруктураДанных.СтранаОформления = Справочники.СтранаОформления.Россия Тогда //ЭПИ + Гарантия или ЭПИ + Гарания + ЭТД
		Если СтруктураДанных.СтранаОформления = Справочники.СтранаОформления.Россия И СтруктураДанных.ТипыУслуг.Количество() > 1 Тогда //ЭПИ + Гарантия или ЭПИ + Гарания + ЭТД или ЭПИ + ЭТД, кроме просто ЭПИ
			Если СтруктураДанных.ТипыУслуг.Количество() = 2 И СтруктураДанных.ТипыУслуг.Найти(Перечисления.ТипыУслугОрганизации.ЭПИГарантия, "Услуга") <> Неопределено Тогда //ЭПИ + Гарантия
				//для ЭПИ + Гарантия считается всё (по сути, только доп.коды), кроме первой ЭПИ
				СтруктураДанных.Вставить("ОпдатаТолькоЗаДопКоды", Истина);
			КонецЕсли;
			// в России сама ЭПИ не считается
			Возврат Истина;
		КонецЕсли;
		
	ИначеЕсли ТипУслуги = Перечисления.ТипыУслугОрганизации.ЭПИГарантия Тогда
		
		
	ИначеЕсли ТипУслуги = Перечисления.ТипыУслугОрганизации.T1_Услуга Тогда
		
		// как я понял, для T1_Услуга CMR-ки вообще не считаются, только коды
		Возврат Истина;
				
	ИначеЕсли ТипУслуги = Перечисления.ТипыУслугОрганизации.Сертификат Тогда
		
		Возврат Истина;
		
	ИначеЕсли ТипУслуги = Перечисления.ТипыУслугОрганизации.ДополнениеCMR Тогда
		
		СтруктураДанных.Вставить("ОпдатаТолькоЗаДопКоды", Истина);
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьДанныеВыбораКатегорийАгентаНаСервере(Контрагент) Экспорт
	
	масДанныеВыбора = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КатегорииМашин.Ссылка
		|ИЗ
		|	Справочник.КатегорииМашин КАК КатегорииМашин
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|		ПО ((ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Контрагенты)) = &Контрагент)
		|			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
		|			И (КонтактнаяИнформация.Вид В (&СЗВидовДляОтветов))
		|			И КатегорииМашин.Ссылка = КонтактнаяИнформация.Категория
		|
		|УПОРЯДОЧИТЬ ПО
		|	КатегорииМашин.Наименование";
	
	Запрос.УстановитьПараметр("Контрагент"			, Контрагент);
	
	СЗ = Новый СписокЗначений;
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов2);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов3);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов4);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов5);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов6);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов7);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов8);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов9);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов10);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов11);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов12);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов13);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов14);
	СЗ.Добавить(Справочники.ВидыКонтактнойИнформации.ЭлектронныйАдресДляОтветов15);
	
	Запрос.УстановитьПараметр("СЗВидовДляОтветов"	, СЗ);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		масДанныеВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат масДанныеВыбора;
	
КонецФункции

