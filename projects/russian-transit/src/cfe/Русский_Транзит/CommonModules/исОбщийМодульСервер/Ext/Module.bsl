		////	КонецЕсли;
		//		
		//КонецЕсли;
		
		пЦена = пЦена + СтрДопУслуга.Сумма;
		
	КонецЦикла;
	
	//Если пДетализацияЦенПоУслугамВСчетах И (НЕ СтруктураДанных.ИндивидуальныйРасчет) Тогда
	//	СтруктураДанных.ТекстДетализации = пТекстДетализации;
	//КонецЕсли;

	СтруктураДанных.Вставить("НедостаточноВходныхДанных", НедостаточноВходныхДанных);
	
