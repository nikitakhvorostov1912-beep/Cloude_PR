						|					И ГруппаСтранНачалаТранзита В (&ГруппаСтранНачалаТранзита)
						|					И ГруппаСтранНачалаТранзита ССЫЛКА Справочник.СтранаОформления
						|					И ГруппаКодовУКТЗЕД В (&МассивГруппКодовУКТЗЕД)) КАК ЦенообразованиеСеткаСрезПоследних
						|	
						|	ОБЪЕДИНИТЬ ВСЕ
						|	
						|	ВЫБРАТЬ ПЕРВЫЕ 1
						|		ЦенообразованиеСеткаСрезПоследних.КлючАналитик,
						|		ЦенообразованиеСеткаСрезПоследних.КлючАналитик.ИспользоватьДополнительнуюАналитику,
						|		ЦенообразованиеСеткаСрезПоследних.КлючАналитик.ТипДополнительнойАналитики,
						|		ЦенообразованиеСеткаСрезПоследних.ГруппаСтранНачалаТранзита,
						|		ЦенообразованиеСеткаСрезПоследних.ГруппаКодовУКТЗЕД,
						|		ЦенообразованиеСеткаСрезПоследних.СпецЦены,
						|		ЦенообразованиеСеткаСрезПоследних.Период,
						|		2,
						|		ВЫБОР
						|			КОГДА ЦенообразованиеСеткаСрезПоследних.ГруппаКодовУКТЗЕД = &ГруппаКодовУКТЗЕД
						|				ТОГДА 1
						|			ИНАЧЕ 2
						|		КОНЕЦ
						|	ИЗ
						|		РегистрСведений.ЦенообразованиеСетка.СрезПоследних(
						|				&Дата,
						|				Контрагент = &Контрагент
						|					И УслугаОрганизации = &УслугаОрганизации
						|					И СпецЦены = &СпецЦены
						|					И Принципал = &Принципал
						|					И ГруппаСтранНачалаТранзита В (&ГруппаСтранНачалаТранзита)
						|					И ГруппаСтранНачалаТранзита ССЫЛКА Справочник.ГруппыСтран
						|					И ГруппаКодовУКТЗЕД В (&МассивГруппКодовУКТЗЕД)) КАК ЦенообразованиеСеткаСрезПоследних
						|	
						|	УПОРЯДОЧИТЬ ПО
						|		Период УБЫВ,
						|		ПриоритетГруппСтран,
						|		ПриоритетГруппКодовУКТЗЕД) КАК ЦеныПоГруппам
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	КлючАналитикСрезПоследних.АналитикаСумм КАК АналитикаСумм,
						|	КлючАналитикСрезПоследних.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
						|	КлючАналитикСрезПоследних.Цена КАК Цена,
						|	КлючАналитикСрезПоследних.ВидРасчета КАК ВидРасчета,
						|	КлючАналитикСрезПоследних.ИндивидуальныйРасчет КАК ИндивидуальныйРасчет,
						|	КлючАналитикСрезПоследних.Валюта КАК Валюта,
						|	КлючАналитикСрезПоследних.МинимальнаяЦена КАК МинимальнаяЦена
						|ПОМЕСТИТЬ ВремВТ
						|ИЗ
						|	РегистрСведений.ЦенообразованиеСетка.СрезПоследних(
						|			&Дата,
						|			Контрагент = &Контрагент
						|				И УслугаОрганизации = &УслугаОрганизации
						|				И (КлючАналитик, ГруппаСтранНачалаТранзита, ГруппаКодовУКТЗЕД, СпецЦены) В
						|					(ВЫБРАТЬ
						|						КлючВТ.КлючАналитик,
						|						КлючВТ.ГруппаСтранНачалаТранзита,
						|						КлючВТ.ГруппаКодовУКТЗЕД,
						|						КлючВТ.СпецЦены
						|					ИЗ
						|						КлючВТ КАК КлючВТ)
						|				И Принципал = &Принципал) КАК КлючАналитикСрезПоследних
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	КлючВТ.КлючАналитик КАК КлючАналитик,
						|	КлючВТ.ИспользоватьДополнительнуюАналитику КАК ИспользоватьДополнительнуюАналитику,
						|	КлючВТ.ТипДополнительнойАналитики КАК ТипДополнительнойАналитики
						|ИЗ
						|	КлючВТ КАК КлючВТ
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ РАЗЛИЧНЫЕ
						|	ВремВТ.АналитикаСумм КАК АналитикаСумм,
						|	ВремВТ.АналитикаСумм.ЗначениеАналитики КАК ЗначениеАналитики
						|ИЗ
						|	ВремВТ КАК ВремВТ
						|
						|УПОРЯДОЧИТЬ ПО
						|	ЗначениеАналитики УБЫВ
						|ИТОГИ
						|	МАКСИМУМ(ЗначениеАналитики)
						|ПО
						|	ОБЩИЕ
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ РАЗЛИЧНЫЕ
						|	ВремВТ.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
						|	ВремВТ.ДополнительнаяАналитика.ЗначениеАналитики КАК ЗначениеАналитики
						|ИЗ
						|	ВремВТ КАК ВремВТ
						|
						|УПОРЯДОЧИТЬ ПО
						|	ЗначениеАналитики УБЫВ,
						|	ВремВТ.ДополнительнаяАналитика.ПорядокСортировкиВКлючеАналитик УБЫВ
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	ВремВТ.АналитикаСумм КАК АналитикаСумм,
						|	ВремВТ.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
						|	ВремВТ.Цена КАК Цена,
						|	ВремВТ.ВидРасчета КАК ВидРасчета,
						|	ВремВТ.ИндивидуальныйРасчет КАК ИндивидуальныйРасчет,
						|	ВремВТ.Валюта КАК Валюта,
						|	ВремВТ.МинимальнаяЦена КАК МинимальнаяЦена
						|ИЗ
						|	ВремВТ КАК ВремВТ
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|УНИЧТОЖИТЬ КлючВТ
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|УНИЧТОЖИТЬ ВремВТ";
					
					Запрос.УстановитьПараметр("Дата"						, пДата);
					Запрос.УстановитьПараметр("Контрагент"					, пКонтрагент);
					Запрос.УстановитьПараметр("Принципал"					, пПринципал);
					Запрос.УстановитьПараметр("УслугаОрганизации"			, пТипУслуги);
					Запрос.УстановитьПараметр("ГруппаСтранНачалаТранзита"	, пСтраныНачалаТранзита);
					Запрос.УстановитьПараметр("МассивГруппКодовУКТЗЕД"		, МассивГруппКодовУКТЗЕД);
					Запрос.УстановитьПараметр("ГруппаКодовУКТЗЕД"			, пГруппаКодовУКТЗЕД);
					Запрос.УстановитьПараметр("СпецЦены"					, пСпецЦены);
					
					МасРезультат = Запрос.ВыполнитьПакет();
					
					ВыборкаКлюч = МасРезультат[2].Выбрать();
					Если ВыборкаКлюч.Следующий() Тогда
						пРасстояние = СтруктураДанных.Расстояние;
						Если ВыборкаКлюч.ИспользоватьДополнительнуюАналитику
								И ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.Расстояние 
								И пРасстояние = 0 Тогда
							НеРассчитыватьЦену = Истина;
						КонецЕсли;
						
						Если НЕ НеРассчитыватьЦену Тогда
							пКоличествоПунктов = СтруктураДанных.КоличествоТаможенныхПунктов;
							Если ВыборкаКлюч.ИспользоватьДополнительнуюАналитику
									И ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.КоличествоТаможенныхПунктов 
									И пКоличествоПунктов = 0 Тогда
								НеРассчитыватьЦену = Истина;
							КонецЕсли;
						КонецЕсли;
						
						пАналитикаСумм = Неопределено;
						
						Если НЕ НеРассчитыватьЦену Тогда
							ВыборкаМаксимумСуммОбеспечения = МасРезультат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
							Если ВыборкаМаксимумСуммОбеспечения.Следующий() Тогда
								Если пСуммаОбеспечения > ВыборкаМаксимумСуммОбеспечения.ЗначениеАналитики Тогда  // если сумма больше максимального значения в сетке, то цену не считаем (индивидуальный расчет)
									//СтруктураДанных.Вставить("ИндивидуальныйРасчет", Истина);
									//Возврат 0;
									НеРассчитыватьЦену = Истина;
								Иначе
									ВыборкаСуммОбеспечения = ВыборкаМаксимумСуммОбеспечения.Выбрать();
									Пока ВыборкаСуммОбеспечения.Следующий() Цикл
										Если пСуммаОбеспечения > ВыборкаСуммОбеспечения.ЗначениеАналитики Тогда
											Прервать;
										КонецЕсли;
										пАналитикаСумм = ВыборкаСуммОбеспечения.АналитикаСумм;
									КонецЦикла;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
						
						Если (НЕ НеРассчитыватьЦену) И ЗначениеЗаполнено(пАналитикаСумм) Тогда
							
							СтруктураПоиска = Новый Структура;
							СтруктураПоиска.Вставить("АналитикаСумм", пАналитикаСумм);
							
							Если ВыборкаКлюч.ИспользоватьДополнительнуюАналитику Тогда
								ВыборкаДопАналитики = МасРезультат[4].Выбрать();
								пДопАналитика = Неопределено;
								
								Если ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.Расстояние Тогда
									Пока ВыборкаДопАналитики.Следующий() Цикл
										Если пРасстояние > ВыборкаДопАналитики.ЗначениеАналитики Тогда
											Прервать;
										КонецЕсли;
										пДопАналитика = ВыборкаДопАналитики.ДополнительнаяАналитика;
									КонецЦикла;	
								ИначеЕсли ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.КоличествоТаможенныхПунктов Тогда
									Если ВыборкаДопАналитики.НайтиСледующий(Новый Структура("ЗначениеАналитики", пКоличествоПунктов)) Тогда
										пДопАналитика = ВыборкаДопАналитики.ДополнительнаяАналитика;
									КонецЕсли;
								ИначеЕсли ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.АдминистративныйОкруг Тогда
									Если ВыборкаДопАналитики.НайтиСледующий(Новый Структура("ЗначениеАналитики", СтруктураДанных.АдминистративныйОкруг)) Тогда
										пДопАналитика = ВыборкаДопАналитики.ДополнительнаяАналитика;
									КонецЕсли;
								ИначеЕсли ВыборкаКлюч.ТипДополнительнойАналитики = Перечисления.ТипыДополнительныхАналитикЦенообразования.Страна Тогда
									Если ВыборкаДопАналитики.НайтиСледующий(Новый Структура("ЗначениеАналитики", СтруктураДанных.СтранаОформления)) Тогда
										пДопАналитика = ВыборкаДопАналитики.ДополнительнаяАналитика;
									КонецЕсли;
								КонецЕсли;
								
								СтруктураПоиска.Вставить("ДополнительнаяАналитика", пДопАналитика);
								
							КонецЕсли;
								
							Если НЕ НеРассчитыватьЦену Тогда
								ВыборкаЦен = МасРезультат[5].Выбрать();
								Если ВыборкаЦен.НайтиСледующий(СтруктураПоиска) Тогда
									Если ВыборкаЦен.ИндивидуальныйРасчет Тогда
										пТекЦена = 0;
									ИначеЕсли ВыборкаЦен.ВидРасчета = Перечисления.ВидыРасчетаЦен.Число Тогда
										пТекЦена = ВыборкаЦен.Цена;
									ИначеЕсли ВыборкаЦен.ВидРасчета = Перечисления.ВидыРасчетаЦен.Процент Тогда
										Если СтруктураДанных.ВалютаОбеспечения <> ВыборкаЦен.Валюта Тогда
											Если ВыборкаЦен.Валюта = ВалютаРоссийскийРубль() Тогда
												пСуммаОбеспеченияВал= ОкруглитьЦену(ПересчитатьПоТипуКурсаВалют(пСуммаОбеспечения, СтруктураДанных.ВалютаОбеспечения, ВыборкаЦен.Валюта, пТипКурсаВалют, пДата), 5);
											Иначе
												пСуммаОбеспеченияВал= ПересчитатьПоТипуКурсаВалют(пСуммаОбеспечения, СтруктураДанных.ВалютаОбеспечения, ВыборкаЦен.Валюта, пТипКурсаВалют, пДата);
											КонецЕсли;
										Иначе
											пСуммаОбеспеченияВал 	= пСуммаОбеспечения;
										КонецЕсли;
										пТекЦена = Окр(пСуммаОбеспеченияВал * ВыборкаЦен.Цена / 100, 2);
									КонецЕсли;
									
									Если ЗначениеЗаполнено(ВыборкаЦен.МинимальнаяЦена) И ЗначениеЗаполнено(пТекЦена)
											И пТекЦена < ВыборкаЦен.МинимальнаяЦена Тогда
										пТекЦена = ВыборкаЦен.МинимальнаяЦена;
									КонецЕсли;
									
									пТекЦенаВВалютеЦены	= пТекЦена;
									пВалютаЦены			= ВыборкаЦен.Валюта;
									
									//Если пТекЦена > 0 И пВалютаОплаты <> ВыборкаЦен.Валюта И ВыборкаЦен.ВидРасчета = Перечисления.ВидыРасчетаЦен.Число Тогда
									Если пТекЦена > 0 И пВалютаОплаты <> ВыборкаЦен.Валюта Тогда
										Если пОплатаВРублях Тогда
											пТекЦена	= ОкруглитьЦену(ПересчитатьПоТипуКурсаВалют(пТекЦена, ВыборкаЦен.Валюта, пВалютаОплаты, пТипКурсаВалют, пДата), 5);
										Иначе
											пТекЦена	= ПересчитатьПоТипуКурсаВалют(пТекЦена, ВыборкаЦен.Валюта, пВалютаОплаты, пТипКурсаВалют, пДата);
										КонецЕсли;
									КонецЕсли;
									
									// в гривнах цена без копеек
									Если пОплатаВГрн Тогда
										пТекЦена		= Окр(пТекЦена);
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
							
							//Если пДетализацияЦенПоУслугамВСчетах И пТекЦена > 0 И (НЕ СтруктураДанных.ИндивидуальныйРасчет) Тогда
							//	Если пТипУслуги = Перечисления.ТипыУслугОрганизации.ЭПИГарантия Тогда
							//		пТекстДетализации = пТекстДетализации + Символы.ПС + "    " + НСтр("ru='Гарантия';uk='Гарантія'", пКодЯзыка) + " = " + Формат(пТекЦена, "ЧДЦ=2");
							//	Иначе //Если пТипУслуги = Перечисления.ТипыУслугОрганизации.T1 Тогда
							//		пТекстДетализации = пТекстДетализации + Символы.ПС + "    " + НСтр("ru='T1 (гарантия)';uk='T1 (гарантія)'", пКодЯзыка) + " = " + Формат(пТекЦена, "ЧДЦ=2");
							//	КонецЕсли;
							//КонецЕсли;
								
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли пТипУслуги = Перечисления.ТипыУслугОрганизации.ЭТД Тогда
				
				//Если ЗначениеЗаполнено(пОрганизация) 
				//		И пОрганизация = Справочники.Организации.НайтиПоКоду("000000006") 
				//		И Найти(пОрганизация.Наименование, "EETG") > 0
				//		И СтруктураДанных.СтранаОформления = Справочники.СтранаОформления.Россия
				//		И пТипыУслуг.Найти(Перечисления.ТипыУслугОрганизации.ЭПИГарантия, "УслугаОрганизации") <> Неопределено
				//		И пТипыУслуг.Найти(Перечисления.ТипыУслугОрганизации.ЭПИ, "УслугаОрганизации") <> Неопределено Тогда
				//	// в России для организации EETG для услуги ЭПИ + Гарантия + ЭТД стоимость ЭТД допустима 0 
				//	пДопустимаНулеваяЦена 		= Истина;
				//КонецЕсли;
				
				КодыCMR 						= СтруктураДанных.КодыCMR;
				КоличествоCMR					= КодыCMR.Количество();
				КоличествоКодов 				= КодыCMR.Итог("КоличествоКодов");
				
				Если КоличествоCMR = 0 Тогда
					НеРассчитыватьЦену 			= Истина;
					НедостаточноВходныхДанных 	= Истина;
				КонецЕсли;

				Если НЕ НеРассчитыватьЦену Тогда
					Запрос = Новый Запрос;
					Запрос.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	ЦенообразованиеУслугиСрезПоследних.ЦенаЗаПервуюCMR КАК ЦенаЗаПервуюCMR,
