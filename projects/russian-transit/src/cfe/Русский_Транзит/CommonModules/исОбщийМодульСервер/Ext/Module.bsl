Функция ТекущаяГруппаКлиентовПринципала(пИмяРегистра, пУслугаОрганизации, пПринципал, пДата, СтруктураДанных) Экспорт

	// Доработка START {CRITICAL #7: Whitelist допустимых имён регистров — защита от SQL-инъекции} {2026-04-09}
	ДопустимыеРегистры = Новый Соответствие;
	ДопустимыеРегистры.Вставить("ЦенообразованиеУслуги", Истина);
	ДопустимыеРегистры.Вставить("ЦенообразованиеСетка", Истина);
	ДопустимыеРегистры.Вставить("ЦенообразованиеДополнительныеУслуги", Истина);
	Если ДопустимыеРегистры.Получить(пИмяРегистра) = Неопределено Тогда
		ВызватьИсключение "Недопустимое имя регистра: " + пИмяРегистра;
	КонецЕсли;
	// Доработка END

	Запрос = Новый Запрос;
	
	Если СтруктураДанных.СтранаОформления = Справочники.СтранаОформления.Беларусь Тогда
		ДопУсловие = "
		|				И ВЫРАЗИТЬ(Контрагент КАК Справочник.ГруппыКлиентовПринципалов).КатегорияУслуги = &КатегорияУслуги";
		
		Запрос.УстановитьПараметр("КатегорияУслуги", СтруктураДанных.КатегорияУслуги);
	Иначе
		ДопУсловие = "
		|				И ВЫРАЗИТЬ(Контрагент КАК Справочник.ГруппыКлиентовПринципалов).КатегорияУслуги = ЗНАЧЕНИЕ(Перечисление.КатегорииУслуг.ПустаяСсылка)";
	КонецЕсли;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ГруппыПринципалаВЗ.Период КАК Период,
		|	ГруппыПринципалаВЗ.ГруппаПринципала КАК ГруппаПринципала
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		ЦенообразованиеУслугиСрезПоследних.Период КАК Период,
		|		ЦенообразованиеУслугиСрезПоследних.Контрагент КАК ГруппаПринципала
		|	ИЗ
		|		РегистрСведений." + пИмяРегистра + ".СрезПоследних(
		|				&Дата,
		|				Принципал = &Принципал
		|					И Контрагент ССЫЛКА Справочник.ГруппыКлиентовПринципалов " + ДопУсловие + "
		|					И УслугаОрганизации = &УслугаОрганизации) КАК ЦенообразованиеУслугиСрезПоследних
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ ПЕРВЫЕ 1
		|		ЦенообразованиеУслугиСрезПоследних.Период,
		|		ЦенообразованиеУслугиСрезПоследних.Контрагент
		|	ИЗ
		|		РегистрСведений." + пИмяРегистра + ".СрезПоследних(
		|				&Дата,
		|				Принципал = &Принципал
		|					И Контрагент ССЫЛКА Справочник.ГруппыКлиентовПринципалов
		|					И ВЫРАЗИТЬ(Контрагент КАК Справочник.ГруппыКлиентовПринципалов) = ЗНАЧЕНИЕ(Справочник.ГруппыКлиентовПринципалов.ПустаяСсылка)
		|					И УслугаОрганизации = &УслугаОрганизации) КАК ЦенообразованиеУслугиСрезПоследних
		|	
		|	УПОРЯДОЧИТЬ ПО
		|		Период) КАК ГруппыПринципалаВЗ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";		
		
		//"ВЫБРАТЬ ПЕРВЫЕ 1
		//|	ЦенообразованиеУслугиСрезПоследних.Контрагент КАК ГруппаПринципала
		//|ИЗ
		//|	РегистрСведений." + пИмяРегистра + ".СрезПоследних(
		//|			&Дата,
		//|			Принципал = &Принципал
		//|				И " + ДопУсловие + "
		//|				И УслугаОрганизации = &УслугаОрганизации) КАК ЦенообразованиеУслугиСрезПоследних
		//|
		//|УПОРЯДОЧИТЬ ПО
		//|	ЦенообразованиеУслугиСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата"				, пДата);
	Запрос.УстановитьПараметр("Принципал"			, пПринципал);
	Запрос.УстановитьПараметр("УслугаОрганизации"	, пУслугаОрганизации);
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ГруппаПринципала;
	КонецЕсли;
	
	Возврат Справочники.ГруппыКлиентовПринципалов.ПустаяСсылка();
	
КонецФункции

Функция ЕстьГруппаКодовУКТЗЕД(СтруктураДанных, пТекГруппаКлиентов = Неопределено) Экспорт
	
	СтруктураДанных.Вставить("ГруппаКодовУКТЗЕД"					, Неопределено);
	СтруктураДанных.Вставить("НесколькоГруппКодовУКТЗЕД"			, Ложь);
	СтруктураДанных.Вставить("ЕстьНезаполненныеГруппыКодовУКТЗЕД"	, Ложь);
	
	пТаблКодыУКТЗЕД = СтруктураДанных.КодыУКТЗЕД;
	Если пТаблКодыУКТЗЕД.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	пТаблКодыУКТЗЕД.Свернуть("КодУКТЗЕД");
	
	пТаблПодготов = Новый ТаблицаЗначений;
	пТаблПодготов.Колонки.Добавить("КодНачало"	, Новый ОписаниеТипов("СправочникСсылка.КлассификаторУКТВЭД"));
	пТаблПодготов.Колонки.Добавить("Код"		, Новый ОписаниеТипов("СправочникСсылка.КлассификаторУКТВЭД"));
	пТаблПодготов.Колонки.Добавить("Приоритет"	, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 0, ДопустимыйЗнак.Неотрицательный)));

	// Доработка START {CRITICAL #10: Предзагрузка кодов УКТЗЕД — замена НайтиПоРеквизиту в цикле на один запрос} {2026-04-09}
	// Собираем все усечённые КодДляПоиска, которые потребуются в цикле
	СписокКодовДляПоиска = Новый Массив;
	Для каждого СтрКпред Из пТаблКодыУКТЗЕД Цикл
		Если ЗначениеЗаполнено(СтрКпред.КодУКТЗЕД) Тогда
			пКодПред = СтрКпред.КодУКТЗЕД.КодДляПоиска;
			Если СтрДлина(пКодПред) > 4 Тогда
				пКодПред = Лев(пКодПред, СтрДлина(пКодПред) - 1);
				Пока СтрДлина(пКодПред) >= 4 Цикл
					СписокКодовДляПоиска.Добавить(пКодПред);
					пКодПред = Лев(пКодПред, СтрДлина(пКодПред) - 1);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	КешКодовУКТЗЕД = Новый Соответствие;
	Если СписокКодовДляПоиска.Количество() > 0 Тогда
		ЗапросКодов = Новый Запрос;
		ЗапросКодов.Текст =
		"ВЫБРАТЬ
		|	КлассификаторУКТВЭД.Ссылка КАК Ссылка,
		|	КлассификаторУКТВЭД.КодДляПоиска КАК КодДляПоиска
		|ИЗ
		|	Справочник.КлассификаторУКТВЭД КАК КлассификаторУКТВЭД
		|ГДЕ
		|	КлассификаторУКТВЭД.КодДляПоиска В (&СписокКодов)";
		ЗапросКодов.УстановитьПараметр("СписокКодов", СписокКодовДляПоиска);
		РезультатКодов = ЗапросКодов.Выполнить();
		ВыборкаКодов = РезультатКодов.Выбрать();
		Пока ВыборкаКодов.Следующий() Цикл
			КешКодовУКТЗЕД.Вставить(ВыборкаКодов.КодДляПоиска, ВыборкаКодов.Ссылка);
		КонецЦикла;
	КонецЕсли;
	// Доработка END

	СтрУдалениеПустойКод = Неопределено;
	Для каждого СтрК Из пТаблКодыУКТЗЕД Цикл
		пКодНачало	= СтрК.КодУКТЗЕД;
		пКод 		= СтрК.КодУКТЗЕД;

		Если ЗначениеЗаполнено(пКод) Тогда
			пКодДляПоиска		= пКод.КодДляПоиска;
			пПриоритет 			= СтрДлина(пКодДляПоиска);
			НовСтрК = пТаблПодготов.Добавить();
			НовСтрК.КодНачало 	= пКодНачало;
			НовСтрК.Код 		= пКод;
			НовСтрК.Приоритет 	= пПриоритет;

			Если пПриоритет <= 4 Тогда
				Продолжить;
			КонецЕсли;

			пКодГр 						= Неопределено;
			пКодДляПоиска 				= Лев(пКодДляПоиска, СтрДлина(пКодДляПоиска)-1);
			Пока СтрДлина(пКодДляПоиска) >= 4 Цикл
				// Доработка START {CRITICAL #10: Поиск через предзагруженный кеш вместо НайтиПоРеквизиту} {2026-04-09}
				пКодГр = КешКодовУКТЗЕД.Получить(пКодДляПоиска);
				// Доработка END
				Если ЗначениеЗаполнено(пКодГр) Тогда
					НовСтрК = пТаблПодготов.Добавить();
					НовСтрК.КодНачало 	= пКодНачало;
					НовСтрК.Код 		= пКодГр;
					НовСтрК.Приоритет 	= СтрДлина(пКодДляПоиска);
				КонецЕсли;

				пКодДляПоиска 		= Лев(пКодДляПоиска, СтрДлина(пКодДляПоиска)-1);
			КонецЦикла;
		Иначе
			СтрУдалениеПустойКод = СтрК;
		КонецЕсли;
	КонецЦикла;
	Если пТаблПодготов.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрУдалениеПустойКод <> Неопределено Тогда
		пТаблКодыУКТЗЕД.Удалить(СтрУдалениеПустойКод);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ТаблицаКодов.КодНачало КАК КодНачало,
		|	ТаблицаКодов.Код КАК Код,
		|	ТаблицаКодов.Приоритет КАК Приоритет
		|ПОМЕСТИТЬ ВремВТ
		|ИЗ
		|	&ТаблицаКодов КАК ТаблицаКодов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремВТ.КодНачало КАК КодНачало,
		|	ВремВТ.Код КАК Код,
		|	ВремВТ.Приоритет КАК Приоритет,
		|	ЕСТЬNULL(КодыВЗ.ГруппаКодов, ЗНАЧЕНИЕ(Справочник.ГруппыКодовУКТЗЕД.ПустаяСсылка)) КАК ГруппаКодов
		|ПОМЕСТИТЬ ГотовВТ
		|ИЗ
		|	ВремВТ КАК ВремВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ГруппыКодовУКТЗЕДСписокКодов.Код КАК Код,
		|			МАКСИМУМ(ГруппыКодовУКТЗЕДСписокКодов.Ссылка) КАК ГруппаКодов
		|		ИЗ
		|			Справочник.ГруппыКодовУКТЗЕД.СписокКодов КАК ГруппыКодовУКТЗЕДСписокКодов
		|		ГДЕ
		|			ГруппыКодовУКТЗЕДСписокКодов.Ссылка В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ЦенообразованиеСеткаСрезПоследних.ГруппаКодовУКТЗЕД КАК ГруппаКодовУКТЗЕД
		|					ИЗ
		|						РегистрСведений.ЦенообразованиеСетка.СрезПоследних(&Дата, УслугаОрганизации = &УслугаОрганизации
		|							И Контрагент = &Контрагент
		|							И Принципал = &Принципал) КАК ЦенообразованиеСеткаСрезПоследних)
		|			И ГруппыКодовУКТЗЕДСписокКодов.Ссылка В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ГруппыКодовУКТЗЕДДоступныеРежимыОформления.Ссылка КАК Ссылка
		|					ИЗ
		|						Справочник.ГруппыКодовУКТЗЕД.ДоступныеРежимыОформления КАК ГруппыКодовУКТЗЕДДоступныеРежимыОформления
		|					ГДЕ
		|						ГруппыКодовУКТЗЕДДоступныеРежимыОформления.Ссылка.УчитыватьРежимыОформления
		|						И ГруппыКодовУКТЗЕДДоступныеРежимыОформления.РежимОформления = &РежимОформления)
		|			И ГруппыКодовУКТЗЕДСписокКодов.Ссылка В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ГруппыКодовУКТЗЕДЦеновыеГруппыМашин.Ссылка КАК Ссылка
		|					ИЗ
		|						Справочник.ГруппыКодовУКТЗЕД.ЦеновыеГруппыМашин КАК ГруппыКодовУКТЗЕДЦеновыеГруппыМашин
		|					ГДЕ
		|						ГруппыКодовУКТЗЕДЦеновыеГруппыМашин.Ссылка.УчитыватьЦеновыеГруппы
		|						И ГруппыКодовУКТЗЕДЦеновыеГруппыМашин.ЦеноваяГруппаМашины = &ЦеноваяГруппаМашины)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ГруппыКодовУКТЗЕДСписокКодов.Код) КАК КодыВЗ
		|		ПО ВремВТ.Код = КодыВЗ.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПриоритетыВЗ.КодНачало КАК КодНачало,
		|	ГотовВТ.Код КАК Код,
		|	ГотовВТ.ГруппаКодов КАК ГруппаКодов
		|ИЗ
		|	(ВЫБРАТЬ
		|		ГотовВТ.КодНачало КАК КодНачало,
		|		МАКСИМУМ(ГотовВТ.Приоритет) КАК Приоритет
		|	ИЗ
		|		ГотовВТ КАК ГотовВТ
		|	ГДЕ
		|		ГотовВТ.ГруппаКодов <> ЗНАЧЕНИЕ(Справочник.ГруппыКодовУКТЗЕД.ПустаяСсылка)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ГотовВТ.КодНачало) КАК ПриоритетыВЗ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ГотовВТ КАК ГотовВТ
		|		ПО ПриоритетыВЗ.КодНачало = ГотовВТ.КодНачало
		|			И ПриоритетыВЗ.Приоритет = ГотовВТ.Приоритет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВремВТ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ГотовВТ";
	
	Запрос.УстановитьПараметр("ТаблицаКодов"		, пТаблПодготов);
	Запрос.УстановитьПараметр("Дата"				, СтруктураДанных.Дата);
	Запрос.УстановитьПараметр("УслугаОрганизации"	, СтруктураДанных.ТипУслуги);
	Запрос.УстановитьПараметр("Принципал"			, СтруктураДанных.ПринципалУстановкиЦен);
	
	Если пТекГруппаКлиентов <> Неопределено Тогда   //для цен принципалов
		пКонтрагент = пТекГруппаКлиентов;
	ИначеЕсли СтруктураДанных.Свойство("Контрагент") Тогда
		пКонтрагент = СтруктураДанных.Контрагент;
	Иначе
		пКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Контрагент"			, пКонтрагент);
	
	Если СтруктураДанных.РазныеЦеныВЗависимостиОтРежимаОформления И ЗначениеЗаполнено(СтруктураДанных.РежимОформления) Тогда
		Запрос.УстановитьПараметр("РежимОформления"	, СтруктураДанных.РежимОформления);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "
		|			И ГруппыКодовУКТЗЕДСписокКодов.Ссылка В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ГруппыКодовУКТЗЕДДоступныеРежимыОформления.Ссылка КАК Ссылка
		|					ИЗ
		|						Справочник.ГруппыКодовУКТЗЕД.ДоступныеРежимыОформления КАК ГруппыКодовУКТЗЕДДоступныеРежимыОформления
		|					ГДЕ
		|						ГруппыКодовУКТЗЕДДоступныеРежимыОформления.Ссылка.УчитыватьРежимыОформления
		|						И ГруппыКодовУКТЗЕДДоступныеРежимыОформления.РежимОформления = &РежимОформления)", "
		|			И (НЕ ГруппыКодовУКТЗЕДСписокКодов.Ссылка.УчитыватьРежимыОформления)");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.ЦеноваяГруппаМашины) Тогда
		Запрос.УстановитьПараметр("ЦеноваяГруппаМашины"	, СтруктураДанных.ЦеноваяГруппаМашины);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "
		|			И ГруппыКодовУКТЗЕДСписокКодов.Ссылка В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ГруппыКодовУКТЗЕДЦеновыеГруппыМашин.Ссылка КАК Ссылка
		|					ИЗ
		|						Справочник.ГруппыКодовУКТЗЕД.ЦеновыеГруппыМашин КАК ГруппыКодовУКТЗЕДЦеновыеГруппыМашин
		|					ГДЕ
		|						ГруппыКодовУКТЗЕДЦеновыеГруппыМашин.Ссылка.УчитыватьЦеновыеГруппы
		|						И ГруппыКодовУКТЗЕДЦеновыеГруппыМашин.ЦеноваяГруппаМашины = &ЦеноваяГруппаМашины)", "
		|			И (НЕ ГруппыКодовУКТЗЕДСписокКодов.Ссылка.УчитыватьЦеновыеГруппы)");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	ТаблГрупп = Запрос.Выполнить().Выгрузить();
	Если ТаблГрупп.Количество() < пТаблКодыУКТЗЕД.Количество() Тогда    //НЕ все коды заполнены
		СтруктураДанных.ЕстьНезаполненныеГруппыКодовУКТЗЕД 	= Истина;
		ТаблГрупп.Свернуть("ГруппаКодов");
		МассивГруппКодов = ТаблГрупп.ВыгрузитьКолонку("ГруппаКодов");
		Если МассивГруппКодов.Количество() = 1 Тогда
			СтруктураДанных.ГруппаКодовУКТЗЕД = МассивГруппКодов[0];   //передаем для заполнения недостающих кодов в машине
		КонецЕсли;
		Возврат Ложь;
	Иначе
		ТаблГрупп.Свернуть("ГруппаКодов");
		МассивГруппКодов = ТаблГрупп.ВыгрузитьКолонку("ГруппаКодов");
		Если МассивГруппКодов.Количество() > 1 Тогда
			СтруктураДанных.НесколькоГруппКодовУКТЗЕД = Истина;
			Возврат Ложь;
		Иначе //Если МассивГруппКодов.Количество() = 1 Тогда
			СтруктураДанных.ГруппаКодовУКТЗЕД = МассивГруппКодов[0];
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПересчитатьПоТипуКурсаВалют(Знач Сумма, ВалютаИз, ВалютаВ, ТипКурсаВалют=Неопределено, Дата=Неопределено) Экспорт
	
	Если Сумма = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ВалютаВ = ВалютаИз Тогда
		Возврат Сумма;
	КонецЕсли;
	
	Если ТипКурсаВалют = Неопределено Тогда
		ТипКурсаВалют = Перечисления.ТипыКурсовВалют.ЦБ_РФ;
	КонецЕсли;
	
	СтрВалютаИз = РегистрыСведений.КурсыВалютДляОплатыМашин.ПолучитьПоследнее(Дата, Новый Структура("Валюта,ТипКурса", ВалютаИз, ТипКурсаВалют));
	Если СтрВалютаИз.КурсНеПоУмолчанию Тогда
		СтрВалютаИз.Вставить("Валюта"	, ВалютаИз);
		СтрВалютаИз.Вставить("ДатаКурса", Дата);
	Иначе
		Если ТипКурсаВалют = Перечисления.ТипыКурсовВалют.ЦБ_РФ Тогда
			СтрВалютаИз = исРаботаСКурсамиВалютСервер.ПолучитьКурсВалютыРФ(ВалютаИз, Дата);
		ИначеЕсли ТипКурсаВалют = Перечисления.ТипыКурсовВалют.НБУ Тогда
			СтрВалютаИз = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаИз, Дата);
		ИначеЕсли ТипКурсаВалют = Перечисления.ТипыКурсовВалют.ЦБ_ЕС Тогда
			СтрВалютаИз = исРаботаСКурсамиВалютСервер.ПолучитьКурсВалютыЕС(ВалютаИз, Дата);
		ИначеЕсли ТипКурсаВалют = Перечисления.ТипыКурсовВалют.НБ_РБ Тогда
			СтрВалютаИз = исРаботаСКурсамиВалютСервер.ПолучитьКурсВалютыРБ(ВалютаИз, Дата);
		КонецЕсли;
	КонецЕсли;
	
	СтрВалютаВ = РегистрыСведений.КурсыВалютДляОплатыМашин.ПолучитьПоследнее(Дата, Новый Структура("Валюта,ТипКурса", ВалютаВ, ТипКурсаВалют));
	Если СтрВалютаВ.КурсНеПоУмолчанию Тогда
		СтрВалютаВ.Вставить("Валюта"	, ВалютаВ);
		СтрВалютаВ.Вставить("ДатаКурса"	, Дата);
	Иначе
		Если ТипКурсаВалют = Перечисления.ТипыКурсовВалют.ЦБ_РФ Тогда
			СтрВалютаВ = исРаботаСКурсамиВалютСервер.ПолучитьКурсВалютыРФ(ВалютаВ, Дата);
		ИначеЕсли ТипКурсаВалют = Перечисления.ТипыКурсовВалют.НБУ Тогда
			СтрВалютаВ = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаВ, Дата);
		ИначеЕсли ТипКурсаВалют = Перечисления.ТипыКурсовВалют.ЦБ_ЕС Тогда
			СтрВалютаВ = исРаботаСКурсамиВалютСервер.ПолучитьКурсВалютыЕС(ВалютаВ, Дата);
		ИначеЕсли ТипКурсаВалют = Перечисления.ТипыКурсовВалют.НБ_РБ Тогда
			СтрВалютаВ = исРаботаСКурсамиВалютСервер.ПолучитьКурсВалютыРБ(ВалютаВ, Дата);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипКурсаВалют = Перечисления.ТипыКурсовВалют.ЦБ_РФ Тогда
		Возврат исРаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Сумма, СтрВалютаИз, СтрВалютаВ)		
	ИначеЕсли ТипКурсаВалют = Перечисления.ТипыКурсовВалют.НБУ Тогда
		Возврат исРаботаСКурсамиВалютСервер.ПересчитатьПоКурсу(Сумма, СтрВалютаИз, СтрВалютаВ)		
	ИначеЕсли ТипКурсаВалют = Перечисления.ТипыКурсовВалют.ЦБ_ЕС Тогда
		Возврат исРаботаСКурсамиВалютСервер.ПересчитатьПоКурсуЕС(Сумма, СтрВалютаИз, СтрВалютаВ);
	ИначеЕсли ТипКурсаВалют = Перечисления.ТипыКурсовВалют.НБ_РБ Тогда
		Возврат исРаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Сумма, СтрВалютаИз, СтрВалютаВ);
	КонецЕсли;
	
	Возврат Сумма;
	
КонецФункции

Функция ПолучитьСтоимостьЗатратС2019(СтруктураДанных) Экспорт
	
	пСуммаПринципала 	= 0;
	пСтранаОформления	= СтруктураДанных.СтранаОформления;
			
	пУслугаОрганизации 	= СтруктураДанных.УслугаОрганизации;
	пДата 				= СтруктураДанных.Дата;
	пСпецЦены 			= СтруктураДанных.СпецЦены;
	
	//ПринципалУстановкиЦен /////////////////////////////////////////////////////////////////////
	пПринципал 			= ?(ТипЗнч(СтруктураДанных.Принципал) = ТИП("СправочникСсылка.Принципал"), СтруктураДанных.Принципал.ПринципалУстановкиЦенПринципала, СтруктураДанных.Принципал);
	СтруктураДанных.Вставить("ПринципалУстановкиЦен", пПринципал);
	//ПринципалУстановкиЦен /////////////////////////////////////////////////////////////////////
	
	//СтраныНачалаТранзита //////////////////////////////////////////////////////////////////////
	пСтраныНачалаТранзита = Новый Массив;
	Если ТипЗнч(СтруктураДанных.СтранаНачалаТранзита) = ТИП("СправочникСсылка.ГруппыСтран") Тогда
		
		пСтраныНачалаТранзита.Добавить(СтруктураДанных.СтранаНачалаТранзита);
		
	ИначеЕсли ТипЗнч(СтруктураДанных.СтранаНачалаТранзита) = ТИП("СправочникСсылка.СтранаОформления") И ЗначениеЗаполнено(СтруктураДанных.СтранаНачалаТранзита) Тогда
		
		пСтраныНачалаТранзита.Добавить(СтруктураДанных.СтранаНачалаТранзита);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ГруппыСтранСтраныГруппы.Ссылка
			|ИЗ
			|	Справочник.ГруппыСтран.СтраныГруппы КАК ГруппыСтранСтраныГруппы
