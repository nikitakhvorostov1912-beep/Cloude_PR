Функция ПолучитьКартинкуПодписи(Организация=Неопределено) Экспорт

	КартинкаПодписи = Новый Картинка;
	
	Если ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Организация.КартинкаПодписи) Тогда
		пХранилищеКартинки = Организация.КартинкаПодписи.Хранилище.Получить();
		Если ТипЗнч(пХранилищеКартинки) = Тип("Картинка") Тогда
			КартинкаПодписи = пХранилищеКартинки;
		КонецЕсли;
	Иначе
		пКартинкаСсылка = Константы.КартинкаПодписи.Получить();
		Если ЗначениеЗаполнено(пКартинкаСсылка) Тогда
			пХранилищеКартинки = пКартинкаСсылка.Хранилище.Получить();
			Если ТипЗнч(пХранилищеКартинки) = Тип("Картинка") Тогда
				КартинкаПодписи = пХранилищеКартинки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
	Возврат КартинкаПодписи;
		
КонецФункции

