// Доработка START {Добавить поле ТипУчета на форму контрагента} {2026-04-03}
&После("ПартнерФормаЭлементаПриСозданииНаСервере")
Процедура Расш1_ПартнерФормаЭлементаПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка)

	Попытка
		Если Форма.Элементы.Найти("Расш1_ТипУчета") <> Неопределено Тогда
			Возврат;
		КонецЕсли;

		// Создаём реквизит формы (не объекта!) для редактирования
		МассивРеквизитов = Новый Массив;
		МассивРеквизитов.Добавить(Новый РеквизитФормы("Расш1_ТипУчетаЗначение",
			Новый ОписаниеТипов("ПеречислениеСсылка.ТипыУчетаКлиентов"),, "Тип учёта"));
		Форма.ИзменитьРеквизиты(МассивРеквизитов);

		// Заполняем из контрагента
		Контрагент = Форма.КонтрагентПартнера;
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Форма.Расш1_ТипУчетаЗначение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				Контрагент, "ТипУчета");
		КонецЕсли;

		// Добавляем элемент на форму
		Родитель = Форма.Элементы.Найти("ГруппаОбщаяИнформация");
		НовоеПоле = Форма.Элементы.Добавить("Расш1_ТипУчета", Тип("ПолеФормы"), Родитель);
		НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
		НовоеПоле.ПутьКДанным = "Расш1_ТипУчетаЗначение";
		НовоеПоле.Заголовок = "Тип учёта";

	Исключение
		ЗаписьЖурналаРегистрации("РусскийТранзит.ТипУчета",
			УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Сохраняем значение ТипУчета в контрагента при записи формы
&После("ПартнерФормаЭлементаПослеЗаписиНаСервере")
Процедура Расш1_ПартнерФормаЭлементаПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи)

	Попытка
		Контрагент = Форма.КонтрагентПартнера;
		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
			Возврат;
		КонецЕсли;

		НовоеЗначение = Форма.Расш1_ТипУчетаЗначение;
		ТекущееЗначение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ТипУчета");

		Если НовоеЗначение <> ТекущееЗначение Тогда
			КонтрагентОбъект = Контрагент.ПолучитьОбъект();
			КонтрагентОбъект.ТипУчета = НовоеЗначение;
			КонтрагентОбъект.Записать();
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("РусскийТранзит.ТипУчетаЗапись",
			УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры
// Доработка END
