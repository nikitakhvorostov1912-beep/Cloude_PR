&НаСервере
Процедура ЗаполнитьКонтрагентаПриВыборе()
	Если КонтрагентДляЗаполнения <> Справочники.Контрагенты.ПустаяСсылка() тогда
		ЗаполнитьКонтрагентаНаСервере();
		ЗаполнитьДинамическиеСписки(); 
		КоличествоВСписках();
	Конецесли;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДанныеПоТекущейСтроке(ТекДанные)
	
	ДанныеСтрок.Очистить();
	
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ТекДанные);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Операция.ВнешнийИдентификатор КАК ВнешнийИдентификатор,
	|	Операция.Ссылка КАК Ссылка,
	|	Операция.Контрагент КАК Контрагент
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК Операция
	|ГДЕ
	|	Операция.Ссылка В (&ссылка)";  
	
	Результат = запрос.Выполнить().Выгрузить();
	
    ДанныеДок = новый массив; 
    ДанныеКонтр = новый Массив;
	Для каждого стр из результат цикл    
		ДанныеДок.Добавить(стр.Ссылка);
		ДанныеКонтр.Добавить(стр.контрагент);
	КонецЦикла;	
	
	Струк = новый Структура;
	Струк.Вставить("Документы", ДанныеДок);
	Струк.Вставить("Контрагенты", ДанныеКонтр); 
	
	Возврат Струк; 
КонецФункции	
	
&НаСервере
Процедура ЗаполнитьКонтрагентаНаСервере() 
		
	Массив = Элементы.СписокОшибочныеОперации.ВыделенныеСтроки;
	
	ВыдСтроки = Новый Массив;
	Для каждого текВыд из Массив цикл
		ВыдСтроки.Добавить(текВыд);	
	КонецЦикла;	
	
	// Доработка START {Аудит 2026-04-04: Возврат→Продолжить, удалён лишний Записать, добавлена Попытка}
	Для Каждого стр Из ВыдСтроки Цикл
		Док = стр.ПолучитьОбъект();

		Если ЗначениеЗаполнено(Док.Контрагент) Тогда
			Продолжить;
		КонецЕсли;

		Док.Контрагент = КонтрагентДляЗаполнения;
		Попытка
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписьЖурналаРегистрации("АРМ.ЗаполнениеКонтрагента",
				УровеньЖурналаРегистрации.Ошибка,,
				стр,
				ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	// Доработка END
КонецПроцедуры

// Доработка START {Пересборка: повторная идентификация + группировка неидентифицированных} {2026-04-05}
// Доработка {2026-04-14}: кнопка в шапке, период обязателен, обёртка Попытка
&НаКлиенте
Процедура ПересобратьДокументы(Команда)
	// Период обязателен
	Если НЕ ЗначениеЗаполнено(Период.ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Укажите период для пересборки документов.");
		Возврат;
	КонецЕсли;
	Результат = ПересобратьДокументыНаСервере();
	Если ЗначениеЗаполнено(Результат) Тогда
		ПоказатьПредупреждение(, Результат);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПересобратьДокументыНаСервере()

	Попытка

	// 1. Выбрать все НеИдентифицированные документы за период
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Комментарий КАК Комментарий,
	|	Док.ОсновноеТС КАК ОсновноеТС,
	|	Док.Дата КАК Дата
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК Док
	|ГДЕ
	|	Док.СтатусОперации = &СтатусНеИдентифицирован
	|	И Док.Дата >= &ДатаНачала
	|	И Док.Дата <= &ДатаОкончания
	|	И НЕ Док.ПометкаУдаления";
	Запрос.УстановитьПараметр("СтатусНеИдентифицирован", Перечисления.СтатусыОпераций.НеИдентифицирован);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Период.ДатаОкончания));

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат "Нет неидентифицированных документов за период "
			+ Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " — "
			+ Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + ".";
	КонецЕсли;

	Выборка = Результат.Выбрать();

	// 2. Повторная идентификация
	// Структура: Ключ (ТС+Контрагент+Дата) → Массив ссылок
	ГруппыДляОбъединения = Новый Соответствие;
	СчётчикИдентифицировано = 0;

	Пока Выборка.Следующий() Цикл
		// Извлечь email из комментария
		// Доработка {2026-04-14}: поддержка 3 форматов: #email#, просто email, "name" <email>
		Email = "";
		Если ЗначениеЗаполнено(Выборка.Комментарий) Тогда
			Комм = СокрЛП(Выборка.Комментарий);
			// 1. Формат #email@domain.ru#
			Позиция1 = СтрНайти(Комм, "#");
			Если Позиция1 > 0 Тогда
				Позиция2 = СтрНайти(Комм, "#", , , 2);
				Если Позиция2 > Позиция1 + 1 Тогда
					Email = СокрЛП(Сред(Комм, Позиция1 + 1, Позиция2 - Позиция1 - 1));
				КонецЕсли;
			КонецЕсли;
			// 2. Формат "name" <email> — извлечь из угловых скобок
			Если СтрНайти(Email, "@") = 0 И СтрНайти(Комм, "<") > 0 Тогда
				П1 = СтрНайти(Комм, "<");
				П2 = СтрНайти(Комм, ">");
				Если П2 > П1 + 1 Тогда
					Email = СокрЛП(Сред(Комм, П1 + 1, П2 - П1 - 1));
				КонецЕсли;
			КонецЕсли;
			// 3. Просто email в комментарии (без решёток и скобок)
			Если СтрНайти(Email, "@") = 0 И СтрНайти(Комм, "@") > 0 Тогда
				Email = СокрЛП(Комм);
				// Убрать кавычки если есть
				Email = СтрЗаменить(Email, """", "");
			КонецЕсли;
			// Финальная проверка
			Если СтрНайти(Email, "@") = 0 Тогда
				Email = "";
			КонецЕсли;
		КонецЕсли;

		// Попытка найти контрагента заново
		НовыйКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
		Если ЗначениеЗаполнено(Email) Тогда
			// Поиск по КонтактнойИнформации
			ЗапросКИ = Новый Запрос;
			ЗапросКИ.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	КИ.Ссылка КАК Контрагент
			|ИЗ
			|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
			|ГДЕ
			|	КИ.Представление ПОДОБНО &Email";
			ЗапросКИ.УстановитьПараметр("Email", "%" + НРег(СокрЛП(Email)) + "%");
			РезКИ = ЗапросКИ.Выполнить();
			Если НЕ РезКИ.Пустой() Тогда
				НовыйКонтрагент = РезКИ.Выгрузить()[0].Контрагент;
			КонецЕсли;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(НовыйКонтрагент) Тогда
			Продолжить; // Не нашли — пропускаем
		КонецЕсли;

		СчётчикИдентифицировано = СчётчикИдентифицировано + 1;

		// 3. Определить группу
		КодТС = Строка(Выборка.ОсновноеТС);
		ДатаДень = НачалоДня(Выборка.Дата);

		Если ЗначениеЗаполнено(КодТС) Тогда
			// Доработка START {SS-6 2026-04-20}: идентификатор контрагента вместо СокрЛП(ссылка) —
			// два юрлица с совпадающим наименованием получали один ключ и смешивались.
			КлючГруппы = КодТС + "|" + Строка(НовыйКонтрагент.УникальныйИдентификатор()) + "|" + Формат(ДатаДень, "ДФ=yyyyMMdd");
			// Доработка END
		Иначе
			КлючГруппы = "SINGLE_" + Выборка.Ссылка.УникальныйИдентификатор();
		КонецЕсли;

		Если ГруппыДляОбъединения[КлючГруппы] = Неопределено Тогда
			Группа = Новый Структура("Контрагент, ТС, Ссылки", НовыйКонтрагент, Выборка.ОсновноеТС, Новый Массив);
			ГруппыДляОбъединения[КлючГруппы] = Группа;
		КонецЕсли;
		ГруппыДляОбъединения[КлючГруппы].Ссылки.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Если СчётчикИдентифицировано = 0 Тогда
		Возврат "Контрагенты не найдены. Добавьте email в КонтактнуюИнформацию контрагентов.";
	КонецЕсли;

	// 4. Обработка групп: объединение + доливание
	СчётчикОбъединено = 0;
	СчётчикДолито = 0;
	СчётчикПомечено = 0;

	Для Каждого КВ Из ГруппыДляОбъединения Цикл
		КлючГруппы = КВ.Ключ;
		Группа = КВ.Значение;
		НовыйКонтрагент = Группа.Контрагент;
		МассивСсылок = Группа.Ссылки;

		// Проверить: есть ли существующий документ с таким ТС+Контрагент+Дата в базе
		// (созданный ранее при загрузке, когда другие операции были идентифицированы)
		ЦелевойДок = Неопределено;

		Если СтрНайти(КлючГруппы, "SINGLE_") = 0 Тогда
			// Групповой ключ — ищем существующий документ
			ЧастиКлюча = СтрРазделить(КлючГруппы, "|");
			ЗапросЦель = Новый Запрос;
			ЗапросЦель.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Док.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ОперацияПоПоручительству КАК Док
			|ГДЕ
			|	Док.Контрагент = &Контрагент
			|	И Док.СтатусОперации <> &СтатусНеИдентифицирован
			|	И НЕ Док.ПометкаУдаления
			|	И Док.ОсновноеТС = &ТС
			|	И Док.Дата >= &НачалоДня
			|	И Док.Дата < &КонецДня";
			ЗапросЦель.УстановитьПараметр("Контрагент", НовыйКонтрагент);
			ЗапросЦель.УстановитьПараметр("СтатусНеИдентифицирован", Перечисления.СтатусыОпераций.НеИдентифицирован);
			ЗапросЦель.УстановитьПараметр("ТС", Группа.ТС);
			ДатаДень = Дата(Лев(ЧастиКлюча[2], 4), Сред(ЧастиКлюча[2], 5, 2), Прав(ЧастиКлюча[2], 2));
			ЗапросЦель.УстановитьПараметр("НачалоДня", ДатаДень);
			ЗапросЦель.УстановитьПараметр("КонецДня", КонецДня(ДатаДень));
			РезЦель = ЗапросЦель.Выполнить();
			Если НЕ РезЦель.Пустой() Тогда
				ЦелевойДок = РезЦель.Выгрузить()[0].Ссылка.ПолучитьОбъект();
			КонецЕсли;
		КонецЕсли;

		// Определить мастер-документ
		Если ЦелевойДок <> Неопределено Тогда
			// ДОЛИВАНИЕ в существующий
			МастерДок = ЦелевойДок;
			ДокументыДляПереноса = МассивСсылок;
		ИначеЕсли МассивСсылок.Количество() = 1 Тогда
			// Единственный — просто назначить контрагента
			МастерДок = МассивСсылок[0].ПолучитьОбъект();
			МастерДок.Контрагент = НовыйКонтрагент;
			Попытка
				МастерДок.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаписьЖурналаРегистрации("АРМ.Пересборка",
					УровеньЖурналаРегистрации.Ошибка,,
					МассивСсылок[0], ОписаниеОшибки());
			КонецПопытки;
			Продолжить;
		Иначе
			// ОБЪЕДИНЕНИЕ: первый = мастер, остальные переносятся
			МастерДок = МассивСсылок[0].ПолучитьОбъект();
			МастерДок.Контрагент = НовыйКонтрагент;
			ДокументыДляПереноса = Новый Массив;
			Для Инд = 1 По МассивСсылок.ВГраница() Цикл
				ДокументыДляПереноса.Добавить(МассивСсылок[Инд]);
			КонецЦикла;
		КонецЕсли;

		// Перенос данных из донорских документов в мастер
		Для Каждого ДонорСсылка Из ДокументыДляПереноса Цикл
			ДонорДок = ДонорСсылка.ПолучитьОбъект();

			// Перенести строки ДанныеДокументов
			Для Каждого СтрДД Из ДонорДок.ДанныеДокументов Цикл
				НоваяДД = МастерДок.ДанныеДокументов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяДД, СтрДД);
			КонецЦикла;

			// Если ДанныеДокументов пуста у донора — создать строку из шапки
			Если ДонорДок.ДанныеДокументов.Количество() = 0 Тогда
				НоваяДД = МастерДок.ДанныеДокументов.Добавить();
				НоваяДД.НомерГТД = ДонорДок.НомерГТД;
				НоваяДД.СуммаОбеспечения = ДонорДок.СуммаОбеспечения;
				НоваяДД.Валюта = ДонорДок.ВалютаОбеспечения;
				НоваяДД.Расстояние = ДонорДок.Расстояние;
				НоваяДД.ПунктОтправления = ДонорДок.ПунктОтправления;
				НоваяДД.ПунктНазначения = ДонорДок.ПунктНазначения;
				НоваяДД.СтатусТранзита = ДонорДок.СтатусТранзита;
				НоваяДД.ДатаОформления = ДонорДок.Дата;
				НоваяДД.УникальныйИдентификатор = ДонорДок.ВнешнийИдентификатор;
			КонецЕсли;

			// Перенести КодыCMR
			Для Каждого СтрCMR Из ДонорДок.КодыCMR Цикл
				НовCMR = МастерДок.КодыCMR.Добавить();
				ЗаполнитьЗначенияСвойств(НовCMR, СтрCMR);
			КонецЦикла;

			// Пометить донора на удаление
			ДонорДок.ПометкаУдаления = Истина;
			Попытка
				ДонорДок.Записать();
				СчётчикПомечено = СчётчикПомечено + 1;
			Исключение
				ЗаписьЖурналаРегистрации("АРМ.Пересборка.ПометкаДонора",
					УровеньЖурналаРегистрации.Ошибка,,
					ДонорСсылка, ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;

		// Записать мастер-документ
		Попытка
			МастерДок.Записать(РежимЗаписиДокумента.Проведение);
			Если ЦелевойДок <> Неопределено Тогда
				СчётчикДолито = СчётчикДолито + 1;
			Иначе
				СчётчикОбъединено = СчётчикОбъединено + 1;
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("АРМ.Пересборка.ЗаписьМастера",
				УровеньЖурналаРегистрации.Ошибка,,
				МастерДок.Ссылка, ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	// 5. Обновить списки
	ЗаполнитьДинамическиеСписки();
	КоличествоВСписках();

	Возврат "Идентифицировано: " + СчётчикИдентифицировано
		+ ", объединено: " + СчётчикОбъединено
		+ ", долито в существующие: " + СчётчикДолито
		+ ", помечено на удаление: " + СчётчикПомечено;

	Исключение
		ЗаписьЖурналаРегистрации("АРМ.Пересборка",
			УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
		Возврат "Ошибка пересборки: " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции
// Доработка END

&НаКлиенте
Процедура ОбновитьОперации(Команда)
	ОбновитьОперацииНаСервере(Команда.Имя);
КонецПроцедуры

&НаСервере
Процедура ОбновитьОперацииНаСервере(Имя)  
	
	//ВсеОперации.Отбор.Элементы.Очистить();
	
	Если Имя = "ТребуетРК" Тогда
		Статус = Перечисления.СтатусыОпераций.ТребуетРучнойКорректировки;
	ИначеЕсли Имя = "НеРасчитан" Тогда	
		Статус = Перечисления.СтатусыОпераций.НеРассчитан;
	ИначеЕсли Имя = "НеИдентифицирован" Тогда	
		Статус = Перечисления.СтатусыОпераций.НеИдентифицирован;
	ИначеЕсли Имя = "Обработан" Тогда	
		Статус = Перечисления.СтатусыОпераций.Обработан;
	ИначеЕсли Имя = "ГотовоКОплате" Тогда	
		Статус = Перечисления.СтатусыОпераций.ГотовоКОплате;
	ИначеЕсли Имя = "Завершен" Тогда	
		Статус = Перечисления.СтатусыОпераций.Завершен;
	ИначеЕсли Имя = "Все" тогда
		ВсеОперации.Отбор.Элементы.Очистить();  
		если объект.Контрагент <> Справочники.Контрагенты.ПустаяСсылка() тогда
			ОтборУточнения = ВсеОперации.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборУточнения.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент");
			ОтборУточнения.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ОтборУточнения.Использование = Истина;
			ОтборУточнения.ПравоеЗначение = объект.Контрагент; 
		КонецЕсли;
		КоличествоВСписках();
		Возврат;
	КонецЕсли;	
	
	ЗаполнитьДинамическиеСписки();
	
	ОтборУточнения = ВсеОперации.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУточнения.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусОперации");
	ОтборУточнения.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборУточнения.Использование = Истина;
	ОтборУточнения.ПравоеЗначение = Статус;
	
	Элементы.ВсеОперации.Обновить();       

    КоличествоВСписках();
	
КонецПроцедуры

Процедура КоличествоВСписках() 
		
	КоличествоОшибок = ПосчитатьКоличествоВСпискеНаСервере(Элементы.СписокОшибочныеОперации);
	Элементы.ВкладкаТребуютУточнения.Заголовок = "Требуют уточнения" + " (" + КоличествоОшибок + ")"; 
	
	КоличествоКРасчету = ПосчитатьКоличествоВСпискеНаСервере(Элементы.СписокОшибокРасчетов);
	Элементы.КРасчету.Заголовок = "К расчету" + " (" + КоличествоКРасчету + ")";  
	
	КоличествоКРасчету = ПосчитатьКоличествоВСпискеНаСервере(Элементы.СписокГотовыхОпераций);
	Элементы.ГотовыКОтправке.Заголовок = "Готовы к отгрузке" + " (" + КоличествоКРасчету + ")";     
	
	КоличествоКРасчету = ПосчитатьКоличествоВСпискеНаСервере(Элементы.ВсеОперации);
	Элементы.ВкладкаВсеОперации.Заголовок = "Все" + " (" + КоличествоКРасчету + ")";
	
КонецПроцедуры	

&НаСервере
Функция ПосчитатьКоличествоВСпискеНаСервере(Список)
	
	Схема = Список.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Список.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = МакетКомпоновки.НаборыДанных.НаборДанныхДинамическогоСписка.Запрос;
	
	ПозВыбратьНачало = СтрНайти(Запрос.Текст, "ВЫБРАТЬ ", НаправлениеПоиска.СКонца);
	Пока НЕ ПозВыбратьНачало = 1
		и НЕ Сред(Запрос.Текст, ПозВыбратьНачало - 1, 1) = Символы.ПС Цикл
		ПозВыбратьНачало = СтрНайти(Запрос.Текст, "ВЫБРАТЬ ", НаправлениеПоиска.СКонца, ПозВыбратьНачало - 1);
	КонецЦикла;
	ПозВыбратьКонец = СтрНайти(Запрос.Текст, Символы.ПС,, ПозВыбратьНачало);
	
	СтрокаВЫБРАТЬ = Лев(Запрос.Текст, ПозВыбратьКонец);
	СтрокаИз = Сред(Запрос.Текст, СтрНайти(Запрос.Текст, Символы.ПС + "ИЗ" + Символы.ПС,, ПозВыбратьКонец));
	
	Если СтрНайти(СтрокаИз, Символы.ПС + "СГРУППИРОВАТЬ") Тогда
		СтрокаИз = Лев(СтрокаИз, СтрНайти(СтрокаИз, Символы.ПС + "СГРУППИРОВАТЬ"));
	КонецЕсли;
	
	Запрос.Текст = СтрокаВЫБРАТЬ + "Количество(*) КАК Кол" + СтрокаИз;
	Если СтрНайти(Запрос.Текст, Символы.ПС + "УПОРЯДОЧИТЬ ПО",, ПозВыбратьКонец) Тогда
		Запрос.Текст = Лев(Запрос.Текст, СтрНайти(Запрос.Текст, Символы.ПС + "УПОРЯДОЧИТЬ ПО",, ПозВыбратьКонец));
	КонецЕсли;
	
	Для Каждого парам из МакетКомпоновки.ЗначенияПараметров Цикл
		Запрос.УстановитьПараметр(парам.Имя, парам.Значение);
	КонецЦикла;
	
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		ЗаписьЖурналаРегистрации("КоличествоВСписке в Списке " + ЭтаФорма.ИмяФормы, УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
	КонецПопытки;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Кол;
КонецФункции

&НаКлиенте
Процедура Расчитать(Команда)
	
	ТекстОшибки = РасчитатьНаСервере();
	
	Если НЕ ТекстОшибки = "" тогда
		Сообщить(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДинамическиеСписки(); 
	КоличествоВСписках();
	
КонецПроцедуры 

&НаСервере
Функция РасчитатьНаСервере()

	ВыдСтроки = Новый Массив;
	Для каждого текВыд из Элементы.СписокОшибокРасчетов.ВыделенныеСтроки цикл
		ВыдСтроки.Добавить(текВыд);
	КонецЦикла;

	ТекстОшибки = "";
	// Доработка START {Perf #1 2026-05-01}: один запрос ВНЕ цикла вместо N запросов внутри
	МапаТарифов = ПолучитьМапуТарифовЗаказчиков(ВыдСтроки);
	// Доработка END
	// Доработка START {SS-8 2026-04-20}: защита от падения всего цикла при ошибке одного документа —
	// ранее ~134 документа «застревали» в статусе ГотовоКОплате без проведения, т.к. первый сбой
	// прерывал обработку оставшихся выделенных строк.
	СчУспех = 0;
	СчОшибок = 0;
	Для каждого стр из ВыдСтроки цикл
		Попытка
			Если ТипЗнч(стр) <> Тип("ДокументСсылка.ОперацияПоПоручительству") Тогда
				Продолжить;
			КонецЕсли;
			Док = стр.ПолучитьОбъект();
			Если Док = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Тариф = ПроверитьТарифыЗаказчика(Док, МапаТарифов);
			Если Тариф Тогда
				исРасчет.ОбновитьЦеныНаСервере(Док);
				Док.Оплата = Док.ОплатыУслуг.Итог("Сумма") + Док.ОплатыУслуг.Итог("СуммаКодов") + Док.ДополнительныеУслуги.Итог("Сумма");
				Если Док.АгентскоеВознаграждениеПроцент <> 0 Тогда
					Док.АгентскоеВознаграждениеСумма = Окр(Док.АгентскоеВознаграждениеПроцент * Док.Оплата / 100, 2);
				КонецЕсли;
				Док.Записать(РежимЗаписиДокумента.Проведение);
				СчУспех = СчУспех + 1;
			Иначе
				ОбщегоНазначения.СообщитьПользователю(
					"У документа № " + Док.Номер
					+ " (" + Формат(Док.Дата, "ДЛФ=DD") + ", " + Строка(Док.Контрагент) + ")"
					+ " не заполнена тарифная сетка.");
				СчОшибок = СчОшибок + 1;
			КонецЕсли;
		Исключение
			СчОшибок = СчОшибок + 1;
			ЗаписьЖурналаРегистрации(
				"АРМ.РасчитатьНаСервере",
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ОперацияПоПоручительству,
				стр,
				ОписаниеОшибки());
			ОбщегоНазначения.СообщитьПользователю(
				"Ошибка расчёта документа " + Строка(стр) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Если СчУспех + СчОшибок > 0 Тогда
		ТекстСводки = "Расчёт завершён: успешно " + СчУспех + ", с ошибками " + СчОшибок + ".";
		Сообщить(ТекстСводки);
	КонецЕсли;
	// Доработка END

	возврат ТекстОшибки;

КонецФункции

// Доработка START {Perf #1: batch-предзагрузка тарифов всех выделенных документов} {2026-05-01}
// Один запрос ИЗ цикла (вместо N запросов внутри). МоментВремени = МАКС(Док.Дата) —
// для проверки наличия тарифа достаточно последнего среза.
// Экспорт — для тестируемости через YAxUnit (на форме обработки, вызов через УникальныйИдентификатор формы).
&НаСервере
Функция ПолучитьМапуТарифовЗаказчиков(ВыдСтроки) Экспорт

	Контрагенты = Новый Массив;
	МаксДата = Дата(1, 1, 1);
	Для Каждого стр Из ВыдСтроки Цикл
		Если ТипЗнч(стр) <> Тип("ДокументСсылка.ОперацияПоПоручительству") Тогда
			Продолжить;
		КонецЕсли;
		Контрагенты.Добавить(стр.Контрагент);
		Если стр.Дата > МаксДата Тогда
			МаксДата = стр.Дата;
		КонецЕсли;
	КонецЦикла;

	Если Контрагенты.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТарифныеСеткиОбеспеченияСрезПоследних.Контрагент КАК Контрагент,
		|	ТарифныеСеткиОбеспеченияСрезПоследних.СпецЦены КАК СпецЦены
		|ИЗ
		|	РегистрСведений.ТарифныеСеткиОбеспечения.СрезПоследних(
		|			&МоментВремени,
		|			Контрагент В (&Контрагенты)) КАК ТарифныеСеткиОбеспеченияСрезПоследних";
	Запрос.УстановитьПараметр("МоментВремени", МаксДата);
	Запрос.УстановитьПараметр("Контрагенты",   Контрагенты);

	Мапа = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = Строка(Выборка.Контрагент.УникальныйИдентификатор()) + "|" + ?(Выборка.СпецЦены, "1", "0");
		Мапа.Вставить(Ключ, Истина);
	КонецЦикла;

	Возврат Мапа;

КонецФункции
// Доработка END

// Доработка {Perf #1 2026-05-01}: lookup в мапе тарифов вместо запроса в цикле.
// Мапа строится 1 запросом до цикла через ПолучитьМапуТарифовЗаказчиков().
// Параметр МапаТарифов обязателен — single-doc запрос убран для устранения EDT query-in-loop.
&НаСервере
Функция ПроверитьТарифыЗаказчика(Док, МапаТарифов)

	Ключ = Строка(Док.Контрагент.УникальныйИдентификатор()) + "|" + ?(Док.СпецЦены, "1", "0");
	Если МапаТарифов.Получить(Ключ) <> Неопределено Тогда
		Возврат Истина;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("У контрагента не заполнена тарифная сетка!");
		Возврат Ложь;
	КонецЕсли;

КонецФункции


&НаКлиенте
Процедура ЗаполнитьКонтрагентовИзВсех(Команда)
	ЗаполнитьКонтрагентаИзВсехНаСервере()
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьКонтрагентаИзВсехНаСервере() 
	
	Если ДобавитьВДокКонтрагента = Справочники.Контрагенты.ПустаяСсылка() тогда 
		ОбщегоНазначения.СообщитьПользователю("Не выбран контрагент для заполнения");
		Возврат;
	КонецЕсли;
	
	Массив = Элементы.ВсеОперации.ВыделенныеСтроки;
	
	ВыдСтроки = Новый Массив;
	Для каждого текВыд из Массив цикл
		ВыдСтроки.Добавить(текВыд);	
	КонецЦикла;	
	
	Для каждого стр из ВыдСтроки цикл
		Попытка
			Док = стр.ПолучитьОбъект();
			Док.Контрагент = ДобавитьВДокКонтрагента;
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗаполнениеКонтрагента",
				УровеньЖурналаРегистрации.Ошибка,
				стр.Метаданные(),
				стр,
				ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьТарифнуюСетку(Команда)

	Если Элементы.СписокОшибокРасчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Контр = ПолучитьКлиентаНаСервере(Элементы.СписокОшибокРасчетов.ВыделенныеСтроки[0]);
	
	Парам = новый Структура();
	Парам.Вставить("Контрагент", Контр);
	
	ОткрытьФорму("Обработка.УстановкаЦенКонтрагентов.Форма.ФормаУпр",Парам,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры 

&НаСервере
Функция ПолучитьКлиентаНаСервере(Док)
	ДокОбъект = Док.ПолучитьОбъект();	
	Возврат ДокОбъект.Контрагент;
КонецФункции	

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ЗаполнитьДинамическиеСписки();
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	Контр = ПроверкаКонтрагента(); 
	
	Если контр = Истина Тогда
		
		ВыделСтроки = Элементы.СписокГотовыхОпераций.ВыделенныеСтроки;         
		ПараметрыОткрытия = новый структура; 
		ПараметрыОткрытия.Вставить("Данные",ВыделСтроки);
		ПараметрыОткрытия.Вставить("Команда", Команда.Имя);  
		ПараметрыОткрытия.Вставить("Контрагент", Объект.Контрагент);  
		
		ОткрытьФорму("Обработка.АРМ.Форма.ВыборРеестров", ПараметрыОткрытия,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе		
		Сообщить("Не заполнен контрагент"); 
	КонецЕсли;    
	
КонецПроцедуры  

&НаСервере
Функция ПроверкаКонтрагента()  
	
	Если Объект.Контрагент <> Справочники.Контрагенты.ПустаяСсылка() тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
		
КонецФункции
#Область РаботаСОтчетами 
&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Режим = РежимДиалогаВыбораФайла.ВыборКаталога;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = Объект.ПутьКФайлу;
	Текст = "ru = ""Текст""; en = ""Text""";
	Фильтр = НСтр(Текст)+"(*.xml)|*.xml";
	//ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите каталог";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		Объект.ПутьКФайлу = ДиалогОткрытияФайла.Каталог;
		ВыбФайл = Новый Файл(Объект.ПутьКФайлу);
		Текст = "ru = ""; Размер = ""; en = ""; Size = """;
	Иначе
		Текст = "ru = ""Файл(ы) не выбран!""; en = ""File(s) not selected!""";
		Сообщить(НСтр(Текст));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)
	
	
	ВыделСтроки = Элементы.СписокГотовыхОпераций.ВыделенныеСтроки;         
	ПараметрыОткрытия = новый структура; 
	ПараметрыОткрытия.Вставить("Данные",ВыделСтроки);
	ПараметрыОткрытия.Вставить("Команда", Команда.Имя);  
	ПараметрыОткрытия.Вставить("Контрагент", Объект.Контрагент);  

	ОткрытьФорму("Обработка.АРМ.Форма.ВыборРеестров",ПараметрыОткрытия,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры   	
	
&НаСервере
Функция СформироватьПечатнуюФормуРеестрыНаСервере()  
	
	Отчет = Отчеты.РеестрОказанныхУслуг.Создать();   
	ТабДокумент = Новый ТабличныйДокумент();   
	
	НастройкиКД = Отчет.КомпоновщикНастроек.ПолучитьНастройки(); 
	
	МассивДокументов = Элементы.СписокГотовыхОпераций.ВыделенныеСтроки; 
		
 	//Отбор по статусам
	ОтборСтатусы = НастройкиКД.Отбор.Элементы.Получить(1);     
	ОтборСтатусы.Использование = Ложь;

	//Отбор по контргенту
	ОтборКонтрагента = НастройкиКД.Отбор.Элементы.Получить(2);     
	Если ОтборКонтрагента = неопределено тогда   
		НовыйОтбор = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		ПолеОтбора = новый ПолеКомпоновкиДанных("Контрагент");
		
		НовыйОтбор.ЛевоеЗначение = ПолеОтбора;
		НовыйОтбор.Использование = Истина;
		НовыйОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		НовыйОтбор.ПравоеЗначение = Объект.Контрагент;
	Иначе	
		ОтборКонтрагента.ПравоеЗначение = Объект.Контрагент;
		ОтборКонтрагента.Использование = Истина;
	КонецЕсли;
	
	// Отбор по договору                   
	
	ОтборДоговор = НастройкиКД.Отбор.Элементы.Получить(0);     
    ОтборДоговор.Использование = Ложь;
	
	// Отбор по документам
	ОтборДокументы = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	ПолеОтбора = новый ПолеКомпоновкиДанных("Документ");  
	
	ОтборДокументы.ЛевоеЗначение = ПолеОтбора;
	ОтборДокументы.Использование = Истина;
	ОтборДокументы.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборДокументы.ПравоеЗначение = МассивДокументов;
	
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКД);
	Отчет.СкомпоноватьРезультат(ТабДокумент);
	
	имя = ПолучитьИмяВременногоФайла("xlsx");
	ТабДокумент.Записать(Имя, ТипФайлаТабличногоДокумента.XLSX);
	
	Возврат ТабДокумент;
	
КонецФункции  

