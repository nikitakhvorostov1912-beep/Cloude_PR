Функция ОрганизацияПоУмолчанию()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК О
	|ГДЕ
	|	НЕ О.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	О.Наименование";
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

// v2: возвращает RUB или, если её нет, первую активную валюту.
// Алиас «В» в запросе — зарезервированное слово 1С (оператор включения),
// заменён на «Вал» (исправление регрессии 2026-05-01).
Функция ВалютаПоУмолчанию()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Вал.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Вал
	|ГДЕ
	|	НЕ Вал.ПометкаУдаления
	|	И Вал.Наименование = ""RUB""";
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].Ссылка;
	КонецЕсли;

	// Fallback: первая активная валюта.
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Вал.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Вал
	|ГДЕ
	|	НЕ Вал.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Вал.Наименование";
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации(
			"РусскийТранзит.ЗагрузкаРееструТД.ВалютаFallback",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"RUB не найдена, использована первая активная валюта: " + Результат[0].Ссылка);
		Возврат Результат[0].Ссылка;
	КонецЕсли;

	Возврат Справочники.Валюты.ПустаяСсылка();

КонецФункции

// v2: универсальный поиск декларанта/перевозчика. Точное совпадение, затем
// fallback по сокращению «Имя Фамилия Отчество» → «Имя Ф.О.».
Функция НайтиИлиПустаяСсылкаДекларанта(ИмяСправочника, Наименование)

	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;

	Очищенное = СокрЛП(Наименование);
	Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Очищенное, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	// Fallback: сокращённая форма.
	Сокр = СокращенноеНаименованиеДекларанта(Очищенное);
	Если Сокр <> Очищенное И ЗначениеЗаполнено(Сокр) Тогда
		Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Сокр, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.НеНайден_" + ИмяСправочника,
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("«%1» не найден в %2 (включая сокращение «%3»)",
			Очищенное, ИмяСправочника, Сокр));
	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

// Текущий пользователь (Справочник.Пользователи) — для Менеджер/Ответственный.
Функция ТекущийПользователь()

	ИмяТекущего = ИмяПользователя();
	Если НЕ ЗначениеЗаполнено(ИмяТекущего) Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	Ссылка = Справочники.Пользователи.НайтиПоНаименованию(ИмяТекущего, Истина);
	Возврат ?(ЗначениеЗаполнено(Ссылка), Ссылка, Справочники.Пользователи.ПустаяСсылка());

КонецФункции

// Batch-предзагрузка соответствий Подразделение→Контрагент. Один запрос вместо N.
Функция ПостроитьМапуПодразделенийКонтрагентов(ТаблицаCSV) Экспорт

	НаборПодразделений = Новый Соответствие;
	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		П = СокрЛП(СтрокаCSV.Подразделение);
		Если ЗначениеЗаполнено(П) Тогда
			НаборПодразделений.Вставить(П, Истина);
		КонецЕсли;
	КонецЦикла;

	Если НаборПодразделений.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Подразделения = Новый Массив;
	Для Каждого Эл Из НаборПодразделений Цикл
		Подразделения.Добавить(Эл.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СоответствияПодразделений.ПодразделениеСигма КАК Подразделение,
		|	СоответствияПодразделений.Контрагент КАК Контрагент
		|ИЗ
		|	РегистрСведений.СоответствияПодразделенийКонтрагентам КАК СоответствияПодразделений
		|ГДЕ
		|	СоответствияПодразделений.ПодразделениеСигма В (&Подразделения)";
	Запрос.УстановитьПараметр("Подразделения", Подразделения);

	Мапа = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Контрагент)
			И Мапа.Получить(Выборка.Подразделение) = Неопределено Тогда
			Мапа.Вставить(Выборка.Подразделение, Выборка.Контрагент);
		КонецЕсли;
	КонецЦикла;

	Возврат Мапа;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Поиск контрагента (приоритет: Email → ИНН → Подразделение)
////////////////////////////////////////////////////////////////////////////////

// v2: точное совпадение email вместо ПОДОБНО %email% (риск false-positive).
// Сначала пробуем = (точно), если не найдено — ' ' + email + ' ' (граница в перечне).
Функция НайтиКонтрагентаПоEmail(EmailДляПоиска)

	Если НЕ ЗначениеЗаполнено(EmailДляПоиска) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;

	// Шаг 1 — Контрагенты.КонтактнаяИнформация (точное).
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НРЕГ(КИ.Представление) = &Email";
	Запрос.УстановитьПараметр("Email", EmailДляПоиска);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
	КонецЕсли;

	// Шаг 2 — Партнёры.КонтактнаяИнформация → Контрагент партнёра.
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКИ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Контрагенты.Партнер = ПартнерыКИ.Ссылка
	|ГДЕ
	|	НРЕГ(ПартнерыКИ.Представление) = &Email";
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
	КонецЕсли;

	// Шаг 3 — fallback: ПОДОБНО с границами (для случаев когда email встроен
	// в перечень через разделитель). Низкая надёжность, последняя попытка.
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НРЕГ(КИ.Представление) ПОДОБНО &EmailВПеречне";
	Запрос.УстановитьПараметр("EmailВПеречне", "% " + EmailДляПоиска + " %");
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
	КонецЕсли;

	// Шаг 4 — JSON-формат БСП 3.1+ (ЗначенияПолей).
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НРЕГ(КИ.ЗначенияПолей) ПОДОБНО &EmailJSON";
	Запрос.УстановитьПараметр("EmailJSON", "%""" + EmailДляПоиска + """%");
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
		КонецЕсли;
	Исключение
		// Поле ЗначенияПолей появилось в БСП 3.1.7. Если нет — игнорируем.
	КонецПопытки;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Поиск контрагента по точному ИНН. ПустаяСсылка если не найден или дубль.
Функция НайтиКонтрагентаПоИНН(ИНН)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИНН", ИНН);

	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() = 1 Тогда
		Возврат Выборка[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Извлекает email между # и # (формат комментариев Сигмы: #user@domain#).
Функция ИзвлечьEmailИзРешёток(Текст) Экспорт

	ПозПервой = СтрНайти(Текст, "#");
	Если ПозПервой = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПозВторой = СтрНайти(Текст, "#",, ПозПервой + 1);
	Если ПозВторой = 0 Тогда
		Возврат "";
	КонецЕсли;

	Фрагмент = СокрЛП(Сред(Текст, ПозПервой + 1, ПозВторой - ПозПервой - 1));
	Если СтрНайти(Фрагмент, "@") > 0 Тогда
		Возврат Фрагмент;
	КонецЕсли;

	Возврат "";

КонецФункции

