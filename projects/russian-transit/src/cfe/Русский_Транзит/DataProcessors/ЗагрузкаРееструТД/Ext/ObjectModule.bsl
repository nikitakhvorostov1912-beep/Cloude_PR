// Нормализация имени колонки CSV: убираем пробелы по краям и приводим к верхнему регистру.
// Используется и при построении карты, и при lookup — чтобы регистр и хвостовые пробелы
// не мешали матчингу.
Функция НормализоватьИмяКолонки(Имя)

	Возврат ВРег(СокрЛП(Имя));

КонецФункции

// Строим карту «нормализованное имя колонки CSV → 0-based индекс в массиве Поля».
// При коллизии имён первое вхождение побеждает. Пустые имена пропускаются.
Функция ПостроитьКартуКолонок(СтрокаЗаголовка)

	Карта = Новый Соответствие;
	ИменаЗаголовков = РазобратьСтрокуCSV(СтрокаЗаголовка);
	Для Индекс = 0 По ИменаЗаголовков.Количество() - 1 Цикл
		Имя = НормализоватьИмяКолонки(ИменаЗаголовков[Индекс]);
		Если ЗначениеЗаполнено(Имя) И Карта.Получить(Имя) = Неопределено Тогда
			Карта.Вставить(Имя, Индекс);
		КонецЕсли;
	КонецЦикла;
	Возврат Карта;

КонецФункции

// Достать значение поля по имени колонки CSV. ИменаКолонок — строка с одним именем
// или несколькими алиасами через "|" (например "Код ТО места назначения|Код ТО назначения").
// Перебираем алиасы по порядку, возвращаем первое совпадение. Если ни одно имя не нашлось
// в карте — возвращаем "" (пустое значение, без исключения).
Функция ПолучитьПолеПоИмени(Поля, КартаКолонок, ИменаКолонок)

	Имена = СтрРазделить(ИменаКолонок, "|", Ложь);
	Для Каждого Имя Из Имена Цикл
		Индекс = КартаКолонок.Получить(НормализоватьИмяКолонки(Имя));
		Если Индекс <> Неопределено Тогда
			Возврат ПолучитьПоле(Поля, Индекс);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Список обязательных колонок CSV. Без них классификация невозможна:
// без РегНомерТД и НомерДДПТД нечего матчить, без ДатыВыпуска нет периода и фильтра в БД.
// Если хоть одна обязательная отсутствует — ПрочитатьCSVФайл падает с понятным сообщением.
Функция НайтиОтсутствующиеОбязательныеКолонки(КартаКолонок)

	Обязательные = Новый Массив;
	Обязательные.Добавить("Подразделение");
	Обязательные.Добавить("Статус процесса");
	Обязательные.Добавить("Регистрационный номер ТД");
	Обязательные.Добавить("Номер ДДП ТД");
	Обязательные.Добавить("Дата выпуска");

	Отсутствующие = Новый Массив;
	Для Каждого Имя Из Обязательные Цикл
		Если КартаКолонок.Получить(НормализоватьИмяКолонки(Имя)) = Неопределено Тогда
			Отсутствующие.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Отсутствующие;

КонецФункции

// Маппинг строки CSV в типизированную таблицу по именам колонок (не индексам).
// КартаКолонок строится в ПрочитатьCSVФайл из заголовка CSV. Если Sigma переименует колонку —
// добавить алиас через "|" (порядок: новое имя | старое имя). Если колонка не найдена —
// ПолучитьПолеПоИмени вернёт "", и значение строки останется пустым (без падения).
Процедура ДобавитьСтрокуВТаблицу(Таблица, Поля, КартаКолонок)

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Подразделение = ПолучитьПолеПоИмени(Поля, КартаКолонок, "Подразделение");
	НоваяСтрока.КоличествоКодовТНВЭД = РазобратьЧисло(ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Количество уникальных кодов ТН ВЭД"));
	НоваяСтрока.НомерДДПТД = СокрЛП(ПолучитьПолеПоИмени(Поля, КартаКолонок, "Номер ДДП ТД"));
	НоваяСтрока.ТС = ПолучитьПолеПоИмени(Поля, КартаКолонок, "Номера ТС");
	НоваяСтрока.СтатусПроцесса = ПолучитьПолеПоИмени(Поля, КартаКолонок, "Статус процесса");
	НоваяСтрока.РегНомерТД = СокрЛП(ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Регистрационный номер ТД"));
	НоваяСтрока.НаименованиеПолучателя = ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Наименование получателя");
	НоваяСтрока.Декларант = ПолучитьПолеПоИмени(Поля, КартаКолонок, "Наименование декларанта");
	НоваяСтрока.Перевозчик = ПолучитьПолеПоИмени(Поля, КартаКолонок, "Наименование перевозчика");
	НоваяСтрока.ДатаВыпуска = РазобратьДату(ПолучитьПолеПоИмени(Поля, КартаКолонок, "Дата выпуска"));
	НоваяСтрока.Комментарий = ПолучитьПолеПоИмени(Поля, КартаКолонок, "Комментарии к документу");
	НоваяСтрока.ИННПолучателя = СокрЛП(ПолучитьПолеПоИмени(Поля, КартаКолонок, "ИНН получателя"));
	НоваяСтрока.НомерТрансДок = СокрЛП(ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Номер трансп. док-та"));
	НоваяСтрока.КодТОНазначения = СокрЛП(ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Код ТО места назначения|Код ТО назначения"));
	НоваяСтрока.НаимТОНазначения = ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Наименование ТО места назначения|Наименование ТО назначения");
	НоваяСтрока.КодТОТД = СокрЛП(ПолучитьПолеПоИмени(Поля, КартаКолонок, "Код ТО ТД"));
	НоваяСтрока.КодВалюты = СокрЛП(ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Код валюты цены договора. Гр 22|Код валюты"));
	НоваяСтрока.СтоимостьТоваров = РазобратьЧисло(ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Общая стоимость товаров. Гр 22|Общая стоимость товаров"));
	НоваяСтрока.РазмерПоручительства = РазобратьЧисло(ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Размер поручительства"));
	НоваяСтрока.ФИОВодителя = ПолучитьПолеПоИмени(Поля, КартаКолонок, "ФИО водителя");
	НоваяСтрока.СрокДоставки = РазобратьДату(ПолучитьПолеПоИмени(Поля, КартаКолонок, "Срок доставки"));
	НоваяСтрока.ДатаЗавершенияТранзита = РазобратьДату(ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Дата завершения транзита"));
	НоваяСтрока.НаимПоручителя = ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"Наименование поручителя (ВН)|Наименование поручителя");
	НоваяСтрока.ИННПоручителя = СокрЛП(ПолучитьПолеПоИмени(Поля, КартаКолонок,
		"ИНН поручителя (ВН)|ИНН поручителя"));

КонецПроцедуры

Функция ПолучитьПоле(Поля, Индекс)

	Если Индекс >= Поля.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Поля[Индекс];

КонецФункции

Функция РазобратьДату(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;

	ЗначениеОчищенное = СокрЛП(Значение);
	Части = СтрРазделить(ЗначениеОчищенное, ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		СтрокаISO = Части[2] + Формат(Число(Части[1]), "ЧЦ=2; ЧВН=; ЧН=0")
			+ Формат(Число(Части[0]), "ЧЦ=2; ЧВН=; ЧН=0");
		Возврат Дата(СтрокаISO);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

Функция РазобратьЧисло(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;

	ЗначениеОчищенное = СокрЛП(Значение);
	ЗначениеОчищенное = СтрЗаменить(ЗначениеОчищенное, ",", ".");
	ЗначениеОчищенное = СтрЗаменить(ЗначениеОчищенное, " ", "");

	Попытка
		Возврат Число(ЗначениеОчищенное);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции


// Помечает КОНКРЕТНУЮ строку ТЧ ДанныеДокументов (по НомерСтрокиТЧ) ТипУчета=Комплекс
// и обогащает данными из CSV (РегНомерТД, ДатаОформления, КоличествоУникальныхКодовТНВЭД).
// Экспорт для unit-тестов (вызывается из цикла ПрименитьКлассификацию).
Функция ОбогатитьСуществующуюСтроку(ПредложенияСтрока, МассивОшибок) Экспорт

	Если НЕ ЗначениеЗаполнено(ПредложенияСтрока.СсылкаДокумент) ИЛИ ПредложенияСтрока.НомерСтрокиТЧ = 0 Тогда
		МассивОшибок.Добавить(СтрШаблон("Комплекс: %1 - нет ссылки на документ или номер строки",
			ПредложенияСтрока.НомерДДПТД));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ОбъектДокумента = ПредложенияСтрока.СсылкаДокумент.ПолучитьОбъект();
		Если ОбъектДокумента = Неопределено Тогда
			МассивОшибок.Добавить(СтрШаблон("Комплекс: документ %1 недоступен",
				ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		Найдена = Ложь;
		Для Каждого СтрокаТЧ Из ОбъектДокумента.ДанныеДокументов Цикл
			Если СтрокаТЧ.НомерСтроки <> ПредложенияСтрока.НомерСтрокиТЧ Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.Комплекс;
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ДатаОформления) И ЗначениеЗаполнено(ПредложенияСтрока.ДатаВыпуска) Тогда
				СтрокаТЧ.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
			КонецЕсли;
			Если ЗначениеЗаполнено(ПредложенияСтрока.КоличествоКодовТНВЭД) Тогда
				СтрокаТЧ.КоличествоУникальныхКодовТНВЭД = ПредложенияСтрока.КоличествоКодовТНВЭД;
			КонецЕсли;
			Найдена = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ Найдена Тогда
			МассивОшибок.Добавить(СтрШаблон("Комплекс: строка ТЧ №%1 не найдена в документе %2",
				ПредложенияСтрока.НомерСтрокиТЧ, ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		// Дозаполнение шапки документа (SPEC v2 §4.1) — ТОЛЬКО пустых полей.
		// Перезапись существующих значений запрещена.
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.Контрагент) И ЗначениеЗаполнено(ПредложенияСтрока.Контрагент) Тогда
			ОбъектДокумента.Контрагент = ПредложенияСтрока.Контрагент;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.ИННКонтрагента) И ЗначениеЗаполнено(ПредложенияСтрока.ИННПолучателя) Тогда
			ОбъектДокумента.ИННКонтрагента = ПредложенияСтрока.ИННПолучателя;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.СтатусТранзита) И ЗначениеЗаполнено(ПредложенияСтрока.СтатусПроцесса) Тогда
			НовыйСтатус = МаппингСтатусаТранзита(ПредложенияСтрока.СтатусПроцесса);
			Если ЗначениеЗаполнено(НовыйСтатус) Тогда
				ОбъектДокумента.СтатусТранзита = НовыйСтатус;
			КонецЕсли;
		КонецЕсли;

		// Доработка START {ОПП-fix #2 2026-05-04}: дозаполнение Декларант/Перевозчик/ОсновноеТС
		// при обогащении существующего документа. Раньше эти поля при «Комплекс»-обогащении
		// не дозаполнялись — Сигма-АПИ часто оставляет их пустыми, а в CSV данные есть.
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.Декларант) И ЗначениеЗаполнено(ПредложенияСтрока.Декларант) Тогда
			ДекларантНайден = НайтиЭлементСFallback("Декларанты", ПредложенияСтрока.Декларант);
			Если ЗначениеЗаполнено(ДекларантНайден) Тогда
				ОбъектДокумента.Декларант = ДекларантНайден;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.Перевозчик) И ЗначениеЗаполнено(ПредложенияСтрока.Перевозчик) Тогда
			ПеревозчикНайден = НайтиЭлементСFallback("Перевозчики", ПредложенияСтрока.Перевозчик);
			Если ЗначениеЗаполнено(ПеревозчикНайден) Тогда
				ОбъектДокумента.Перевозчик = ПеревозчикНайден;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.ОсновноеТС) И ЗначениеЗаполнено(ПредложенияСтрока.ТС) Тогда
			НомерОсновногоТС = ИзвлечьОсновнойНомерТС(ПредложенияСтрока.ТС);
			Если ЗначениеЗаполнено(НомерОсновногоТС) Тогда
				ТСНайдено = НайтиЭлементСFallback("ТранспортныеСредства", НомерОсновногоТС);
				Если ЗначениеЗаполнено(ТСНайдено) Тогда
					ОбъектДокумента.ОсновноеТС = ТСНайдено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// Доработка END

		// Доработка START {ОПП-fix-recalc 2026-05-04}: пересчёт цен после обогащения.
		// Тип учёта строки ТЧ изменён (ТолькоОбеспечение/пусто → Комплекс),
		// сумма документа должна перерасчитаться через тарифы. ОбменДанными.Загрузка
		// отключает ПередЗаписью/ПриЗаписи — поэтому пересчёт делаем явно.
		// Защищаем Попыткой: если расчёт упадёт (нет тарифов, пустые ТО),
		// обогащение не должно откатываться — оператор пересчитает вручную.
		Попытка
			исРасчет.ОбновитьЦеныНаСервере(ОбъектДокумента);
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.Комплекс.ПересчётНеУдался",
				УровеньЖурналаРегистрации.Предупреждение, , ОбъектДокумента.Ссылка,
				ОписаниеОшибки());
		КонецПопытки;
		// Доработка END

		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();

		// Доработка START {ОПП-fix-dedup 2026-05-04}: пометка дублей ТДФайл на удаление.
		// Если этот РегНомерТД ранее был создан как самостоятельный ОПП-ТДФайл
		// (через предыдущую загрузку CSV), то теперь обогащение API-документа делает
		// ТДФайл-дубликатом — ставим пометку удаления, чтобы оператор увидел и почистил.
		Попытка
			ЗапросДубль = Новый Запрос;
			ЗапросДубль.Текст =
			"ВЫБРАТЬ
			|	Дубль.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ОперацияПоПоручительству КАК Дубль
			|ГДЕ
			|	Дубль.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручительства.ТДФайл)
			|	И Дубль.НомерЭТД = &РегНомерТД
			|	И НЕ Дубль.ПометкаУдаления
			|	И Дубль.Ссылка <> &АктуальныйДок";
			ЗапросДубль.УстановитьПараметр("РегНомерТД", ПредложенияСтрока.РегНомерТД);
			ЗапросДубль.УстановитьПараметр("АктуальныйДок", ОбъектДокумента.Ссылка);
			ВыборкаДубль = ЗапросДубль.Выполнить().Выбрать();
			Пока ВыборкаДубль.Следующий() Цикл
				ОбъектДубль = ВыборкаДубль.Ссылка.ПолучитьОбъект();
				Если ОбъектДубль <> Неопределено Тогда
					ОбъектДубль.ПометкаУдаления = Истина;
					ОбъектДубль.Комментарий = СокрЛП(ОбъектДубль.Комментарий)
						+ Символы.ПС + "[Авто-пометка] Дубликат: данные перенесены в "
						+ Строка(ОбъектДокумента.Ссылка);
					ОбъектДубль.ОбменДанными.Загрузка = Истина;
					ОбъектДубль.Записать();
				КонецЕсли;
			КонецЦикла;
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.Комплекс.ПометкаДубляНеУдалась",
				УровеньЖурналаРегистрации.Предупреждение, , ОбъектДокумента.Ссылка,
				ОписаниеОшибки());
		КонецПопытки;
		// Доработка END

		Возврат Истина;
	Исключение
		МассивОшибок.Добавить(СтрШаблон("Комплекс %1: %2",
			ПредложенияСтрока.НомерДДПТД, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Помечает КОНКРЕТНУЮ строку ТЧ ДанныеДокументов (по НомерСтрокиТЧ) ТипУчета=ТолькоОбеспечение.
Функция ПометитьТолькоОбеспечение(ПредложенияСтрока, МассивОшибок)

	Если НЕ ЗначениеЗаполнено(ПредложенияСтрока.СсылкаДокумент) ИЛИ ПредложенияСтрока.НомерСтрокиТЧ = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ОбъектДокумента = ПредложенияСтрока.СсылкаДокумент.ПолучитьОбъект();
		Если ОбъектДокумента = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Найдена = Ложь;
		Для Каждого СтрокаТЧ Из ОбъектДокумента.ДанныеДокументов Цикл
			Если СтрокаТЧ.НомерСтроки <> ПредложенияСтрока.НомерСтрокиТЧ Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоОбеспечение;
			Найдена = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ Найдена Тогда
			МассивОшибок.Добавить(СтрШаблон("ТолькоОбеспечение: строка ТЧ №%1 не найдена в документе %2",
				ПредложенияСтрока.НомерСтрокиТЧ, ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();
		Возврат Истина;
	Исключение
		МассивОшибок.Добавить(СтрШаблон("ТолькоОбеспечение %1: %2",
			ПредложенияСтрока.СсылкаДокумент, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Доработка {Perf #3 2026-05-01}: добавлен обязательный параметр КешРеквизитов
// (Структура с полями Организация, Валюта). Раньше внутри функции вызывались
// ОрганизацияПоУмолчанию() и ВалютаПоУмолчанию() — оба создавали query-in-loop
// при вызове из ПрименитьКлассификацию. Теперь обе предзагружаются один раз
// вне цикла и передаются структурой.
// Экспорт для unit-тестов (вызывается из цикла ПрименитьКлассификацию).
Функция СоздатьНовыйДокументТД(ПредложенияСтрока, МассивОшибок, КешРеквизитов) Экспорт

	// Доработка {P1-fix 2026-05-03}: пустая ДатаВыпуска в CSV → отказ от создания.
	// Раньше брали ТекущаяДатаСеанса() — документ уезжал с текущей датой вместо настоящей,
	// что искажало учёт. Лучше явно отказать и записать ошибку.
	Если НЕ ЗначениеЗаполнено(ПредложенияСтрока.ДатаВыпуска) Тогда
		МассивОшибок.Добавить(СтрШаблон("НоваяТД %1: пустая «Дата выпуска» в CSV — документ не создан. Проверьте строку в Сигме.",
			ПредложенияСтрока.РегНомерТД));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		НовыйДокумент = Документы.ОперацияПоПоручительству.СоздатьДокумент();

		// Базовые реквизиты шапки
		НовыйДокумент.Дата = ПредложенияСтрока.ДатаВыпуска;
		НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийПоручительства.ТДФайл;
		// Доработка START {ОПП-fix #3 2026-05-04}: разделение НомерГТД и НомерЭТД
		// До правки оба поля = РегНомерТД (семантически неверно). ДДП ТД — номер общей
		// декларации поручительства, РегНомерТД — индивидуальный номер транзитной декларации.
		Если ЗначениеЗаполнено(ПредложенияСтрока.НомерДДПТД) Тогда
			НовыйДокумент.НомерГТД = ПредложенияСтрока.НомерДДПТД;
		Иначе
			НовыйДокумент.НомерГТД = ПредложенияСтрока.РегНомерТД;
		КонецЕсли;
		НовыйДокумент.НомерЭТД = ПредложенияСтрока.РегНомерТД;
		// Доработка END
		НовыйДокумент.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
		НовыйДокумент.СуммаОбеспечения = 0;
		НовыйДокумент.СуммаДокумента = 0;
		НовыйДокумент.РазмерПоручительства = 0;
		// Доработка {ОПП-fix-comment 2026-05-04}: убран автокомментарий — оставляем только
		// исходный комментарий из CSV (там лежат email и пометки оператора, не путаем своими).
		НовыйДокумент.Комментарий = ПредложенияСтрока.Комментарий;

		// Обязательные реквизиты (FillChecking=ShowError) — иначе документ не пишется
		НовыйДокумент.Организация = КешРеквизитов.Организация;
		// Доработка {ОПП-fix #6 2026-05-04}: ТребуетРучнойКорректировки вместо НеРассчитан.
		// Часть обязательных реквизитов всё ещё может быть пустой (Контрагент, иногда ОсновноеТС
		// если госномер не в справочнике) — статус показывает что документ ещё не готов.
		НовыйДокумент.СтатусОперации = Перечисления.СтатусыОпераций.ТребуетРучнойКорректировки;
		// Доработка {ОПП-fix-data 2026-05-04}: ВалютаДокумента — из CSV col [42] (USD/EUR/RUB),
		// fallback на КешРеквизитов.Валюта (RUB). ВалютаОбеспечения и ВалютаОплаты — всегда RUB.
		// Обращение к КодВалюты — новое поле, защищаем Попыткой на случай старой ТЧ формы.
		НовыйДокумент.ВалютаОбеспечения = КешРеквизитов.Валюта;
		НовыйДокумент.ВалютаОплаты = КешРеквизитов.Валюта;
		НовыйДокумент.ВалютаДокумента = КешРеквизитов.Валюта;
		Попытка
			НовыйДокумент.ВалютаДокумента = ВалютаПоКоду(ПредложенияСтрока.КодВалюты, КешРеквизитов.Валюта);
		Исключение КонецПопытки;

		// Статус транзита из CSV col #12 (SPEC v2 §4.2). Ставим в шапке —
		// для НоваяТД это всегда инициализация (пустого значения было нет).
		НовыйДокумент.СтатусТранзита = МаппингСтатусаТранзита(ПредложенияСтрока.СтатусПроцесса);

		// Декларант (CSV col #23) и Перевозчик (CSV col #24) — раздельно через справочники
		// с fallback на сокращённое наименование (SPEC v2 §7).
		Если ЗначениеЗаполнено(ПредложенияСтрока.Декларант) Тогда
			НовыйДокумент.Декларант = НайтиЭлементСFallback("Декларанты", ПредложенияСтрока.Декларант);
		КонецЕсли;
		// ВНИМАНИЕ: Перевозчик берётся из отдельной колонки CSV «Наименование перевозчика»,
		// а не из Декларанта. До правки 2026-05-01 был баг — оба поля ставились из Декларанта.
		Если ЗначениеЗаполнено(ПредложенияСтрока.Перевозчик) Тогда
			НовыйДокумент.Перевозчик = НайтиЭлементСFallback("Перевозчики", ПредложенияСтрока.Перевозчик);
		КонецЕсли;

		// Контрагент (если найден) и его ИНН
		Если ЗначениеЗаполнено(ПредложенияСтрока.Контрагент) Тогда
			НовыйДокумент.Контрагент = ПредложенияСтрока.Контрагент;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПредложенияСтрока.ИННПолучателя) Тогда
			НовыйДокумент.ИННКонтрагента = ПредложенияСтрока.ИННПолучателя;
		КонецЕсли;

		// Менеджер / Ответственный = текущий пользователь
		ТекПользователь = ТекущийПользователь();
		Если ЗначениеЗаполнено(ТекПользователь) Тогда
			НовыйДокумент.Менеджер = ТекПользователь;
			НовыйДокумент.Ответственный = ТекПользователь;
		КонецЕсли;

		// Доработка START {ОПП-fix #1 2026-05-04}: ОсновноеТС из CSV col #10 (lookup в справочнике).
		// Раньше поле оставалось пустым → документ не проходил ПроверитьЗаполнениеДокумента
		// и оставался непроведённым черновиком. CSV содержит ТС в формате '1:M367MM32/34ZN2410',
		// извлекаем основной номер через ИзвлечьОсновнойНомерТС() и ищем по справочнику.
		Если ЗначениеЗаполнено(ПредложенияСтрока.ТС) Тогда
			НомерОсновногоТС = ИзвлечьОсновнойНомерТС(ПредложенияСтрока.ТС);
			Если ЗначениеЗаполнено(НомерОсновногоТС) Тогда
				ОсновноеТСНайдено = НайтиЭлементСFallback("ТранспортныеСредства", НомерОсновногоТС);
				Если ЗначениеЗаполнено(ОсновноеТСНайдено) Тогда
					НовыйДокумент.ОсновноеТС = ОсновноеТСНайдено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// Доработка END

		// Доработка START {ОПП-fix-data 2026-05-04}: блок дозаполнения из дополнительных
		// колонок CSV. Каждый sub-блок защищён отдельным Попытка — если один lookup упадёт
		// (например, справочника Водители нет, или реквизита Код у ТаможенныеПункты),
		// остальные поля всё равно заполнятся. До этого фикса один сбой ломал весь документ.

		// CMR (col [10] Номер трансп. док-та) → НомераCMR + КоличествоCMR + ТЧ КодыCMR
		Попытка
			Если ЗначениеЗаполнено(ПредложенияСтрока.НомерТрансДок) Тогда
				НовыйДокумент.НомераCMR = ПредложенияСтрока.НомерТрансДок;
				НовыйДокумент.КоличествоCMR = 1;
				// Доработка {ОПП-fix-cmr 2026-05-04}: заполняем ТЧ КодыCMR одной строкой
				// (по образцу API-загрузки в ЧтениеДеклараций). Цена = СтоимостьТоваров,
				// Валюта = ВалютаДокумента, ЭТД = РегНомерТД.
				ЦМР = НовыйДокумент.КодыCMR.Добавить();
				ЦМР.НомерCMR = ПредложенияСтрока.НомерТрансДок;
				Попытка
					ЦМР.ЭТД = ПредложенияСтрока.РегНомерТД;
				Исключение КонецПопытки;
				Попытка
					ЦМР.Цена = ПредложенияСтрока.СтоимостьТоваров;
				Исключение КонецПопытки;
				Попытка
					ЦМР.Валюта = НовыйДокумент.ВалютаДокумента;
				Исключение КонецПопытки;
				Попытка
					ЦМР.КоличествоКодов = ПредложенияСтрока.КоличествоКодовТНВЭД;
				Исключение КонецПопытки;
			Иначе
				НовыйДокумент.КоличествоCMR = 0;
			КонецЕсли;
		Исключение КонецПопытки;

		// Пункт назначения (col [40] Код ТО назн. + [41] Наим.)
		Попытка
			ПунктНазначения = ТаможенныйПунктПоКоду(
				ПредложенияСтрока.КодТОНазначения, ПредложенияСтрока.НаимТОНазначения);
			Если ЗначениеЗаполнено(ПунктНазначения) Тогда
				НовыйДокумент.ПунктНазначения = ПунктНазначения;
			КонецЕсли;
		Исключение КонецПопытки;

		// Пункт отправления (col [81] Код ТО ТД — где ТД оформлена)
		Попытка
			ПунктОтправления = ТаможенныйПунктПоКоду(ПредложенияСтрока.КодТОТД);
			Если ЗначениеЗаполнено(ПунктОтправления) Тогда
				НовыйДокумент.ПунктОтправления = ПунктОтправления;
			КонецЕсли;
		Исключение КонецПопытки;

		// Доработка {ОПП-fix-distance 2026-05-04}: подтягиваем Расстояние из
		// РегистрСведений.РасстоянияМеждуТаможеннымиПунктами по паре (Отправление, Назначение).
		// В CSV «Отчёт по журналу ЭТД» нет колонки расстояния — в API оно берётся из
		// GCA_TARIFFDISTANCE, но в файле этого поля нет. Поэтому ищем в регистре.
		// Используем JOIN по НАИМЕНОВАНИЮ ТО — справочник ТаможенныеПункты содержит
		// дубли (один ТО = две ссылки: с кодом ФТС и с внутренним кодом 000000XXX),
		// и регистр заполнен преимущественно ссылками с внутренними кодами.
		// Покрытие на текущих данных: 31 из 48 (65%) ОПП с заполненными пунктами.
		Попытка
			Если ЗначениеЗаполнено(НовыйДокумент.ПунктОтправления)
				И ЗначениеЗаполнено(НовыйДокумент.ПунктНазначения) Тогда
				ЗапросРасстояния = Новый Запрос;
				ЗапросРасстояния.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Р.Расстояние КАК Расстояние
				|ИЗ
				|	РегистрСведений.РасстоянияМеждуТаможеннымиПунктами КАК Р
				|ГДЕ
				|	Р.ПунктОтправления.Наименование = &НаимОтпр
				|	И Р.ПунктНазначения.Наименование = &НаимНазн
				|	И Р.Расстояние > 0";
				ЗапросРасстояния.УстановитьПараметр("НаимОтпр",
					НовыйДокумент.ПунктОтправления.Наименование);
				ЗапросРасстояния.УстановитьПараметр("НаимНазн",
					НовыйДокумент.ПунктНазначения.Наименование);
				ВыборкаРасстояния = ЗапросРасстояния.Выполнить().Выбрать();
				Если ВыборкаРасстояния.Следующий() И ВыборкаРасстояния.Расстояние > 0 Тогда
					НовыйДокумент.Расстояние = ВыборкаРасстояния.Расстояние;
					НовыйДокумент.РасстояниеИтог = ВыборкаРасстояния.Расстояние;
				КонецЕсли;
			КонецЕсли;
		Исключение КонецПопытки;

		// Принципал — единственный из справочника (CSV col [64] заполнен в 2.7%).
		Попытка
			Если ЗначениеЗаполнено(КешРеквизитов.Принципал) Тогда
				НовыйДокумент.Принципал = КешРеквизитов.Принципал;
			КонецЕсли;
		Исключение КонецПопытки;

		// Стоимость и размер (col [43] Стоимость товаров, [95] Размер поручительства)
		Попытка
			Если ПредложенияСтрока.СтоимостьТоваров > 0 Тогда
				НовыйДокумент.СуммаДокумента = ПредложенияСтрока.СтоимостьТоваров;
			КонецЕсли;
			Если ПредложенияСтрока.РазмерПоручительства > 0 Тогда
				НовыйДокумент.РазмерПоручительства = ПредложенияСтрока.РазмерПоручительства;
			КонецЕсли;
		Исключение КонецПопытки;

		// Водитель (col [26] ФИО водителя). Если справочника Водители нет — Попытка проглотит.
		Попытка
			Если ЗначениеЗаполнено(ПредложенияСтрока.ФИОВодителя) Тогда
				ВодительНайден = НайтиЭлементСFallback("Водители", ПредложенияСтрока.ФИОВодителя);
				Если ЗначениеЗаполнено(ВодительНайден) Тогда
					НовыйДокумент.Водитель = ВодительНайден;
				КонецЕсли;
			КонецЕсли;
		Исключение КонецПопытки;

		// Сроки транзита и завершения (col [28], [29])
		Попытка
			Если ЗначениеЗаполнено(ПредложенияСтрока.СрокДоставки) Тогда
				НовыйДокумент.СрокТранзита = ПредложенияСтрока.СрокДоставки;
			КонецЕсли;
			Если ЗначениеЗаполнено(ПредложенияСтрока.ДатаЗавершенияТранзита) Тогда
				НовыйДокумент.ДатаЗавершения = ПредложенияСтрока.ДатаЗавершенияТранзита;
			КонецЕсли;
		Исключение КонецПопытки;
		// Доработка END

		// ТЧ ДанныеДокументов — заполняем по образцу API-загрузки (ЧтениеДеклараций.ЗаполнитьИзAPIОперации):
		// Контрагент, Декларант, ПунктыОтправления/Назначения, СуммаОбеспечения, СтатусТранзита,
		// ДатаОформления, КодВалюты. Каждое поле под отдельной Попыткой — если справочник пуст
		// или поле не существует, остальные всё равно заполнятся.
		НоваяСтрокаТЧ = НовыйДокумент.ДанныеДокументов.Добавить();
		НоваяСтрокаТЧ.НомерГТД = ПредложенияСтрока.РегНомерТД;
		НоваяСтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоТД;
		НоваяСтрокаТЧ.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
		НоваяСтрокаТЧ.КоличествоУникальныхКодовТНВЭД = ПредложенияСтрока.КоличествоКодовТНВЭД;
		Попытка
			НоваяСтрокаТЧ.Контрагент = НовыйДокумент.Контрагент;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.Декларант = НовыйДокумент.Декларант;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.ПунктОтправления = НовыйДокумент.ПунктОтправления;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.ПунктНазначения = НовыйДокумент.ПунктНазначения;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.СуммаОбеспечения = НовыйДокумент.РазмерПоручительства;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.Валюта = НовыйДокумент.ВалютаОбеспечения;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.СтатусТранзита = НовыйДокумент.СтатусТранзита;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.СрокТранзита = НовыйДокумент.СрокТранзита;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.ДатаЗавершения = НовыйДокумент.ДатаЗавершения;
		Исключение КонецПопытки;
		// Доработка {ОПП-fix-distance 2026-05-04}: расстояние в ТЧ ДанныеДокументов
		// (по образцу API-загрузки). Берём из шапки — там оно уже подставлено из регистра.
		Попытка
			НоваяСтрокаТЧ.Расстояние = НовыйДокумент.Расстояние;
		Исключение КонецПопытки;

		// ОбменДанными.Загрузка отключает проверки заполнения и обработчики записи —
		// документ создаётся как ЧЕРНОВИК (не проводится). Пользователь дозаполнит
		// недостающее (Контрагент / Декларант) и проведёт вручную.
		НовыйДокумент.ОбменДанными.Загрузка = Истина;
		НовыйДокумент.Записать();
		Возврат Истина;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		МассивОшибок.Добавить(СтрШаблон("НоваяТД %1: %2", ПредложенияСтрока.РегНомерТД, ТекстОшибки));
		// Доработка {Diag 2026-05-04}: дополнительный логгинг полной ошибки в ЖР для диагностики.
		// До этого ошибки накапливались в МассивОшибок и показывались пользователю в форме,
		// но если их 78 — пользователь не дожимал, теряли стектрейс.
		// Логгинг защищён Попыткой — если ТЧ формы старая и нет новых полей,
		// чтобы сам логгинг не упал на обращении к ним.
		Попытка
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.СозданиеНовойТД.Ошибка",
				УровеньЖурналаРегистрации.Ошибка, , ,
				СтрШаблон("РегНомер=%1 ОшибкаПолн=%2",
					ПредложенияСтрока.РегНомерТД, ТекстОшибки));
		Исключение КонецПопытки;
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Возвращает первую активную организацию (используется как дефолт для новых документов).
// Экспорт для unit-тестов.
Функция ОрганизацияПоУмолчанию() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК О
	|ГДЕ
	|	НЕ О.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	О.Наименование";
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

// Возвращает RUB (или первую валюту из справочника, если RUB не найдена).
// Экспорт для unit-тестов.
Функция ВалютаПоУмолчанию() Экспорт

	// Доработка {Bug-fix 2026-05-01}: алиас "В" — зарезервированное слово 1С (оператор включения).
	// Заменён на "Вал" — синтаксическая ошибка обнаружена через YAxUnit-тест после Refactor #3.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Вал.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Вал
	|ГДЕ
	|	НЕ Вал.ПометкаУдаления
	|	И Вал.Наименование = ""RUB""";
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Валюты.ПустаяСсылка();

КонецФункции

// Доработка {ОПП-fix-data 2026-05-04}: lookup валюты по коду из CSV (USD/EUR/RUB/CNY ...).
// Возвращает ссылку или ВалютаПоУмолчанию() если не найдена.
// Экспорт для unit-тестов.
Функция ВалютаПоКоду(КодВалюты, ВалютаДефолт) Экспорт

	Если НЕ ЗначениеЗаполнено(КодВалюты) Тогда
		Возврат ВалютаДефолт;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Вал.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Вал
	|ГДЕ
	|	НЕ Вал.ПометкаУдаления
	|	И Вал.Наименование = &Код";
	Запрос.УстановитьПараметр("Код", СокрЛП(КодВалюты));
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() > 0 Тогда
		Возврат РезультатЗапроса[0].Ссылка;
	КонецЕсли;
	Возврат ВалютаДефолт;

КонецФункции

// Доработка {ОПП-fix-data 2026-05-04}: единственный непомеченный Принципал из справочника.
// Если в справочнике РОВНО 1 непомеченный — авто-подставляем в новые ОПП. Иначе пусто
// (оператор дозаполнит вручную). Бизнес-решение: по факту у Русского Транзита один Принципал
// (РТ-Сервис), поэтому heuristic безопасен.
// Экспорт для unit-тестов.
Функция ПринципалПоУмолчанию() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Прц.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Принципалы КАК Прц
	|ГДЕ
	|	НЕ Прц.ПометкаУдаления";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() = 1 Тогда
		Возврат РезультатЗапроса[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Принципалы.ПустаяСсылка();

КонецФункции

// Доработка {ОПП-fix-data 2026-05-04}: lookup ТаможенногоПункта по коду из CSV (col #40, #81).
// Алгоритм: НайтиПоКоду → fallback на наименование. НайтиПоКоду молча возвращает пусто
// если у справочника тип кода другой или нет такого кода — попыткой ловим преобразования.
// Экспорт для unit-тестов.
Функция ТаможенныйПунктПоКоду(КодТаможни, НаименованиеFallback = "") Экспорт

	Если ЗначениеЗаполнено(КодТаможни) Тогда
		Попытка
			Ссылка = Справочники.ТаможенныеПункты.НайтиПоКоду(СокрЛП(КодТаможни));
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
			// Тип кода не подходит (Число vs Строка) — переходим к fallback.
		КонецПопытки;
	КонецЕсли;

	Если ЗначениеЗаполнено(НаименованиеFallback) Тогда
		Попытка
			Возврат НайтиЭлементСFallback("ТаможенныеПункты", НаименованиеFallback);
		Исключение
			// Справочника нет — пустая ссылка.
		КонецПопытки;
	КонецЕсли;

	Возврат Справочники.ТаможенныеПункты.ПустаяСсылка();

КонецФункции

// Универсальный поиск элемента справочника по точному наименованию.
// При отсутствии или дублях возвращает ПустуюСсылку.
Функция НайтиИлиПустаяСсылка(ИмяСправочника, Наименование)

	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;
	Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(СокрЛП(Наименование), Истина);
	Возврат ?(ЗначениеЗаполнено(Ссылка), Ссылка, Справочники[ИмяСправочника].ПустаяСсылка());

КонецФункции

// Поиск элемента справочника с fallback на сокращённое наименование.
// SPEC v2 §7: точное → сокращение → пусто. Используется для Декларанта и Перевозчика
// (CSV: «ИП СИДОРЕНКОВ ДМИТРИЙ АЛЕКСЕЕВИЧ» → 1С: «ИП СИДОРЕНКОВ Д.А.»).
// НЕ создаёт элементы — только сопоставление.
Функция НайтиЭлементСFallback(ИмяСправочника, Наименование) Экспорт

	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;

	Чистое = СокрЛП(Наименование);

	// Шаг 1: точное совпадение.
	Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Чистое, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	// Шаг 2: пробуем сокращённую форму.
	Сокращённое = СокращенноеНаименованиеДекларанта(Чистое);
	Если ЗначениеЗаполнено(Сокращённое) И Сокращённое <> Чистое Тогда
		Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Сокращённое, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.СопоставлениеСправочника",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("%1: «%2» (сокращённо «%3») не найден — оставлен пустым.",
			ИмяСправочника, Чистое, Сокращённое));

	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

// Преобразует полное ФИО в формат «Фамилия И.О.» для ИП и физлиц.
// Для юрлиц с кавычками — снимает внешние кавычки («"INTEGER" LLC» → «INTEGER LLC»).
// SPEC v2 §7. Экспорт — для тестов T09, T10.
Функция СокращенноеНаименованиеДекларанта(Наименование) Экспорт

	Текст = СокрЛП(Наименование);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	// Юрлица в кавычках: «"INTEGER" LLC» → «INTEGER LLC».
	Если СтрНайти(Текст, """") > 0 Тогда
		Возврат СокрЛП(СтрЗаменить(Текст, """", ""));
	КонецЕсли;

	// ФИО: «ПРЕФИКС ФАМИЛИЯ ИМЯ ОТЧЕСТВО» → «ПРЕФИКС ФАМИЛИЯ И.О.» (для ИП — 4 слова).
	// Также «ФАМИЛИЯ ИМЯ ОТЧЕСТВО» → «ФАМИЛИЯ И.О.» (3 слова).
	Слова = СтрРазделить(Текст, " ", Ложь);
	Если Слова.Количество() >= 4 И ВРег(Слова[0]) = "ИП" Тогда
		Возврат "ИП " + Слова[1] + " " + Лев(Слова[2], 1) + "." + Лев(Слова[3], 1) + ".";
	ИначеЕсли Слова.Количество() = 3 Тогда
		// Эвристика: только если все слова больше 1 символа (иначе уже сокращено).
		Если СтрДлина(Слова[1]) > 1 И СтрДлина(Слова[2]) > 1 Тогда
			Возврат Слова[0] + " " + Лев(Слова[1], 1) + "." + Лев(Слова[2], 1) + ".";
		КонецЕсли;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Текущий пользователь (Справочник.Пользователи) — для Менеджер/Ответственный.
Функция ТекущийПользователь()

	ИмяТекущего = ИмяПользователя();
	Если НЕ ЗначениеЗаполнено(ИмяТекущего) Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	Ссылка = Справочники.Пользователи.НайтиПоНаименованию(ИмяТекущего, Истина);
	Возврат ?(ЗначениеЗаполнено(Ссылка), Ссылка, Справочники.Пользователи.ПустаяСсылка());

КонецФункции

// Доработка {Perf #2 2026-05-01}: batch-предзагрузка соответствий Подразделение→Контрагент.
// Один запрос на все уникальные подразделения в CSV-таблице. Используется в СопоставитьСДокументами
// перед циклом — устраняет N+1 query-in-loop через ВернутьКонтрагента.
// Экспорт — для тестируемости через YAxUnit.
Функция ПостроитьМапуПодразделенийКонтрагентов(ТаблицаCSV) Экспорт

	НаборПодразделений = Новый Соответствие;
	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		П = СокрЛП(СтрокаCSV.Подразделение);
		Если ЗначениеЗаполнено(П) Тогда
			НаборПодразделений.Вставить(П, Истина);
		КонецЕсли;
	КонецЦикла;

	Если НаборПодразделений.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Подразделения = Новый Массив;
	Для Каждого Эл Из НаборПодразделений Цикл
		Подразделения.Добавить(Эл.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СоответствияПодразделений.ПодразделениеСигма КАК Подразделение,
		|	СоответствияПодразделений.Контрагент КАК Контрагент
		|ИЗ
		|	РегистрСведений.СоответствияПодразделенийКонтрагентам КАК СоответствияПодразделений
		|ГДЕ
		|	СоответствияПодразделений.ПодразделениеСигма В (&Подразделения)";
	Запрос.УстановитьПараметр("Подразделения", Подразделения);

	Мапа = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Контрагент) И Мапа.Получить(Выборка.Подразделение) = Неопределено Тогда
			Мапа.Вставить(Выборка.Подразделение, Выборка.Контрагент);
		КонецЕсли;
	КонецЦикла;

	Возврат Мапа;

КонецФункции

// =====================================================================
// Связка контрагента. Приоритет:
//   1) Email из комментария (#email#) → КонтактнаяИнформация контрагента/партнёра
//   2) ИНН получателя → Справочник.Контрагенты.ИНН (точное совпадение)
//   3) Подразделение Сигмы (uso_name) → lookup в МапаПодразделений (batch-предзагружена)
//   4) Не найден → ПустаяСсылка + лог в ЖР для ручной привязки
// Шаги 1, 3 — копия логики APIСигма. Шаг 2 — добавлен для CSV ЭТД, где есть прямой ИНН получателя.
// Доработка {Perf #2 2026-05-01}: запрос шага 3 убран, заменён на lookup в МапаПодразделений.
// Доработка {Perf #5 2026-05-01}: добавлен опциональный КешEmail/КешИНН — Соответствие в роли
// memoization-кеша. При повторном email или ИНН в одном прогоне CSV запрос не выполняется,
// возвращается результат предыдущего поиска. Передаётся вызывающим кодом из СопоставитьСДокументами.
// =====================================================================
Функция ВернутьКонтрагента(Представление, ПодразделениеСигма = "", ИНН = "", МапаПодразделений = Неопределено,
	КешEmail = Неопределено, КешИНН = Неопределено)

	Email = ИзвлечьEmailИзРешёток(Представление);

	Если ЗначениеЗаполнено(Email) Тогда
		EmailДляПоиска = НРег(СокрЛП(Email));
		Контрагент = ПолучитьКонтрагентаПоEmailСКешем(EmailДляПоиска, КешEmail);
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Возврат Контрагент;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИНН) Тогда
		Контрагент = ПолучитьКонтрагентаПоИННСКешем(СокрЛП(ИНН), КешИНН);
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Возврат Контрагент;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПодразделениеСигма) И МапаПодразделений <> Неопределено Тогда
		Контрагент = МапаПодразделений.Получить(СокрЛП(ПодразделениеСигма));
		Если Контрагент <> Неопределено И ЗначениеЗаполнено(Контрагент) Тогда
			Возврат Контрагент;
		КонецЕсли;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("РусскийТранзит.ЗагрузкаРееструТД.КонтрагентНеНайден",
		УровеньЖурналаРегистрации.Предупреждение,,,
		"Email: " + ?(ЗначениеЗаполнено(Email), Email, "<пусто>")
		+ " | ИНН: " + ?(ЗначениеЗаполнено(ИНН), ИНН, "<пусто>")
		+ " | Подразделение: " + ?(ЗначениеЗаполнено(ПодразделениеСигма), ПодразделениеСигма, "<пусто>")
		+ " | Действие: добавьте email в КонтактнуюИнформацию, или ИНН контрагенту, или запись в РС Соответствия подразделений");

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Memoization-обёртка над НайтиКонтрагентаПоEmailВ1С: при повторном email — возврат из кеша.
Функция ПолучитьКонтрагентаПоEmailСКешем(EmailДляПоиска, КешEmail)

	Если ТипЗнч(КешEmail) = Тип("Соответствие") Тогда
		Сохранённый = КешEmail.Получить(EmailДляПоиска);
		Если Сохранённый <> Неопределено Тогда
			Возврат Сохранённый;
		КонецЕсли;
	КонецЕсли;

	Контрагент = НайтиКонтрагентаПоEmailВ1С(EmailДляПоиска);

	Если ТипЗнч(КешEmail) = Тип("Соответствие") Тогда
		КешEmail.Вставить(EmailДляПоиска, Контрагент);
	КонецЕсли;

	Возврат Контрагент;

КонецФункции

// Memoization-обёртка над НайтиКонтрагентаПоИНН: при повторном ИНН — возврат из кеша.
Функция ПолучитьКонтрагентаПоИННСКешем(ИНН, КешИНН)

	Если ТипЗнч(КешИНН) = Тип("Соответствие") Тогда
		Сохранённый = КешИНН.Получить(ИНН);
		Если Сохранённый <> Неопределено Тогда
			Возврат Сохранённый;
		КонецЕсли;
	КонецЕсли;

	Контрагент = НайтиКонтрагентаПоИНН(ИНН);

	Если ТипЗнч(КешИНН) = Тип("Соответствие") Тогда
		КешИНН.Вставить(ИНН, Контрагент);
	КонецЕсли;

	Возврат Контрагент;

КонецФункции

// Поиск контрагента по точному ИНН. Возвращает ПустаяСсылка если не найден или несколько.
Функция НайтиКонтрагентаПоИНН(ИНН)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИНН", ИНН);

	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() = 1 Тогда
		Возврат Выборка[0].Ссылка;
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Поиск контрагента по email из комментария ТД (формат `#user@domain#`).
// SPEC v2 §6: переход с ПОДОБНО %email% на = (точное) — раньше давало false-positive
// когда email встречался как substring (например, поиск user@a.ru находил user@aa.ru).
// JSON-fallback (шаг 3) использует ПОДОБНО потому что email лежит как поле внутри JSON,
// но ограничен жёсткими разделителями («"value":"<email>"») для устранения substring-совпадений.
Функция НайтиКонтрагентаПоEmailВ1С(EmailДляПоиска)

	Запрос = Новый Запрос;

	// 1. Контрагенты.КонтактнаяИнформация.Представление — точное совпадение.
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НРЕГ(КИ.Представление) = &Email";
	Запрос.УстановитьПараметр("Email", EmailДляПоиска);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
	КонецЕсли;

	// 2. Партнёры.КонтактнаяИнформация → Контрагент партнёра — точное совпадение.
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКИ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Контрагенты.Партнер = ПартнерыКИ.Ссылка
	|ГДЕ
	|	НРЕГ(ПартнерыКИ.Представление) = &Email";
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
	КонецЕсли;

	// 3. ЗначенияПолей (JSON-формат БСП 3.1+) — паттерн с разделителями кавычек,
	// иначе ПОДОБНО %email% даёт substring-совпадения.
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НРЕГ(КИ.ЗначенияПолей) ПОДОБНО &Email";
	Запрос.УстановитьПараметр("Email", "%""" + EmailДляПоиска + """%");
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Извлекает email между # и # (формат комментариев Сигмы: #user@domain#).
// Доработка {Header-based mapping 2026-05-07}: устойчивость к крайним случаям.
// СтрНайти(..,, ПозПервой + 1) падал на платформе 8.3.27 если первая # — последний символ
// строки (ПозПервой + 1 > СтрДлина). Перешли на поиск второй # в хвостовой подстроке.
Функция ИзвлечьEmailИзРешёток(Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	ПозПервой = СтрНайти(Текст, "#");
	Если ПозПервой = 0 ИЛИ ПозПервой >= СтрДлина(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, ПозПервой + 1);
	ПозВторойВХвосте = СтрНайти(Хвост, "#");
	Если ПозВторойВХвосте = 0 Тогда
		Возврат "";
	КонецЕсли;

	Фрагмент = СокрЛП(Лев(Хвост, ПозВторойВХвосте - 1));
	Если СтрНайти(Фрагмент, "@") > 0 Тогда
		Возврат Фрагмент;
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#КонецЕсли
