#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Прочитать CSV «Отчёт по журналу ЭТД» (кодировка windows-1251, разделитель ";").
// Возвращает таблицу значений с 51 типизированной колонкой.
//
// Параметры:
//   ПутьКФайлу - Строка - полный путь к CSV
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки соответствуют структуре CSV_STRUCTURE.md
//
Функция ПрочитатьCSVФайл(ПутьКФайлу) Экспорт

	Результат = СоздатьТаблицуCSV();

	Попытка
		// {audit 2026-05-19 MEDIUM #15}: явная кодировка вместо ANSI.
		// На ru-RU Windows ANSI = cp1251, но на сервере с другой локалью ANSI = cp1252 → битые буквы.
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, "windows-1251");
	Исключение
		ЗаписьЖурналаРегистрации(
			"РусскийТранзит.ЗагрузкаРееструТД.ОткрытиеФайла",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон("Не удалось открыть файл «%1»: %2", ПутьКФайлу, ОписаниеОшибки()));
		ВызватьИсключение СтрШаблон("Не удалось открыть файл реестра ТД. Проверьте путь и доступ. Файл: %1", ПутьКФайлу);
	КонецПопытки;

	СтрокаЗаголовка = ЧтениеТекста.ПрочитатьСтроку();
	Если СтрокаЗаголовка = Неопределено Тогда
		ЧтениеТекста.Закрыть();
		ВызватьИсключение "Файл пуст или не удалось прочитать заголовок";
	КонецЕсли;

	// Доработка START {Маппинг по имени колонок 2026-05-15}: формат Сигмы меняется
	// (v1=51, v2=105, v3=121 колонок и т.д.), но имена нужных колонок стабильны.
	// Строим Соответствие "имя колонки" → индекс из заголовка, дальше парсинг по имени.
	ПоляЗаголовка = РазобратьСтрокуCSV(СтрокаЗаголовка);
	ИндексыПолей = ПостроитьИндексыПолейПоИмени(ПоляЗаголовка);

	ОшибкаОтсутствующиеПоля = ПроверитьОбязательныеПоля(ИндексыПолей);
	Если ЗначениеЗаполнено(ОшибкаОтсутствующиеПоля) Тогда
		ЧтениеТекста.Закрыть();
		ВызватьИсключение ОшибкаОтсутствующиеПоля;
	КонецЕсли;
	// Доработка END

	НомерСтроки = 1;
	Накопитель = "";
	Строка = ЧтениеТекста.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		НомерСтроки = НомерСтроки + 1;

		// Многострочные значения в кавычках: если число " в накопленной строке нечётное —
		// читаем дальше пока не наберём чётное (то есть пока кавычка не закрылась).
		Если ЗначениеЗаполнено(Накопитель) Тогда
			Накопитель = Накопитель + Символы.ПС + Строка;
		Иначе
			Если ПустаяСтрока(Строка) Тогда
				Строка = ЧтениеТекста.ПрочитатьСтроку();
				Продолжить;
			КонецЕсли;
			Накопитель = Строка;
		КонецЕсли;

		Если ПодсчитатьКавычки(Накопитель) % 2 <> 0 Тогда
			// Кавычка ещё не закрылась — читаем следующую строку и продолжаем накопление.
			Строка = ЧтениеТекста.ПрочитатьСтроку();
			Продолжить;
		КонецЕсли;

		Попытка
			Поля = РазобратьСтрокуCSV(Накопитель);
			ДобавитьСтрокуВТаблицу(Результат, Поля, ИндексыПолей);
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.Парсер",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				СтрШаблон("Строка %1: %2. Исходная строка: %3", НомерСтроки, ОписаниеОшибки(), Лев(Накопитель, 200)));
		КонецПопытки;

		Накопитель = "";
		Строка = ЧтениеТекста.ПрочитатьСтроку();
	КонецЦикла;

	// Если файл закончился, а кавычка осталась незакрытой — пытаемся разобрать как есть.
	Если ЗначениеЗаполнено(Накопитель) Тогда
		Попытка
			Поля = РазобратьСтрокуCSV(Накопитель);
			ДобавитьСтрокуВТаблицу(Результат, Поля, ИндексыПолей);
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.Парсер",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон("Хвостовая незакрытая кавычка: %1. Лев(200): %2", ОписаниеОшибки(), Лев(Накопитель, 200)));
		КонецПопытки;
	КонецЕсли;

	ЧтениеТекста.Закрыть();

	Возврат Результат;

КонецФункции

// Сопоставить строки CSV «Отчёт по журналу ЭТД» со строками ТЧ ДанныеДокументов наших ОПП.
//
// АЛГОРИТМ V3.1 — CSV-driven 1:1 (одна строка CSV → одно предложение):
//   Шаг 0. Собираем уникальные НомерДДПТД из CSV (только для запроса к БД).
//   Шаг 1. Один запрос ТЧ ДД с НомерГТД В &СписокНомеровДДП → карта DDP→ТЧ.
//   Шаг 2. Для КАЖДОЙ строки CSV (без дедупа):
//          — пустой НомерДДПТД           → НоваяТД (создать ОПП по РегНомеру ТД)
//          — DDP найден в карте          → Комплекс (обогащение существующей ТЧ)
//          — DDP не найден, но матч по ТС+Декларант+Дата → Комплекс (fallback)
//          — DDP не найден совсем        → НоваяТД (создание нового ОПП)
//
// ВАЖНО: дубликаты НомерДДПТД в CSV — это бизнес-кейс «общее ДДП на несколько ТД»
// (одно ДДП покрывает 4..28 разных РегНомеров ТД). Каждая такая строка CSV — отдельная
// ТД, поэтому каждая получает своё предложение. Дедуп по DDP терял 59 разных ТД.
//
// ПОЧЕМУ CSV-driven: в нашей БД АПИСигма автоматически грузит ВСЕ ТД из Сигмы как ОПП
// с ВидОперации=ДДПАвто. За неделю это 1000+ строк ТЧ ДД, тогда как наш CSV «Отчёт по
// журналу ЭТД» (= то что прошло через нашего брокера) содержит ~370 уникальных DDP.
// Старая логика V2 «по строкам ТЧ ДД, не нашли в CSV → ТолькоОбеспечение» давала ~920
// ложноположительных ТолькоОбеспечений (чужие ТД от других брокеров).
//
// ТолькоОбеспечение по этому алгоритму НЕ генерируется автоматически. Поле сохранено
// в реквизитах формы и метод ПометитьТолькоОбеспечение() оставлен для ручного режима.
//
// Параметры:
//   ТаблицаCSV - ТаблицаЗначений - результат ПрочитатьCSVФайл()
//   Метрики    - Структура (out) - заполняется счётчиками для UX формы:
//                 * ДублейВБД        - Число
//                 * КонтрагентыНайдено - Число
//                 * КонтрагентыПусто   - Число
//
// Возвращаемое значение:
//   ТаблицаЗначений - структура как у СоздатьТаблицуПредложений(),
//                     количество строк = количеству строк ТаблицаCSV
//
Функция СопоставитьСДокументами(ТаблицаCSV, Метрики = Неопределено) Экспорт

	Предложения = СоздатьТаблицуПредложений();

	Если ТаблицаCSV.Количество() = 0 Тогда
		Возврат Предложения;
	КонецЕсли;

	ДатаМин = Неопределено;
	ДатаМакс = Неопределено;
	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		Если ЗначениеЗаполнено(СтрокаCSV.ДатаВыпуска) Тогда
			Если ДатаМин = Неопределено ИЛИ СтрокаCSV.ДатаВыпуска < ДатаМин Тогда
				ДатаМин = СтрокаCSV.ДатаВыпуска;
			КонецЕсли;
			Если ДатаМакс = Неопределено ИЛИ СтрокаCSV.ДатаВыпуска > ДатаМакс Тогда
				ДатаМакс = СтрокаCSV.ДатаВыпуска;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Шаг 0: уникальные ключи поиска — НомерДДПТД И РегНомерТД (оба).
	// {audit 2026-05-19 v7}: добавлен РегНомерТД — ОПП, созданные нашей обработкой,
	// имеют в ДД.НомерГТД = РегНомерТД (а не ДДП). Без этого повторная загрузка
	// того же CSV не находила бы свои же записи и снова классифицировала как НоваяТД.
	НаборDDP = Новый Соответствие;
	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		КлючДДП = СокрЛП(СтрокаCSV.НомерДДПТД);
		Если ЗначениеЗаполнено(КлючДДП) Тогда
			НаборDDP.Вставить(КлючДДП, Истина);
		КонецЕсли;
		КлючРег = СокрЛП(СтрокаCSV.РегНомерТД);
		Если ЗначениеЗаполнено(КлючРег) Тогда
			НаборDDP.Вставить(КлючРег, Истина);
		КонецЕсли;
	КонецЦикла;

	МассивНомеров = Новый Массив;
	Для Каждого Эл Из НаборDDP Цикл
		МассивНомеров.Добавить(Эл.Ключ);
	КонецЦикла;

	// Шаг 1: один запрос ТЧ ДД с НомерГТД В &СписокНомеров.
	// Структура-out для КоличествоДублей — счётчик дублей НомерГТД в БД (SPEC v2 §8).
	КоличествоДублей = Новый Структура("Значение", 0);
	КартаПоНомеру = ПостроитьКартуТЧПоНомеруГТД(МассивНомеров, КоличествоДублей);

	// Доработка START {Perf #2 2026-05-01}: batch-предзагрузка соответствий Подразделение→Контрагент
	// (один запрос вместо N в цикле через ВернутьКонтрагента)
	МапаПодразделенийКонтрагентов = ПостроитьМапуПодразделенийКонтрагентов(ТаблицаCSV);
	// Доработка END

	// Доработка {Perf #5 2026-05-01}: memoization-кеш email lookup'ов на время одного прогона CSV.
	// Один email встречается в нескольких строках CSV — повторный запрос не выполняется.
	// {audit 2026-05-19}: поиск по ИНН удалён — ИНН без КПП не идентифицирует уникально
	// (юр.лицо + его обособленные подразделения = разные контрагенты с одним ИНН).
	КешEmailКонтрагентов = Новый Соответствие;

	// Доработка START {Perf #4 2026-05-01}: eager построение карты вторичных признаков ДО цикла
	// (раньше была ленивая инициализация внутри цикла — EDT помечал как query-in-loop).
	// Если ДатаМин/ДатаМакс пустые → пустая карта → fallback на шаге 2 не сработает (тот же эффект,
	// что и при старой ленивой инициализации, где условие сразу было ложным).
	КартаПоТСДекларантДата = Новый Соответствие;
	Если ЗначениеЗаполнено(ДатаМин) И ЗначениеЗаполнено(ДатаМакс) Тогда
		КартаПоТСДекларантДата = ПостроитьКартуТЧПоВторичнымПризнакам(ДатаМин, ДатаМакс, КартаПоНомеру);
	КонецЕсли;
	// Доработка END

	// Шаг 2: итерация по ВСЕМ строкам CSV (без дедупа).
	КолКомплекс = 0;
	КолКомплексFallback = 0;
	КолНоваяТД = 0;
	КолНовыйКомплекс = 0;
	КолНоваяТДПустойDDP = 0;
	КолНестандарт = 0;

	// {audit 2026-05-19}: шаблон формата ТД — один раз перед циклом.
	ШаблонНомераТД = "^\d{8}/\d{6}/\d{7}$";

	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		НоваяСтрока = Предложения.Добавить();
		ЗаполнитьЗначенияСвойствПолей(НоваяСтрока, СтрокаCSV);

		// {audit 2026-05-19 v3}: «НестандартныйФормат» = только когда сам РегНомер невалиден
		// (УИН в Рег.№, мусор). Кривой ДДП при валидном РегНомере — обычная Новая ТД,
		// РегНомер первичен для ОПП.
		РегНомерСтанд = СтрПодобнаПоРегулярномуВыражению(СокрЛП(НоваяСтрока.РегНомерТД), ШаблонНомераТД);
		ДДПСтанд = СтрПодобнаПоРегулярномуВыражению(СокрЛП(НоваяСтрока.НомерДДПТД), ШаблонНомераТД);
		РегНомерНестанд = ЗначениеЗаполнено(НоваяСтрока.РегНомерТД) И НЕ РегНомерСтанд;
		НоваяСтрока.НестандартныйФормат = РегНомерНестанд;

		// {audit 2026-05-19 v2}: нестандартный формат → отдельная категория,
		// галка Выбрать СНЯТА — такие строки не обрабатываются автоматически,
		// пользователь сам решает что делать (часто это шлак типа УИН в РегНомер).
		Если НоваяСтрока.НестандартныйФормат Тогда
			НоваяСтрока.Категория = "НестандартныйФормат";
			НоваяСтрока.Выбрать = Ложь;
			НоваяСтрока.Контрагент = ВернутьКонтрагента(
				СтрокаCSV.Комментарий, СтрокаCSV.Подразделение, СтрокаCSV.ИННПолучателя,
				МапаПодразделенийКонтрагентов, КешEmailКонтрагентов);
			НоваяСтрока.Примечание = "Нестандартный формат номера — проверьте вручную";
			КолНестандарт = КолНестандарт + 1;
			Продолжить;
		КонецЕсли;

		НомерDDP = СокрЛП(СтрокаCSV.НомерДДПТД);
		НомерРег = СокрЛП(СтрокаCSV.РегНомерТД);
		ОбаНомераВалидны = РегНомерСтанд И ДДПСтанд;

		// {audit 2026-05-19 v7}: сначала пробуем матч в БД ВНЕ зависимости от формата —
		// строка с РегНомером валидным и кривым ДДП могла быть создана этой же обработкой
		// в прошлый раз, тогда в ТЧ ДД её НомерГТД = РегНомер. Если в БД нашли — Комплекс.
		// Только если ВСЕ способы матча провалились — определяем НоваяТД/НовыйКомплекс.

		// Шаг 1: точное совпадение по любому из ключей CSV (ДДП или РегНомер).
		НайденнаяТЧ = Неопределено;
		Если ЗначениеЗаполнено(НомерDDP) Тогда
			НайденнаяТЧ = КартаПоНомеру.Получить(НомерDDP);
		КонецЕсли;
		Если НайденнаяТЧ = Неопределено И ЗначениеЗаполнено(НомерРег) Тогда
			НайденнаяТЧ = КартаПоНомеру.Получить(НомерРег);
		КонецЕсли;

		Примечание = "";
		ИсточникМатча = "";
		Если НайденнаяТЧ <> Неопределено Тогда
			ИсточникМатча = "Шаг 1";
		Иначе
			// Шаг 2 fallback: lookup в карте вторичных признаков (построена до цикла).
			Если КартаПоТСДекларантДата.Количество() > 0 Тогда
				НайденнаяТЧ = ПоискПоВторичнымПризнакам(КартаПоТСДекларантДата, СтрокаCSV);
			КонецЕсли;
			Если НайденнаяТЧ <> Неопределено Тогда
				Примечание = "Найдено по ТС+Декларант+Дата (шаг 2)";
				ИсточникМатча = "Шаг 2";
			КонецЕсли;
		КонецЕсли;

		// Не нашли ни в Шаге 1, ни в Шаге 2 — теперь решаем НоваяТД / НовыйКомплекс.
		Если НайденнаяТЧ = Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(НомерDDP) Тогда
				НоваяСтрока.Категория = "НоваяТД";
				НоваяСтрока.Выбрать = Истина;
				НоваяСтрока.Контрагент = ВернутьКонтрагента(
					СтрокаCSV.Комментарий, СтрокаCSV.Подразделение, СтрокаCSV.ИННПолучателя,
					МапаПодразделенийКонтрагентов, КешEmailКонтрагентов);
				НоваяСтрока.Примечание = "Пустой Номер ДДП ТД в CSV — создать ОПП по РегНомеру";
				КолНоваяТДПустойDDP = КолНоваяТДПустойDDP + 1;
				Продолжить;
			ИначеЕсли НЕ ОбаНомераВалидны Тогда
				НоваяСтрока.Категория = "НоваяТД";
				НоваяСтрока.Выбрать = Истина;
				НоваяСтрока.Контрагент = ВернутьКонтрагента(
					СтрокаCSV.Комментарий, СтрокаCSV.Подразделение, СтрокаCSV.ИННПолучателя,
					МапаПодразделенийКонтрагентов, КешEmailКонтрагентов);
				НоваяСтрока.Примечание = "ТД из CSV без пары в базе → создать ОПП ТолькоТД";
				КолНоваяТД = КолНоваяТД + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если НайденнаяТЧ <> Неопределено Тогда
			НоваяСтрока.Категория = "Комплекс";
			НоваяСтрока.Выбрать = Истина;
			НоваяСтрока.СсылкаДокумент = НайденнаяТЧ.Ссылка;
			НоваяСтрока.НомерСтрокиТЧ = НайденнаяТЧ.НомерСтрокиТЧ;
			// Контрагент: приоритет шапки ОПП → вычисленный по email/ИНН/Подразделению.
			// Если в шапке ОПП пусто — предложим вычисленного, при «Применить» он
			// дозаполнится в шапку (SPEC v2 §4.1).
			Если ЗначениеЗаполнено(НайденнаяТЧ.Контрагент) Тогда
				НоваяСтрока.Контрагент = НайденнаяТЧ.Контрагент;
			Иначе
				НоваяСтрока.Контрагент = ВернутьКонтрагента(
					СтрокаCSV.Комментарий, СтрокаCSV.Подразделение, СтрокаCSV.ИННПолучателя,
					МапаПодразделенийКонтрагентов, КешEmailКонтрагентов);
			КонецЕсли;
			НоваяСтрока.Примечание = Примечание;
			Если ИсточникМатча = "Шаг 1" Тогда
				КолКомплекс = КолКомплекс + 1;
			Иначе
				КолКомплексFallback = КолКомплексFallback + 1;
			КонецЕсли;
		Иначе
			// На этом месте ОбаНомераВалидны = Истина (проверено выше в начале итерации).
			// {audit 2026-05-19 HIGH #13}: убран dead-code ветки else с Предложения.Удалить —
			// он был недостижим, т.к. до этого блока невалидные номера ушли в НоваяТД через Продолжить.
			НоваяСтрока.Категория = "НовыйКомплекс";
			НоваяСтрока.Выбрать = Истина;
			НоваяСтрока.Контрагент = ВернутьКонтрагента(
				СтрокаCSV.Комментарий, СтрокаCSV.Подразделение, СтрокаCSV.ИННПолучателя,
				МапаПодразделенийКонтрагентов, КешEmailКонтрагентов);
			НоваяСтрока.Примечание = "ТД из CSV без пары в базе → создать ОПП Комплекс";
			КолНовыйКомплекс = КолНовыйКомплекс + 1;
		КонецЕсли;
	КонецЦикла;

	// Метрики для UX формы (SPEC v2 §9.2): счётчики контрагентов, дублей и нестандартных форматов.
	КонтрагентыНайдено = 0;
	КонтрагентыПусто = 0;
	НестандартныхФорматов = 0;
	Для Каждого СтрокаПредл Из Предложения Цикл
		Если ЗначениеЗаполнено(СтрокаПредл.Контрагент) Тогда
			КонтрагентыНайдено = КонтрагентыНайдено + 1;
		Иначе
			КонтрагентыПусто = КонтрагентыПусто + 1;
		КонецЕсли;
		Если СтрокаПредл.НестандартныйФормат Тогда
			НестандартныхФорматов = НестандартныхФорматов + 1;
		КонецЕсли;
	КонецЦикла;

	Если ТипЗнч(Метрики) = Тип("Структура") Тогда
		Метрики.Вставить("ДублейВБД", КоличествоДублей.Значение);
		Метрики.Вставить("КонтрагентыНайдено", КонтрагентыНайдено);
		Метрики.Вставить("КонтрагентыПусто", КонтрагентыПусто);
		Метрики.Вставить("НестандартныхФорматов", НестандартныхФорматов);
		// SPEC v2 §9.2 — счётчики и период считаем здесь один раз, форма не переобходит таблицу.
		Метрики.Вставить("Комплекс", КолКомплекс + КолКомплексFallback);
		Метрики.Вставить("НовыйКомплекс", КолНовыйКомплекс);
		Метрики.Вставить("НоваяТД", КолНоваяТД + КолНоваяТДПустойDDP);
		Метрики.Вставить("ДатаМин", ДатаМин);
		Метрики.Вставить("ДатаМакс", ДатаМакс);
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаМин) Тогда
		ПериодСтр = Формат(ДатаМин, "ДФ=dd.MM.yyyy") + ".." + Формат(ДатаМакс, "ДФ=dd.MM.yyyy");
	Иначе
		ПериодСтр = "<нет дат>";
	КонецЕсли;
	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.Сопоставление",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Период [%1] CSV=%2 уникDDP=%3 Комплекс(1)=%4 Комплекс(2)=%5 НоваяТД(пустDDP)=%6 НоваяТД(notfound)=%7 Всего=%8 ДублейБД=%9",
			ПериодСтр,
			ТаблицаCSV.Количество(),
			НаборDDP.Количество(),
			КолКомплекс, КолКомплексFallback, КолНоваяТДПустойDDP, КолНоваяТД,
			Предложения.Количество(),
			КоличествоДублей.Значение)
		+ " КонтрагентыНайдено=" + КонтрагентыНайдено + " Пусто=" + КонтрагентыПусто);

	Возврат Предложения;

КонецФункции

// Запрос ТЧ ДД с НомерГТД ∈ список → карта НомерГТД → структура (Ссылка, НомерСтрокиТЧ, Контрагент).
// Если в БД одинаковый НомерГТД встречается несколько раз — берём первое попавшееся ОПП
// (сортировка по ОПП.Дата по возрастанию). Дубли логируются и считаются — пользователь
// увидит счётчик в форме (SPEC v2 §8: «найти проблему чтобы устранить отдельно»).
//
// Параметры:
//   МассивНомеров — Массив строк
//   КоличествоДублей — Структура с полем «Значение» (out-параметр; число найденных дублей)
//
Функция ПостроитьКартуТЧПоНомеруГТД(МассивНомеров, КоличествоДублей = Неопределено)

	Карта = Новый Соответствие;
	Если МассивНомеров.Количество() = 0 Тогда
		Возврат Карта;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОПП.Ссылка КАК Ссылка,
	|	ОПП.Контрагент КАК Контрагент,
	|	ДД.НомерСтроки КАК НомерСтрокиТЧ,
	|	ДД.НомерГТД КАК НомерГТД,
	|	ДД.ДатаОформления КАК ДатаОформления
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК ОПП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОперацияПоПоручительству.ДанныеДокументов КАК ДД
	|		ПО ДД.Ссылка = ОПП.Ссылка
	|ГДЕ
	|	ДД.НомерГТД В (&СписокНомеров)
	|	И НЕ ОПП.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ОПП.Дата";
	Запрос.УстановитьПараметр("СписокНомеров", МассивНомеров);

	Дубли = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = СокрЛП(Выборка.НомерГТД);
		Если Карта.Получить(Ключ) = Неопределено Тогда
			Структура = Новый Структура("Ссылка, НомерСтрокиТЧ, Контрагент, ДатаОформления");
			ЗаполнитьЗначенияСвойств(Структура, Выборка);
			Карта.Вставить(Ключ, Структура);
		Иначе
			Дубли = Дубли + 1;
			ПервыйПопавшийся = Карта.Получить(Ключ);
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.ДубльНомерГТД",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон("НомерГТД=%1: дубль в БД. Использован документ %2 (от %3), пропущен документ %4 (НомерСтроки=%5).",
					Ключ,
					ПервыйПопавшийся.Ссылка,
					Формат(ПервыйПопавшийся.ДатаОформления, "ДФ=dd.MM.yyyy"),
					Выборка.Ссылка,
					Выборка.НомерСтрокиТЧ));
		КонецЕсли;
	КонецЦикла;

	Если ТипЗнч(КоличествоДублей) = Тип("Структура") Тогда
		КоличествоДублей.Значение = Дубли;
	КонецЕсли;

	Возврат Карта;

КонецФункции

// Запрос ТЧ ДД за период CSV → карта (НомерТС|Декларант|ДатаОформления) → структура.
// Используется только для шага 2 fallback. Исключает строки, уже сматченные на шаге 1.
Функция ПостроитьКартуТЧПоВторичнымПризнакам(ДатаНачала, ДатаОкончания, КартаШага1)

	Карта = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОПП.Ссылка КАК Ссылка,
	|	ОПП.Контрагент КАК Контрагент,
	|	ОПП.Декларант.Наименование КАК ДекларантОПП,
	|	ОПП.ОсновноеТС.Наименование КАК ОсновноеТС,
	|	ОПП.ДополнительноеТС.Наименование КАК ДополнительноеТС,
	|	ДД.НомерСтроки КАК НомерСтрокиТЧ,
	|	ДД.НомерГТД КАК НомерГТД,
	|	ДД.ДатаОформления КАК ДатаОформления
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК ОПП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОперацияПоПоручительству.ДанныеДокументов КАК ДД
	|		ПО ДД.Ссылка = ОПП.Ссылка
	|ГДЕ
	|	ДД.ДатаОформления МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ ОПП.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Пропускаем строки, уже захваченные шагом 1.
		Если КартаШага1.Получить(СокрЛП(Выборка.НомерГТД)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Декларант = СокрЛП(Выборка.ДекларантОПП);
		Если НЕ ЗначениеЗаполнено(Декларант) Тогда
			Продолжить;
		КонецЕсли;
		ДатаКлюч = НачалоДня(Выборка.ДатаОформления);
		Если НЕ ЗначениеЗаполнено(ДатаКлюч) Тогда
			Продолжить;
		КонецЕсли;

		НомерОснТС = ИзвлечьОсновнойНомерТС(Выборка.ОсновноеТС);
		НомерДопТС = ИзвлечьОсновнойНомерТС(Выборка.ДополнительноеТС);

		Структура = Новый Структура("Ссылка, НомерСтрокиТЧ, Контрагент, ДатаОформления");
		ЗаполнитьЗначенияСвойств(Структура, Выборка);

		// Доработка {ОПП-fix #7 2026-05-04}: лог при DUP. До правки коллизия по
		// ТС+Декларант+Дата молча отбрасывала обоих кандидатов в матчинге шага 2 — пользователь
		// видел НоваяТД для CSV-строк, у которых в БД на самом деле был парный ОПП. Логируем
		// в ЖР, чтобы можно было отследить и при необходимости разрулить вручную.
		Если ЗначениеЗаполнено(НомерОснТС) Тогда
			Ключ = НомерОснТС + "|" + Декларант + "|" + Формат(ДатаКлюч, "ДФ=yyyyMMdd");
			ЛогироватьDUPЕслиКоллизия(Карта, Ключ, Структура, "Шаг 2 fallback");
		КонецЕсли;
		Если ЗначениеЗаполнено(НомерДопТС) И НомерДопТС <> НомерОснТС Тогда
			Ключ = НомерДопТС + "|" + Декларант + "|" + Формат(ДатаКлюч, "ДФ=yyyyMMdd");
			ЛогироватьDUPЕслиКоллизия(Карта, Ключ, Структура, "Шаг 2 fallback (доп ТС)");
		КонецЕсли;
	КонецЦикла;

	Возврат Карта;

КонецФункции

// Помечает ключ как DUP (если уже был кандидат) и логирует коллизию в журнал регистрации.
// Используется в ПостроитьКартуТЧПоВторичнымПризнакам для шага 2 fallback (ОПП-fix #7).
Процедура ЛогироватьDUPЕслиКоллизия(Карта, Ключ, НовыйКандидат, Контекст)

	Существующее = Карта.Получить(Ключ);
	Если Существующее = Неопределено Тогда
		Карта.Вставить(Ключ, НовыйКандидат);
		Возврат;
	КонецЕсли;

	Карта.Вставить(Ключ, "DUP");

	Если ТипЗнч(Существующее) = Тип("Структура") Тогда
		ПервыйКандидат = Строка(Существующее.Ссылка);
	Иначе
		ПервыйКандидат = "<уже DUP>";
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.DUP",
		УровеньЖурналаРегистрации.Предупреждение, , ,
		СтрШаблон("%1: ключ [%2] коллизия. Кандидаты: %3 и %4 — оба исключены из матчинга.",
			Контекст, Ключ, ПервыйКандидат, Строка(НовыйКандидат.Ссылка)));

КонецПроцедуры

// Поиск по карте (НомерТС|Декларант|Дата) для CSV-строки. Возвращает структуру или Неопределено.
Функция ПоискПоВторичнымПризнакам(КартаПоПризнакам, СтрокаCSV)

	Декларант = СокрЛП(СтрокаCSV.Декларант);
	Если НЕ ЗначениеЗаполнено(Декларант) ИЛИ НЕ ЗначениеЗаполнено(СтрокаCSV.ДатаВыпуска) Тогда
		Возврат Неопределено;
	КонецЕсли;
	НомерТС = ИзвлечьОсновнойНомерТС(СтрокаCSV.ТС);
	Если НЕ ЗначениеЗаполнено(НомерТС) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ключ = НомерТС + "|" + Декларант + "|" + Формат(НачалоДня(СтрокаCSV.ДатаВыпуска), "ДФ=yyyyMMdd");
	Значение = КартаПоПризнакам.Получить(Ключ);
	Если Значение = Неопределено ИЛИ Значение = "DUP" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Копирует поля из строки CSV (или НайденнойCSV) в строку предложения.
Процедура ЗаполнитьЗначенияСвойствПолей(СтрокаПредложения, СтрокаCSV)

	СтрокаПредложения.РегНомерТД = СокрЛП(СтрокаCSV.РегНомерТД);
	СтрокаПредложения.НомерДДПТД = СокрЛП(СтрокаCSV.НомерДДПТД);
	СтрокаПредложения.Подразделение = СтрокаCSV.Подразделение;
	СтрокаПредложения.Декларант = СтрокаCSV.Декларант;
	СтрокаПредложения.ДатаВыпуска = СтрокаCSV.ДатаВыпуска;
	СтрокаПредложения.КоличествоКодовТНВЭД = СтрокаCSV.КоличествоКодовТНВЭД;
	СтрокаПредложения.ИННПолучателя = СтрокаCSV.ИННПолучателя;
	СтрокаПредложения.НаименованиеПолучателя = СтрокаCSV.НаименованиеПолучателя;
	СтрокаПредложения.СтатусПроцесса = СтрокаCSV.СтатусПроцесса;
	СтрокаПредложения.ТС = СтрокаCSV.ТС;
	СтрокаПредложения.Перевозчик = СтрокаCSV.Перевозчик;
	СтрокаПредложения.Комментарий = СтрокаCSV.Комментарий;
	// Доработка {ОПП-fix-data 2026-05-04}: пробрасываем дополнительные CSV-поля.
	СтрокаПредложения.НомерТрансДок = СтрокаCSV.НомерТрансДок;
	СтрокаПредложения.КодТОНазначения = СтрокаCSV.КодТОНазначения;
	СтрокаПредложения.НаимТОНазначения = СтрокаCSV.НаимТОНазначения;
	СтрокаПредложения.КодТОТД = СтрокаCSV.КодТОТД;
	СтрокаПредложения.КодВалюты = СтрокаCSV.КодВалюты;
	СтрокаПредложения.СтоимостьТоваров = СтрокаCSV.СтоимостьТоваров;
	СтрокаПредложения.РазмерПоручительства = СтрокаCSV.РазмерПоручительства;
	СтрокаПредложения.ФИОВодителя = СтрокаCSV.ФИОВодителя;
	СтрокаПредложения.СрокДоставки = СтрокаCSV.СрокДоставки;
	СтрокаПредложения.ДатаЗавершенияТранзита = СтрокаCSV.ДатаЗавершенияТранзита;
	СтрокаПредложения.НаимПоручителя = СтрокаCSV.НаимПоручителя;

КонецПроцедуры

// Маппинг текстовых статусов из CSV «Статус процесса» (col #12) на значения
// перечисления СтатусыТранзита. Покрывает 14 известных значений (живой замер
// 437 строк CSV даёт 2 — «Транзит завершен» и «Выпуск товара» — но синонимы
// учитываем все, чтобы новые выгрузки не падали).
//
// Возвращает Перечисления.СтатусыТранзита.<Имя> или ПустуюСсылку для неизвестного.
// Источник: SPEC v2 §5.
Функция МаппингСтатусаТранзита(СтатусПроцесса) Экспорт

	Текст = НРег(СокрЛП(СтатусПроцесса));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Перечисления.СтатусыТранзита.ПустаяСсылка();
	КонецЕсли;

	Если Текст = "транзит завершен" Тогда
		Возврат Перечисления.СтатусыТранзита.ТранзитЗавершен;
	ИначеЕсли Текст = "транзит завершен с оговорками" Тогда
		Возврат Перечисления.СтатусыТранзита.ТранзитЗавершенСОговорками;
	ИначеЕсли Текст = "выпуск товара" ИЛИ Текст = "товар выпущен" Тогда
		Возврат Перечисления.СтатусыТранзита.ТоварВыпущен;
	ИначеЕсли Текст = "транзит разрешен" Тогда
		Возврат Перечисления.СтатусыТранзита.ТранзитРазрешен;
	ИначеЕсли Текст = "дополнение зарегистрировано" Тогда
		Возврат Перечисления.СтатусыТранзита.ДополнениеЗарегистрировано;
	ИначеЕсли Текст = "дополнение заключено" Тогда
		Возврат Перечисления.СтатусыТранзита.ДополнениеЗаключено;
	ИначеЕсли Текст = "дополнение отправлено" Тогда
		Возврат Перечисления.СтатусыТранзита.ДополнениеОтправлено;
	ИначеЕсли Текст = "средства разрезервированы" Тогда
		Возврат Перечисления.СтатусыТранзита.СредстваРазрезервированы;
	ИначеЕсли Текст = "товар не выпущен" Тогда
		Возврат Перечисления.СтатусыТранзита.ТоварНеВыпущен;
	ИначеЕсли Текст = "аннулировано специалистом" Тогда
		Возврат Перечисления.СтатусыТранзита.АннулированоСпециалистом;
	ИначеЕсли Текст = "в заключении дополнения отказано" Тогда
		Возврат Перечисления.СтатусыТранзита.ВЗаключенииДополненияОтказано;
	ИначеЕсли Текст = "отказано в приеме дополнения" Тогда
		Возврат Перечисления.СтатусыТранзита.ОтказаноВПриемеДополнения;
	ИначеЕсли Текст = "таможенный досмотр" Тогда
		Возврат Перечисления.СтатусыТранзита.ТаможенныйДосмотр;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.МаппингСтатуса",
		УровеньЖурналаРегистрации.Предупреждение, , ,
		СтрШаблон("Неизвестный статус процесса в CSV: «%1». Проверьте маппинг в МаппингСтатусаТранзита().", СтатусПроцесса));

	Возврат Перечисления.СтатусыТранзита.ПустаяСсылка();

КонецФункции

// Извлекает основной номер ТС из формата '1:M367MM32/34ZN2410' → 'M367MM32'.
// Экспорт для unit-тестов YAxUnit. Внутренняя логика (не для прикладного кода).
Функция ИзвлечьОсновнойНомерТС(ТС) Экспорт

	Текст = СокрЛП(ТС);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	ПозДвоеточия = СтрНайти(Текст, ":");
	Если ПозДвоеточия > 0 Тогда
		Текст = Сред(Текст, ПозДвоеточия + 1);
	КонецЕсли;
	ПозСлеша = СтрНайти(Текст, "/");
	Если ПозСлеша > 0 Тогда
		Текст = Лев(Текст, ПозСлеша - 1);
	КонецЕсли;
	Возврат СокрЛП(Текст);

КонецФункции

// Применить предложения: обогатить существующие строки, создать новые документы. Всё в транзакции.
//
// Параметры:
//   ТаблицаПредложений - ТаблицаЗначений - все категории, только строки с Выбрать=Истина обрабатываются
//
// Возвращаемое значение:
//   Структура:
//     * Обогащено - Число
//     * Создано - Число
//     * ПомеченоТолькоОбеспечение - Число (всегда 0, оставлено для совместимости с формой)
//     * Ошибки - Массив
//
Функция ПрименитьКлассификацию(ТаблицаПредложений) Экспорт

	Результат = Новый Структура("Обогащено, НовыйКомплекс, Создано, ПомеченоТолькоОбеспечение, ПропущеноДублей, Дозаполнено, Переквалифицировано, Ошибки", 0, 0, 0, 0, 0, 0, 0, Новый Массив);

	// {audit 2026-05-19 v4}: таблица «что произошло с каждой обработанной строкой» —
	// форма мерджит её обратно в ТЧ ПредложенияКлассификации (не очищая всё подряд).
	ТипДок = Новый ОписаниеТипов("ДокументСсылка.ОперацияПоПоручительству");
	Обновления = Новый ТаблицаЗначений;
	Обновления.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Обновления.Колонки.Добавить("Исход", Новый ОписаниеТипов("Строка"));
	Обновления.Колонки.Добавить("СсылкаДокумент", ТипДок);
	Обновления.Колонки.Добавить("Примечание", Новый ОписаниеТипов("Строка"));
	Результат.Вставить("Обновления", Обновления);

	// Доработка {Perf #3 2026-05-01}: предзагрузка справочных констант ВНЕ цикла.
	// Доработка {ОПП-fix-data 2026-05-04}: добавлен Принципал (единственный непомеченный из
	// справочника) — в CSV колонка "Поручитель ВН" заполнена в 2.7% строк, поэтому fallback
	// на дефолт безопасен.
	КешРеквизитов = Новый Структура("Организация, Валюта, Принципал",
		ОрганизацияПоУмолчанию(), ВалютаПоУмолчанию(), ПринципалПоУмолчанию());

	// {fix-group 2026-05-15}: собираем мин/макс дату обработанных строк — для последующей
	// автогруппировки по ТС+Контрагент+День (как в АПИСигма после Создать документы).
	ДатаГрМин = Неопределено;
	ДатаГрМакс = Неопределено;

	// {audit 2026-05-19 HIGH #5}: батч-предзагрузка карты существующих ОПП по НомерГТД.
	// Раньше в СоздатьНовыйДокументТД на каждую строку CSV выполнялся отдельный запрос
	// проверки дубля → N+1 (437 строк = 437 запросов). Теперь один запрос на все ключи.
	КартаСуществующихПоНомерГТД = ПостроитьКартуСуществующихОПППоНомерГТД(ТаблицаПредложений);

	// Доработка START {ОПП-fix #4 2026-05-04}: построчные транзакции вместо общей.
	// До правки одна ошибка из 437 строк откатывала всю транзакцию (0 обогащено, 0 создано).
	// Теперь каждая строка обрабатывается в собственной транзакции — ошибочные пропускаются,
	// корректные сохраняются. Ошибки накапливаются и выводятся пользователю одним сообщением.
	Индекс = -1;
	Для Каждого Строка Из ТаблицаПредложений Цикл
		Индекс = Индекс + 1;
		Если НЕ Строка.Выбрать Тогда
			Продолжить;
		КонецЕсли;

		Исход = "";
		СсылкаДок = Неопределено;

		НачатьТранзакцию();
		Попытка
			ОбработаноУспешно = Ложь;
			Если Строка.Категория = "Комплекс" Тогда
				ОбработаноУспешно = ОбогатитьСуществующуюСтроку(Строка, Результат.Ошибки);
				Если ОбработаноУспешно Тогда
					Результат.Обогащено = Результат.Обогащено + 1;
					Исход = "Обогащён";
					СсылкаДок = Строка.СсылкаДокумент;
				КонецЕсли;
			ИначеЕсли Строка.Категория = "НоваяТД" ИЛИ Строка.Категория = "НовыйКомплекс" Тогда
				Статус = Новый Структура("Дубль, Дозаполнен, Переквалифицирован, СсылкаНаОПП", Ложь, Ложь, Ложь, Неопределено);
				ОбработаноУспешно = СоздатьНовыйДокументТД(Строка, Результат.Ошибки, КешРеквизитов, Статус, КартаСуществующихПоНомерГТД);
				Если ОбработаноУспешно Тогда
					Если Статус.Переквалифицирован Тогда
						Результат.Переквалифицировано = Результат.Переквалифицировано + 1;
						Исход = "Переквалифицирован";
					ИначеЕсли Статус.Дозаполнен Тогда
						Результат.Дозаполнено = Результат.Дозаполнено + 1;
						Исход = "Дозаполнен";
					ИначеЕсли Строка.Категория = "НоваяТД" Тогда
						Результат.Создано = Результат.Создано + 1;
						Исход = "Создан";
					Иначе
						Результат.НовыйКомплекс = Результат.НовыйКомплекс + 1;
						Исход = "Создан комплекс";
					КонецЕсли;
					СсылкаДок = Статус.СсылкаНаОПП;
				ИначеЕсли Статус.Дубль Тогда
					Результат.ПропущеноДублей = Результат.ПропущеноДублей + 1;
					Исход = "ДубльВБД";
					СсылкаДок = Статус.СсылкаНаОПП;
				КонецЕсли;
			ИначеЕсли Строка.Категория = "ТолькоОбеспечение" Тогда
				ОбработаноУспешно = ПометитьТолькоОбеспечение(Строка, Результат.Ошибки);
				Если ОбработаноУспешно Тогда
					Результат.ПомеченоТолькоОбеспечение = Результат.ПомеченоТолькоОбеспечение + 1;
					Исход = "ТолькоОбеспечение";
					СсылкаДок = Строка.СсылкаДокумент;
				КонецЕсли;
			КонецЕсли;

			Если ОбработаноУспешно Тогда
				ЗафиксироватьТранзакцию();
				// Накапливаем диапазон для последующей группировки
				Если ЗначениеЗаполнено(Строка.ДатаВыпуска) Тогда
					Если ДатаГрМин = Неопределено ИЛИ Строка.ДатаВыпуска < ДатаГрМин Тогда ДатаГрМин = Строка.ДатаВыпуска; КонецЕсли;
					Если ДатаГрМакс = Неопределено ИЛИ Строка.ДатаВыпуска > ДатаГрМакс Тогда ДатаГрМакс = Строка.ДатаВыпуска; КонецЕсли;
				КонецЕсли;
			Иначе
				ОтменитьТранзакцию();
			КонецЕсли;
		Исключение
			ОтменитьТранзакцию();
			Исход = "Ошибка";
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1 (%2): %3",
				Строка.РегНомерТД, Строка.Категория, ОписаниеОшибки()));
		КонецПопытки;

		// {audit 2026-05-19 v4}: фиксируем исход и ссылку — даже если обработка не удалась,
		// чтобы форма пометила строку и сняла галку (повторный клик «Применить» не должен
		// заново её обрабатывать без явного действия пользователя).
		Если ЗначениеЗаполнено(Исход) Тогда
			ОбнСтр = Результат.Обновления.Добавить();
			ОбнСтр.НомерСтроки = Индекс;
			ОбнСтр.Исход = Исход;
			Если СсылкаДок <> Неопределено Тогда
				ОбнСтр.СсылкаДокумент = СсылкаДок;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// Доработка END

	// {audit 2026-05-19 CRIT #2}: авто-склейка ОПП по ТС+Контрагент+Дата отключена.
	// Раньше после Применить автоматически склеивались существующие ОПП за весь период CSV
	// без подтверждения пользователя — это могло объединять документы, которые
	// бизнес-логически склеивать нельзя.
	// Функция СгруппироватьДокументыПоТСКонтрагенту оставлена для ручного вызова
	// (через будущую отдельную команду формы с явным подтверждением).

	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.Применение",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон("Обогащено=%1, Создано=%2, ТолькоОбеспечение=%3, Ошибок=%4",
			Результат.Обогащено, Результат.Создано, Результат.ПомеченоТолькоОбеспечение, Результат.Ошибки.Количество()));

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// {fix-group 2026-05-15}: группировка дубликатов ОПП по ТС+Контрагент+День (логика АПИСигма).
// Документы с одинаковым ТС+Контрагент+Дата(день) объединяются в один Мастер,
// остальные помечаются на удаление. ТЧ ДанныеДокументов и КодыCMR — объединяются.
// Возвращает Структура { Групп: Число (сколько мастеров), Всего: Число (сколько склеилось) }.
Функция СгруппироватьДокументыПоТСКонтрагенту(ДатаНач, ДатаКон) Экспорт

	Результат = Новый Структура("Групп, Всего", 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.ОсновноеТС КАК ТС,
	|	Док.Контрагент КАК Контрагент,
	|	НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) КАК ДатаДень,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) КАК Кол
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &ДН И &ДК
	|	И НЕ Док.ПометкаУдаления
	|	И Док.ОсновноеТС <> ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка)
	|	И Док.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	Док.ОсновноеТС,
	|	Док.Контрагент,
	|	НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ)
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) > 1";
	Запрос.УстановитьПараметр("ДН", ДатаНач);
	Запрос.УстановитьПараметр("ДК", ДатаКон);

	РезГрупп = Запрос.Выполнить();
	Если РезГрупп.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;

	Выборка = РезГрупп.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗапрДок = Новый Запрос;
		ЗапрДок.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Док.Ссылка КАК Ссылка
		|ИЗ Документ.ОперацияПоПоручительству КАК Док
		|ГДЕ Док.ОсновноеТС = &ТС И Док.Контрагент = &Контрагент
		|	И НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) = &ДатаДень
		|	И НЕ Док.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Док.Дата";
		ЗапрДок.УстановитьПараметр("ТС", Выборка.ТС);
		ЗапрДок.УстановитьПараметр("Контрагент", Выборка.Контрагент);
		ЗапрДок.УстановитьПараметр("ДатаДень", Выборка.ДатаДень);

		ТабДоков = ЗапрДок.Выполнить().Выгрузить();
		Если ТабДоков.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		МастерДок = ТабДоков[0].Ссылка.ПолучитьОбъект();
		КодыCMRМастера = МастерДок.КодыCMR.Выгрузить();
		МастерДок.ДанныеДокументов.Очистить();
		МастерДок.КодыCMR.Очистить();

		Для Каждого СтрДок Из ТабДоков Цикл
			ТекДок = СтрДок.Ссылка.ПолучитьОбъект();
			Если ЗначениеЗаполнено(ТекДок.ВнешнийИдентификатор) Тогда
				ИД = ТекДок.ВнешнийИдентификатор;
			Иначе
				ИД = ТекДок.НомерГТД;
			КонецЕсли;

			НоваяДД = МастерДок.ДанныеДокументов.Добавить();
			НоваяДД.НомерГТД = ТекДок.НомерГТД;
			НоваяДД.СуммаОбеспечения = ТекДок.СуммаОбеспечения;
			НоваяДД.Валюта = ТекДок.ВалютаОбеспечения;
			НоваяДД.Расстояние = ТекДок.Расстояние;
			НоваяДД.Контрагент = ТекДок.Контрагент;
			НоваяДД.Декларант = ТекДок.Декларант;
			НоваяДД.Ответственный = ТекДок.Ответственный;
			НоваяДД.ПунктОтправления = ТекДок.ПунктОтправления;
			НоваяДД.ПунктНазначения = ТекДок.ПунктНазначения;
			НоваяДД.СтатусТранзита = ТекДок.СтатусТранзита;
			НоваяДД.ДатаОформления = ТекДок.Дата;
			НоваяДД.ДатаЗавершения = ТекДок.ДатаЗавершения;
			НоваяДД.СрокТранзита = ТекДок.СрокТранзита;
			НоваяДД.УникальныйИдентификатор = ИД;

			// {audit 2026-05-19 v8}: ТипУчета и Количество... из первой строки ТЧ ДД исходного
			// документа — иначе после группировки эти поля становятся пустыми (баг).
			Если ТекДок.ДанныеДокументов.Количество() > 0 Тогда
				ИсхСтрокаТЧ = ТекДок.ДанныеДокументов[0];
				Попытка НоваяДД.ТипУчета = ИсхСтрокаТЧ.ТипУчета; Исключение КонецПопытки;
				Попытка НоваяДД.КоличествоУникальныхКодовТНВЭД = ИсхСтрокаТЧ.КоличествоУникальныхКодовТНВЭД; Исключение КонецПопытки;
			КонецЕсли;

			Если СтрДок.Ссылка = ТабДоков[0].Ссылка Тогда
				ИсточникCMR = КодыCMRМастера;
			Иначе
				ИсточникCMR = ТекДок.КодыCMR;
			КонецЕсли;
			Для Каждого СтрCMR Из ИсточникCMR Цикл
				НовCMR = МастерДок.КодыCMR.Добавить();
				ЗаполнитьЗначенияСвойств(НовCMR, СтрCMR);
				НовCMR.УникальныйИдентификатор = ИД;
			КонецЦикла;

			Если СтрДок.Ссылка <> ТабДоков[0].Ссылка Тогда
				ТекДок.ПометкаУдаления = Истина;
				Попытка ТекДок.Записать(); Исключение КонецПопытки;
			КонецЕсли;
		КонецЦикла;

		Попытка
			МастерДок.Записать();
			Результат.Групп = Результат.Групп + 1;
			Результат.Всего = Результат.Всего + ТабДоков.Количество();
		Исключение
			ЗаписьЖурналаРегистрации("РусскийТранзит.ЗагрузкаРееструТД.ГруппировкаОшибка",
				УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Считает количество символов " в строке (для определения многострочного значения).
Функция ПодсчитатьКавычки(Текст)

	Счётчик = 0;
	Позиция = 1;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина Цикл
		Если Сред(Текст, Позиция, 1) = """" Тогда
			Счётчик = Счётчик + 1;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Счётчик;

КонецФункции

// Разбирает одну строку CSV, учитывая кавычки и экранирование "".
Функция РазобратьСтрокуCSV(Строка)

	Поля = Новый Массив;
	ТекущееПоле = "";
	ВнутриКавычек = Ложь;
	Позиция = 1;
	ДлинаСтроки = СтрДлина(Строка);

	Пока Позиция <= ДлинаСтроки Цикл
		Символ = Сред(Строка, Позиция, 1);

		Если Символ = """" Тогда
			Если Позиция < ДлинаСтроки Тогда
				СледующийСимвол = Сред(Строка, Позиция + 1, 1);
			Иначе
				СледующийСимвол = "";
			КонецЕсли;
			Если ВнутриКавычек И СледующийСимвол = """" Тогда
				ТекущееПоле = ТекущееПоле + """";
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			ВнутриКавычек = НЕ ВнутриКавычек;
		ИначеЕсли Символ = ";" И НЕ ВнутриКавычек Тогда
			Поля.Добавить(ТекущееПоле);
			ТекущееПоле = "";
		Иначе
			ТекущееПоле = ТекущееПоле + Символ;
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Поля.Добавить(ТекущееПоле);
	Возврат Поля;

КонецФункции

