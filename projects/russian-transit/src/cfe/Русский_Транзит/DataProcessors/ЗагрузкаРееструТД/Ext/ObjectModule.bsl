// Парсер CSV «Отчёт по журналу ЭТД» (105 колонок, выгрузка по дате выпуска).
// Индексы привязаны к актуальному формату Sigma на 2026-04-29.
// Если формат изменится — обновить эту таблицу.
Процедура ДобавитьСтрокуВТаблицу(Таблица, Поля)

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Подразделение = ПолучитьПоле(Поля, 1);
	НоваяСтрока.КоличествоКодовТНВЭД = РазобратьЧисло(ПолучитьПоле(Поля, 7));
	НоваяСтрока.НомерДДПТД = СокрЛП(ПолучитьПоле(Поля, 8));
	НоваяСтрока.ТС = ПолучитьПоле(Поля, 10);
	НоваяСтрока.СтатусПроцесса = ПолучитьПоле(Поля, 12);
	НоваяСтрока.РегНомерТД = СокрЛП(ПолучитьПоле(Поля, 14));
	НоваяСтрока.НаименованиеПолучателя = ПолучитьПоле(Поля, 22);
	НоваяСтрока.Декларант = ПолучитьПоле(Поля, 23);
	НоваяСтрока.ДатаВыпуска = РазобратьДату(ПолучитьПоле(Поля, 29));
	НоваяСтрока.Комментарий = ПолучитьПоле(Поля, 84);
	НоваяСтрока.ИННПолучателя = СокрЛП(ПолучитьПоле(Поля, 101));

КонецПроцедуры

Функция ПолучитьПоле(Поля, Индекс)

	Если Индекс >= Поля.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Поля[Индекс];

КонецФункции

Функция РазобратьДату(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;

	ЗначениеОчищенное = СокрЛП(Значение);
	Части = СтрРазделить(ЗначениеОчищенное, ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		СтрокаISO = Части[2] + Формат(Число(Части[1]), "ЧЦ=2; ЧВН=; ЧН=0")
			+ Формат(Число(Части[0]), "ЧЦ=2; ЧВН=; ЧН=0");
		Возврат Дата(СтрокаISO);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

Функция РазобратьЧисло(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;

	ЗначениеОчищенное = СокрЛП(Значение);
	ЗначениеОчищенное = СтрЗаменить(ЗначениеОчищенное, ",", ".");
	ЗначениеОчищенное = СтрЗаменить(ЗначениеОчищенное, " ", "");

	Попытка
		Возврат Число(ЗначениеОчищенное);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции


// Помечает КОНКРЕТНУЮ строку ТЧ ДанныеДокументов (по НомерСтрокиТЧ) ТипУчета=Комплекс
// и обогащает данными из CSV (РегНомерТД, ДатаОформления, КоличествоУникальныхКодовТНВЭД).
Функция ОбогатитьСуществующуюСтроку(ПредложенияСтрока, МассивОшибок)

	Если НЕ ЗначениеЗаполнено(ПредложенияСтрока.СсылкаДокумент) ИЛИ ПредложенияСтрока.НомерСтрокиТЧ = 0 Тогда
		МассивОшибок.Добавить(СтрШаблон("Комплекс: %1 - нет ссылки на документ или номер строки",
			ПредложенияСтрока.НомерДДПТД));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ОбъектДокумента = ПредложенияСтрока.СсылкаДокумент.ПолучитьОбъект();
		Если ОбъектДокумента = Неопределено Тогда
			МассивОшибок.Добавить(СтрШаблон("Комплекс: документ %1 недоступен",
				ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		Найдена = Ложь;
		Для Каждого СтрокаТЧ Из ОбъектДокумента.ДанныеДокументов Цикл
			Если СтрокаТЧ.НомерСтроки <> ПредложенияСтрока.НомерСтрокиТЧ Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.Комплекс;
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ДатаОформления) И ЗначениеЗаполнено(ПредложенияСтрока.ДатаВыпуска) Тогда
				СтрокаТЧ.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
			КонецЕсли;
			Если ЗначениеЗаполнено(ПредложенияСтрока.КоличествоКодовТНВЭД) Тогда
				СтрокаТЧ.КоличествоУникальныхКодовТНВЭД = ПредложенияСтрока.КоличествоКодовТНВЭД;
			КонецЕсли;
			Найдена = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ Найдена Тогда
			МассивОшибок.Добавить(СтрШаблон("Комплекс: строка ТЧ №%1 не найдена в документе %2",
				ПредложенияСтрока.НомерСтрокиТЧ, ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();
		Возврат Истина;
	Исключение
		МассивОшибок.Добавить(СтрШаблон("Комплекс %1: %2",
			ПредложенияСтрока.НомерДДПТД, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Помечает КОНКРЕТНУЮ строку ТЧ ДанныеДокументов (по НомерСтрокиТЧ) ТипУчета=ТолькоОбеспечение.
Функция ПометитьТолькоОбеспечение(ПредложенияСтрока, МассивОшибок)

	Если НЕ ЗначениеЗаполнено(ПредложенияСтрока.СсылкаДокумент) ИЛИ ПредложенияСтрока.НомерСтрокиТЧ = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ОбъектДокумента = ПредложенияСтрока.СсылкаДокумент.ПолучитьОбъект();
		Если ОбъектДокумента = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Найдена = Ложь;
		Для Каждого СтрокаТЧ Из ОбъектДокумента.ДанныеДокументов Цикл
			Если СтрокаТЧ.НомерСтроки <> ПредложенияСтрока.НомерСтрокиТЧ Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоОбеспечение;
			Найдена = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ Найдена Тогда
			МассивОшибок.Добавить(СтрШаблон("ТолькоОбеспечение: строка ТЧ №%1 не найдена в документе %2",
				ПредложенияСтрока.НомерСтрокиТЧ, ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();
		Возврат Истина;
	Исключение
		МассивОшибок.Добавить(СтрШаблон("ТолькоОбеспечение %1: %2",
			ПредложенияСтрока.СсылкаДокумент, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Доработка {Perf #3 2026-05-01}: добавлен обязательный параметр КешРеквизитов
// (Структура с полями Организация, Валюта). Раньше внутри функции вызывались
// ОрганизацияПоУмолчанию() и ВалютаПоУмолчанию() — оба создавали query-in-loop
// при вызове из ПрименитьКлассификацию. Теперь обе предзагружаются один раз
// вне цикла и передаются структурой.
Функция СоздатьНовыйДокументТД(ПредложенияСтрока, МассивОшибок, КешРеквизитов)

	Попытка
		НовыйДокумент = Документы.ОперацияПоПоручительству.СоздатьДокумент();

		// Базовые реквизиты шапки
		НовыйДокумент.Дата = ?(ЗначениеЗаполнено(ПредложенияСтрока.ДатаВыпуска),
			ПредложенияСтрока.ДатаВыпуска, ТекущаяДатаСеанса());
		НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийПоручительства.ТДФайл;
		НовыйДокумент.НомерГТД = ПредложенияСтрока.РегНомерТД;
		НовыйДокумент.НомерЭТД = ПредложенияСтрока.РегНомерТД;
		НовыйДокумент.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
		НовыйДокумент.СуммаОбеспечения = 0;
		НовыйДокумент.СуммаДокумента = 0;
		НовыйДокумент.РазмерПоручительства = 0;
		НовыйДокумент.Комментарий = ПредложенияСтрока.Комментарий;

		// Обязательные реквизиты (FillChecking=ShowError) — иначе документ не пишется
		НовыйДокумент.Организация = КешРеквизитов.Организация;
		НовыйДокумент.СтатусОперации = Перечисления.СтатусыОпераций.НеРассчитан;
		НовыйДокумент.ВалютаОбеспечения = КешРеквизитов.Валюта;
		НовыйДокумент.ВалютаДокумента = НовыйДокумент.ВалютаОбеспечения;
		НовыйДокумент.ВалютаОплаты = НовыйДокумент.ВалютаОбеспечения;

		// Декларант / Перевозчик — пытаемся найти по наименованию из CSV
		Если ЗначениеЗаполнено(ПредложенияСтрока.Декларант) Тогда
			НовыйДокумент.Декларант = НайтиИлиПустаяСсылка("Декларанты", ПредложенияСтрока.Декларант);
			НовыйДокумент.Перевозчик = НайтиИлиПустаяСсылка("Перевозчики", ПредложенияСтрока.Декларант);
		КонецЕсли;

		// Контрагент (если найден) и его ИНН
		Если ЗначениеЗаполнено(ПредложенияСтрока.Контрагент) Тогда
			НовыйДокумент.Контрагент = ПредложенияСтрока.Контрагент;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПредложенияСтрока.ИННПолучателя) Тогда
			НовыйДокумент.ИННКонтрагента = ПредложенияСтрока.ИННПолучателя;
		КонецЕсли;

		// Менеджер / Ответственный = текущий пользователь
		ТекПользователь = ТекущийПользователь();
		Если ЗначениеЗаполнено(ТекПользователь) Тогда
			НовыйДокумент.Менеджер = ТекПользователь;
			НовыйДокумент.Ответственный = ТекПользователь;
		КонецЕсли;

		// ТЧ ДанныеДокументов
		НоваяСтрокаТЧ = НовыйДокумент.ДанныеДокументов.Добавить();
		НоваяСтрокаТЧ.НомерГТД = ПредложенияСтрока.РегНомерТД;
		НоваяСтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоТД;
		НоваяСтрокаТЧ.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
		НоваяСтрокаТЧ.КоличествоУникальныхКодовТНВЭД = ПредложенияСтрока.КоличествоКодовТНВЭД;

		// ОбменДанными.Загрузка отключает проверки заполнения и обработчики записи —
		// документ создаётся как ЧЕРНОВИК (не проводится). Пользователь дозаполнит
		// недостающее (Контрагент / Декларант) и проведёт вручную.
		НовыйДокумент.ОбменДанными.Загрузка = Истина;
		НовыйДокумент.Записать();
		Возврат Истина;
	Исключение
		МассивОшибок.Добавить(СтрШаблон("НоваяТД %1: %2", ПредложенияСтрока.РегНомерТД, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Возвращает первую активную организацию (используется как дефолт для новых документов).
Функция ОрганизацияПоУмолчанию()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК О
	|ГДЕ
	|	НЕ О.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	О.Наименование";
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

