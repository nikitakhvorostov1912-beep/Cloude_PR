#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// Обработка «Загрузка реестра ТД» — серверная логика. Версия v2 (2026-05-01).
//
// НАЗНАЧЕНИЕ
//   Сравнивает выгрузку «Отчёт по журналу ЭТД» из Сигмы (CSV, 105 колонок,
//   cp1251) с документами «Операция по поручительству» в 1С и:
//     1. Помечает существующие документы как «Комплекс» (мы оформляли и
//        обеспечение, и ТД) — обогащает строки ТЧ ДанныеДокументов.
//     2. Создаёт новые документы «Только ТД» для тех ТД, которых ещё нет
//        в 1С (мы оформляли только декларацию, обеспечение давал другой).
//
// АЛГОРИТМ V3.1 (CSV-driven 1:1)
//   Каждая строка CSV → одно предложение классификации (без дедупликации).
//   Подробности — см. docs/requirements/td-spec-v2/SPEC.md.
//
// ИЗМЕНЕНИЯ v2 относительно v1
//   • Маппинг СтатусПроцесса (CSV) → СтатусТранзита (1С) — новый.
//   • Дозаполнение Контрагента/ИНН/Статуса в шапке Комплекс-документов.
//   • Email-поиск через ТОЧНОЕ совпадение (вместо ПОДОБНО %x%).
//   • Декларант — fallback по сокращённой форме «Имя Фамилия» → «Имя Ф.».
//   • Валюта по умолчанию — RUB → fallback на первую активную.
//   • Логирование дублей НомерГТД в БД.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Прочитать CSV «Отчёт по журналу ЭТД» (cp1251, разделитель «;»).
// Возвращает таблицу значений с типизированными колонками.
//
// Параметры:
//   ПутьКФайлу — Строка — полный путь к CSV.
//
// Возвращаемое значение:
//   ТаблицаЗначений с 11 колонками (см. СоздатьТаблицуCSV).
//
Функция ПрочитатьCSVФайл(ПутьКФайлу) Экспорт

	Результат = СоздатьТаблицуCSV();

	Попытка
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.ANSI);
	Исключение
		ЗаписьЖурналаРегистрации(
			"РусскийТранзит.ЗагрузкаРееструТД.ОткрытиеФайла",
			УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон("Не удалось открыть «%1»: %2", ПутьКФайлу, ОписаниеОшибки()));
		ВызватьИсключение СтрШаблон(
			"Не удалось открыть файл реестра ТД. Проверьте путь и доступ. Файл: %1",
			ПутьКФайлу);
	КонецПопытки;

	СтрокаЗаголовка = ЧтениеТекста.ПрочитатьСтроку();
	Если СтрокаЗаголовка = Неопределено Тогда
		ЧтениеТекста.Закрыть();
		ВызватьИсключение "Файл пуст или не удалось прочитать заголовок";
	КонецЕсли;

	КоличествоКолонок = РазобратьСтрокуCSV(СтрокаЗаголовка).Количество();
	Если КоличествоКолонок < 102 Тогда
		ЧтениеТекста.Закрыть();
		ВызватьИсключение СтрШаблон(
			"Неподдерживаемый формат CSV: %1 колонок (ожидалось 105). "
			+ "Используйте свежую выгрузку «Отчёт по журналу ЭТД» из Сигмы по дате выпуска.",
			КоличествоКолонок);
	КонецЕсли;

	НомерСтроки = 1;
	Накопитель = "";
	Строка = ЧтениеТекста.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		НомерСтроки = НомерСтроки + 1;

		// Многострочные значения в кавычках: накапливаем до закрытия кавычки.
		Если ЗначениеЗаполнено(Накопитель) Тогда
			Накопитель = Накопитель + Символы.ПС + Строка;
		Иначе
			Если ПустаяСтрока(Строка) Тогда
				Строка = ЧтениеТекста.ПрочитатьСтроку();
				Продолжить;
			КонецЕсли;
			Накопитель = Строка;
		КонецЕсли;

		Если ПодсчитатьКавычки(Накопитель) % 2 <> 0 Тогда
			Строка = ЧтениеТекста.ПрочитатьСтроку();
			Продолжить;
		КонецЕсли;

		Попытка
			Поля = РазобратьСтрокуCSV(Накопитель);
			ДобавитьСтрокуВТаблицу(Результат, Поля);
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.Парсер",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон("Строка %1: %2. Лев(200): %3",
					НомерСтроки, ОписаниеОшибки(), Лев(Накопитель, 200)));
		КонецПопытки;

		Накопитель = "";
		Строка = ЧтениеТекста.ПрочитатьСтроку();
	КонецЦикла;

	// Хвост — незакрытая кавычка в конце файла: парсим как есть.
	Если ЗначениеЗаполнено(Накопитель) Тогда
		Попытка
			Поля = РазобратьСтрокуCSV(Накопитель);
			ДобавитьСтрокуВТаблицу(Результат, Поля);
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.Парсер",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон("Хвост незакрытой кавычки: %1. Лев(200): %2",
					ОписаниеОшибки(), Лев(Накопитель, 200)));
		КонецПопытки;
	КонецЕсли;

	ЧтениеТекста.Закрыть();
	Возврат Результат;

КонецФункции

// Сопоставить строки CSV со строками ТЧ ДанныеДокументов существующих ОПП.
//
// Возвращает таблицу предложений с категорией и кандидатом на действие
// для каждой строки CSV (см. СоздатьТаблицуПредложений).
//
// V3.1 алгоритм: каждая строка CSV → одно предложение, без дедупликации.
//
// Возвращаемое значение:
//   ТаблицаЗначений с реквизитом ДополнительнаяИнформация (Структура) для UI.
//
Функция СопоставитьСДокументами(ТаблицаCSV) Экспорт

	Предложения = СоздатьТаблицуПредложений();

	Если ТаблицаCSV.Количество() = 0 Тогда
		Возврат Предложения;
	КонецЕсли;

	// Минимум/максимум дат CSV — границы для запроса вторичных признаков.
	ДатаМин = Неопределено;
	ДатаМакс = Неопределено;
	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		Если ЗначениеЗаполнено(СтрокаCSV.ДатаВыпуска) Тогда
			Если ДатаМин = Неопределено ИЛИ СтрокаCSV.ДатаВыпуска < ДатаМин Тогда
				ДатаМин = СтрокаCSV.ДатаВыпуска;
			КонецЕсли;
			Если ДатаМакс = Неопределено ИЛИ СтрокаCSV.ДатаВыпуска > ДатаМакс Тогда
				ДатаМакс = СтрокаCSV.ДатаВыпуска;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Уникальные DDP из CSV — для запроса к БД (только в этом запросе).
	НаборDDP = Новый Соответствие;
	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		Ключ = СокрЛП(СтрокаCSV.НомерДДПТД);
		Если ЗначениеЗаполнено(Ключ) Тогда
			НаборDDP.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	МассивНомеров = Новый Массив;
	Для Каждого Эл Из НаборDDP Цикл
		МассивНомеров.Добавить(Эл.Ключ);
	КонецЦикла;

	// Шаг 1: один запрос ТЧ ДД с НомерГТД В &СписокНомеров.
	КартаПоНомеру = Новый Структура("Карта, КолДублей", Новый Соответствие, 0);
	КартаПоНомеру = ПостроитьКартуТЧПоНомеруГТД(МассивНомеров);

	// Batch-предзагрузка соответствий Подразделение→Контрагент.
	МапаПодразделенийКонтрагентов = ПостроитьМапуПодразделенийКонтрагентов(ТаблицаCSV);

	// Карта вторичных признаков (ТС+Декларант+Дата) — для шага 2.
	КартаПоТСДекларантДата = Новый Соответствие;
	Если ЗначениеЗаполнено(ДатаМин) И ЗначениеЗаполнено(ДатаМакс) Тогда
		КартаПоТСДекларантДата = ПостроитьКартуТЧПоВторичнымПризнакам(
			ДатаМин, ДатаМакс, КартаПоНомеру.Карта);
	КонецЕсли;

	// Шаг 2: классификация по строкам CSV.
	КолКомплекс = 0;
	КолКомплексFallback = 0;
	КолНоваяТД = 0;
	КолНоваяТДПустойDDP = 0;
	КолКонтрагентEmail = 0;
	КолКонтрагентИНН = 0;
	КолКонтрагентПодразделение = 0;
	КолКонтрагентНеНайден = 0;

	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		НоваяСтрока = Предложения.Добавить();
		ЗаполнитьЗначенияСвойствПолей(НоваяСтрока, СтрокаCSV);

		НомерDDP = СокрЛП(СтрокаCSV.НомерДДПТД);

		Если НЕ ЗначениеЗаполнено(НомерDDP) Тогда
			// Пустой DDP в CSV — невозможно найти пару, создаём ОПП по РегНомеру.
			НоваяСтрока.Категория = "НоваяТД";
			НоваяСтрока.Выбрать = Истина;
			ЗаполнитьКонтрагентаПредложения(НоваяСтрока, СтрокаCSV, МапаПодразделенийКонтрагентов);
			НоваяСтрока.Примечание = "Пустой Номер ДДП ТД в CSV — создать ОПП по РегНомеру";
			КолНоваяТДПустойDDP = КолНоваяТДПустойDDP + 1;
		Иначе
			НайденнаяТЧ = КартаПоНомеру.Карта.Получить(НомерDDP);
			ИсточникМатча = "";
			Если НайденнаяТЧ <> Неопределено Тогда
				ИсточникМатча = "Шаг 1";
			ИначеЕсли КартаПоТСДекларантДата.Количество() > 0 Тогда
				НайденнаяТЧ = ПоискПоВторичнымПризнакам(КартаПоТСДекларантДата, СтрокаCSV);
				Если НайденнаяТЧ <> Неопределено Тогда
					ИсточникМатча = "Шаг 2";
				КонецЕсли;
			КонецЕсли;

			Если НайденнаяТЧ <> Неопределено Тогда
				НоваяСтрока.Категория = "Комплекс";
				НоваяСтрока.Выбрать = Истина;
				НоваяСтрока.СсылкаДокумент = НайденнаяТЧ.Ссылка;
				НоваяСтрока.НомерСтрокиТЧ = НайденнаяТЧ.НомерСтрокиТЧ;
				// Контрагент: приоритет — из найденного ОПП, дальше — поиск по CSV.
				Если ЗначениеЗаполнено(НайденнаяТЧ.Контрагент) Тогда
					НоваяСтрока.Контрагент = НайденнаяТЧ.Контрагент;
					НоваяСтрока.ИсточникКонтрагента = "Из БД (документ ОПП)";
				Иначе
					ЗаполнитьКонтрагентаПредложения(НоваяСтрока, СтрокаCSV, МапаПодразделенийКонтрагентов);
				КонецЕсли;
				Если ИсточникМатча = "Шаг 1" Тогда
					КолКомплекс = КолКомплекс + 1;
				Иначе
					КолКомплексFallback = КолКомплексFallback + 1;
					НоваяСтрока.Примечание = "Найдено по ТС+Декларант+Дата (шаг 2)";
				КонецЕсли;
			Иначе
				НоваяСтрока.Категория = "НоваяТД";
				НоваяСтрока.Выбрать = Истина;
				ЗаполнитьКонтрагентаПредложения(НоваяСтрока, СтрокаCSV, МапаПодразделенийКонтрагентов);
				НоваяСтрока.Примечание = "ТД из CSV без пары в базе — создать новый ОПП";
				КолНоваяТД = КолНоваяТД + 1;
			КонецЕсли;
		КонецЕсли;

		// Учёт источников контрагентов для статистики формы.
		Если НоваяСтрока.ИсточникКонтрагента = "Email" Тогда
			КолКонтрагентEmail = КолКонтрагентEmail + 1;
		ИначеЕсли НоваяСтрока.ИсточникКонтрагента = "ИНН" Тогда
			КолКонтрагентИНН = КолКонтрагентИНН + 1;
		ИначеЕсли НоваяСтрока.ИсточникКонтрагента = "Подразделение" Тогда
			КолКонтрагентПодразделение = КолКонтрагентПодразделение + 1;
		ИначеЕсли НЕ ЗначениеЗаполнено(НоваяСтрока.Контрагент) Тогда
			КолКонтрагентНеНайден = КолКонтрагентНеНайден + 1;
		КонецЕсли;
	КонецЦикла;

	ПериодСтр = ?(ЗначениеЗаполнено(ДатаМин),
		Формат(ДатаМин, "ДФ=dd.MM.yyyy") + ".." + Формат(ДатаМакс, "ДФ=dd.MM.yyyy"),
		"<нет дат>");
	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.Сопоставление",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон(
			"Период [%1] CSV строк=%2, уникDDP=%3, дублей в БД=%4, "
			+ "Комплекс[ш1]=%5, Комплекс[ш2]=%6, НоваяТД(пустойDDP)=%7, НоваяТД=%8, Всего=%9. "
			+ "Контрагент: Email=%10, ИНН=%11, Подразделение=%12, НеНайден=%13",
			ПериодСтр, ТаблицаCSV.Количество(), НаборDDP.Количество(),
			КартаПоНомеру.КолДублей,
			КолКомплекс, КолКомплексFallback, КолНоваяТДПустойDDP, КолНоваяТД,
			Предложения.Количество(),
			КолКонтрагентEmail, КолКонтрагентИНН, КолКонтрагентПодразделение,
			КолКонтрагентНеНайден));

	Возврат Предложения;

КонецФункции

// Применить предложения: обогатить существующие ОПП, создать новые. В транзакции.
//
// Параметры:
//   ТаблицаПредложений — ТаблицаЗначений — обрабатываются только Выбрать=Истина.
//
// Возвращаемое значение:
//   Структура:
//     * Обогащено              — Число
//     * Создано                — Число
//     * ДозаполненоКонтрагентов — Число
//     * ДозаполненоСтатусов     — Число
//     * Ошибки                  — Массив строк
//
Функция ПрименитьКлассификацию(ТаблицаПредложений) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Обогащено", 0);
	Результат.Вставить("Создано", 0);
	Результат.Вставить("ДозаполненоКонтрагентов", 0);
	Результат.Вставить("ДозаполненоСтатусов", 0);
	Результат.Вставить("Ошибки", Новый Массив);
	// Совместимость: оставляем поля v1, не используются V3 алгоритмом.
	Результат.Вставить("ПомеченоТолькоОбеспечение", 0);

	КешРеквизитов = Новый Структура("Организация, Валюта",
		ОрганизацияПоУмолчанию(), ВалютаПоУмолчанию());

	НачатьТранзакцию();
	Попытка
		Для Каждого Строка Из ТаблицаПредложений Цикл
			Если НЕ Строка.Выбрать Тогда
				Продолжить;
			КонецЕсли;

			Если Строка.Категория = "Комплекс" Тогда
				Если ОбогатитьСуществующуюСтроку(Строка, Результат) Тогда
					Результат.Обогащено = Результат.Обогащено + 1;
				КонецЕсли;
			ИначеЕсли Строка.Категория = "НоваяТД" Тогда
				Если СоздатьНовыйДокументТД(Строка, Результат, КешРеквизитов) Тогда
					Результат.Создано = Результат.Создано + 1;
				КонецЕсли;
			ИначеЕсли Строка.Категория = "ТолькоОбеспечение" Тогда
				// Зарезервировано на будущее (отдельная обработка).
				Если ПометитьТолькоОбеспечение(Строка, Результат.Ошибки) Тогда
					Результат.ПомеченоТолькоОбеспечение = Результат.ПомеченоТолькоОбеспечение + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Транзакция отменена: " + ОписаниеОшибки());
	КонецПопытки;

	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.Применение",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон(
			"Обогащено=%1, Создано=%2, ДозКонтрагентов=%3, ДозСтатусов=%4, Ошибок=%5",
			Результат.Обогащено, Результат.Создано,
			Результат.ДозаполненоКонтрагентов, Результат.ДозаполненоСтатусов,
			Результат.Ошибки.Количество()));

	Возврат Результат;

КонецФункции

// Маппинг текстового статуса CSV → значение перечисления СтатусыТранзита.
// Возвращает ПустаяСсылка() если строка не распознана + лог в ЖР.
//
// Параметры:
//   СтрокаСтатуса — Строка — значение из CSV col #12 «Статус процесса».
//
// Возвращаемое значение:
//   ПеречислениеСсылка.СтатусыТранзита.
//
Функция МаппингСтатусаТранзита(СтрокаСтатуса) Экспорт

	Если НЕ ЗначениеЗаполнено(СтрокаСтатуса) Тогда
		Возврат Перечисления.СтатусыТранзита.ПустаяСсылка();
	КонецЕсли;

	Очищ = НРег(СокрЛП(СтрокаСтатуса));

	Если Очищ = "транзит завершен" Тогда
		Возврат Перечисления.СтатусыТранзита.ТранзитЗавершен;
	ИначеЕсли Очищ = "транзит завершен с оговорками" Тогда
		Возврат Перечисления.СтатусыТранзита.ТранзитЗавершенСОговорками;
	ИначеЕсли Очищ = "выпуск товара" Тогда
		Возврат Перечисления.СтатусыТранзита.ТоварВыпущен;
	ИначеЕсли Очищ = "товар выпущен" Тогда
		Возврат Перечисления.СтатусыТранзита.ТоварВыпущен;
	ИначеЕсли Очищ = "транзит разрешен" Тогда
		Возврат Перечисления.СтатусыТранзита.ТранзитРазрешен;
	ИначеЕсли Очищ = "дополнение зарегистрировано" Тогда
		Возврат Перечисления.СтатусыТранзита.ДополнениеЗарегистрировано;
	ИначеЕсли Очищ = "дополнение заключено" Тогда
		Возврат Перечисления.СтатусыТранзита.ДополнениеЗаключено;
	ИначеЕсли Очищ = "дополнение отправлено" Тогда
		Возврат Перечисления.СтатусыТранзита.ДополнениеОтправлено;
	ИначеЕсли Очищ = "средства разрезервированы" Тогда
		Возврат Перечисления.СтатусыТранзита.СредстваРазрезервированы;
	ИначеЕсли Очищ = "товар не выпущен" Тогда
		Возврат Перечисления.СтатусыТранзита.ТоварНеВыпущен;
	ИначеЕсли Очищ = "аннулировано специалистом" Тогда
		Возврат Перечисления.СтатусыТранзита.АннулированоСпециалистом;
	ИначеЕсли Очищ = "в заключении дополнения отказано" Тогда
		Возврат Перечисления.СтатусыТранзита.ВЗаключенииДополненияОтказано;
	ИначеЕсли Очищ = "отказано в приеме дополнения" Тогда
		Возврат Перечисления.СтатусыТранзита.ОтказаноВПриемеДополнения;
	ИначеЕсли Очищ = "таможенный досмотр" Тогда
		Возврат Перечисления.СтатусыТранзита.ТаможенныйДосмотр;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.СтатусНеРаспознан",
		УровеньЖурналаРегистрации.Предупреждение, , ,
		СтрШаблон("Статус CSV не распознан: «%1». Документ будет создан без статуса.",
			СтрокаСтатуса));
	Возврат Перечисления.СтатусыТранзита.ПустаяСсылка();

КонецФункции

// Сократить наименование декларанта для fallback-поиска.
// «ИП СИДОРЕНКОВ ДМИТРИЙ АЛЕКСЕЕВ» → «ИП СИДОРЕНКОВ Д.А.»
// «"INTEGER" LLC» → «INTEGER LLC» (убираем кавычки).
//
// Используется в НайтиИлиПустаяСсылкаДекларанта когда точный поиск не нашёл.
//
Функция СокращенноеНаименованиеДекларанта(ПолноеНаименование) Экспорт

	Текст = СокрЛП(ПолноеНаименование);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	// Удалим кавычки разных видов (часто в иностранных названиях).
	Текст = СтрЗаменить(Текст, """", "");
	Текст = СтрЗаменить(Текст, "«", "");
	Текст = СтрЗаменить(Текст, "»", "");
	Текст = СокрЛП(Текст);

	// Если в названии есть Имя+Отчество (минимум 4 слова), сократим до Ф.О.
	// «ИП СИДОРЕНКОВ ДМИТРИЙ АЛЕКСЕЕВ» (4 слова) → «ИП СИДОРЕНКОВ Д.А.»
	Слова = СтрРазделить(Текст, " ", Ложь);
	Если Слова.Количество() >= 4 Тогда
		// Слова: 0=ИП, 1=СИДОРЕНКОВ, 2=ДМИТРИЙ, 3=АЛЕКСЕЕВ
		Сокр = "";
		Для Сч = 0 По Слова.Количество() - 1 Цикл
			Если Сч < 2 Тогда
				Сокр = Сокр + ?(Сч = 0, "", " ") + Слова[Сч];
			Иначе
				Если ЗначениеЗаполнено(Слова[Сч]) Тогда
					Сокр = Сокр + " " + Лев(Слова[Сч], 1) + ".";
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат СокрЛП(Сокр);
	КонецЕсли;

	Возврат Текст;

КонецФункции

#КонецОбласти

