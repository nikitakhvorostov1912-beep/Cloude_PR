// Обогатить найденную строку ТЧ + при необходимости дозаполнить шапку ОПП.
//
// Изменения v2:
//   • При пустом ОПП.Контрагент — подставляется ПредложенияСтрока.Контрагент
//     (увеличивает Результат.ДозаполненоКонтрагентов).
//   • При пустом ОПП.СтатусТранзита — заполняется маппингом из CSV
//     (увеличивает Результат.ДозаполненоСтатусов).
//   • Все правки шапки логируются.
//
Функция ОбогатитьСуществующуюСтроку(ПредложенияСтрока, Результат)

	Если НЕ ЗначениеЗаполнено(ПредложенияСтрока.СсылкаДокумент)
		ИЛИ ПредложенияСтрока.НомерСтрокиТЧ = 0 Тогда
		Результат.Ошибки.Добавить(СтрШаблон(
			"Комплекс %1: нет ссылки на документ или номер строки",
			ПредложенияСтрока.НомерДДПТД));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ОбъектДокумента = ПредложенияСтрока.СсылкаДокумент.ПолучитьОбъект();
		Если ОбъектДокумента = Неопределено Тогда
			Результат.Ошибки.Добавить(СтрШаблон(
				"Комплекс: документ %1 недоступен",
				ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		Найдена = Ложь;
		Для Каждого СтрокаТЧ Из ОбъектДокумента.ДанныеДокументов Цикл
			Если СтрокаТЧ.НомерСтроки <> ПредложенияСтрока.НомерСтрокиТЧ Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.Комплекс;
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ДатаОформления)
				И ЗначениеЗаполнено(ПредложенияСтрока.ДатаВыпуска) Тогда
				СтрокаТЧ.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
			КонецЕсли;
			Если ЗначениеЗаполнено(ПредложенияСтрока.КоличествоКодовТНВЭД) Тогда
				СтрокаТЧ.КоличествоУникальныхКодовТНВЭД = ПредложенияСтрока.КоличествоКодовТНВЭД;
			КонецЕсли;
			Найдена = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ Найдена Тогда
			Результат.Ошибки.Добавить(СтрШаблон(
				"Комплекс: строка ТЧ №%1 не найдена в документе %2",
				ПредложенияСтрока.НомерСтрокиТЧ, ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		// v2: дозаполнение Контрагента в шапке (если был пуст и в предложении есть).
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.Контрагент)
			И ЗначениеЗаполнено(ПредложенияСтрока.Контрагент) Тогда
			ОбъектДокумента.Контрагент = ПредложенияСтрока.Контрагент;
			Результат.ДозаполненоКонтрагентов = Результат.ДозаполненоКонтрагентов + 1;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.ИННКонтрагента)
			И ЗначениеЗаполнено(ПредложенияСтрока.ИННПолучателя) Тогда
			ОбъектДокумента.ИННКонтрагента = ПредложенияСтрока.ИННПолучателя;
		КонецЕсли;

		// v2: дозаполнение СтатусТранзита в шапке (если был пуст).
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.СтатусТранзита) Тогда
			НовыйСтатус = МаппингСтатусаТранзита(ПредложенияСтрока.СтатусПроцесса);
			Если ЗначениеЗаполнено(НовыйСтатус) Тогда
				ОбъектДокумента.СтатусТранзита = НовыйСтатус;
				Результат.ДозаполненоСтатусов = Результат.ДозаполненоСтатусов + 1;
			КонецЕсли;
		КонецЕсли;

		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();
		Возврат Истина;
	Исключение
		Результат.Ошибки.Добавить(СтрШаблон("Комплекс %1: %2",
			ПредложенияСтрока.НомерДДПТД, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Создать черновик ОПП ТипУчета=ТолькоТД из предложения.
Функция СоздатьНовыйДокументТД(ПредложенияСтрока, Результат, КешРеквизитов)

	Попытка
		НовыйДокумент = Документы.ОперацияПоПоручительству.СоздатьДокумент();

		НовыйДокумент.Дата = ?(ЗначениеЗаполнено(ПредложенияСтрока.ДатаВыпуска),
			ПредложенияСтрока.ДатаВыпуска, ТекущаяДатаСеанса());
		НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийПоручительства.ТДФайл;

		// Номер ТД хранится в двух полях шапки (для совместимости с текущим АРМ
		// и расчётами): НомерГТД (декларация) и НомерЭТД (электронная).
		// Для категории «Только ТД» оба совпадают — в реальности это один номер.
		НовыйДокумент.НомерГТД = ПредложенияСтрока.РегНомерТД;
		НовыйДокумент.НомерЭТД = ПредложенияСтрока.РегНомерТД;
		НовыйДокумент.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
		НовыйДокумент.СуммаОбеспечения = 0;
		НовыйДокумент.СуммаДокумента = 0;
		НовыйДокумент.РазмерПоручительства = 0;
		НовыйДокумент.Комментарий = ПредложенияСтрока.Комментарий;

		НовыйДокумент.Организация = КешРеквизитов.Организация;
		НовыйДокумент.СтатусОперации = Перечисления.СтатусыОпераций.НеРассчитан;

		// v2: маппинг статуса транзита из CSV.
		НовыйСтатус = МаппингСтатусаТранзита(ПредложенияСтрока.СтатусПроцесса);
		Если ЗначениеЗаполнено(НовыйСтатус) Тогда
			НовыйДокумент.СтатусТранзита = НовыйСтатус;
			Результат.ДозаполненоСтатусов = Результат.ДозаполненоСтатусов + 1;
		КонецЕсли;

		НовыйДокумент.ВалютаОбеспечения = КешРеквизитов.Валюта;
		НовыйДокумент.ВалютаДокумента = НовыйДокумент.ВалютаОбеспечения;
		НовыйДокумент.ВалютаОплаты = НовыйДокумент.ВалютаОбеспечения;

		// v2: декларант с fallback по сокращению.
		Если ЗначениеЗаполнено(ПредложенияСтрока.Декларант) Тогда
			НовыйДокумент.Декларант = НайтиИлиПустаяСсылкаДекларанта(
				"Декларанты", ПредложенияСтрока.Декларант);
			НовыйДокумент.Перевозчик = НайтиИлиПустаяСсылкаДекларанта(
				"Перевозчики", ПредложенияСтрока.Декларант);
		КонецЕсли;

		Если ЗначениеЗаполнено(ПредложенияСтрока.Контрагент) Тогда
			НовыйДокумент.Контрагент = ПредложенияСтрока.Контрагент;
			Результат.ДозаполненоКонтрагентов = Результат.ДозаполненоКонтрагентов + 1;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПредложенияСтрока.ИННПолучателя) Тогда
			НовыйДокумент.ИННКонтрагента = ПредложенияСтрока.ИННПолучателя;
		КонецЕсли;

		ТекПользователь = ТекущийПользователь();
		Если ЗначениеЗаполнено(ТекПользователь) Тогда
			НовыйДокумент.Менеджер = ТекПользователь;
			НовыйДокумент.Ответственный = ТекПользователь;
		КонецЕсли;

		НоваяСтрокаТЧ = НовыйДокумент.ДанныеДокументов.Добавить();
		НоваяСтрокаТЧ.НомерГТД = ПредложенияСтрока.РегНомерТД;
		НоваяСтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоТД;
		НоваяСтрокаТЧ.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
		НоваяСтрокаТЧ.КоличествоУникальныхКодовТНВЭД = ПредложенияСтрока.КоличествоКодовТНВЭД;

		// ОбменДанными.Загрузка=Истина — документ создаётся как ЧЕРНОВИК
		// (FillChecking отключён, ПередЗаписью пропущен, регистры не пишутся).
		// Пользователь дозаполнит недостающее (если есть) и проведёт вручную.
		НовыйДокумент.ОбменДанными.Загрузка = Истина;
		НовыйДокумент.Записать();
		Возврат Истина;
	Исключение
		Результат.Ошибки.Добавить(СтрШаблон("НоваяТД %1: %2",
			ПредложенияСтрока.РегНомерТД, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Зарезервировано: пометить строку ТЧ как ТолькоОбеспечение.
// V3 алгоритм не генерирует эту категорию, оставлено для отдельной обработки.
Функция ПометитьТолькоОбеспечение(ПредложенияСтрока, МассивОшибок)

	Если НЕ ЗначениеЗаполнено(ПредложенияСтрока.СсылкаДокумент)
		ИЛИ ПредложенияСтрока.НомерСтрокиТЧ = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ОбъектДокумента = ПредложенияСтрока.СсылкаДокумент.ПолучитьОбъект();
		Если ОбъектДокумента = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Найдена = Ложь;
		Для Каждого СтрокаТЧ Из ОбъектДокумента.ДанныеДокументов Цикл
			Если СтрокаТЧ.НомерСтроки <> ПредложенияСтрока.НомерСтрокиТЧ Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоОбеспечение;
			Найдена = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ Найдена Тогда
			МассивОшибок.Добавить(СтрШаблон(
				"ТолькоОбеспечение: строка ТЧ №%1 не найдена в документе %2",
				ПредложенияСтрока.НомерСтрокиТЧ, ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();
		Возврат Истина;
	Исключение
		МассивОшибок.Добавить(СтрШаблон("ТолькоОбеспечение %1: %2",
			ПредложенияСтрока.СсылкаДокумент, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Справочные функции
