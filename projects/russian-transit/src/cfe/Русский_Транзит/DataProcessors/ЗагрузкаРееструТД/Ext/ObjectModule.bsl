#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Прочитать CSV «Отчёт по журналу ЭТД» (кодировка windows-1251, разделитель ";").
// Возвращает таблицу значений с 51 типизированной колонкой.
//
// Параметры:
//   ПутьКФайлу - Строка - полный путь к CSV
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки соответствуют структуре CSV_STRUCTURE.md
//
Функция ПрочитатьCSVФайл(ПутьКФайлу) Экспорт

	Результат = СоздатьТаблицуCSV();

	Попытка
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.ANSI);
	Исключение
		ЗаписьЖурналаРегистрации(
			"РусскийТранзит.ЗагрузкаРееструТД.ОткрытиеФайла",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон("Не удалось открыть файл «%1»: %2", ПутьКФайлу, ОписаниеОшибки()));
		ВызватьИсключение СтрШаблон("Не удалось открыть файл реестра ТД. Проверьте путь и доступ. Файл: %1", ПутьКФайлу);
	КонецПопытки;

	СтрокаЗаголовка = ЧтениеТекста.ПрочитатьСтроку();
	Если СтрокаЗаголовка = Неопределено Тогда
		ЧтениеТекста.Закрыть();
		ВызватьИсключение "Файл пуст или не удалось прочитать заголовок";
	КонецЕсли;

	// Проверка формата: ожидаем 105 колонок (выгрузка ЭТД по дате выпуска).
	КоличествоКолонок = РазобратьСтрокуCSV(СтрокаЗаголовка).Количество();
	Если КоличествоКолонок < 102 Тогда
		ЧтениеТекста.Закрыть();
		ВызватьИсключение СтрШаблон(
			"Неподдерживаемый формат CSV: %1 колонок (ожидалось 105). Используйте свежую выгрузку «Отчёт по журналу ЭТД» из Сигмы по дате выпуска.",
			КоличествоКолонок);
	КонецЕсли;

	НомерСтроки = 1;
	Накопитель = "";
	Строка = ЧтениеТекста.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		НомерСтроки = НомерСтроки + 1;

		// Многострочные значения в кавычках: если число " в накопленной строке нечётное —
		// читаем дальше пока не наберём чётное (то есть пока кавычка не закрылась).
		Если ЗначениеЗаполнено(Накопитель) Тогда
			Накопитель = Накопитель + Символы.ПС + Строка;
		Иначе
			Если ПустаяСтрока(Строка) Тогда
				Строка = ЧтениеТекста.ПрочитатьСтроку();
				Продолжить;
			КонецЕсли;
			Накопитель = Строка;
		КонецЕсли;

		Если ПодсчитатьКавычки(Накопитель) % 2 <> 0 Тогда
			// Кавычка ещё не закрылась — читаем следующую строку и продолжаем накопление.
			Строка = ЧтениеТекста.ПрочитатьСтроку();
			Продолжить;
		КонецЕсли;

		Попытка
			Поля = РазобратьСтрокуCSV(Накопитель);
			ДобавитьСтрокуВТаблицу(Результат, Поля);
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.Парсер",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				СтрШаблон("Строка %1: %2. Исходная строка: %3", НомерСтроки, ОписаниеОшибки(), Лев(Накопитель, 200)));
		КонецПопытки;

		Накопитель = "";
		Строка = ЧтениеТекста.ПрочитатьСтроку();
	КонецЦикла;

	// Если файл закончился, а кавычка осталась незакрытой — пытаемся разобрать как есть.
	Если ЗначениеЗаполнено(Накопитель) Тогда
		Попытка
			Поля = РазобратьСтрокуCSV(Накопитель);
			ДобавитьСтрокуВТаблицу(Результат, Поля);
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.Парсер",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон("Хвостовая незакрытая кавычка: %1. Лев(200): %2", ОписаниеОшибки(), Лев(Накопитель, 200)));
		КонецПопытки;
	КонецЕсли;

	ЧтениеТекста.Закрыть();

	Возврат Результат;

КонецФункции

// Сопоставить строки CSV «Отчёт по журналу ЭТД» со строками ТЧ ДанныеДокументов наших ОПП.
//
// АЛГОРИТМ V3.1 — CSV-driven 1:1 (одна строка CSV → одно предложение):
//   Шаг 0. Собираем уникальные НомерДДПТД из CSV (только для запроса к БД).
//   Шаг 1. Один запрос ТЧ ДД с НомерГТД В &СписокНомеровДДП → карта DDP→ТЧ.
//   Шаг 2. Для КАЖДОЙ строки CSV (без дедупа):
//          — пустой НомерДДПТД           → НоваяТД (создать ОПП по РегНомеру ТД)
//          — DDP найден в карте          → Комплекс (обогащение существующей ТЧ)
//          — DDP не найден, но матч по ТС+Декларант+Дата → Комплекс (fallback)
//          — DDP не найден совсем        → НоваяТД (создание нового ОПП)
//
// ВАЖНО: дубликаты НомерДДПТД в CSV — это бизнес-кейс «общее ДДП на несколько ТД»
// (одно ДДП покрывает 4..28 разных РегНомеров ТД). Каждая такая строка CSV — отдельная
// ТД, поэтому каждая получает своё предложение. Дедуп по DDP терял 59 разных ТД.
//
// ПОЧЕМУ CSV-driven: в нашей БД АПИСигма автоматически грузит ВСЕ ТД из Сигмы как ОПП
// с ВидОперации=ДДПАвто. За неделю это 1000+ строк ТЧ ДД, тогда как наш CSV «Отчёт по
// журналу ЭТД» (= то что прошло через нашего брокера) содержит ~370 уникальных DDP.
// Старая логика V2 «по строкам ТЧ ДД, не нашли в CSV → ТолькоОбеспечение» давала ~920
// ложноположительных ТолькоОбеспечений (чужие ТД от других брокеров).
//
// ТолькоОбеспечение по этому алгоритму НЕ генерируется автоматически. Поле сохранено
// в реквизитах формы и метод ПометитьТолькоОбеспечение() оставлен для ручного режима.
//
// Параметры:
//   ТаблицаCSV - ТаблицаЗначений - результат ПрочитатьCSVФайл()
//
// Возвращаемое значение:
//   ТаблицаЗначений - структура как у СоздатьТаблицуПредложений(),
//                     количество строк = количеству строк ТаблицаCSV
//
Функция СопоставитьСДокументами(ТаблицаCSV) Экспорт

	Предложения = СоздатьТаблицуПредложений();

	Если ТаблицаCSV.Количество() = 0 Тогда
		Возврат Предложения;
	КонецЕсли;

	ДатаМин = Неопределено;
	ДатаМакс = Неопределено;
	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		Если ЗначениеЗаполнено(СтрокаCSV.ДатаВыпуска) Тогда
			Если ДатаМин = Неопределено ИЛИ СтрокаCSV.ДатаВыпуска < ДатаМин Тогда
				ДатаМин = СтрокаCSV.ДатаВыпуска;
			КонецЕсли;
			Если ДатаМакс = Неопределено ИЛИ СтрокаCSV.ДатаВыпуска > ДатаМакс Тогда
				ДатаМакс = СтрокаCSV.ДатаВыпуска;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Шаг 0: уникальные DDP — нужны только для запроса к БД.
	НаборDDP = Новый Соответствие;
	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		Ключ = СокрЛП(СтрокаCSV.НомерДДПТД);
		Если ЗначениеЗаполнено(Ключ) Тогда
			НаборDDP.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	МассивНомеров = Новый Массив;
	Для Каждого Эл Из НаборDDP Цикл
		МассивНомеров.Добавить(Эл.Ключ);
	КонецЦикла;

	// Шаг 1: один запрос ТЧ ДД с НомерГТД В &СписокНомеров.
	КартаПоНомеру = ПостроитьКартуТЧПоНомеруГТД(МассивНомеров);

	// Доработка START {Perf #2 2026-05-01}: batch-предзагрузка соответствий Подразделение→Контрагент
	// (один запрос вместо N в цикле через ВернутьКонтрагента)
	МапаПодразделенийКонтрагентов = ПостроитьМапуПодразделенийКонтрагентов(ТаблицаCSV);
	// Доработка END

	// Доработка START {Perf #4 2026-05-01}: eager построение карты вторичных признаков ДО цикла
	// (раньше была ленивая инициализация внутри цикла — EDT помечал как query-in-loop).
	// Если ДатаМин/ДатаМакс пустые → пустая карта → fallback на шаге 2 не сработает (тот же эффект,
	// что и при старой ленивой инициализации, где условие сразу было ложным).
	КартаПоТСДекларантДата = Новый Соответствие;
	Если ЗначениеЗаполнено(ДатаМин) И ЗначениеЗаполнено(ДатаМакс) Тогда
		КартаПоТСДекларантДата = ПостроитьКартуТЧПоВторичнымПризнакам(ДатаМин, ДатаМакс, КартаПоНомеру);
	КонецЕсли;
	// Доработка END

	// Шаг 2: итерация по ВСЕМ строкам CSV (без дедупа).
	КолКомплекс = 0;
	КолКомплексFallback = 0;
	КолНоваяТД = 0;
	КолНоваяТДПустойDDP = 0;

	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		НоваяСтрока = Предложения.Добавить();
		ЗаполнитьЗначенияСвойствПолей(НоваяСтрока, СтрокаCSV);

		НомерDDP = СокрЛП(СтрокаCSV.НомерДДПТД);

		Если НЕ ЗначениеЗаполнено(НомерDDP) Тогда
			// Пустой DDP в CSV — невозможно найти пару, создаём ОПП по РегНомеру.
			НоваяСтрока.Категория = "НоваяТД";
			НоваяСтрока.Выбрать = Истина;
			НоваяСтрока.Контрагент = ВернутьКонтрагента(
				СтрокаCSV.Комментарий, СтрокаCSV.Подразделение, СтрокаCSV.ИННПолучателя,
				МапаПодразделенийКонтрагентов);
			НоваяСтрока.Примечание = "Пустой Номер ДДП ТД в CSV — создать ОПП по РегНомеру";
			КолНоваяТДПустойDDP = КолНоваяТДПустойDDP + 1;
			Продолжить;
		КонецЕсли;

		// Шаг 1: точное совпадение по НомерДДПТД.
		НайденнаяТЧ = КартаПоНомеру.Получить(НомерDDP);
		Примечание = "";
		ИсточникМатча = "";

		Если НайденнаяТЧ <> Неопределено Тогда
			ИсточникМатча = "Шаг 1";
		Иначе
			// Шаг 2 fallback: lookup в карте вторичных признаков (построена до цикла).
			Если КартаПоТСДекларантДата.Количество() > 0 Тогда
				НайденнаяТЧ = ПоискПоВторичнымПризнакам(КартаПоТСДекларантДата, СтрокаCSV);
			КонецЕсли;
			Если НайденнаяТЧ <> Неопределено Тогда
				Примечание = "Найдено по ТС+Декларант+Дата (шаг 2)";
				ИсточникМатча = "Шаг 2";
			КонецЕсли;
		КонецЕсли;

		Если НайденнаяТЧ <> Неопределено Тогда
			НоваяСтрока.Категория = "Комплекс";
			НоваяСтрока.Выбрать = Истина;
			НоваяСтрока.СсылкаДокумент = НайденнаяТЧ.Ссылка;
			НоваяСтрока.НомерСтрокиТЧ = НайденнаяТЧ.НомерСтрокиТЧ;
			НоваяСтрока.Контрагент = НайденнаяТЧ.Контрагент;
			НоваяСтрока.Примечание = Примечание;
			Если ИсточникМатча = "Шаг 1" Тогда
				КолКомплекс = КолКомплекс + 1;
			Иначе
				КолКомплексFallback = КолКомплексFallback + 1;
			КонецЕсли;
		Иначе
			НоваяСтрока.Категория = "НоваяТД";
			НоваяСтрока.Выбрать = Истина;
			НоваяСтрока.Контрагент = ВернутьКонтрагента(
				СтрокаCSV.Комментарий, СтрокаCSV.Подразделение, СтрокаCSV.ИННПолучателя,
				МапаПодразделенийКонтрагентов);
			НоваяСтрока.Примечание = "ТД из CSV без пары в базе → создать ОПП ТолькоТД";
			КолНоваяТД = КолНоваяТД + 1;
		КонецЕсли;
	КонецЦикла;

	ПериодСтр = ?(ЗначениеЗаполнено(ДатаМин),
		Формат(ДатаМин, "ДФ=dd.MM.yyyy") + ".." + Формат(ДатаМакс, "ДФ=dd.MM.yyyy"),
		"<нет дат>");
	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.Сопоставление",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Период [%1] CSV строк=%2, уникDDP=%3, Комплекс(шаг1)=%4, Комплекс(шаг2)=%5, НоваяТД(нашли пустой DDP)=%6, НоваяТД(не нашли в БД)=%7, Всего=%8",
			ПериодСтр,
			ТаблицаCSV.Количество(),
			НаборDDP.Количество(),
			КолКомплекс, КолКомплексFallback, КолНоваяТДПустойDDP, КолНоваяТД,
			Предложения.Количество()));

	Возврат Предложения;

КонецФункции

// Запрос ТЧ ДД с НомерГТД ∈ список → карта НомерГТД → структура (Ссылка, НомерСтрокиТЧ, Контрагент).
// Если в БД одинаковый НомерГТД встречается несколько раз — берём первое попавшееся ОПП.
Функция ПостроитьКартуТЧПоНомеруГТД(МассивНомеров)

	Карта = Новый Соответствие;
	Если МассивНомеров.Количество() = 0 Тогда
		Возврат Карта;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОПП.Ссылка КАК Ссылка,
	|	ОПП.Контрагент КАК Контрагент,
	|	ДД.НомерСтроки КАК НомерСтрокиТЧ,
	|	ДД.НомерГТД КАК НомерГТД,
	|	ДД.ДатаОформления КАК ДатаОформления
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК ОПП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОперацияПоПоручительству.ДанныеДокументов КАК ДД
	|		ПО ДД.Ссылка = ОПП.Ссылка
	|ГДЕ
	|	ДД.НомерГТД В (&СписокНомеров)
	|	И НЕ ОПП.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ОПП.Дата";
	Запрос.УстановитьПараметр("СписокНомеров", МассивНомеров);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = СокрЛП(Выборка.НомерГТД);
		Если Карта.Получить(Ключ) = Неопределено Тогда
			Структура = Новый Структура("Ссылка, НомерСтрокиТЧ, Контрагент, ДатаОформления");
			ЗаполнитьЗначенияСвойств(Структура, Выборка);
			Карта.Вставить(Ключ, Структура);
		КонецЕсли;
	КонецЦикла;

	Возврат Карта;

КонецФункции

// Запрос ТЧ ДД за период CSV → карта (НомерТС|Декларант|ДатаОформления) → структура.
// Используется только для шага 2 fallback. Исключает строки, уже сматченные на шаге 1.
Функция ПостроитьКартуТЧПоВторичнымПризнакам(ДатаНачала, ДатаОкончания, КартаШага1)

	Карта = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОПП.Ссылка КАК Ссылка,
	|	ОПП.Контрагент КАК Контрагент,
	|	ОПП.Декларант.Наименование КАК ДекларантОПП,
	|	ОПП.ОсновноеТС.Наименование КАК ОсновноеТС,
	|	ОПП.ДополнительноеТС.Наименование КАК ДополнительноеТС,
	|	ДД.НомерСтроки КАК НомерСтрокиТЧ,
	|	ДД.НомерГТД КАК НомерГТД,
	|	ДД.ДатаОформления КАК ДатаОформления
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК ОПП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОперацияПоПоручительству.ДанныеДокументов КАК ДД
	|		ПО ДД.Ссылка = ОПП.Ссылка
	|ГДЕ
	|	ДД.ДатаОформления МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ ОПП.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Пропускаем строки, уже захваченные шагом 1.
		Если КартаШага1.Получить(СокрЛП(Выборка.НомерГТД)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Декларант = СокрЛП(Выборка.ДекларантОПП);
		Если НЕ ЗначениеЗаполнено(Декларант) Тогда
			Продолжить;
		КонецЕсли;
		ДатаКлюч = НачалоДня(Выборка.ДатаОформления);
		Если НЕ ЗначениеЗаполнено(ДатаКлюч) Тогда
			Продолжить;
		КонецЕсли;

		НомерОснТС = ИзвлечьОсновнойНомерТС(Выборка.ОсновноеТС);
		НомерДопТС = ИзвлечьОсновнойНомерТС(Выборка.ДополнительноеТС);

		Структура = Новый Структура("Ссылка, НомерСтрокиТЧ, Контрагент, ДатаОформления");
		ЗаполнитьЗначенияСвойств(Структура, Выборка);

		Если ЗначениеЗаполнено(НомерОснТС) Тогда
			Ключ = НомерОснТС + "|" + Декларант + "|" + Формат(ДатаКлюч, "ДФ=yyyyMMdd");
			Если Карта.Получить(Ключ) = Неопределено Тогда
				Карта.Вставить(Ключ, Структура);
			Иначе
				Карта.Вставить(Ключ, "DUP"); // помечаем неоднозначность
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(НомерДопТС) И НомерДопТС <> НомерОснТС Тогда
			Ключ = НомерДопТС + "|" + Декларант + "|" + Формат(ДатаКлюч, "ДФ=yyyyMMdd");
			Если Карта.Получить(Ключ) = Неопределено Тогда
				Карта.Вставить(Ключ, Структура);
			Иначе
				Карта.Вставить(Ключ, "DUP");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Карта;

КонецФункции

// Поиск по карте (НомерТС|Декларант|Дата) для CSV-строки. Возвращает структуру или Неопределено.
Функция ПоискПоВторичнымПризнакам(КартаПоПризнакам, СтрокаCSV)

	Декларант = СокрЛП(СтрокаCSV.Декларант);
	Если НЕ ЗначениеЗаполнено(Декларант) ИЛИ НЕ ЗначениеЗаполнено(СтрокаCSV.ДатаВыпуска) Тогда
		Возврат Неопределено;
	КонецЕсли;
	НомерТС = ИзвлечьОсновнойНомерТС(СтрокаCSV.ТС);
	Если НЕ ЗначениеЗаполнено(НомерТС) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ключ = НомерТС + "|" + Декларант + "|" + Формат(НачалоДня(СтрокаCSV.ДатаВыпуска), "ДФ=yyyyMMdd");
	Значение = КартаПоПризнакам.Получить(Ключ);
	Если Значение = Неопределено ИЛИ Значение = "DUP" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Копирует поля из строки CSV (или НайденнойCSV) в строку предложения.
Процедура ЗаполнитьЗначенияСвойствПолей(СтрокаПредложения, СтрокаCSV)

	СтрокаПредложения.РегНомерТД = СокрЛП(СтрокаCSV.РегНомерТД);
	СтрокаПредложения.НомерДДПТД = СокрЛП(СтрокаCSV.НомерДДПТД);
	СтрокаПредложения.Подразделение = СтрокаCSV.Подразделение;
	СтрокаПредложения.Декларант = СтрокаCSV.Декларант;
	СтрокаПредложения.ДатаВыпуска = СтрокаCSV.ДатаВыпуска;
	СтрокаПредложения.КоличествоКодовТНВЭД = СтрокаCSV.КоличествоКодовТНВЭД;
	СтрокаПредложения.ИННПолучателя = СтрокаCSV.ИННПолучателя;
	СтрокаПредложения.НаименованиеПолучателя = СтрокаCSV.НаименованиеПолучателя;
	СтрокаПредложения.СтатусПроцесса = СтрокаCSV.СтатусПроцесса;
	СтрокаПредложения.ТС = СтрокаCSV.ТС;
	СтрокаПредложения.Комментарий = СтрокаCSV.Комментарий;

КонецПроцедуры

// Извлекает основной номер ТС из формата '1:M367MM32/34ZN2410' → 'M367MM32'.
Функция ИзвлечьОсновнойНомерТС(ТС)

	Текст = СокрЛП(ТС);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	ПозДвоеточия = СтрНайти(Текст, ":");
	Если ПозДвоеточия > 0 Тогда
		Текст = Сред(Текст, ПозДвоеточия + 1);
	КонецЕсли;
	ПозСлеша = СтрНайти(Текст, "/");
	Если ПозСлеша > 0 Тогда
		Текст = Лев(Текст, ПозСлеша - 1);
	КонецЕсли;
	Возврат СокрЛП(Текст);

КонецФункции

// Применить предложения: обогатить существующие строки, создать новые документы. Всё в транзакции.
//
// Параметры:
//   ТаблицаПредложений - ТаблицаЗначений - все категории, только строки с Выбрать=Истина обрабатываются
//
// Возвращаемое значение:
//   Структура:
//     * Обогащено - Число
//     * Создано - Число
//     * ПомеченоТолькоОбеспечение - Число (всегда 0, оставлено для совместимости с формой)
//     * Ошибки - Массив
//
Функция ПрименитьКлассификацию(ТаблицаПредложений) Экспорт

	Результат = Новый Структура("Обогащено, Создано, ПомеченоТолькоОбеспечение, Ошибки", 0, 0, 0, Новый Массив);

	// Доработка {Perf #3 2026-05-01}: предзагрузка справочных констант ВНЕ цикла.
	// Один вызов ОрганизацияПоУмолчанию() + ВалютаПоУмолчанию() — обе функции возвращают
	// неизменное значение для всей обработки. Передаются в СоздатьНовыйДокументТД
	// структурой — устраняет N+1 query-in-loop.
	КешРеквизитов = Новый Структура("Организация, Валюта",
		ОрганизацияПоУмолчанию(), ВалютаПоУмолчанию());

	НачатьТранзакцию();
	Попытка
		Для Каждого Строка Из ТаблицаПредложений Цикл
			Если НЕ Строка.Выбрать Тогда
				Продолжить;
			КонецЕсли;

			Если Строка.Категория = "Комплекс" Тогда
				Если ОбогатитьСуществующуюСтроку(Строка, Результат.Ошибки) Тогда
					Результат.Обогащено = Результат.Обогащено + 1;
				КонецЕсли;
			ИначеЕсли Строка.Категория = "НоваяТД" Тогда
				Если СоздатьНовыйДокументТД(Строка, Результат.Ошибки, КешРеквизитов) Тогда
					Результат.Создано = Результат.Создано + 1;
				КонецЕсли;
			ИначеЕсли Строка.Категория = "ТолькоОбеспечение" Тогда
				Если ПометитьТолькоОбеспечение(Строка, Результат.Ошибки) Тогда
					Результат.ПомеченоТолькоОбеспечение = Результат.ПомеченоТолькоОбеспечение + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Транзакция отменена: " + ОписаниеОшибки());
	КонецПопытки;

	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.Применение",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон("Обогащено=%1, Создано=%2, ТолькоОбеспечение=%3, Ошибок=%4",
			Результат.Обогащено, Результат.Создано, Результат.ПомеченоТолькоОбеспечение, Результат.Ошибки.Количество()));

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Считает количество символов " в строке (для определения многострочного значения).
Функция ПодсчитатьКавычки(Текст)

	Счётчик = 0;
	Позиция = 1;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина Цикл
		Если Сред(Текст, Позиция, 1) = """" Тогда
			Счётчик = Счётчик + 1;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Счётчик;

КонецФункции

// Разбирает одну строку CSV, учитывая кавычки и экранирование "".
Функция РазобратьСтрокуCSV(Строка)

	Поля = Новый Массив;
	ТекущееПоле = "";
	ВнутриКавычек = Ложь;
	Позиция = 1;
	ДлинаСтроки = СтрДлина(Строка);

	Пока Позиция <= ДлинаСтроки Цикл
		Символ = Сред(Строка, Позиция, 1);

		Если Символ = """" Тогда
			СледующийСимвол = ?(Позиция < ДлинаСтроки, Сред(Строка, Позиция + 1, 1), "");
			Если ВнутриКавычек И СледующийСимвол = """" Тогда
				ТекущееПоле = ТекущееПоле + """";
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			ВнутриКавычек = НЕ ВнутриКавычек;
		ИначеЕсли Символ = ";" И НЕ ВнутриКавычек Тогда
			Поля.Добавить(ТекущееПоле);
			ТекущееПоле = "";
		Иначе
			ТекущееПоле = ТекущееПоле + Символ;
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Поля.Добавить(ТекущееПоле);
	Возврат Поля;

КонецФункции

