КонецФункции

// Парсер CSV «Отчёт по журналу ЭТД» (105 колонок, выгрузка по дате выпуска).
// Индексы привязаны к актуальному формату Sigma на 2026-04-29.
// Если формат изменится — обновить эту таблицу.
// Маппинг строки CSV в строку таблицы — ПО ИМЕНИ колонок (через ИндексыПолей из заголовка).
// Формат Сигмы менялся (51 → 105 → 121 колонок), порядок переставлялся, но имена стабильны.
// Канонические имена закреплены в docs/requirements/td-spec-v1/CSV_STRUCTURE.md.
Процедура ДобавитьСтрокуВТаблицу(Таблица, Поля, ИндексыПолей)

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Подразделение = ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Подразделение");
	НоваяСтрока.КоличествоКодовТНВЭД = РазобратьЧисло(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Количество уникальных кодов ТН ВЭД"));
	НоваяСтрока.НомерДДПТД = СокрЛП(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Номер ДДП ТД"));
	НоваяСтрока.ТС = ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Номера ТС");
	НоваяСтрока.СтатусПроцесса = ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Статус процесса");
	НоваяСтрока.РегНомерТД = СокрЛП(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Регистрационный номер ТД"));
	НоваяСтрока.НаименованиеПолучателя = ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Наименование получателя");
	НоваяСтрока.Декларант = ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Наименование декларанта");
	НоваяСтрока.Перевозчик = ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Наименование перевозчика");
	НоваяСтрока.ДатаВыпуска = РазобратьДату(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Дата выпуска"));
	НоваяСтрока.Комментарий = ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Комментарии к документу");
	НоваяСтрока.ИННПолучателя = СокрЛП(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "ИНН получателя"));
	НоваяСтрока.НомерТрансДок = СокрЛП(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Номер трансп. док-та"));
	НоваяСтрока.КодТОНазначения = СокрЛП(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Код ТО места назначения"));
	НоваяСтрока.НаимТОНазначения = ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Наименование ТО места назначения");
	НоваяСтрока.КодТОТД = СокрЛП(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Код ТО ТД"));
	НоваяСтрока.КодВалюты = СокрЛП(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Код валюты цены договора. Гр 22"));
	НоваяСтрока.СтоимостьТоваров = РазобратьЧисло(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Общая стоимость товаров. Гр 22"));
	НоваяСтрока.РазмерПоручительства = РазобратьЧисло(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Размер поручительства"));
	НоваяСтрока.ФИОВодителя = ПолучитьПолеПоИмени(Поля, ИндексыПолей, "ФИО водителя");
	НоваяСтрока.СрокДоставки = РазобратьДату(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Срок доставки"));
	НоваяСтрока.ДатаЗавершенияТранзита = РазобратьДату(ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Дата завершения транзита"));
	НоваяСтрока.НаимПоручителя = ПолучитьПолеПоИмени(Поля, ИндексыПолей, "Наименование поручителя (ВН)");

КонецПроцедуры

// Строим Соответствие "имя колонки заголовка" → индекс в массиве Поля.
// Имена нормализуются: СокрЛП + сжатие двойных пробелов.
Функция ПостроитьИндексыПолейПоИмени(ПоляЗаголовка)

	Результат = Новый Соответствие;
	Для Сч = 0 По ПоляЗаголовка.Количество() - 1 Цикл
		Имя = НормализоватьИмяКолонки(ПоляЗаголовка[Сч]);
		Если ЗначениеЗаполнено(Имя) И Результат.Получить(Имя) = Неопределено Тогда
			Результат.Вставить(Имя, Сч);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НормализоватьИмяКолонки(Имя)

	Результат = СокрЛП(Имя);
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает текст ошибки, если в заголовке CSV не найдено какое-либо обязательное поле.
// Пустая строка = все поля на месте.
Функция ПроверитьОбязательныеПоля(ИндексыПолей)

	ОбязательныеПоля = СтрРазделить(
		"Подразделение"
		+ "|Количество уникальных кодов ТН ВЭД"
		+ "|Номер ДДП ТД"
		+ "|Номера ТС"
		+ "|Статус процесса"
		+ "|Регистрационный номер ТД"
		+ "|Наименование получателя"
		+ "|Наименование декларанта"
		+ "|Дата выпуска"
		+ "|Комментарии к документу"
		+ "|ИНН получателя",
		"|", Ложь);

	Отсутствующие = Новый Массив;
	Для Каждого ИмяПоля Из ОбязательныеПоля Цикл
		Если ИндексыПолей.Получить(НормализоватьИмяКолонки(ИмяПоля)) = Неопределено Тогда
			Отсутствующие.Добавить("«" + ИмяПоля + "»");
		КонецЕсли;
	КонецЦикла;

	Если Отсутствующие.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(
		"В заголовке CSV не найдены обязательные колонки: %1. "
		+ "Используйте свежую выгрузку «Отчёт по журналу ЭТД» из Сигмы по дате выпуска.",
		СтрСоединить(Отсутствующие, ", "));

КонецФункции

Функция ПолучитьПолеПоИмени(Поля, ИндексыПолей, ИмяПоля)

	Индекс = ИндексыПолей.Получить(НормализоватьИмяКолонки(ИмяПоля));
	Если Индекс = Неопределено ИЛИ Индекс >= Поля.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Поля[Индекс];

КонецФункции

Функция РазобратьДату(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;

	ЗначениеОчищенное = СокрЛП(Значение);
	Части = СтрРазделить(ЗначениеОчищенное, ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		СтрокаISO = Части[2] + Формат(Число(Части[1]), "ЧЦ=2; ЧВН=; ЧН=0")
			+ Формат(Число(Части[0]), "ЧЦ=2; ЧВН=; ЧН=0");
		Возврат Дата(СтрокаISO);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

Функция РазобратьЧисло(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;

	ЗначениеОчищенное = СокрЛП(Значение);
	ЗначениеОчищенное = СтрЗаменить(ЗначениеОчищенное, ",", ".");
	ЗначениеОчищенное = СтрЗаменить(ЗначениеОчищенное, " ", "");

	Попытка
		Возврат Число(ЗначениеОчищенное);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции


// Помечает КОНКРЕТНУЮ строку ТЧ ДанныеДокументов (по НомерСтрокиТЧ) ТипУчета=Комплекс
// и обогащает данными из CSV (РегНомерТД, ДатаОформления, КоличествоУникальныхКодовТНВЭД).
// Экспорт для unit-тестов (вызывается из цикла ПрименитьКлассификацию).
Функция ОбогатитьСуществующуюСтроку(ПредложенияСтрока, МассивОшибок) Экспорт

	Если НЕ ЗначениеЗаполнено(ПредложенияСтрока.СсылкаДокумент) ИЛИ ПредложенияСтрока.НомерСтрокиТЧ = 0 Тогда
		МассивОшибок.Добавить(СтрШаблон("Комплекс: %1 - нет ссылки на документ или номер строки",
			ПредложенияСтрока.НомерДДПТД));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		// {audit 2026-05-19 HIGH #14}: блокировка ОПП перед ПолучитьОбъект().
		// Защита от race condition при параллельном применении / API-перезаписи Сигмы.
		Блокировка = Новый БлокировкаДанных;
		ЭлБлокировки = Блокировка.Добавить("Документ.ОперацияПоПоручительству");
		ЭлБлокировки.УстановитьЗначение("Ссылка", ПредложенияСтрока.СсылкаДокумент);
		ЭлБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		ОбъектДокумента = ПредложенияСтрока.СсылкаДокумент.ПолучитьОбъект();
		Если ОбъектДокумента = Неопределено Тогда
			МассивОшибок.Добавить(СтрШаблон("Комплекс: документ %1 недоступен",
				ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		Найдена = Ложь;
		Для Каждого СтрокаТЧ Из ОбъектДокумента.ДанныеДокументов Цикл
			Если СтрокаТЧ.НомерСтроки <> ПредложенияСтрока.НомерСтрокиТЧ Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.Комплекс;
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ДатаОформления) И ЗначениеЗаполнено(ПредложенияСтрока.ДатаВыпуска) Тогда
				СтрокаТЧ.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
			КонецЕсли;
			Если ЗначениеЗаполнено(ПредложенияСтрока.КоличествоКодовТНВЭД) Тогда
				СтрокаТЧ.КоличествоУникальныхКодовТНВЭД = ПредложенияСтрока.КоличествоКодовТНВЭД;
			КонецЕсли;
			Найдена = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ Найдена Тогда
			МассивОшибок.Добавить(СтрШаблон("Комплекс: строка ТЧ №%1 не найдена в документе %2",
				ПредложенияСтрока.НомерСтрокиТЧ, ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		// Дозаполнение шапки документа (SPEC v2 §4.1) — ТОЛЬКО пустых полей.
		// Перезапись существующих значений запрещена.
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.Контрагент) И ЗначениеЗаполнено(ПредложенияСтрока.Контрагент) Тогда
			ОбъектДокумента.Контрагент = ПредложенияСтрока.Контрагент;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.ИННКонтрагента) И ЗначениеЗаполнено(ПредложенияСтрока.ИННПолучателя) Тогда
			ОбъектДокумента.ИННКонтрагента = ПредложенияСтрока.ИННПолучателя;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ОбъектДокумента.СтатусТранзита) И ЗначениеЗаполнено(ПредложенияСтрока.СтатусПроцесса) Тогда
			НовыйСтатус = МаппингСтатусаТранзита(ПредложенияСтрока.СтатусПроцесса);
			Если ЗначениеЗаполнено(НовыйСтатус) Тогда
				ОбъектДокумента.СтатусТранзита = НовыйСтатус;
			КонецЕсли;
		КонецЕсли;

		// Доработка START {ОПП-fix #2 2026-05-04}: дозаполнение Декларант/Перевозчик/ОсновноеТС
		// при обогащении существующего документа. Раньше эти поля при «Комплекс»-обогащении
		// не дозаполнялись — Сигма-АПИ часто оставляет их пустыми, а в CSV данные есть.
		// {fix-mutable-check 2026-05-15}: ЗначениеЗаполнено на типах УТ может падать
		// «Проверка мутабельных значений не поддерживается» — оборачиваем в Попытка.
		Заполнено = Истина;
		Попытка Заполнено = ЗначениеЗаполнено(ОбъектДокумента.Декларант); Исключение КонецПопытки;
		Если НЕ Заполнено И ЗначениеЗаполнено(ПредложенияСтрока.Декларант) Тогда
			ДекларантНайден = НайтиЭлементСFallback("Декларанты", ПредложенияСтрока.Декларант);
			Если ЗначениеЗаполнено(ДекларантНайден) Тогда
				ОбъектДокумента.Декларант = ДекларантНайден;
			КонецЕсли;
		КонецЕсли;
		Заполнено = Истина;
		Попытка Заполнено = ЗначениеЗаполнено(ОбъектДокумента.Перевозчик); Исключение КонецПопытки;
		Если НЕ Заполнено И ЗначениеЗаполнено(ПредложенияСтрока.Перевозчик) Тогда
			ПеревозчикНайден = НайтиЭлементСFallback("Перевозчики", ПредложенияСтрока.Перевозчик);
			Если ЗначениеЗаполнено(ПеревозчикНайден) Тогда
				ОбъектДокумента.Перевозчик = ПеревозчикНайден;
			КонецЕсли;
		КонецЕсли;
		Заполнено = Истина;
		Попытка Заполнено = ЗначениеЗаполнено(ОбъектДокумента.ОсновноеТС); Исключение КонецПопытки;
		Если НЕ Заполнено И ЗначениеЗаполнено(ПредложенияСтрока.ТС) Тогда
			НомерОсновногоТС = ИзвлечьОсновнойНомерТС(ПредложенияСтрока.ТС);
			Если ЗначениеЗаполнено(НомерОсновногоТС) Тогда
				ТСНайдено = НайтиЭлементСFallback("ТранспортныеСредства", НомерОсновногоТС);
				Если ЗначениеЗаполнено(ТСНайдено) Тогда
					ОбъектДокумента.ОсновноеТС = ТСНайдено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// Доработка END

		// Доработка START {ОПП-fix-recalc 2026-05-04}: пересчёт цен после обогащения.
		// Тип учёта строки ТЧ изменён (ТолькоОбеспечение/пусто → Комплекс),
		// сумма документа должна перерасчитаться через тарифы. ОбменДанными.Загрузка
		// отключает ПередЗаписью/ПриЗаписи — поэтому пересчёт делаем явно.
		// Защищаем Попыткой: если расчёт упадёт (нет тарифов, пустые ТО),
		// обогащение не должно откатываться — оператор пересчитает вручную.
		Попытка
			исРасчет.ОбновитьЦеныНаСервере(ОбъектДокумента);
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.Комплекс.ПересчётНеУдался",
				УровеньЖурналаРегистрации.Предупреждение, , ОбъектДокумента.Ссылка,
				ОписаниеОшибки());
		КонецПопытки;
		// Доработка END

		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();

		// {audit 2026-05-19 CRIT #3}: авто-пометка дублей ТДФайл удалением — отключена.
		// Найденные дубли по НомерЭТД=РегНомерТД только ЛОГИРУЮТСЯ для оператора.
		// Оператор сам решает: пометить/удалить или оставить.
		Попытка
			ЗапросДубль = Новый Запрос;
			ЗапросДубль.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Дубль.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ОперацияПоПоручительству КАК Дубль
			|ГДЕ
			|	Дубль.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручительства.ТДФайл)
			|	И Дубль.НомерЭТД = &РегНомерТД
			|	И НЕ Дубль.ПометкаУдаления
			|	И Дубль.Ссылка <> &АктуальныйДок";
			ЗапросДубль.УстановитьПараметр("РегНомерТД", ПредложенияСтрока.РегНомерТД);
			ЗапросДубль.УстановитьПараметр("АктуальныйДок", ОбъектДокумента.Ссылка);
			ВыборкаДубль = ЗапросДубль.Выполнить().Выбрать();
			Пока ВыборкаДубль.Следующий() Цикл
				ЗаписьЖурналаРегистрации(
					"РусскийТранзит.ЗагрузкаРееструТД.НайденДубльТДФайл",
					УровеньЖурналаРегистрации.Предупреждение, , ВыборкаДубль.Ссылка,
					СтрШаблон("Найден дубль ТДФайл с НомерЭТД=%1. Актуальный документ: %2. "
						+ "Решение об удалении/пометке оставлено оператору.",
						ПредложенияСтрока.РегНомерТД, Строка(ОбъектДокумента.Ссылка)));
			КонецЦикла;
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.ПоискДублейТДФайл.Ошибка",
				УровеньЖурналаРегистрации.Предупреждение, , ОбъектДокумента.Ссылка,
				ОписаниеОшибки());
		КонецПопытки;

		Возврат Истина;
	Исключение
		МассивОшибок.Добавить(СтрШаблон("Комплекс %1: %2",
			ПредложенияСтрока.НомерДДПТД, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Помечает КОНКРЕТНУЮ строку ТЧ ДанныеДокументов (по НомерСтрокиТЧ) ТипУчета=ТолькоОбеспечение.
Функция ПометитьТолькоОбеспечение(ПредложенияСтрока, МассивОшибок)

	Если НЕ ЗначениеЗаполнено(ПредложенияСтрока.СсылкаДокумент) ИЛИ ПредложенияСтрока.НомерСтрокиТЧ = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		// {audit 2026-05-19 HIGH #14}: блокировка перед ПолучитьОбъект().
		Блокировка = Новый БлокировкаДанных;
		ЭлБлокировки = Блокировка.Добавить("Документ.ОперацияПоПоручительству");
		ЭлБлокировки.УстановитьЗначение("Ссылка", ПредложенияСтрока.СсылкаДокумент);
		ЭлБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		ОбъектДокумента = ПредложенияСтрока.СсылкаДокумент.ПолучитьОбъект();
		Если ОбъектДокумента = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Найдена = Ложь;
		Для Каждого СтрокаТЧ Из ОбъектДокумента.ДанныеДокументов Цикл
			Если СтрокаТЧ.НомерСтроки <> ПредложенияСтрока.НомерСтрокиТЧ Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоОбеспечение;
			Найдена = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ Найдена Тогда
			МассивОшибок.Добавить(СтрШаблон("ТолькоОбеспечение: строка ТЧ №%1 не найдена в документе %2",
				ПредложенияСтрока.НомерСтрокиТЧ, ПредложенияСтрока.СсылкаДокумент));
			Возврат Ложь;
		КонецЕсли;

		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();
		Возврат Истина;
	Исключение
		МассивОшибок.Добавить(СтрШаблон("ТолькоОбеспечение %1: %2",
			ПредложенияСтрока.СсылкаДокумент, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Доработка {Perf #3 2026-05-01}: добавлен обязательный параметр КешРеквизитов
// (Структура с полями Организация, Валюта). Раньше внутри функции вызывались
// ОрганизацияПоУмолчанию() и ВалютаПоУмолчанию() — оба создавали query-in-loop
// при вызове из ПрименитьКлассификацию. Теперь обе предзагружаются один раз
// вне цикла и передаются структурой.
// {audit 2026-05-19 HIGH #5}: добавлен опциональный КартаСуществующих — Соответствие
// "НомерГТД (ключ)" → СправочникСсылка. Если передана — lookup в карте вместо запроса.
// Экспорт для unit-тестов (вызывается из цикла ПрименитьКлассификацию).
Функция СоздатьНовыйДокументТД(ПредложенияСтрока, МассивОшибок, КешРеквизитов, СтатусВозврата = Неопределено, КартаСуществующих = Неопределено) Экспорт

	// {fix-dup-v3 2026-05-15}: вариант B — при совпадении НомерДДП с существующим ОПП:
	//   * если в его ТЧ ДанныеДокументов уже есть строка с УникальныйИдентификатор=РегНомерТД
	//     → ПОЛНЫЙ дубль (ПропущеноДублей++);
	//   * иначе добавляем строку в ТЧ существующего ОПП и записываем (Дозаполнено++).
	// СтатусВозврата (out-структура) различает: «Дозаполнен», «Дубль», или ни то, ни другое.
	Если ЗначениеЗаполнено(ПредложенияСтрока.НомерДДПТД) Тогда
		КлючДубля = ПредложенияСтрока.НомерДДПТД;
	Иначе
		КлючДубля = ПредложенияСтрока.РегНомерТД;
	КонецЕсли;
	Если ЗначениеЗаполнено(КлючДубля) Тогда
		// {audit 2026-05-19 HIGH #5}: lookup в предзагруженной карте если она передана.
		СсылкаСуществующего = Неопределено;
		Если ТипЗнч(КартаСуществующих) = Тип("Соответствие") Тогда
			СсылкаСуществующего = КартаСуществующих.Получить(СокрЛП(КлючДубля));
		Иначе
			// Fallback (вызов без карты — например из unit-тестов): запрос в БД.
			ЗапросДубль = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ОперацияПоПоручительству ГДЕ НомерГТД = &Н И НЕ ПометкаУдаления");
			ЗапросДубль.УстановитьПараметр("Н", КлючДубля);
			РезД = ЗапросДубль.Выполнить();
			Если НЕ РезД.Пустой() Тогда
				СсылкаСуществующего = РезД.Выгрузить()[0].Ссылка;
			КонецЕсли;
		КонецЕсли;
		Если СсылкаСуществующего <> Неопределено И ЗначениеЗаполнено(СсылкаСуществующего) Тогда
			// {audit 2026-05-19 HIGH #14}: блокировка перед ПолучитьОбъект().
			Блокировка = Новый БлокировкаДанных;
			ЭлБлокировки = Блокировка.Добавить("Документ.ОперацияПоПоручительству");
			ЭлБлокировки.УстановитьЗначение("Ссылка", СсылкаСуществующего);
			ЭлБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			СуществующийДок = СсылкаСуществующего.ПолучитьОбъект();
			// Проверка полного дубля по УникальныйИдентификатор (=РегНомерТД).
			// Запоминаем найденную строку — пригодится для переквалификации (v5).
			РегТД = СокрЛП(ПредложенияСтрока.РегНомерТД);
			СтрокаТЧНайдена = Неопределено;
			Если ЗначениеЗаполнено(РегТД) Тогда
				Для Каждого СтрТЧ Из СуществующийДок.ДанныеДокументов Цикл
					Попытка
						Если СокрЛП(СтрТЧ.УникальныйИдентификатор) = РегТД Тогда
							СтрокаТЧНайдена = СтрТЧ; Прервать;
						КонецЕсли;
					Исключение КонецПопытки;
				КонецЦикла;
			КонецЕсли;
			Если СтрокаТЧНайдена <> Неопределено Тогда
				// {audit 2026-05-19 v5}: для категории «НоваяТД» — АВТОМАТИЧЕСКАЯ переквалификация
				// в ТолькоТД (раньше требовала отдельную кнопку). Бизнес-смысл: ТД пришла
				// самостоятельно (без нашего формата ДДП) — значит это не Комплекс, а ТолькоТД.
				Если ПредложенияСтрока.Категория = "НоваяТД" Тогда
					Попытка
						Если СтрокаТЧНайдена.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоТД Тогда
							// Уже ТолькоТД — нечего менять, считаем как дубль.
							Если ТипЗнч(СтатусВозврата) = Тип("Структура") Тогда
								СтатусВозврата.Вставить("Дубль", Истина);
								СтатусВозврата.Вставить("СсылкаНаОПП", СсылкаСуществующего);
							КонецЕсли;
							Возврат Ложь;
						КонецЕсли;
						СтрокаТЧНайдена.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоТД;
						СуществующийДок.ОбменДанными.Загрузка = Истина;
						СуществующийДок.Записать();
						Если ТипЗнч(СтатусВозврата) = Тип("Структура") Тогда
							СтатусВозврата.Вставить("Переквалифицирован", Истина);
							СтатусВозврата.Вставить("СсылкаНаОПП", СсылкаСуществующего);
						КонецЕсли;
						ЗаписьЖурналаРегистрации("РусскийТранзит.ЗагрузкаРееструТД.Переквалификация",
							УровеньЖурналаРегистрации.Информация,,СсылкаСуществующего,
							СтрШаблон("РегНомерТД=%1: ТипУчета строки ТЧ → ТолькоТД (auto)", РегТД));
						Возврат Истина;
					Исключение
						МассивОшибок.Добавить(СтрШаблон("Переквалификация %1: %2",
							РегТД, ОписаниеОшибки()));
						Если ТипЗнч(СтатусВозврата) = Тип("Структура") Тогда
							СтатусВозврата.Вставить("Дубль", Истина);
							СтатусВозврата.Вставить("СсылкаНаОПП", СсылкаСуществующего);
						КонецЕсли;
						Возврат Ложь;
					КонецПопытки;
				КонецЕсли;
				// НовыйКомплекс с полным дублем — пропуск (как раньше).
				Если ТипЗнч(СтатусВозврата) = Тип("Структура") Тогда
					СтатусВозврата.Вставить("Дубль", Истина);
					СтатусВозврата.Вставить("СсылкаНаОПП", СсылкаСуществующего);
				КонецЕсли;
				ЗаписьЖурналаРегистрации("РусскийТранзит.ЗагрузкаРееструТД.ДубльПолный",
					УровеньЖурналаРегистрации.Информация,,,
					СтрШаблон("РегНомерТД=%1 уже в ТЧ ДД (НомерДДП=%2)", РегТД, КлючДубля));
				Возврат Ложь;
			КонецЕсли;
			// Дозаполнение: добавляем строку ТЧ в существующий ОПП
			Попытка
				НоваяДД = СуществующийДок.ДанныеДокументов.Добавить();
				НоваяДД.НомерГТД = ПредложенияСтрока.РегНомерТД;
				Попытка НоваяДД.УникальныйИдентификатор = ПредложенияСтрока.РегНомерТД; Исключение КонецПопытки;
				Если ПредложенияСтрока.Категория = "НоваяТД" Тогда
					Попытка НоваяДД.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоТД; Исключение КонецПопытки;
				Иначе
					Попытка НоваяДД.ТипУчета = Перечисления.ТипыУчетаКлиентов.Комплекс; Исключение КонецПопытки;
				КонецЕсли;
				НоваяДД.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
				Попытка НоваяДД.КоличествоУникальныхКодовТНВЭД = ПредложенияСтрока.КоличествоКодовТНВЭД; Исключение КонецПопытки;
				Попытка
					Если ЗначениеЗаполнено(ПредложенияСтрока.Контрагент) Тогда
						НоваяДД.Контрагент = ПредложенияСтрока.Контрагент;
					КонецЕсли;
				Исключение КонецПопытки;
				Попытка
					Если ЗначениеЗаполнено(ПредложенияСтрока.Декларант) Тогда
						НоваяДД.Декларант = НайтиЭлементСFallback("Декларанты", ПредложенияСтрока.Декларант);
					КонецЕсли;
				Исключение КонецПопытки;
				СуществующийДок.Записать();
				Если ТипЗнч(СтатусВозврата) = Тип("Структура") Тогда
					СтатусВозврата.Вставить("Дозаполнен", Истина);
					// {audit 2026-05-19 v4}: ссылка на ОПП в который дозаполнили.
					СтатусВозврата.Вставить("СсылкаНаОПП", СсылкаСуществующего);
				КонецЕсли;
				ЗаписьЖурналаРегистрации("РусскийТранзит.ЗагрузкаРееструТД.ДозаполнениеТЧ",
					УровеньЖурналаРегистрации.Информация,,,
					СтрШаблон("ОПП с НомерДДП=%1 дозаполнен строкой РегНомерТД=%2", КлючДубля, РегТД));
				Возврат Истина;
			Исключение
				МассивОшибок.Добавить(СтрШаблон("Дозаполнение [%1]: %2",
					ПредложенияСтрока.РегНомерТД, ОписаниеОшибки()));
				Возврат Ложь;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	// Доработка {P1-fix 2026-05-03}: пустая ДатаВыпуска в CSV → отказ от создания.
	// Раньше брали ТекущаяДатаСеанса() — документ уезжал с текущей датой вместо настоящей,
	// что искажало учёт. Лучше явно отказать и записать ошибку.
	Если НЕ ЗначениеЗаполнено(ПредложенияСтрока.ДатаВыпуска) Тогда
		МассивОшибок.Добавить(СтрШаблон("НоваяТД %1: пустая «Дата выпуска» в CSV — документ не создан. Проверьте строку в Сигме.",
			ПредложенияСтрока.РегНомерТД));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		НовыйДокумент = Документы.ОперацияПоПоручительству.СоздатьДокумент();

		// Базовые реквизиты шапки
		НовыйДокумент.Дата = ПредложенияСтрока.ДатаВыпуска;
		НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийПоручительства.ТДФайл;
		// Доработка START {ОПП-fix #3 2026-05-04}: разделение НомерГТД и НомерЭТД
		// До правки оба поля = РегНомерТД (семантически неверно). ДДП ТД — номер общей
		// декларации поручительства, РегНомерТД — индивидуальный номер транзитной декларации.
		Если ЗначениеЗаполнено(ПредложенияСтрока.НомерДДПТД) Тогда
			НовыйДокумент.НомерГТД = ПредложенияСтрока.НомерДДПТД;
		Иначе
			НовыйДокумент.НомерГТД = ПредложенияСтрока.РегНомерТД;
		КонецЕсли;
		НовыйДокумент.НомерЭТД = ПредложенияСтрока.РегНомерТД;
		// Доработка END
		НовыйДокумент.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
		НовыйДокумент.СуммаОбеспечения = 0;
		НовыйДокумент.СуммаДокумента = 0;
		НовыйДокумент.РазмерПоручительства = 0;
		// Доработка {ОПП-fix-comment 2026-05-04}: убран автокомментарий — оставляем только
		// исходный комментарий из CSV (там лежат email и пометки оператора, не путаем своими).
		НовыйДокумент.Комментарий = ПредложенияСтрока.Комментарий;

		// Обязательные реквизиты (FillChecking=ShowError) — иначе документ не пишется
		НовыйДокумент.Организация = КешРеквизитов.Организация;
		// Доработка {ОПП-fix #6 2026-05-04}: ТребуетРучнойКорректировки вместо НеРассчитан.
		// Часть обязательных реквизитов всё ещё может быть пустой (Контрагент, иногда ОсновноеТС
		// если госномер не в справочнике) — статус показывает что документ ещё не готов.
		НовыйДокумент.СтатусОперации = Перечисления.СтатусыОпераций.ТребуетРучнойКорректировки;
		// Доработка {ОПП-fix-data 2026-05-04}: ВалютаДокумента — из CSV col [42] (USD/EUR/RUB),
		// fallback на КешРеквизитов.Валюта (RUB). ВалютаОбеспечения и ВалютаОплаты — всегда RUB.
		// Обращение к КодВалюты — новое поле, защищаем Попыткой на случай старой ТЧ формы.
		НовыйДокумент.ВалютаОбеспечения = КешРеквизитов.Валюта;
		НовыйДокумент.ВалютаОплаты = КешРеквизитов.Валюта;
		НовыйДокумент.ВалютаДокумента = КешРеквизитов.Валюта;
		Попытка
			НовыйДокумент.ВалютаДокумента = ВалютаПоКоду(ПредложенияСтрока.КодВалюты, КешРеквизитов.Валюта);
		Исключение КонецПопытки;

		// Статус транзита из CSV col #12 (SPEC v2 §4.2). Ставим в шапке —
		// для НоваяТД это всегда инициализация (пустого значения было нет).
		НовыйДокумент.СтатусТранзита = МаппингСтатусаТранзита(ПредложенияСтрока.СтатусПроцесса);

		// Декларант (CSV col #23) и Перевозчик (CSV col #24) — раздельно через справочники
		// с fallback на сокращённое наименование (SPEC v2 §7).
		Если ЗначениеЗаполнено(ПредложенияСтрока.Декларант) Тогда
			НовыйДокумент.Декларант = НайтиЭлементСFallback("Декларанты", ПредложенияСтрока.Декларант);
		КонецЕсли;
		// ВНИМАНИЕ: Перевозчик берётся из отдельной колонки CSV «Наименование перевозчика»,
		// а не из Декларанта. До правки 2026-05-01 был баг — оба поля ставились из Декларанта.
		Если ЗначениеЗаполнено(ПредложенияСтрока.Перевозчик) Тогда
			НовыйДокумент.Перевозчик = НайтиЭлементСFallback("Перевозчики", ПредложенияСтрока.Перевозчик);
		КонецЕсли;

		// Контрагент (если найден) и его ИНН
		Если ЗначениеЗаполнено(ПредложенияСтрока.Контрагент) Тогда
			НовыйДокумент.Контрагент = ПредложенияСтрока.Контрагент;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПредложенияСтрока.ИННПолучателя) Тогда
			НовыйДокумент.ИННКонтрагента = ПредложенияСтрока.ИННПолучателя;
		КонецЕсли;

		// Менеджер / Ответственный = текущий пользователь
		ТекПользователь = ТекущийПользователь();
		Если ЗначениеЗаполнено(ТекПользователь) Тогда
			НовыйДокумент.Менеджер = ТекПользователь;
			НовыйДокумент.Ответственный = ТекПользователь;
		КонецЕсли;

		// Доработка START {ОПП-fix #1 2026-05-04}: ОсновноеТС из CSV col #10 (lookup в справочнике).
		// Раньше поле оставалось пустым → документ не проходил ПроверитьЗаполнениеДокумента
		// и оставался непроведённым черновиком. CSV содержит ТС в формате '1:M367MM32/34ZN2410',
		// извлекаем основной номер через ИзвлечьОсновнойНомерТС() и ищем по справочнику.
		Если ЗначениеЗаполнено(ПредложенияСтрока.ТС) Тогда
			НомерОсновногоТС = ИзвлечьОсновнойНомерТС(ПредложенияСтрока.ТС);
			Если ЗначениеЗаполнено(НомерОсновногоТС) Тогда
				ОсновноеТСНайдено = НайтиЭлементСFallback("ТранспортныеСредства", НомерОсновногоТС);
				Если ЗначениеЗаполнено(ОсновноеТСНайдено) Тогда
					НовыйДокумент.ОсновноеТС = ОсновноеТСНайдено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// Доработка END

		// Доработка START {ОПП-fix-data 2026-05-04}: блок дозаполнения из дополнительных
		// колонок CSV. Каждый sub-блок защищён отдельным Попытка — если один lookup упадёт
		// (например, справочника Водители нет, или реквизита Код у ТаможенныеПункты),
		// остальные поля всё равно заполнятся. До этого фикса один сбой ломал весь документ.

		// CMR (col [10] Номер трансп. док-та) → НомераCMR + КоличествоCMR + ТЧ КодыCMR
		Попытка
			Если ЗначениеЗаполнено(ПредложенияСтрока.НомерТрансДок) Тогда
				НовыйДокумент.НомераCMR = ПредложенияСтрока.НомерТрансДок;
				НовыйДокумент.КоличествоCMR = 1;
				// Доработка {ОПП-fix-cmr 2026-05-04}: заполняем ТЧ КодыCMR одной строкой
				// (по образцу API-загрузки в ЧтениеДеклараций). Цена = СтоимостьТоваров,
				// Валюта = ВалютаДокумента, ЭТД = РегНомерТД.
				ЦМР = НовыйДокумент.КодыCMR.Добавить();
				ЦМР.НомерCMR = ПредложенияСтрока.НомерТрансДок;
				Попытка
					ЦМР.ЭТД = ПредложенияСтрока.РегНомерТД;
				Исключение КонецПопытки;
				Попытка
					ЦМР.Цена = ПредложенияСтрока.СтоимостьТоваров;
				Исключение КонецПопытки;
				Попытка
					ЦМР.Валюта = НовыйДокумент.ВалютаДокумента;
				Исключение КонецПопытки;
				Попытка
					ЦМР.КоличествоКодов = ПредложенияСтрока.КоличествоКодовТНВЭД;
				Исключение КонецПопытки;
			Иначе
				НовыйДокумент.КоличествоCMR = 0;
			КонецЕсли;
		Исключение КонецПопытки;

		// Пункт назначения (col [40] Код ТО назн. + [41] Наим.)
		Попытка
			ПунктНазначения = ТаможенныйПунктПоКоду(
				ПредложенияСтрока.КодТОНазначения, ПредложенияСтрока.НаимТОНазначения);
			Если ЗначениеЗаполнено(ПунктНазначения) Тогда
				НовыйДокумент.ПунктНазначения = ПунктНазначения;
			КонецЕсли;
		Исключение КонецПопытки;

		// Пункт отправления (col [81] Код ТО ТД — где ТД оформлена)
		Попытка
			ПунктОтправления = ТаможенныйПунктПоКоду(ПредложенияСтрока.КодТОТД);
			Если ЗначениеЗаполнено(ПунктОтправления) Тогда
				НовыйДокумент.ПунктОтправления = ПунктОтправления;
			КонецЕсли;
		Исключение КонецПопытки;

		// Доработка {ОПП-fix-distance 2026-05-04}: подтягиваем Расстояние из
		// РегистрСведений.РасстоянияМеждуТаможеннымиПунктами по паре (Отправление, Назначение).
		// В CSV «Отчёт по журналу ЭТД» нет колонки расстояния — в API оно берётся из
		// GCA_TARIFFDISTANCE, но в файле этого поля нет. Поэтому ищем в регистре.
		// Используем JOIN по НАИМЕНОВАНИЮ ТО — справочник ТаможенныеПункты содержит
		// дубли (один ТО = две ссылки: с кодом ФТС и с внутренним кодом 000000XXX),
		// и регистр заполнен преимущественно ссылками с внутренними кодами.
		// Покрытие на текущих данных: 31 из 48 (65%) ОПП с заполненными пунктами.
		Попытка
			Если ЗначениеЗаполнено(НовыйДокумент.ПунктОтправления)
				И ЗначениеЗаполнено(НовыйДокумент.ПунктНазначения) Тогда
				ЗапросРасстояния = Новый Запрос;
				// {audit 2026-05-19 HIGH #9}: явный JOIN со справочником вместо точки в ГДЕ.
				// Раньше «Р.ПунктОтправления.Наименование = &Н» создавал неявный JOIN
				// без контроля плана и без индекса по Наименование.
				ЗапросРасстояния.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	Р.Расстояние КАК Расстояние
				|ИЗ
				|	РегистрСведений.РасстоянияМеждуТаможеннымиПунктами КАК Р
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТаможенныеПункты КАК ПунктОтпр
				|		ПО Р.ПунктОтправления = ПунктОтпр.Ссылка
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТаможенныеПункты КАК ПунктНазн
				|		ПО Р.ПунктНазначения = ПунктНазн.Ссылка
				|ГДЕ
				|	ПунктОтпр.Наименование = &НаимОтпр
				|	И ПунктНазн.Наименование = &НаимНазн
				|	И Р.Расстояние > 0";
				ЗапросРасстояния.УстановитьПараметр("НаимОтпр",
					НовыйДокумент.ПунктОтправления.Наименование);
				ЗапросРасстояния.УстановитьПараметр("НаимНазн",
					НовыйДокумент.ПунктНазначения.Наименование);
				ВыборкаРасстояния = ЗапросРасстояния.Выполнить().Выбрать();
				Если ВыборкаРасстояния.Следующий() И ВыборкаРасстояния.Расстояние > 0 Тогда
					НовыйДокумент.Расстояние = ВыборкаРасстояния.Расстояние;
					НовыйДокумент.РасстояниеИтог = ВыборкаРасстояния.Расстояние;
				КонецЕсли;
			КонецЕсли;
		Исключение КонецПопытки;

		// Принципал — единственный из справочника (CSV col [64] заполнен в 2.7%).
		Попытка
			Если ЗначениеЗаполнено(КешРеквизитов.Принципал) Тогда
				НовыйДокумент.Принципал = КешРеквизитов.Принципал;
			КонецЕсли;
		Исключение КонецПопытки;

		// Стоимость и размер (col [43] Стоимость товаров, [95] Размер поручительства)
		Попытка
			Если ПредложенияСтрока.СтоимостьТоваров > 0 Тогда
				НовыйДокумент.СуммаДокумента = ПредложенияСтрока.СтоимостьТоваров;
			КонецЕсли;
			Если ПредложенияСтрока.РазмерПоручительства > 0 Тогда
				НовыйДокумент.РазмерПоручительства = ПредложенияСтрока.РазмерПоручительства;
			КонецЕсли;
		Исключение КонецПопытки;

		// Водитель (col [26] ФИО водителя). Если справочника Водители нет — Попытка проглотит.
		Попытка
			Если ЗначениеЗаполнено(ПредложенияСтрока.ФИОВодителя) Тогда
				ВодительНайден = НайтиЭлементСFallback("Водители", ПредложенияСтрока.ФИОВодителя);
				Если ЗначениеЗаполнено(ВодительНайден) Тогда
					НовыйДокумент.Водитель = ВодительНайден;
				КонецЕсли;
			КонецЕсли;
		Исключение КонецПопытки;

		// Сроки транзита и завершения (col [28], [29])
		Попытка
			Если ЗначениеЗаполнено(ПредложенияСтрока.СрокДоставки) Тогда
				НовыйДокумент.СрокТранзита = ПредложенияСтрока.СрокДоставки;
			КонецЕсли;
			Если ЗначениеЗаполнено(ПредложенияСтрока.ДатаЗавершенияТранзита) Тогда
				НовыйДокумент.ДатаЗавершения = ПредложенияСтрока.ДатаЗавершенияТранзита;
			КонецЕсли;
		Исключение КонецПопытки;
		// Доработка END

		// ТЧ ДанныеДокументов — заполняем по образцу API-загрузки (ЧтениеДеклараций.ЗаполнитьИзAPIОперации):
		// Контрагент, Декларант, ПунктыОтправления/Назначения, СуммаОбеспечения, СтатусТранзита,
		// ДатаОформления, КодВалюты. Каждое поле под отдельной Попыткой — если справочник пуст
		// или поле не существует, остальные всё равно заполнятся.
	    НоваяСтрокаТЧ = НовыйДокумент.ДанныеДокументов.Добавить();
		// {audit 2026-05-19 v7}: ДД.НомерГТД = тот же ключ что в шапке (ДДП если есть,
		// иначе РегНомер). Так при повторной классификации Шаг 1 ловит ОПП по тому же
		// ключу, по которому он был создан — нет ложно-новых записей.
		// УникальныйИдентификатор = РегНомерТД — для проверки полного дубля при дозаполнении.
		Если ЗначениеЗаполнено(ПредложенияСтрока.НомерДДПТД) Тогда
			НоваяСтрокаТЧ.НомерГТД = ПредложенияСтрока.НомерДДПТД;
		Иначе
			НоваяСтрокаТЧ.НомерГТД = ПредложенияСтрока.РегНомерТД;
		КонецЕсли;
		Попытка НоваяСтрокаТЧ.УникальныйИдентификатор = ПредложенияСтрока.РегНомерТД; Исключение КонецПопытки;
		Если ПредложенияСтрока.Категория = "НоваяТД" Тогда
			НоваяСтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоТД;
		Иначе
			НоваяСтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.Комплекс;
		КонецЕсли;
		НоваяСтрокаТЧ.ДатаОформления = ПредложенияСтрока.ДатаВыпуска;
		НоваяСтрокаТЧ.КоличествоУникальныхКодовТНВЭД = ПредложенияСтрока.КоличествоКодовТНВЭД;
		Попытка
			НоваяСтрокаТЧ.Контрагент = НовыйДокумент.Контрагент;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.Декларант = НовыйДокумент.Декларант;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.ПунктОтправления = НовыйДокумент.ПунктОтправления;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.ПунктНазначения = НовыйДокумент.ПунктНазначения;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.СуммаОбеспечения = НовыйДокумент.РазмерПоручительства;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.Валюта = НовыйДокумент.ВалютаОбеспечения;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.СтатусТранзита = НовыйДокумент.СтатусТранзита;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.СрокТранзита = НовыйДокумент.СрокТранзита;
		Исключение КонецПопытки;
		Попытка
			НоваяСтрокаТЧ.ДатаЗавершения = НовыйДокумент.ДатаЗавершения;
		Исключение КонецПопытки;
		// Доработка {ОПП-fix-distance 2026-05-04}: расстояние в ТЧ ДанныеДокументов
		// (по образцу API-загрузки). Берём из шапки — там оно уже подставлено из регистра.
		Попытка
			НоваяСтрокаТЧ.Расстояние = НовыйДокумент.Расстояние;
		Исключение КонецПопытки;

		// ОбменДанными.Загрузка отключает проверки заполнения и обработчики записи —
		// документ создаётся как ЧЕРНОВИК (не проводится). Пользователь дозаполнит
		// недостающее (Контрагент / Декларант) и проведёт вручную.
		НовыйДокумент.ОбменДанными.Загрузка = Истина;
		НовыйДокумент.Записать();
		// {audit 2026-05-19 v4}: ссылка на созданный ОПП — для отображения в форме.
		Если ТипЗнч(СтатусВозврата) = Тип("Структура") Тогда
			СтатусВозврата.Вставить("СсылкаНаОПП", НовыйДокумент.Ссылка);
		КонецЕсли;
		Возврат Истина;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		МассивОшибок.Добавить(СтрШаблон("НоваяТД %1: %2", ПредложенияСтрока.РегНомерТД, ТекстОшибки));
		// Доработка {Diag 2026-05-04}: дополнительный логгинг полной ошибки в ЖР для диагностики.
		// До этого ошибки накапливались в МассивОшибок и показывались пользователю в форме,
		// но если их 78 — пользователь не дожимал, теряли стектрейс.
		// Логгинг защищён Попыткой — если ТЧ формы старая и нет новых полей,
		// чтобы сам логгинг не упал на обращении к ним.
		Попытка
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.СозданиеНовойТД.Ошибка",
				УровеньЖурналаРегистрации.Ошибка, , ,
				СтрШаблон("РегНомер=%1 ОшибкаПолн=%2",
					ПредложенияСтрока.РегНомерТД, ТекстОшибки));
		Исключение КонецПопытки;
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Возвращает первую активную организацию (используется как дефолт для новых документов).
// Экспорт для unit-тестов.
Функция ОрганизацияПоУмолчанию() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	О.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК О
	|ГДЕ
	|	НЕ О.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	О.Наименование";
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

// Возвращает RUB (или первую валюту из справочника, если RUB не найдена).
// Экспорт для unit-тестов.
Функция ВалютаПоУмолчанию() Экспорт

	// Доработка {Bug-fix 2026-05-01}: алиас "В" — зарезервированное слово 1С (оператор включения).
	// Заменён на "Вал" — синтаксическая ошибка обнаружена через YAxUnit-тест после Refactor #3.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Вал.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Вал
	|ГДЕ
	|	НЕ Вал.ПометкаУдаления
	|	И Вал.Наименование = ""RUB""";
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Валюты.ПустаяСсылка();

КонецФункции

// Доработка {ОПП-fix-data 2026-05-04}: lookup валюты по коду из CSV (USD/EUR/RUB/CNY ...).
// Возвращает ссылку или ВалютаПоУмолчанию() если не найдена.
// Экспорт для unit-тестов.
Функция ВалютаПоКоду(КодВалюты, ВалютаДефолт) Экспорт

	Если НЕ ЗначениеЗаполнено(КодВалюты) Тогда
		Возврат ВалютаДефолт;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Вал.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Вал
	|ГДЕ
	|	НЕ Вал.ПометкаУдаления
	|	И Вал.Наименование = &Код";
	Запрос.УстановитьПараметр("Код", СокрЛП(КодВалюты));
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() > 0 Тогда
		Возврат РезультатЗапроса[0].Ссылка;
	КонецЕсли;
	Возврат ВалютаДефолт;

КонецФункции

// Доработка {ОПП-fix-data 2026-05-04}: единственный непомеченный Принципал из справочника.
// Если в справочнике РОВНО 1 непомеченный — авто-подставляем в новые ОПП. Иначе пусто
// (оператор дозаполнит вручную). Бизнес-решение: по факту у Русского Транзита один Принципал
// (РТ-Сервис), поэтому heuristic безопасен.
// Экспорт для unit-тестов.
Функция ПринципалПоУмолчанию() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Прц.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Принципалы КАК Прц
	|ГДЕ
	|	НЕ Прц.ПометкаУдаления";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() = 1 Тогда
		Возврат РезультатЗапроса[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Принципалы.ПустаяСсылка();

КонецФункции

// Доработка {ОПП-fix-data 2026-05-04}: lookup ТаможенногоПункта по коду из CSV (col #40, #81).
// Алгоритм: НайтиПоКоду → fallback на наименование. НайтиПоКоду молча возвращает пусто
// если у справочника тип кода другой или нет такого кода — попыткой ловим преобразования.
// Экспорт для unit-тестов.
Функция ТаможенныйПунктПоКоду(КодТаможни, НаименованиеFallback = "") Экспорт

	КодЧистый = СокрЛП(КодТаможни);

	Если ЗначениеЗаполнено(КодЧистый) Тогда
		Попытка
			Ссылка = Справочники.ТаможенныеПункты.НайтиПоКоду(КодЧистый);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
			// Тип кода не подходит (Число vs Строка) — переходим к fallback.
		КонецПопытки;
	КонецЕсли;

	НаимЧистое = СокрЛП(НаименованиеFallback);
	Если ЗначениеЗаполнено(НаимЧистое) Тогда
		Попытка
			СсылкаНайдена = Справочники.ТаможенныеПункты.НайтиПоНаименованию(НаимЧистое, Истина);
			Если ЗначениеЗаполнено(СсылкаНайдена) Тогда
				Возврат СсылкаНайдена;
			КонецЕсли;
		Исключение
			// Справочника нет — пустая ссылка.
		КонецПопытки;
	КонецЕсли;

	// {audit 2026-05-19 v9}: автосоздание ТаможенногоПункта если есть код или наименование
	// из CSV. Раньше функция возвращала пустую ссылку → ПунктОтправления/Назначения в ОПП
	// оставались пустыми, расчёт расстояния не работал. Теперь создаём элемент справочника.
	// Расстояние НЕ создаётся — в CSV «Отчёт по журналу ЭТД» нет колонки расстояния
	// (в API оно есть как GCA_TARIFFDISTANCE, в файле — нет). Оператор внесёт вручную
	// в РегистрСведений.РасстоянияМеждуТаможеннымиПунктами для пары пунктов.
	Если НЕ ЗначениеЗаполнено(КодЧистый) И НЕ ЗначениеЗаполнено(НаимЧистое) Тогда
		Возврат Справочники.ТаможенныеПункты.ПустаяСсылка();
	КонецЕсли;

	Попытка
		НовыйПункт = Справочники.ТаможенныеПункты.СоздатьЭлемент();
		Если ЗначениеЗаполнено(КодЧистый) Тогда
			Попытка НовыйПункт.Код = КодЧистый; Исключение КонецПопытки;
		КонецЕсли;
		Если ЗначениеЗаполнено(НаимЧистое) Тогда
			НовыйПункт.Наименование = НаимЧистое;
		ИначеЕсли ЗначениеЗаполнено(КодЧистый) Тогда
			НовыйПункт.Наименование = КодЧистый;
		КонецЕсли;
		НовыйПункт.ОбменДанными.Загрузка = Истина;
		НовыйПункт.Записать();
		ЗаписьЖурналаРегистрации(
			"РусскийТранзит.ЗагрузкаРееструТД.АвтосозданиеЭлемента",
			УровеньЖурналаРегистрации.Информация, , НовыйПункт.Ссылка,
			СтрШаблон("Создан ТаможенныйПункт: Код=«%1», Наименование=«%2» (из CSV).",
				КодЧистый, НаимЧистое));
		Возврат НовыйПункт.Ссылка;
	Исключение
		ЗаписьЖурналаРегистрации(
			"РусскийТранзит.ЗагрузкаРееструТД.АвтосозданиеЭлемента.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон("Не удалось создать ТаможенныйПункт Код=«%1» Наименование=«%2»: %3. Поле оставлено пустым.",
				КодЧистый, НаимЧистое, ОписаниеОшибки()));
	КонецПопытки;

	Возврат Справочники.ТаможенныеПункты.ПустаяСсылка();

КонецФункции

// Универсальный поиск элемента справочника по точному наименованию.
// При отсутствии или дублях возвращает ПустуюСсылку.
Функция НайтиИлиПустаяСсылка(ИмяСправочника, Наименование)

	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;
	Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(СокрЛП(Наименование), Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

// Поиск элемента справочника с fallback на сокращённое наименование.
// SPEC v2 §7: точное → сокращение → авто-создание (для whitelist) → пусто.
//
// Используется для Декларанта, Перевозчика, Водителя, ОсновноеТС
// (CSV: «ИП СИДОРЕНКОВ ДМИТРИЙ АЛЕКСЕЕВИЧ» → 1С: «ИП СИДОРЕНКОВ Д.А.»).
//
// {audit 2026-05-19 v6}: авто-создание восстановлено по запросу пользователя.
// Список справочников для авто-создания (whitelist):
//   Декларанты, Перевозчики, Водители, ТранспортныеСредства.
// Контрагенты НЕ создаются (своя логика email/подразделение в ВернутьКонтрагента).
// ТаможенныеПункты НЕ создаются (привязка по коду в ТаможенныйПунктПоКоду).
//
// Защита от дублей: при повторном чтении CSV то же написание даст точное совпадение
// на Шаге 1 — повторного создания не будет. ОбменДанными.Загрузка=Истина отключает
// FillChecking, поэтому элемент запишется даже если в справочнике есть обязательные
// реквизиты — пользователь дозаполнит позже.
Функция НайтиЭлементСFallback(ИмяСправочника, Наименование) Экспорт

	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;

	Чистое = СокрЛП(Наименование);

	// Шаг 1: точное совпадение.
	Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Чистое, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	// Шаг 2: пробуем сокращённую форму.
	Сокращённое = СокращенноеНаименованиеДекларанта(Чистое);
	Если ЗначениеЗаполнено(Сокращённое) И Сокращённое <> Чистое Тогда
		Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Сокращённое, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Шаг 3: авто-создание (только для whitelist).
	СоздаютсяАвто = Новый Соответствие;
	СоздаютсяАвто.Вставить("Декларанты", Истина);
	СоздаютсяАвто.Вставить("Перевозчики", Истина);
	СоздаютсяАвто.Вставить("Водители", Истина);
	СоздаютсяАвто.Вставить("ТранспортныеСредства", Истина);

	Если СоздаютсяАвто.Получить(ИмяСправочника) = Истина Тогда
		Попытка
			НовыйЭлемент = Справочники[ИмяСправочника].СоздатьЭлемент();
			НовыйЭлемент.Наименование = Чистое;
			НовыйЭлемент.ОбменДанными.Загрузка = Истина;
			НовыйЭлемент.Записать();
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.АвтосозданиеЭлемента",
				УровеньЖурналаРегистрации.Информация, , НовыйЭлемент.Ссылка,
				СтрШаблон("Создан элемент справочника %1: «%2» (из CSV).",
					ИмяСправочника, Чистое));
			Возврат НовыйЭлемент.Ссылка;
		Исключение
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.АвтосозданиеЭлемента.Ошибка",
				УровеньЖурналаРегистрации.Ошибка, , ,
				СтрШаблон("Не удалось создать %1 «%2»: %3. Поле оставлено пустым.",
					ИмяСправочника, Чистое, ОписаниеОшибки()));
		КонецПопытки;
	Иначе
		ЗаписьЖурналаРегистрации(
			"РусскийТранзит.ЗагрузкаРееструТД.СопоставлениеСправочника",
			УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("%1: «%2» (сокращённо «%3») не найден — оставлен пустым.",
				ИмяСправочника, Чистое, Сокращённое));
	КонецЕсли;

	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

// Преобразует полное ФИО в формат «Фамилия И.О.» для ИП и физлиц.
// Для юрлиц с кавычками — снимает внешние кавычки («"INTEGER" LLC» → «INTEGER LLC»).
// SPEC v2 §7. Экспорт — для тестов T09, T10.
Функция СокращенноеНаименованиеДекларанта(Наименование) Экспорт

	Текст = СокрЛП(Наименование);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	// Юрлица в кавычках: «"INTEGER" LLC» → «INTEGER LLC».
	Если СтрНайти(Текст, """") > 0 Тогда
		Возврат СокрЛП(СтрЗаменить(Текст, """", ""));
	КонецЕсли;

	// ФИО: «ПРЕФИКС ФАМИЛИЯ ИМЯ ОТЧЕСТВО» → «ПРЕФИКС ФАМИЛИЯ И.О.» (для ИП — 4 слова).
	// Также «ФАМИЛИЯ ИМЯ ОТЧЕСТВО» → «ФАМИЛИЯ И.О.» (3 слова).
	Слова = СтрРазделить(Текст, " ", Ложь);
	Если Слова.Количество() >= 4 И ВРег(Слова[0]) = "ИП" Тогда
		Возврат "ИП " + Слова[1] + " " + Лев(Слова[2], 1) + "." + Лев(Слова[3], 1) + ".";
	ИначеЕсли Слова.Количество() = 3 Тогда
		// Эвристика: только если все слова больше 1 символа (иначе уже сокращено).
		Если СтрДлина(Слова[1]) > 1 И СтрДлина(Слова[2]) > 1 Тогда
			Возврат Слова[0] + " " + Лев(Слова[1], 1) + "." + Лев(Слова[2], 1) + ".";
		КонецЕсли;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Текущий пользователь (Справочник.Пользователи) — для Менеджер/Ответственный.
Функция ТекущийПользователь()

	ИмяТекущего = ИмяПользователя();
	Если НЕ ЗначениеЗаполнено(ИмяТекущего) Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	Ссылка = Справочники.Пользователи.НайтиПоНаименованию(ИмяТекущего, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Возврат Справочники.Пользователи.ПустаяСсылка();

КонецФункции

// Доработка {Perf #2 2026-05-01}: batch-предзагрузка соответствий Подразделение→Контрагент.
// Один запрос на все уникальные подразделения в CSV-таблице. Используется в СопоставитьСДокументами
// перед циклом — устраняет N+1 query-in-loop через ВернутьКонтрагента.
// Экспорт — для тестируемости через YAxUnit.
Функция ПостроитьМапуПодразделенийКонтрагентов(ТаблицаCSV) Экспорт

	НаборПодразделений = Новый Соответствие;
	Для Каждого СтрокаCSV Из ТаблицаCSV Цикл
		П = СокрЛП(СтрокаCSV.Подразделение);
		Если ЗначениеЗаполнено(П) Тогда
			НаборПодразделений.Вставить(П, Истина);
		КонецЕсли;
	КонецЦикла;

	Если НаборПодразделений.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Подразделения = Новый Массив;
	Для Каждого Эл Из НаборПодразделений Цикл
		Подразделения.Добавить(Эл.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоответствияПодразделений.ПодразделениеСигма КАК Подразделение,
		|	СоответствияПодразделений.Контрагент КАК Контрагент
		|ИЗ
		|	РегистрСведений.СоответствияПодразделенийКонтрагентам КАК СоответствияПодразделений
		|ГДЕ
		|	СоответствияПодразделений.ПодразделениеСигма В (&Подразделения)";
	Запрос.УстановитьПараметр("Подразделения", Подразделения);

	Мапа = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Контрагент) И Мапа.Получить(Выборка.Подразделение) = Неопределено Тогда
			Мапа.Вставить(Выборка.Подразделение, Выборка.Контрагент);
		КонецЕсли;
	КонецЦикла;

	Возврат Мапа;

КонецФункции

// {audit 2026-05-19 HIGH #5}: батч-предзагрузка карты существующих ОПП по НомерГТД.
// Собирает уникальные ключи дублей (НомерДДПТД ИЛИ РегНомерТД) из выбранных к применению
// строк-«НоваяТД/НовыйКомплекс» и одним запросом строит Соответствие.
// Заменяет N+1 запрос-в-цикле в СоздатьНовыйДокументТД.
Функция ПостроитьКартуСуществующихОПППоНомерГТД(ТаблицаПредложений) Экспорт

	НаборКлючей = Новый Соответствие;
	Для Каждого Строка Из ТаблицаПредложений Цикл
		Если НЕ Строка.Выбрать Тогда
			Продолжить;
		КонецЕсли;
		Если Строка.Категория <> "НоваяТД" И Строка.Категория <> "НовыйКомплекс" Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.НомерДДПТД) Тогда
			Ключ = СокрЛП(Строка.НомерДДПТД);
		Иначе
			Ключ = СокрЛП(Строка.РегНомерТД);
		КонецЕсли;
		Если ЗначениеЗаполнено(Ключ) Тогда
			НаборКлючей.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	Карта = Новый Соответствие;
	Если НаборКлючей.Количество() = 0 Тогда
		Возврат Карта;
	КонецЕсли;

	Ключи = Новый Массив;
	Для Каждого Эл Из НаборКлючей Цикл
		Ключи.Добавить(Эл.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОПП.Ссылка КАК Ссылка,
	|	ОПП.НомерГТД КАК НомерГТД
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК ОПП
	|ГДЕ
	|	ОПП.НомерГТД В (&Ключи)
	|	И НЕ ОПП.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ОПП.Дата";
	Запрос.УстановитьПараметр("Ключи", Ключи);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = СокрЛП(Выборка.НомерГТД);
		Если Карта.Получить(Ключ) = Неопределено Тогда
			Карта.Вставить(Ключ, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Карта;

КонецФункции

// {audit 2026-05-19 v4}: переквалифицировать существующие ОПП-дубли в «ТолькоТД».
//
// Зачем: в реестре ТД из Сигмы (CSV) приходят строки с валидным РегНомером, но без
// нашего формата НомерДДП. Если в БД уже есть ОПП с этим РегНомером (через CMR/АПИСигма
// был создан как Комплекс), значит на самом деле ТД пришла самостоятельно — нужно
// «понизить» тип учёта строки ТЧ ДанныеДокументов с «Комплекс» (или другого) на «ТолькоТД».
//
// Алгоритм:
//   1. Берём строки CSV с Категория="НоваяТД" И Выбрать=Истина (только дубли «НоваяТД»).
//   2. Строим карту существующих ОПП по НомерГТД (тот же запрос что и в Применить).
//   3. Для каждой строки ищем соответствующий ОПП в БД.
//   4. Если ОПП найден — в ТЧ ДанныеДокументов ищем строку с УникальныйИдентификатор=РегНомерТД.
//   5. Если найдена и ТипУчета<>ТолькоТД → меняем на ТолькоТД, записываем.
//
// Возвращаемое значение:
//   Структура:
//     * Переквалифицировано - Число (изменили ТипУчета на ТолькоТД)
//     * УжеТолькоТД          - Число (уже было ТолькоТД, пропустили)
//     * НеНайденоВТЧ         - Число (ОПП есть, но строки ТЧ с этим РегНомером нет)
//     * НеНайденоВБД         - Число (ОПП с таким НомерГТД нет в базе)
//     * Ошибки               - Массив строк
//     * Обновления           - ТаблицаЗначений: НомерСтроки, Исход, СсылкаДокумент
//
Функция ПереквалифицироватьВТолькоТД(ТаблицаПредложений) Экспорт

	Результат = Новый Структура("Переквалифицировано, УжеТолькоТД, НеНайденоВТЧ, НеНайденоВБД, Ошибки",
		0, 0, 0, 0, Новый Массив);

	ТипДок = Новый ОписаниеТипов("ДокументСсылка.ОперацияПоПоручительству");
	Обновления = Новый ТаблицаЗначений;
	Обновления.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Обновления.Колонки.Добавить("Исход", Новый ОписаниеТипов("Строка"));
	Обновления.Колонки.Добавить("СсылкаДокумент", ТипДок);
	Результат.Вставить("Обновления", Обновления);

	КартаОПП = ПостроитьКартуСуществующихОПППоНомерГТД(ТаблицаПредложений);
	Если КартаОПП.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Индекс = -1;
	Для Каждого Строка Из ТаблицаПредложений Цикл
		Индекс = Индекс + 1;
		Если НЕ Строка.Выбрать ИЛИ Строка.Категория <> "НоваяТД" Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Строка.НомерДДПТД) Тогда
			Ключ = СокрЛП(Строка.НомерДДПТД);
		Иначе
			Ключ = СокрЛП(Строка.РегНомерТД);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		СсылкаОПП = КартаОПП.Получить(Ключ);
		Если СсылкаОПП = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СсылкаОПП) Тогда
			Результат.НеНайденоВБД = Результат.НеНайденоВБД + 1;
			ОбнСтр = Обновления.Добавить();
			ОбнСтр.НомерСтроки = Индекс;
			ОбнСтр.Исход = "НеНайденоВБД";
			Продолжить;
		КонецЕсли;

		РегТД = СокрЛП(Строка.РегНомерТД);

		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлБлокировки = Блокировка.Добавить("Документ.ОперацияПоПоручительству");
			ЭлБлокировки.УстановитьЗначение("Ссылка", СсылкаОПП);
			ЭлБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();

			ОбъектОПП = СсылкаОПП.ПолучитьОбъект();
			Если ОбъектОПП = Неопределено Тогда
				ОтменитьТранзакцию();
				Результат.Ошибки.Добавить(СтрШаблон("ОПП %1: ПолучитьОбъект() вернул Неопределено", СсылкаОПП));
				Продолжить;
			КонецЕсли;

			НайденаСтрокаТЧ = Неопределено;
			Если ЗначениеЗаполнено(РегТД) Тогда
				Для Каждого СтрТЧ Из ОбъектОПП.ДанныеДокументов Цикл
					Попытка
						Если СокрЛП(СтрТЧ.УникальныйИдентификатор) = РегТД Тогда
							НайденаСтрокаТЧ = СтрТЧ;
							Прервать;
						КонецЕсли;
					Исключение КонецПопытки;
				КонецЦикла;
			КонецЕсли;

			Исход = "";
			Если НайденаСтрокаТЧ = Неопределено Тогда
				Результат.НеНайденоВТЧ = Результат.НеНайденоВТЧ + 1;
				Исход = "НеНайденоВТЧ";
				ОтменитьТранзакцию();
			ИначеЕсли НайденаСтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоТД Тогда
				Результат.УжеТолькоТД = Результат.УжеТолькоТД + 1;
				Исход = "УжеТолькоТД";
				ОтменитьТранзакцию();
			Иначе
				НайденаСтрокаТЧ.ТипУчета = Перечисления.ТипыУчетаКлиентов.ТолькоТД;
				ОбъектОПП.ОбменДанными.Загрузка = Истина;
				ОбъектОПП.Записать();
				ЗафиксироватьТранзакцию();
				Результат.Переквалифицировано = Результат.Переквалифицировано + 1;
				Исход = "Переквалифицирован";
				ЗаписьЖурналаРегистрации("РусскийТранзит.ЗагрузкаРееструТД.Переквалификация",
					УровеньЖурналаРегистрации.Информация,,СсылкаОПП,
					СтрШаблон("РегНомерТД=%1: ТипУчета строки ТЧ → ТолькоТД", РегТД));
			КонецЕсли;

			ОбнСтр = Обновления.Добавить();
			ОбнСтр.НомерСтроки = Индекс;
			ОбнСтр.Исход = Исход;
			ОбнСтр.СсылкаДокумент = СсылкаОПП;
		Исключение
			ОтменитьТранзакцию();
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1 (ОПП %2): %3",
				Строка.РегНомерТД, СсылкаОПП, ОписаниеОшибки()));
		КонецПопытки;
	КонецЦикла;

	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.Переквалификация.Итог",
		УровеньЖурналаРегистрации.Информация,,,
		СтрШаблон("Переквалифицировано=%1, УжеТолькоТД=%2, НеНайденоВТЧ=%3, НеНайденоВБД=%4, Ошибок=%5",
			Результат.Переквалифицировано, Результат.УжеТолькоТД, Результат.НеНайденоВТЧ,
			Результат.НеНайденоВБД, Результат.Ошибки.Количество()));

	Возврат Результат;

КонецФункции

// =====================================================================
// Связка контрагента. Приоритет:
//   1) Email из комментария (#email#) → КонтактнаяИнформация контрагента/партнёра
//   2) Подразделение Сигмы (uso_name) → lookup в МапаПодразделений (batch-предзагружена)
//   3) Не найден → ПустаяСсылка + лог в ЖР для ручной привязки
//
// {audit 2026-05-19}: поиск по ИНН (бывший шаг 2) удалён. Причина: ИНН без КПП
// не идентифицирует контрагента уникально — у юр.лица могут быть обособленные
// подразделения с разными КПП = разные контрагенты в 1С с одним ИНН. Текущий
// CSV «Отчёт по журналу ЭТД» из Сигмы не содержит колонки КПП, добавить нельзя.
// ИНН оставлен как информационный параметр — попадает в лог ЖР при ненайденном
// контрагенте чтобы оператор мог понять кого привязывать вручную.
//
// Доработка {Perf #2 2026-05-01}: запрос подразделения убран, заменён на lookup в МапаПодразделений.
// Доработка {Perf #5 2026-05-01}: добавлен опциональный КешEmail — Соответствие в роли
// memoization-кеша. При повторном email в одном прогоне CSV запрос не выполняется.
// =====================================================================
Функция ВернутьКонтрагента(Представление, ПодразделениеСигма = "", ИНН = "", МапаПодразделений = Неопределено,
	КешEmail = Неопределено)

	Email = ИзвлечьEmailИзРешёток(Представление);

	Если ЗначениеЗаполнено(Email) Тогда
		EmailДляПоиска = НРег(СокрЛП(Email));
		Контрагент = ПолучитьКонтрагентаПоEmailСКешем(EmailДляПоиска, КешEmail);
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Возврат Контрагент;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПодразделениеСигма) И МапаПодразделений <> Неопределено Тогда
		Контрагент = МапаПодразделений.Получить(СокрЛП(ПодразделениеСигма));
		Если Контрагент <> Неопределено И ЗначениеЗаполнено(Контрагент) Тогда
			Возврат Контрагент;
		КонецЕсли;
	КонецЕсли;

	ЗначЕmail = ЗначениеИлиЗаглушка(Email);
	ЗначИНН = ЗначениеИлиЗаглушка(ИНН);
	ЗначПодр = ЗначениеИлиЗаглушка(ПодразделениеСигма);
	ЗаписьЖурналаРегистрации("РусскийТранзит.ЗагрузкаРееструТД.КонтрагентНеНайден",
		УровеньЖурналаРегистрации.Предупреждение,,,
		"Email: " + ЗначЕmail
		+ " | ИНН (для справки, поиск по нему не выполняется): " + ЗначИНН
		+ " | Подразделение: " + ЗначПодр
		+ " | Действие: добавьте email в КонтактнуюИнформацию контрагента, или запись в РС Соответствия подразделений");

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Memoization-обёртка над НайтиКонтрагентаПоEmailВ1С: при повторном email — возврат из кеша.
Функция ПолучитьКонтрагентаПоEmailСКешем(EmailДляПоиска, КешEmail)

	Если ТипЗнч(КешEmail) = Тип("Соответствие") Тогда
		Сохранённый = КешEmail.Получить(EmailДляПоиска);
		Если Сохранённый <> Неопределено Тогда
			Возврат Сохранённый;
		КонецЕсли;
	КонецЕсли;

	Контрагент = НайтиКонтрагентаПоEmailВ1С(EmailДляПоиска);

	Если ТипЗнч(КешEmail) = Тип("Соответствие") Тогда
		КешEmail.Вставить(EmailДляПоиска, Контрагент);
	КонецЕсли;

	Возврат Контрагент;

КонецФункции

// {audit 2026-05-19}: функции ПолучитьКонтрагентаПоИННСКешем и НайтиКонтрагентаПоИНН удалены.
// Поиск по ИНН исключён из логики ВернутьКонтрагента — см. комментарий к этой функции выше.

// Поиск контрагента по email из комментария ТД (формат `#user@domain#`).
// SPEC v2 §6: переход с ПОДОБНО %email% на = (точное) — раньше давало false-positive
// когда email встречался как substring (например, поиск user@a.ru находил user@aa.ru).
// JSON-fallback (шаг 3) использует ПОДОБНО потому что email лежит как поле внутри JSON,
// но ограничен жёсткими разделителями («"value":"<email>"») для устранения substring-совпадений.
Функция НайтиКонтрагентаПоEmailВ1С(EmailДляПоиска)

	Запрос = Новый Запрос;

	// 1. Контрагенты.КонтактнаяИнформация.Представление — точное совпадение.
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НРЕГ(КИ.Представление) = &Email";
	Запрос.УстановитьПараметр("Email", EmailДляПоиска);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
	КонецЕсли;

	// 2. Партнёры.КонтактнаяИнформация → Контрагент партнёра — точное совпадение.
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКИ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Контрагенты.Партнер = ПартнерыКИ.Ссылка
	|ГДЕ
	|	НРЕГ(ПартнерыКИ.Представление) = &Email";
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
	КонецЕсли;

	// 3. ЗначенияПолей (JSON-формат БСП 3.1+) — паттерн с разделителями кавычек,
	// иначе ПОДОБНО %email% даёт substring-совпадения.
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НРЕГ(КИ.ЗначенияПолей) ПОДОБНО &Email";
	Запрос.УстановитьПараметр("Email", "%""" + EmailДляПоиска + """%");
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Извлекает email между # и # (формат комментариев Сигмы: #user@domain#).
// {audit 2026-05-19}: хелпер для замены тернарника в лог-сообщениях.
// Возвращает строковое представление значения или заглушку если оно не заполнено.
Функция ЗначениеИлиЗаглушка(Значение, Заглушка = "<пусто>")

	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат Заглушка;

КонецФункции

Функция ИзвлечьEmailИзРешёток(Текст)

	ПозПервой = СтрНайти(Текст, "#");
	Если ПозПервой = 0 Тогда
		Возврат "";
	КонецЕсли;

	// Защита: если # стоит в самом конце строки — НачальнаяПозиция > длины,
	// платформа выдаёт «Недопустимое значение параметра 4».
	Если ПозПервой >= СтрДлина(Текст) Тогда
		Возврат "";
	КонецЕсли;

	ПозВторой = СтрНайти(Текст, "#", НаправлениеПоиска.СНачала, ПозПервой + 1);
	Если ПозВторой = 0 Тогда
		Возврат "";
	КонецЕсли;

	Фрагмент = СокрЛП(Сред(Текст, ПозПервой + 1, ПозВторой - ПозПервой - 1));
	Если СтрНайти(Фрагмент, "@") > 0 Тогда
		Возврат Фрагмент;
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#КонецЕсли
