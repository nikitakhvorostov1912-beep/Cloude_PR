////////////////////////////////////////////////////////////////////////////////
// Форма обработки «Загрузка реестра ТД» — клиентская и серверная логика.
// Версия v2 (2026-05-01).
//
// Основные улучшения относительно v1:
//   • Информационный баннер сверху (всегда видно — что делает обработка).
//   • Условное оформление колонки «Категория» — синий/зелёный/серый.
//   • Колонки «Статус» и «Источник» (как нашёлся контрагент).
//   • Сводка после ПрочитатьCSV: сколько контрагентов найдено и как.
//   • Ошибки применения — одним блоком, не по одному сообщению.
//   • Скрыта вкладка «Только обеспечение» (V3 алгоритм её не генерирует).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НастроитьВидимостьЭлементов(Ложь);
	НастроитьУсловноеОформление();
	ТекущийФильтрКатегории = "";

КонецПроцедуры

&НаКлиенте
Процедура ФайлCSVНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Оповещение = Новый ОписаниеОповещения("ФайлCSVНачалоВыбораЗавершение", ЭтотОбъект);
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выбор файла реестра ЭТД";
	ДиалогВыбора.Фильтр = "CSV файлы (*.csv)|*.csv|Все файлы (*.*)|*.*";
	ДиалогВыбора.МножественныйВыбор = Ложь;
	ДиалогВыбора.ПредварительныйПросмотр = Ложь;
	ДиалогВыбора.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ФайлCSVНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Объект.ФайлCSV = ВыбранныеФайлы[0];

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитатьCSV(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.ФайлCSV) Тогда
		ПоказатьПредупреждение(, "Укажите путь к файлу CSV");
		Возврат;
	КонецЕсли;

	Состояние("Читаем CSV и сопоставляем с базой...");
	Сводка = ПрочитатьCSVСервер();
	Состояние();

	НастроитьВидимостьЭлементов(Истина);
	ОбновитьЗаголовкиФильтров();
	ТекущийФильтрКатегории = "";
	ОбновитьОтборСтрок();

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Сводка;
	Сообщение.Сообщить();

КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)

	КоличествоВыбранных = ПодсчитатьВыбранные();
	Если КоличествоВыбранных = 0 Тогда
		ПоказатьПредупреждение(, "Не выбрано ни одной строки для применения");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПрименитьЗавершение", ЭтотОбъект);
	Текст = СтрШаблон("Применить классификацию к %1 строкам?", КоличествоВыбранных);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Применение классификации...");
	Результат = ПрименитьСервер();
	Состояние();

	ПоказатьРезультатПрименения(Результат);

	Если Результат.Ошибки.Количество() = 0 Тогда
		ОчиститьПослеПримененияСервер();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФильтрВсе(Команда)

	ТекущийФильтрКатегории = "";
	ОбновитьОтборСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ФильтрКомплекс(Команда)

	ТекущийФильтрКатегории = "Комплекс";
	ОбновитьОтборСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ФильтрНоваяТД(Команда)

	ТекущийФильтрКатегории = "НоваяТД";
	ОбновитьОтборСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(ТекстИнструкции());
	Текст.Показать("Инструкция: загрузка реестра ТД");

КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедуры

// Управление видимостью групп: до загрузки скрываем статистику/фильтры/таблицу.
&НаСервере
Процедура НастроитьВидимостьЭлементов(ДанныеЕсть)

	Элементы.ГруппаСтатистика.Видимость = ДанныеЕсть;
	Элементы.ГруппаПериод.Видимость = ДанныеЕсть;
	Элементы.ГруппаФильтры.Видимость = ДанныеЕсть;
	Элементы.КнопкаПрименить.Видимость = ДанныеЕсть;
	Элементы.Предложения.Видимость = ДанныеЕсть;

КонецПроцедуры

// Условное оформление: цветные плашки для колонки Категория.
&НаСервере
Процедура НастроитьУсловноеОформление()

	УсловноеОформление = ЭтотОбъект.УсловноеОформление;
	УсловноеОформление.Элементы.Очистить();

	// Комплекс — синий фон.
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	ПолеКатегория = Элемент.Поля.Элементы.Добавить();
	ПолеКатегория.Поле = Новый ПолеКомпоновкиДанных("ПредложенияКатегория");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПредложенияКлассификации.Категория");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "Комплекс";
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лавандовый);

	// НоваяТД — зелёный фон.
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	ПолеКатегория = Элемент.Поля.Элементы.Добавить();
	ПолеКатегория.Поле = Новый ПолеКомпоновкиДанных("ПредложенияКатегория");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПредложенияКлассификации.Категория");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "НоваяТД";
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоЗелёный);

	// Контрагент пуст — серый текст в колонке Источник (предупреждение).
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	ПолеИсточник = Элемент.Поля.Элементы.Добавить();
	ПолеИсточник.Поле = Новый ПолеКомпоновкиДанных("ПредложенияИсточникКонтрагента");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПредложенияКлассификации.Контрагент");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "⚠ не сопоставлен");

КонецПроцедуры

// Сервер: разобрать CSV, классифицировать, посчитать счётчики.
// Возвращает строку-сводку для показа в форме.
&НаСервере
Функция ПрочитатьCSVСервер()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ПредложенияКлассификации.Очистить();

	ТаблицаCSV = ОбъектОбработки.ПрочитатьCSVФайл(Объект.ФайлCSV);
	ТаблицаПредложений = ОбъектОбработки.СопоставитьСДокументами(ТаблицаCSV);

	Для Каждого Строка Из ТаблицаПредложений Цикл
		НоваяСтрока = ОбъектОбработки.ПредложенияКлассификации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;

	КолКомплекс = 0;
	КолНоваяТД = 0;
	КолКонтрагентEmail = 0;
	КолКонтрагентИНН = 0;
	КолКонтрагентПодразделение = 0;
	КолКонтрагентИзБД = 0;
	КолКонтрагентНеНайден = 0;
	ДатаМин = Неопределено;
	ДатаМакс = Неопределено;

	Для Каждого Строка Из ОбъектОбработки.ПредложенияКлассификации Цикл
		Если Строка.Категория = "Комплекс" Тогда
			КолКомплекс = КолКомплекс + 1;
		ИначеЕсли Строка.Категория = "НоваяТД" Тогда
			КолНоваяТД = КолНоваяТД + 1;
		КонецЕсли;

		Если Строка.ИсточникКонтрагента = "Email" Тогда
			КолКонтрагентEmail = КолКонтрагентEmail + 1;
		ИначеЕсли Строка.ИсточникКонтрагента = "ИНН" Тогда
			КолКонтрагентИНН = КолКонтрагентИНН + 1;
		ИначеЕсли Строка.ИсточникКонтрагента = "Подразделение" Тогда
			КолКонтрагентПодразделение = КолКонтрагентПодразделение + 1;
		ИначеЕсли Строка.ИсточникКонтрагента = "Из БД (документ ОПП)" Тогда
			КолКонтрагентИзБД = КолКонтрагентИзБД + 1;
		ИначеЕсли НЕ ЗначениеЗаполнено(Строка.Контрагент) Тогда
			КолКонтрагентНеНайден = КолКонтрагентНеНайден + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(Строка.ДатаВыпуска) Тогда
			Если ДатаМин = Неопределено ИЛИ Строка.ДатаВыпуска < ДатаМин Тогда
				ДатаМин = Строка.ДатаВыпуска;
			КонецЕсли;
			Если ДатаМакс = Неопределено ИЛИ Строка.ДатаВыпуска > ДатаМакс Тогда
				ДатаМакс = Строка.ДатаВыпуска;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ОбъектОбработки.СтрокКомплекс = КолКомплекс;
	ОбъектОбработки.СтрокНовыеТД = КолНоваяТД;
	ОбъектОбработки.СтрокТолькоОбеспечение = 0;
	ОбъектОбработки.СтрокПроблемы = 0;
	ОбъектОбработки.СтрокВсего = КолКомплекс + КолНоваяТД;
	ОбъектОбработки.ПериодС = ?(ДатаМин = Неопределено, '00010101', ДатаМин);
	ОбъектОбработки.ПериодПо = ?(ДатаМакс = Неопределено, '00010101', ДатаМакс);

	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

	// Готовим сводку для пользователя.
	СводкаТекст = Новый Массив;
	СводкаТекст.Добавить(СтрШаблон("Загружено %1 строк CSV. Из них:",
		ОбъектОбработки.СтрокВсего));
	СводкаТекст.Добавить(СтрШаблон("  • Комплекс (обогатить): %1", КолКомплекс));
	СводкаТекст.Добавить(СтрШаблон("  • Новые ТД (создать черновик): %1", КолНоваяТД));
	СводкаТекст.Добавить("");
	СводкаТекст.Добавить("Контрагенты найдены:");
	СводкаТекст.Добавить(СтрШаблон("  • из БД (уже в ОПП):     %1", КолКонтрагентИзБД));
	СводкаТекст.Добавить(СтрШаблон("  • по email:              %1", КолКонтрагентEmail));
	СводкаТекст.Добавить(СтрШаблон("  • по ИНН:                %1", КолКонтрагентИНН));
	СводкаТекст.Добавить(СтрШаблон("  • по подразделению:      %1", КолКонтрагентПодразделение));
	СводкаТекст.Добавить(СтрШаблон("  • не сопоставлены:       %1 (см. колонку «Источник»)",
		КолКонтрагентНеНайден));

	СводкаСтатистики = СтрСоединить(СводкаТекст, Символы.ПС);
	Возврат СводкаСтатистики;

КонецФункции

&НаСервере
Функция ПрименитьСервер()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.ПрименитьКлассификацию(
		ОбъектОбработки.ПредложенияКлассификации.Выгрузить());

КонецФункции

&НаКлиенте
Процедура ПоказатьРезультатПрименения(Результат)

	Стр = Новый Массив;
	Если Результат.Ошибки.Количество() = 0 Тогда
		Стр.Добавить("✅ Готово.");
	Иначе
		Стр.Добавить(СтрШаблон("⚠ Применение завершено с ошибками (%1).",
			Результат.Ошибки.Количество()));
		Стр.Добавить("Транзакция откачена. Исправьте ошибки и повторите.");
		Стр.Добавить("");
	КонецЕсли;

	Стр.Добавить(СтрШаблон("  • Обогащено документов «Комплекс»: %1", Результат.Обогащено));
	Стр.Добавить(СтрШаблон("  • Создано новых документов «ТД-файл»: %1", Результат.Создано));
	Стр.Добавить(СтрШаблон("  • Дозаполнено Контрагентов в шапке: %1",
		Результат.ДозаполненоКонтрагентов));
	Стр.Добавить(СтрШаблон("  • Дозаполнено Статусов транзита: %1",
		Результат.ДозаполненоСтатусов));

	Если Результат.Ошибки.Количество() > 0 Тогда
		Стр.Добавить("");
		Стр.Добавить("Список ошибок:");
		ПредельноеЧислоОшибок = 30;
		Сч = 0;
		Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
			Сч = Сч + 1;
			Если Сч > ПредельноеЧислоОшибок Тогда
				Стр.Добавить(СтрШаблон("  ... и ещё %1 ошибок (см. журнал регистрации)",
					Результат.Ошибки.Количество() - ПредельноеЧислоОшибок));
				Прервать;
			КонецЕсли;
			Стр.Добавить(СтрШаблон("  %1. %2", Сч, ТекстОшибки));
		КонецЦикла;
	КонецЕсли;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрСоединить(Стр, Символы.ПС);
	Сообщение.Сообщить();

КонецПроцедуры

&НаСервере
Процедура ОчиститьПослеПримененияСервер()

	Объект.ПредложенияКлассификации.Очистить();
	Объект.СтрокВсего = 0;
	Объект.СтрокКомплекс = 0;
	Объект.СтрокНовыеТД = 0;
	Объект.СтрокПроблемы = 0;
	Объект.СтрокТолькоОбеспечение = 0;
	Объект.ПериодС = '00010101';
	Объект.ПериодПо = '00010101';
	Объект.ФайлCSV = "";

	Элементы.Предложения.ОтборСтрок = Новый ФиксированнаяСтруктура();
	НастроитьВидимостьЭлементов(Ложь);

КонецПроцедуры

&НаКлиенте
Функция ПодсчитатьВыбранные()

	Количество = 0;
	Для Каждого Строка Из Объект.ПредложенияКлассификации Цикл
		Если Строка.Выбрать Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

&НаКлиенте
Процедура ОбновитьЗаголовкиФильтров()

	Элементы.КнопкаФильтрВсе.Заголовок = СтрШаблон("Все (%1)", Объект.СтрокВсего);
	Элементы.КнопкаФильтрКомплекс.Заголовок = СтрШаблон("Комплекс (%1)",
		Объект.СтрокКомплекс);
	Элементы.КнопкаФильтрНоваяТД.Заголовок = СтрШаблон("Новые ТД (%1)",
		Объект.СтрокНовыеТД);

КонецПроцедуры

// Применяет к таблице Предложения отбор строк по текущей категории.
&НаКлиенте
Процедура ОбновитьОтборСтрок()

	Структура = Новый Структура;
	Если ЗначениеЗаполнено(ТекущийФильтрКатегории) Тогда
		Структура.Вставить("Категория", ТекущийФильтрКатегории);
	КонецЕсли;
	Элементы.Предложения.ОтборСтрок = Новый ФиксированнаяСтруктура(Структура);

КонецПроцедуры

#КонецОбласти

#Область ИнструкцияТекст

&НаКлиенте
Функция ТекстИнструкции()

	Стр = Новый Массив;
	Стр.Добавить("ЗАГРУЗКА РЕЕСТРА ТД  (v2 от 2026-05-01)");
	Стр.Добавить("");
	Стр.Добавить("ЗАЧЕМ");
	Стр.Добавить("Сравнивает реестр выпущенных таможенных деклараций (журнал ЭТД)");
