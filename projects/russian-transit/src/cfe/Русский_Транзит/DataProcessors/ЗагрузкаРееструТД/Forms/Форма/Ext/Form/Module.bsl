	Стр.Добавить("Рекомендуемый порядок");
	Стр.Добавить("---------------------");
	Стр.Добавить("1. Сначала «Новые ТД» — создаём недостающие документы.");
	Стр.Добавить("2. Потом «Комплекс» — обогащаем существующие.");
	Стр.Добавить("3. По строкам с пустым контрагентом — досверка по почте/телефону");
	Стр.Добавить("   (пользователь сам решает, кому привязать).");

	Возврат СтрСоединить(Стр, Символы.ПС);

КонецФункции

&НаСервере
Процедура ОчиститьПослеПримененияСервер()

	Объект.ПредложенияКлассификации.Очистить();
	Объект.СтрокВсего = 0;
	Объект.СтрокКомплекс = 0;
	Объект.СтрокНовыеТД = 0;
	Объект.СтрокДублейВБД = 0;
	Объект.СтрокКонтрагентыНайдено = 0;
	Объект.СтрокКонтрагентыПусто = 0;
	Объект.ПериодС = '00010101';
	Объект.ПериодПо = '00010101';
	Объект.ФайлCSV = "";

	Элементы.Предложения.ОтборСтрок = Новый ФиксированнаяСтруктура();

	// После очистки скрываем статистику и кнопку «Применить» — возврат к виду «до загрузки».
	Элементы.ГруппаСтатистика.Видимость = Ложь;
	Элементы.ГруппаПериод.Видимость = Ложь;
	Элементы.ГруппаФильтры.Видимость = Ложь;
	Элементы.КнопкаПрименить.Видимость = Ложь;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьCSVСервер()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ПредложенияКлассификации.Очистить();

	ТаблицаCSV = ОбъектОбработки.ПрочитатьCSVФайл(Объект.ФайлCSV);
	Метрики = Новый Структура;
	ТаблицаПредложений = ОбъектОбработки.СопоставитьСДокументами(ТаблицаCSV, Метрики);

	Для Каждого Строка Из ТаблицаПредложений Цикл
		НоваяСтрока = ОбъектОбработки.ПредложенияКлассификации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;

	// Метрики счётчиков уже посчитаны в СопоставитьСДокументами — берём оттуда.
	ОбъектОбработки.СтрокКомплекс = ?(Метрики.Свойство("Комплекс"), Метрики.Комплекс, 0);
	ОбъектОбработки.СтрокНовыеТД = ?(Метрики.Свойство("НоваяТД"), Метрики.НоваяТД, 0);
	ОбъектОбработки.СтрокДублейВБД = ?(Метрики.Свойство("ДублейВБД"), Метрики.ДублейВБД, 0);
	ОбъектОбработки.СтрокКонтрагентыНайдено = ?(Метрики.Свойство("КонтрагентыНайдено"), Метрики.КонтрагентыНайдено, 0);
	ОбъектОбработки.СтрокКонтрагентыПусто = ?(Метрики.Свойство("КонтрагентыПусто"), Метрики.КонтрагентыПусто, 0);

	ОбъектОбработки.ПериодС = ?(Метрики.Свойство("ДатаМин") И ЗначениеЗаполнено(Метрики.ДатаМин), Метрики.ДатаМин, '00010101');
	ОбъектОбработки.ПериодПо = ?(Метрики.Свойство("ДатаМакс") И ЗначениеЗаполнено(Метрики.ДатаМакс), Метрики.ДатаМакс, '00010101');

	// Всего = Комплекс + НоваяТД (CSV-driven алгоритм V3, ТолькоОбеспечение не генерируется).
	ОбъектОбработки.СтрокВсего = ОбъектОбработки.СтрокКомплекс + ОбъектОбработки.СтрокНовыеТД;

	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

КонецПроцедуры

&НаСервере
Функция ПрименитьСервер()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОбработки.ПрименитьКлассификацию(ОбъектОбработки.ПредложенияКлассификации.Выгрузить());

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПодсчитатьСозданныеТДСервер()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК ОПП
	|ГДЕ
	|	ОПП.ВидОперации = &ВидОперации
	|	И НЕ ОПП.ПометкаУдаления";
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийПоручительства.ТДФайл);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;

КонецФункции

&НаСервере
Функция УдалитьСозданныеТДСервер()

	Результат = Новый Структура("Удалено, Ошибок", 0, 0);

	// Доработка {ОПП-fix-delete 2026-05-04}: физическое удаление вместо пометки.
	// Захватываем непроведённые ОПП ТДФайл (включая помеченные ранее) и пытаемся удалить.
	// Перед удалением — НайтиПоСсылкам(): если на документ ссылаются другие объекты
	// (например, регистр ПрочитанныеДекларации), удаление пропускается — иначе была бы
	// битая ссылка. Такие случаи логируются в ЖР.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОПП.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК ОПП
	|ГДЕ
	|	ОПП.ВидОперации = &ВидОперации";
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийПоручительства.ТДФайл);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
			СсылкаДок = Выборка.Ссылка;

			// Проверка ссылок ДО удаления.
			МассивСсылок = Новый Массив;
			МассивСсылок.Добавить(СсылкаДок);
			ТаблицаСсылок = НайтиПоСсылкам(МассивСсылок);
			// Записи самого документа в его регистрах не считаются «битыми ссылками»
			// (регистры удалятся каскадно), поэтому фильтруем строки где ОбъектСсылка = сам документ.
			ВнешнихСсылок = 0;
			Для Каждого СтрокаСсылки Из ТаблицаСсылок Цикл
				Если СтрокаСсылки.ОбъектСсылка <> СсылкаДок Тогда
					ВнешнихСсылок = ВнешнихСсылок + 1;
				КонецЕсли;
			КонецЦикла;

			Если ВнешнихСсылок > 0 Тогда
				ОтменитьТранзакцию();
				Результат.Ошибок = Результат.Ошибок + 1;
				ЗаписьЖурналаРегистрации(
					"РусскийТранзит.ЗагрузкаРееструТД.УдалениеТД",
					УровеньЖурналаРегистрации.Предупреждение, , СсылкаДок,
					СтрШаблон("Не удалён: на документ есть %1 внешних ссылок.", ВнешнихСсылок));
				Продолжить;
			КонецЕсли;

			ОбъектДокумента = СсылкаДок.ПолучитьОбъект();
			Если ОбъектДокумента <> Неопределено Тогда
				ОбъектДокумента.Удалить();
				Результат.Удалено = Результат.Удалено + 1;
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Результат.Ошибок = Результат.Ошибок + 1;
			ЗаписьЖурналаРегистрации(
				"РусскийТранзит.ЗагрузкаРееструТД.УдалениеТД",
				УровеньЖурналаРегистрации.Ошибка, , Выборка.Ссылка,
				ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ЗаписьЖурналаРегистрации(
		"РусскийТранзит.ЗагрузкаРееструТД.УдалениеТД",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Удалено=%1, Ошибок=%2", Результат.Удалено, Результат.Ошибок));

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПодсчитатьВыбранные()

	Количество = 0;
	Для Каждого Строка Из Объект.ПредложенияКлассификации Цикл
		Если Строка.Выбрать Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

&НаКлиенте
Процедура ОбновитьЗаголовкиФильтров()

	Элементы.КнопкаФильтрВсе.Заголовок = СтрШаблон("Все (%1)", Объект.СтрокВсего);
	Элементы.КнопкаФильтрКомплекс.Заголовок = СтрШаблон("Комплекс (%1)", Объект.СтрокКомплекс);
	Элементы.КнопкаФильтрНоваяТД.Заголовок = СтрШаблон("Новые ТД (%1)", Объект.СтрокНовыеТД);

	// Доступность кнопки «Применить» — только если есть выбранные строки (P2 #9).
	Элементы.КнопкаПрименить.Доступность = (ПодсчитатьВыбранные() > 0);

КонецПроцедуры

// Применяет к таблице Предложения отбор строк по текущей категории.
// Поля «Период с/по» — информационные (показывают диапазон дат CSV), не используются для фильтра.
&НаКлиенте
Процедура ОбновитьОтборСтрок()

	Структура = Новый Структура;
	Если ЗначениеЗаполнено(ТекущийФильтрКатегории) Тогда
		Структура.Вставить("Категория", ТекущийФильтрКатегории);
	КонецЕсли;
	Элементы.Предложения.ОтборСтрок = Новый ФиксированнаяСтруктура(Структура);

КонецПроцедуры

// Условное оформление таблицы предложений (SPEC v2 §9.2):
//   • Категория Комплекс → светло-синий фон строк
//   • Категория НоваяТД → светло-зелёный фон строк
//   • Контрагент пусто → серый текст в колонке Контрагент с подписью «⚠ пусто»
&НаСервере
Процедура НастроитьУсловноеОформление()

	УО = Элементы.Предложения.УсловноеОформление;
	УО.Очистить();

	// 1) Категория Комплекс — светло-синий фон (#DBEAFE).
	Элемент = УО.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(219, 234, 254));
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПредложенияКлассификации.Категория");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "Комплекс";
	Отбор.Использование = Истина;
	ОформляемыеПоляКомплекс = СписокОформляемыхПолейСтроки();
	Для Каждого ИмяПоля Из ОформляемыеПоляКомплекс Цикл
		ОФП = Элемент.Поля.Элементы.Добавить();
		ОФП.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;

	// 2) Категория НоваяТД — светло-зелёный фон (#DCFCE7).
	Элемент = УО.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(220, 252, 231));
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПредложенияКлассификации.Категория");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "НоваяТД";
	Отбор.Использование = Истина;
	Для Каждого ИмяПоля Из ОформляемыеПоляКомплекс Цикл
		ОФП = Элемент.Поля.Элементы.Добавить();
		ОФП.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;

	// 3) Контрагент пусто — серый текст «⚠ пусто» в колонке Контрагент.
	Элемент = УО.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(120, 120, 120));
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "⚠ пусто");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПредложенияКлассификации.Контрагент");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Отбор.Использование = Истина;
	ОФП = Элемент.Поля.Элементы.Добавить();
	ОФП.Поле = Новый ПолеКомпоновкиДанных("ПредложенияКонтрагент");

	// Доработка START {НеНаши/Пропустить 2026-05-13}: серый фон для отсеянных категорий.
	// 4) НеНаши — светло-серый (#E5E7EB) + приглушённый текст.
	Элемент = УО.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(229, 231, 235));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(107, 114, 128));
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПредложенияКлассификации.Категория");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "НеНаши";
	Отбор.Использование = Истина;
	Для Каждого ИмяПоля Из ОформляемыеПоляКомплекс Цикл
		ОФП = Элемент.Поля.Элементы.Добавить();
		ОФП.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;

	// 5) Пропустить — янтарный фон (#FEF3C7) — обращает внимание, но не блокирует.
	Элемент = УО.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(254, 243, 199));
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПредложенияКлассификации.Категория");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "Пропустить";
	Отбор.Использование = Истина;
	Для Каждого ИмяПоля Из ОформляемыеПоляКомплекс Цикл
		ОФП = Элемент.Поля.Элементы.Добавить();
		ОФП.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;
	// Доработка END

КонецПроцедуры

// Список имён колонок таблицы Предложения, на которые наложить фон категории.
// Контрагент исключён — на нём собственное оформление «пусто».
&НаСервере
Функция СписокОформляемыхПолейСтроки()

	Поля = Новый Массив;
	Поля.Добавить("ПредложенияКатегория");
	Поля.Добавить("ПредложенияРегНомерТД");
	Поля.Добавить("ПредложенияНомерДДПТД");
	Поля.Добавить("ПредложенияПодразделение");
	Поля.Добавить("ПредложенияДекларант");
	Поля.Добавить("ПредложенияДатаВыпуска");
	Поля.Добавить("ПредложенияКоличествоКодовТНВЭД");
	Поля.Добавить("ПредложенияСсылкаДокумент");
	Поля.Добавить("ПредложенияИННПолучателя");
	Поля.Добавить("ПредложенияСтатусПроцесса");
	Поля.Добавить("ПредложенияПеревозчик");
	Поля.Добавить("ПредложенияКомментарий");
	Поля.Добавить("ПредложенияПримечание");
	Возврат Поля;

КонецФункции

// Обработчик изменения галочки в строке таблицы — переоценивает доступность кнопки «Применить».
&НаКлиенте
Процедура ПредложенияВыбратьПриИзменении(Элемент)

	Элементы.КнопкаПрименить.Доступность = (ПодсчитатьВыбранные() > 0);

КонецПроцедуры

#КонецОбласти
