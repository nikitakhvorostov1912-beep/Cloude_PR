#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// До загрузки CSV - скрываем статистику и кнопку «Применить».
	// Они появятся только после успешного «Прочитать CSV».
	Элементы.ГруппаСтатистика.Видимость = Ложь;
	Элементы.КнопкаПрименить.Видимость = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ФайлCSVНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Оповещение = Новый ОписаниеОповещения("ФайлCSVНачалоВыбораЗавершение", ЭтотОбъект);
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выбор файла реестра ЭТД";
	ДиалогВыбора.Фильтр = "CSV файлы (*.csv)|*.csv|Все файлы (*.*)|*.*";
	ДиалогВыбора.МножественныйВыбор = Ложь;
	ДиалогВыбора.ПредварительныйПросмотр = Ложь;
	ДиалогВыбора.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ФайлCSVНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Объект.ФайлCSV = ВыбранныеФайлы[0];

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитатьCSV(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.ФайлCSV) Тогда
		ПоказатьПредупреждение(, "Укажите путь к файлу CSV");
		Возврат;
	КонецЕсли;

	Состояние("Читаем CSV и сопоставляем с базой...");
	ПрочитатьCSVСервер();
	Состояние();

	Элементы.ГруппаСтатистика.Видимость = Истина;
	Элементы.КнопкаПрименить.Видимость = Истина;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(
		"Прочитано строк: %1. Комплекс: %2, Новые ТД: %3, Проблемы: %4, ТолькоОбеспечение: %5.",
		Объект.СтрокВсего, Объект.СтрокКомплекс, Объект.СтрокНовыеТД, Объект.СтрокПроблемы, Объект.СтрокТолькоОбеспечение);
	Сообщение.Сообщить();

КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)

	КоличествоВыбранных = ПодсчитатьВыбранные();
	Если КоличествоВыбранных = 0 Тогда
		ПоказатьПредупреждение(, "Не выбрано ни одной строки для применения");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПрименитьЗавершение", ЭтотОбъект);
	Текст = СтрШаблон("Применить классификацию к %1 строкам?", КоличествоВыбранных);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Применение классификации...");
	Результат = ПрименитьСервер();
	Состояние();

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(
		"Обогащено: %1, Создано новых ТД: %2, Помечено ТолькоОбеспечение: %3. Ошибок: %4.",
		Результат.Обогащено, Результат.Создано, Результат.ПомеченоТолькоОбеспечение, Результат.Ошибки.Количество());
	Сообщение.Сообщить();

	Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
		ЗаписьОшибки = Новый СообщениеПользователю;
		ЗаписьОшибки.Текст = ТекстОшибки;
		ЗаписьОшибки.Сообщить();
	КонецЦикла;

	Если Результат.Ошибки.Количество() = 0 Тогда
		ОчиститьПослеПримененияСервер();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОчиститьПослеПримененияСервер()

	Объект.ПредложенияКлассификации.Очистить();
	Объект.СтрокВсего = 0;
	Объект.СтрокКомплекс = 0;
	Объект.СтрокНовыеТД = 0;
	Объект.СтрокПроблемы = 0;
	Объект.СтрокТолькоОбеспечение = 0;
	Объект.ФайлCSV = "";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьCSVСервер()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ПредложенияКлассификации.Очистить();

	ТаблицаCSV = ОбъектОбработки.ПрочитатьCSVФайл(Объект.ФайлCSV);
	ТаблицаПредложений = ОбъектОбработки.СопоставитьСДокументами(ТаблицаCSV);

	Для Каждого Строка Из ТаблицаПредложений Цикл
		НоваяСтрока = ОбъектОбработки.ПредложенияКлассификации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;

	ОбъектОбработки.СтрокВсего = ТаблицаCSV.Количество();
	ОбъектОбработки.СтрокКомплекс = 0;
	ОбъектОбработки.СтрокНовыеТД = 0;
	ОбъектОбработки.СтрокПроблемы = 0;
	ОбъектОбработки.СтрокТолькоОбеспечение = 0;

	Для Каждого Строка Из ОбъектОбработки.ПредложенияКлассификации Цикл
		Если Строка.Категория = "Комплекс" Тогда
			ОбъектОбработки.СтрокКомплекс = ОбъектОбработки.СтрокКомплекс + 1;
		ИначеЕсли Строка.Категория = "НоваяТД" Тогда
			ОбъектОбработки.СтрокНовыеТД = ОбъектОбработки.СтрокНовыеТД + 1;
		ИначеЕсли Строка.Категория = "Проблема" Тогда
			ОбъектОбработки.СтрокПроблемы = ОбъектОбработки.СтрокПроблемы + 1;
		ИначеЕсли Строка.Категория = "ТолькоОбеспечение" Тогда
			ОбъектОбработки.СтрокТолькоОбеспечение = ОбъектОбработки.СтрокТолькоОбеспечение + 1;
		КонецЕсли;
	КонецЦикла;

	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

КонецПроцедуры

&НаСервере
Функция ПрименитьСервер()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОбработки.ПрименитьКлассификацию(ОбъектОбработки.ПредложенияКлассификации.Выгрузить());

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПодсчитатьВыбранные()

	Количество = 0;
	Для Каждого Строка Из Объект.ПредложенияКлассификации Цикл
		Если Строка.Выбрать Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

#КонецОбласти
