#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// До загрузки CSV — скрываем статистику, фильтры и кнопку «Применить».
	Элементы.ГруппаСтатистика.Видимость = Ложь;
	Элементы.ГруппаПериод.Видимость = Ложь;
	Элементы.ГруппаФильтры.Видимость = Ложь;
	Элементы.КнопкаПрименить.Видимость = Ложь;

	ТекущийФильтрКатегории = "";

	// Условное оформление таблицы Предложения (SPEC v2 §9.2):
	//   • Категория Комплекс → светло-синий фон
	//   • Категория НоваяТД → светло-зелёный фон
	//   • Контрагент пусто → серый текст «⚠ пусто»
	НастроитьУсловноеОформление();

КонецПроцедуры

&НаКлиенте
Процедура ФайлCSVНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Оповещение = Новый ОписаниеОповещения("ФайлCSVНачалоВыбораЗавершение", ЭтотОбъект);
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выбор файла реестра ЭТД";
	ДиалогВыбора.Фильтр = "CSV файлы (*.csv)|*.csv|Все файлы (*.*)|*.*";
	ДиалогВыбора.МножественныйВыбор = Ложь;
	ДиалогВыбора.ПредварительныйПросмотр = Ложь;
	ДиалогВыбора.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ФайлCSVНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Объект.ФайлCSV = ВыбранныеФайлы[0];

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитатьCSV(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.ФайлCSV) Тогда
		ПоказатьПредупреждение(, "Укажите путь к файлу CSV");
		Возврат;
	КонецЕсли;

	// P2 #8: если в таблице уже есть предложения — спросить о перезаписи.
	Если Объект.ПредложенияКлассификации.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПрочитатьCSVПодтверждение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			"В таблице уже есть предложения по предыдущему файлу. Перечитать CSV? Текущие галочки будут потеряны.",
			РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	ВыполнитьЧтениеCSV();

КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьCSVПодтверждение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ВыполнитьЧтениеCSV();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЧтениеCSV()
    Состояние("Читаем CSV и сопоставляем с базой...");
    
    // Передаём файл с клиента на сервер через временное хранилище
    АдресВХранилище = "";
    Результат = ПоместитьФайл(АдресВХранилище, Объект.ФайлCSV, , Ложь, УникальныйИдентификатор);
    
    Если НЕ Результат Тогда
        Состояние();
        ПоказатьПредупреждение(, "Не удалось передать файл на сервер");
        Возврат;
    КонецЕсли;
    
    ПрочитатьCSVСервер(АдресВХранилище);
    
    Состояние();
    Элементы.ГруппаСтатистика.Видимость = Истина;
    Элементы.ГруппаПериод.Видимость = Истина;
    Элементы.ГруппаФильтры.Видимость = Истина;
    Элементы.КнопкаПрименить.Видимость = Истина;
    ОбновитьЗаголовкиФильтров();
    ТекущийФильтрКатегории = "";
    ОбновитьОтборСтрок();
    
    // Сводка одним сообщением (SPEC v2 §9.2). Всего = Комплекс + НоваяТД,
    // дополнительно показываем найденных контрагентов и дубли в БД.
    ХвостДублей = "";
    Если Объект.СтрокДублейВБД > 0 Тогда
        ХвостДублей = Символы.ПС + СтрШаблон(
            "⚠ Дублей НомерГТД в БД: %1 (использован первый по дате — см. ЖР).",
            Объект.СтрокДублейВБД);
    КонецЕсли;
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = СтрШаблон("Прочитано: %1 строк. Комплекс: %2, Новые ТД: %3."
        + Символы.ПС + "Контрагенты: найдено %4, пусто %5." + ХвостДублей,
        Объект.СтрокВсего, Объект.СтрокКомплекс, Объект.СтрокНовыеТД,
        Объект.СтрокКонтрагентыНайдено, Объект.СтрокКонтрагентыПусто);
    Сообщение.Сообщить();
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)

	КоличествоВыбранных = ПодсчитатьВыбранные();
	Если КоличествоВыбранных = 0 Тогда
		ПоказатьПредупреждение(, "Не выбрано ни одной строки для применения");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПрименитьЗавершение", ЭтотОбъект);
	Текст = СтрШаблон("Применить классификацию к %1 строкам?", КоличествоВыбранных);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Применение классификации...");
	Результат = ПрименитьСервер();
	Состояние();

	// Сводка + список ошибок одним сообщением (SPEC v2 §9.4 — раньше был popup × N).
	СтрокиСводки = Новый Массив;
	ТекстСводки = СтрШаблон("✅ Готово. Обогащено Комплекс: %1, Создано новых ТД: %2",
		Результат.Обогащено, Результат.Создано);
	Если Результат.Свойство("НовыйКомплекс") И Результат.НовыйКомплекс > 0 Тогда
		ТекстСводки = ТекстСводки + СтрШаблон(", Новый комплекс: %1", Результат.НовыйКомплекс);
	КонецЕсли;
	Если Результат.Свойство("Дозаполнено") И Результат.Дозаполнено > 0 Тогда
		ТекстСводки = ТекстСводки + СтрШаблон(", дозаполнено ТЧ существующих ОПП: %1", Результат.Дозаполнено);
	КонецЕсли;
	Если Результат.Свойство("ПропущеноДублей") И Результат.ПропущеноДублей > 0 Тогда
		ТекстСводки = ТекстСводки + СтрШаблон(", пропущено дублей: %1", Результат.ПропущеноДублей);
	КонецЕсли;
	Если Результат.Свойство("СгруппированоГрупп") И Результат.СгруппированоГрупп > 0 Тогда
		ТекстСводки = ТекстСводки + СтрШаблон(", сгруппировано: %1 групп (%2 док→%1)",
			Результат.СгруппированоГрупп, Результат.СгруппированоВсего);
	КонецЕсли;
	СтрокиСводки.Добавить(ТекстСводки + ".");

	Если Результат.Ошибки.Количество() > 0 Тогда
		СтрокиСводки.Добавить("");
		СтрокиСводки.Добавить(СтрШаблон("⚠ Ошибок: %1. Ошибочные строки откачены, успешные сохранены. Исправьте и повторите Применить:",
			Результат.Ошибки.Количество()));
		// Показываем не более 20 ошибок в форме — остальные в журнале регистрации.
		Лимит = Мин(20, Результат.Ошибки.Количество());
		Для Сч = 0 По Лимит - 1 Цикл
			СтрокиСводки.Добавить("  • " + Результат.Ошибки[Сч]);
		КонецЦикла;
		Если Результат.Ошибки.Количество() > Лимит Тогда
			СтрокиСводки.Добавить(СтрШаблон("  ... и ещё %1 (см. журнал регистрации)",
				Результат.Ошибки.Количество() - Лимит));
		КонецЕсли;
	КонецЕсли;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрСоединить(СтрокиСводки, Символы.ПС);
	Сообщение.Сообщить();

	// {fix-keep-rest 2026-05-15}: после Применить удаляем только обработанные строки
	// (Выбрать=Истина), невыбранные оставляем — пользователь видит что не применял.
	УдалитьПримененныеИзТаблицыНаСервере();
	Объект.СтрокКомплекс = Макс(0, Объект.СтрокКомплекс - Результат.Обогащено);
	Объект.СтрокНовыеТД = Макс(0, Объект.СтрокНовыеТД - Результат.Создано);
	Объект.СтрокНовыйКомплекс = Макс(0, Объект.СтрокНовыйКомплекс - Результат.НовыйКомплекс);
	Объект.СтрокВсего = Объект.СтрокКомплекс + Объект.СтрокНовыеТД + Объект.СтрокНовыйКомплекс;
	ОбновитьЗаголовкиФильтров();
	// Если таблица опустела совсем — сбрасываем форму в исходный вид (как было раньше)
	Если Объект.ПредложенияКлассификации.Количество() = 0 Тогда
		ОчиститьПослеПримененияСервер();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФильтрВсе(Команда)

	ТекущийФильтрКатегории = "";
	ОбновитьОтборСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ФильтрНовыйКомплекс(Команда)

	ТекущийФильтрКатегории = "НовыйКомплекс";
	ОбновитьОтборСтрок();

КонецПроцедуры

// {audit 2026-05-19}: фильтр строк где Рег.№ ТД или Номер ДДП не \d{8}/\d{6}/\d{7}.
// Эти строки требуют внимания оператора (импорт, опечатки CSV).
&НаКлиенте
Процедура ФильтрНестандартныйФормат(Команда)

	ТекущийФильтрКатегории = "@НестандартныйФормат";
	ОбновитьОтборСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ФильтрКомплекс(Команда)

	ТекущийФильтрКатегории = "Комплекс";
	ОбновитьОтборСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ФильтрНоваяТД(Команда)

	ТекущийФильтрКатегории = "НоваяТД";
	ОбновитьОтборСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(ТекстИнструкции());
	Текст.Показать("Инструкция: загрузка реестра ТД");

КонецПроцедуры

&НаКлиенте
Процедура УдалитьСозданныеТД(Команда)

	КоличествоНайдено = ПодсчитатьСозданныеТДСервер();
	Если КоличествоНайдено = 0 Тогда
		ПоказатьПредупреждение(, "Документов «Операция по поручительству» с видом «ТД — ручная загрузка» не найдено.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("УдалитьСозданныеТДЗавершение", ЭтотОбъект);
	Текст = СтрШаблон(
		"Найдено %1 ОПП с видом операции «ТД — ручная загрузка» (созданные через реестр ТД)."
		+ Символы.ПС + Символы.ПС + "⚠ Документы будут УДАЛЕНЫ ФИЗИЧЕСКИ. Это необратимо."
		+ Символы.ПС + "Документы со ссылками из других объектов (регистры, остатки) будут пропущены"
		+ Символы.ПС + "с ошибкой, чтобы не оставить битых ссылок."
		+ Символы.ПС + Символы.ПС + "Удалить?",
		КоличествоНайдено);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьСозданныеТДЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Удаляем документы...");
	Результат = УдалитьСозданныеТДСервер();
	Состояние();

	Сообщение = Новый СообщениеПользователю;
	Если Результат.Ошибок = 0 Тогда
		Сообщение.Текст = СтрШаблон("✅ Удалено физически: %1.", Результат.Удалено);
	Иначе
		Сообщение.Текст = СтрШаблон("⚠ Удалено: %1. Пропущено из-за ссылок: %2 (см. журнал регистрации).",
			Результат.Удалено, Результат.Ошибок);
	КонецЕсли;
	Сообщение.Сообщить();

КонецПроцедуры

// {audit 2026-05-19}: ручной запуск группировки дублей.
// Раньше запускалось автоматически в конце Применить — без подтверждения и без видимости
// для пользователя что происходит. Теперь — отдельная кнопка, отдельное подтверждение.
&НаКлиенте
Процедура СгруппироватьДубли(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.ПериодС) ИЛИ Объект.ПериодС = '00010101' Тогда
		ПоказатьПредупреждение(,
			"Период не определён. Сначала прочитайте CSV — программа возьмёт"
			+ " период из дат выпуска CSV, и кнопка станет рабочей.");
		Возврат;
	КонецЕсли;

	Текст = СтрШаблон(
		"Найти и склеить дублирующие ОПП за период %1..%2?"
		+ Символы.ПС + Символы.ПС
		+ "Группировка по: основное ТС + Контрагент + Дата (день)."
		+ Символы.ПС
		+ "ОПП-«первый по дате» становится МАСТЕРОМ, остальные — помечаются на удаление."
		+ Символы.ПС
		+ "Их строки ТЧ ДанныеДокументов и КодыCMR переносятся в Мастер.",
		Формат(Объект.ПериодС, "ДФ=dd.MM.yyyy"),
		Формат(Объект.ПериодПо, "ДФ=dd.MM.yyyy"));
	Оповещение = Новый ОписаниеОповещения("СгруппироватьДублиЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СгруппироватьДублиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Группируем дубли по ТС+Контрагент+Дата...");
	Результат = СгруппироватьДублиСервер(Объект.ПериодС, Объект.ПериодПо);
	Состояние();

	Сообщение = Новый СообщениеПользователю;
	Если Результат.Групп = 0 Тогда
		Сообщение.Текст = "Дубли по ТС+Контрагент+Дата за указанный период не найдены — группировать нечего.";
	Иначе
		Сообщение.Текст = СтрШаблон(
			"✅ Сгруппировано: %1 групп. Всего обработано документов: %2."
			+ Символы.ПС + "Мастер-ОПП остался, дубликаты помечены на удаление —"
			+ " проверьте список ОПП и удалите помеченные если всё корректно.",
			Результат.Групп, Результат.Всего);
	КонецЕсли;
	Сообщение.Сообщить();

КонецПроцедуры

&НаСервере
Функция СгруппироватьДублиСервер(ДатаНач, ДатаКон)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.СгруппироватьДокументыПоТСКонтрагенту(
		НачалоДня(ДатаНач), КонецДня(ДатаКон));

КонецФункции

&НаКлиенте
Функция ТекстИнструкции()

	Стр = Новый Массив;
	Стр.Добавить("ЗАГРУЗКА РЕЕСТРА ТД — КАК РАБОТАТЬ");
	Стр.Добавить("Версия инструкции от 19.05.2026");
	Стр.Добавить("");
	Стр.Добавить("ЧТО ДЕЛАЕТ ОБРАБОТКА");
	Стр.Добавить("====================");
	Стр.Добавить("Сверяет CSV-выгрузку «Отчёт по журналу ЭТД» из Сигмы со списком");
	Стр.Добавить("документов «Операция по поручительству» (ОПП) в 1С и подсказывает,");
	Стр.Добавить("что делать с каждой строкой. Сама ничего не проводит и ничего не");
	Стр.Добавить("удаляет автоматически — только готовит черновики и логирует.");
	Стр.Добавить("");
	Стр.Добавить("КНОПКИ В КОМАНДНОЙ ПАНЕЛИ");
	Стр.Добавить("=========================");
	Стр.Добавить("  [Прочитать CSV]        — основной сценарий, шаг 1");
	Стр.Добавить("  [Применить выбранные]  — основной сценарий, шаг 2");
