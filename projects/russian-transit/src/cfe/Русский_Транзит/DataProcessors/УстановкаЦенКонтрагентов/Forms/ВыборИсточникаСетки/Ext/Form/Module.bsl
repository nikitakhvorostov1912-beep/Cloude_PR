
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Сохраняем настройки для ОбновитьПросмотрНаСервере
	АдресНастроек = ПоместитьВоВременноеХранилище(Параметры.СтруктураНастроек, УникальныйИдентификатор);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Контрагент КАК Контрагент,
	|	К.Наименование КАК Наименование,
	|	КОЛИЧЕСТВО(*) КАК КолвоСтрок,
	|	МАКСИМУМ(Т.ДатаУстановки) КАК ДатаУстановки
	|ИЗ
	|	РегистрСведений.ТарифныеСеткиОбеспечения.СрезПоследних(,) КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК К
	|		ПО Т.Контрагент = К.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	Т.Контрагент,
	|	К.Наименование
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		НовСтр = ТаблицаИсточников.Добавить();
		НовСтр.Контрагент = Выборка.Контрагент;
		НовСтр.Наименование = Выборка.Наименование;
		НовСтр.КолвоСтрок = Выборка.КолвоСтрок;
		НовСтр.ДатаУстановки = Выборка.ДатаУстановки;
	КонецЦикла;

	Если ТаблицаИсточников.Количество() = 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Показать сетку первого контрагента
	ВыбранныйКонтрагент = ТаблицаИсточников[0].Контрагент;
	ОбновитьПросмотрНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИсточниковПриАктивизацииСтроки(Элемент)

	ТекДанные = Элементы.ТаблицаИсточников.ТекущиеДанные;

	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекДанные.Контрагент <> ВыбранныйКонтрагент Тогда
		ВыбранныйКонтрагент = ТекДанные.Контрагент;
		ОбновитьПросмотрНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИсточниковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Выбрать(Неопределено);

КонецПроцедуры

&НаСервере
Процедура ОбновитьПросмотрНаСервере()

	ТабличныйДокументПросмотр.Очистить();

	Если НЕ ЗначениеЗаполнено(ВыбранныйКонтрагент) Тогда
		Возврат;
	КонецЕсли;

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Контрагент", ВыбранныйКонтрагент);

	СтруктураНастроек = ПолучитьИзВременногоХранилища(АдресНастроек);
	Если ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		Для Каждого КЗ Из СтруктураНастроек Цикл
			Если КЗ.Ключ <> "Контрагент" Тогда
				СтруктураПараметров.Вставить(КЗ.Ключ, КЗ.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ТабличныйДокументПросмотр = РегистрыСведений.ТарифныеСеткиОбеспечения.ТабличныйДокументЦенВывод(
		СтруктураПараметров, Ложь,, "",,, Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)

	Если НЕ ЗначениеЗаполнено(ВыбранныйКонтрагент) Тогда
		ПоказатьПредупреждение(, "Выберите контрагента из списка.");
		Возврат;
	КонецЕсли;

	Закрыть(ВыбранныйКонтрагент);

КонецПроцедуры
