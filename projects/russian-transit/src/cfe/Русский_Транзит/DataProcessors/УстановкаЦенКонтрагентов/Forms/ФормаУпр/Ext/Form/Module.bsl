Процедура ТабличныйДокументНовыхЦенПриИзмененииСодержимогоОбласти(Элемент, Область)
	
	Если Область.СодержитЗначение И ТипЗнч(Область.Расшифровка) = Тип("Структура") Тогда
		
		//Если Область.Расшифровка.Свойство("ЭтоВидРасчета") Тогда
		//	Если Область.Значение <> "%" И Область.Значение <> "" И Область.Значение <> " " Тогда
		//		ПоказатьПредупреждение(, "Некорректный ввод. Доступен только символ ""%""");
		//		Область.Значение = "";
		//		Элементы.ТабличныйДокументНовыхЦен.ТекущаяОбласть = Область;
		//	КонецЕсли;
		//КонецЕсли;
		
		Если Область.Расшифровка.ИндивидуальныйРасчет = "ИР" Тогда
