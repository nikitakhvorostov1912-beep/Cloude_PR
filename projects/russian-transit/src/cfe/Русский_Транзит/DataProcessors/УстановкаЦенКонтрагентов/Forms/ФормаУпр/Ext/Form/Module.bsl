// Доработка START {Аудит UX-07: предупреждение если контрагент не выбран} {2026-04-05}
&НаКлиенте
Процедура ИсторияЦен(Команда)

	Если НЕ ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(, "Выберите контрагента в списке слева.");
		Возврат;
	КонецЕсли;

	Если ТекущийКонтрагент <> Неопределено
			И ЗначениеЗаполнено(Объект.Организация)
			И ЗначениеЗаполнено(Объект.УслугаОрганизации) Тогда
		
		Если Объект.ГруппаСтранНачалаТранзита = Неопределено ИЛИ Объект.ГруппаСтранНачалаТранзита = ПредопределенноеЗначение("Справочник.СтранаОформления.ПустаяСсылка") Тогда
			Объект.ГруппаСтранНачалаТранзита = ПредопределенноеЗначение("Справочник.ГруппыСтран.ПустаяСсылка");
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Контрагент"			, ТекущийКонтрагент);
		СтруктураПараметров.Вставить("Организация"			, Объект.Организация);
		СтруктураПараметров.Вставить("УслугаОрганизации"	, Объект.УслугаОрганизации);
		СтруктураПараметров.Вставить("СтранаНачалаТранзита"	, Объект.ГруппаСтранНачалаТранзита);
		СтруктураПараметров.Вставить("ГруппаКодовУКТЗЕД"	, Объект.ГруппаКодовУКТЗЕД);
		СтруктураПараметров.Вставить("СпецЦены"				, Объект.СпецЦены);
		СтруктураПараметров.Вставить("ТипУслуги"			, Объект.ТипУслуги);
		СтруктураПараметров.Вставить("СубконтоСпецЦены"		, Объект.СубконтоСпецЦены);
		СтруктураПараметров.Вставить("СубконтоСпецЦены2"	, Объект.СубконтоСпецЦены2);
		// Доработка START {FR-008: СубконтоСпецЦены3} {2026-04-09}
		СтруктураПараметров.Вставить("СубконтоСпецЦены3"	, Объект.СубконтоСпецЦены3);
		// Доработка END
		
		ОткрытьФорму("Обработка.УстановкаЦенКонтрагентов.Форма.ИсторияЦенКонтрагента", СтруктураПараметров, ЭтаФорма, ТекущийКонтрагент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьТекущуюСетку(Команда)
	// Доработка START {Упрощение СпецЦены: проверка СпецСетка вместо субконто} {2026-04-12}
	Если Объект.СпецЦены И НЕ ЗначениеЗаполнено(Объект.СпецСетка) Тогда
		СтруктураПараметры = Новый Структура;
		СтруктураПараметры.Вставить("ТекстСообщения", НСтр("ru='Выберите спец-сетку!'"));

		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПоказатьПредупреждениеЗавершение",ЭтаФорма, СтруктураПараметры);
		ПоказатьПредупреждение(ОписаниеОповещенияОЗавершении, НСтр("ru='Выберите спец-сетку!'"),10);
	// Доработка END
	Иначе
	
		Если ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
			
			Если Объект.ГруппаСтранНачалаТранзита = Неопределено ИЛИ Объект.ГруппаСтранНачалаТранзита = ПредопределенноеЗначение("Справочник.СтранаОформления.ПустаяСсылка") Тогда
				Объект.ГруппаСтранНачалаТранзита = ПредопределенноеЗначение("Справочник.ГруппыСтран.ПустаяСсылка");
			КонецЕсли;
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Контрагент"			, ТекущийКонтрагент);
			СтруктураПараметров.Вставить("Организация"			, Объект.Организация);
			СтруктураПараметров.Вставить("УслугаОрганизации"	, Объект.УслугаОрганизации);
			СтруктураПараметров.Вставить("СтранаНачалаТранзита"	, Объект.ГруппаСтранНачалаТранзита);
			СтруктураПараметров.Вставить("ГруппаКодовУКТЗЕД"	, Объект.ГруппаКодовУКТЗЕД);
			СтруктураПараметров.Вставить("СпецЦены"				, Объект.СпецЦены);
			СтруктураПараметров.Вставить("ТипУслуги"			, Объект.ТипУслуги);
			СтруктураПараметров.Вставить("СубконтоСпецЦены"		, Объект.СубконтоСпецЦены);
		СтруктураПараметров.Вставить("СубконтоСпецЦены2"	, Объект.СубконтоСпецЦены2);
		// Доработка START {FR-008: СубконтоСпецЦены3} {2026-04-09}
		СтруктураПараметров.Вставить("СубконтоСпецЦены3"	, Объект.СубконтоСпецЦены3);
		// Доработка END
			
			ТабличныйДокументНовыхЦен = ПолучитьТабличныйДокументДанныхКонтрагента(СтруктураПараметров, Истина, Истина, " ");
			Если ТабличныйДокументНовыхЦен.Области.Количество() > 0 Тогда	
				ЗаполнитьТаблицуУстановкиЦен();
			Иначе
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Нет тарифной сетки для заполнения из текущей.";
				Сообщение.Сообщить();
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

