&НаКлиенте
Процедура ИсторияЦенУслуги(Команда)
	
	СтрокаТЧ = Элементы.ЦенообразованиеУслуги.ТекущиеДанные;
	Если СтрокаТЧ <> Неопределено Тогда
		Если ЗначениеЗаполнено(СтрокаТЧ.Контрагент)
				И ЗначениеЗаполнено(Объект.Организация) Тогда
				
			Если Объект.ТипУслуги = 0 Тогда //Основные услуги
				Если ЗначениеЗаполнено(Объект.УслугаОрганизации) Тогда
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("Контрагент"		, СтрокаТЧ.Контрагент);
					СтруктураПараметров.Вставить("Организация"		, Объект.Организация);
					СтруктураПараметров.Вставить("УслугаОрганизации", Объект.УслугаОрганизации);
					
					ОткрытьФорму("Обработка.УстановкаЦенКонтрагентов.Форма.ИсторияЦенКонтрагентаУслуги", СтруктураПараметров, ЭтаФорма, СтрокаТЧ.Контрагент);
				КонецЕсли;
			Иначе //Если Объект.ТипУслуги = 0 Тогда //Дополнительные услуги
				Если ЗначениеЗаполнено(Объект.УслугаОрганизации) Тогда
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("Контрагент"		, СтрокаТЧ.Контрагент);
					СтруктураПараметров.Вставить("Организация"		, Объект.Организация);
					СтруктураПараметров.Вставить("УслугаОрганизации", Объект.ДополнительнаяУслугаОрганизации);
					
					ОткрытьФорму("Обработка.УстановкаЦенКонтрагентов.Форма.ИсторияЦенКонтрагентаДопУслуги", СтруктураПараметров, ЭтаФорма, СтрокаТЧ.Контрагент);
				КонецЕсли;
			КонецЕсли;	
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

