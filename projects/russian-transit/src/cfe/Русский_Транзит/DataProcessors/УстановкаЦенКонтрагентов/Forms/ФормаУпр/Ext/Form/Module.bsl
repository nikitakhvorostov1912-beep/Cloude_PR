&НаСервереБезКонтекста
Функция ДопУслугиПринципалаНачалоВыбораИзСпискаНаСервере(пПринципал)
	
	СЗ = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(пПринципал) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ПринципалДополнительныеУслуги.УслугаОрганизации КАК УслугаОрганизации
			|ИЗ
			|	Справочник.Организация.ДополнительныеУслуги КАК ПринципалДополнительныеУслуги
			|ГДЕ
			|	ПринципалДополнительныеУслуги.Ссылка.ПринципалУстановкиЦен = &Организация
			|
			|УПОРЯДОЧИТЬ ПО
			|	УслугаОрганизации";
		
		Запрос.УстановитьПараметр("Организация", пПринципал);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СЗ.Добавить(Выборка.УслугаОрганизации);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СЗ;
	
КонецФункции

