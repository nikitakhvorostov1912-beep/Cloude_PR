&НаСервере
Процедура ЗаполнитьСтрокуТаблицыУстановкиЦен(пСтруктураПараметров, пЗначение)
	
	МасСтр = ТаблицаУстановкиЦен.НайтиСтроки(Новый Структура("АналитикаСумм,ДополнительнаяАналитика", пСтруктураПараметров.АналитикаСумм, пСтруктураПараметров.ДопАналитика));
	Если МасСтр.Количество() > 0 Тогда
		пСтрТабл = МасСтр[0];
		Если пСтруктураПараметров.Свойство("ЭтоИндивидуальныйРасчет") Тогда
			//Если пЗначение = "ИР" Тогда
			//	пСтрТабл.ИндивидуальныйРасчет = Истина;
			//Иначе
			//	пСтрТабл.ИндивидуальныйРасчет = Ложь;
			//КонецЕсли;
		ИначеЕсли пСтруктураПараметров.Свойство("ЭтоВидРасчета") Тогда
			Если пЗначение = "%" Тогда
				пСтрТабл.ВидРасчета = Перечисления.ВидыРасчетаЦен.Процент;
			Иначе
				пСтрТабл.ВидРасчета = Перечисления.ВидыРасчетаЦен.Число;
			КонецЕсли;
		ИначеЕсли пСтруктураПараметров.Свойство("ЭтоМинимальнаяЦена") Тогда
			пСтрТабл.МинимальнаяЦена= пЗначение;
		Иначе  //Если пСтруктураПараметров.ЭтоЗначение Тогда
			пСтрТабл.Цена 			= пЗначение;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументНовыхЦенВыбор(Элемент, Область, СтандартнаяОбработка)
		
	Если Область.СодержитЗначение И ТипЗнч(Область.Расшифровка) = Тип("Структура") Тогда
		
		пРасш = Область.Расшифровка;
		Если пРасш.Свойство("ЭтоИндивидуальныйРасчет") Тогда
			
			СтандартнаяОбработка = Ложь;
			
			//Если Область.Значение = "ИР" Тогда
			//	Область.Значение = "";
			//Иначе
			//	Область.Значение = "ИР";
			//КонецЕсли;
			
			ЗаполнитьСтрокуТаблицыУстановкиЦен(пРасш, Область.Значение);
			
			Если Область.Значение = "ИР" Тогда
				
				ОблЦена = ТабличныйДокументНовыхЦен.Область(Область.Верх - 1, Область.Лево - 3, Область.Низ - 1, Область.Право - 3);
				ОблЦена.Защита 		= Истина;
				ОблЦена.Значение 	= 0;
				//ОблЦена.Расшифровка.Вставить("ИндивидуальныйРасчет", "ИР");
				
				ОблМинЦена = ТабличныйДокументНовыхЦен.Область(Область.Верх, Область.Лево - 2, Область.Низ, Область.Право - 2);
				ОблМинЦена.Защита 	= Истина;
				ОблМинЦена.Значение = 0;
				//ОблМинЦена.Расшифровка.Вставить("ИндивидуальныйРасчет", "ИР");
				
				ОблВР = ТабличныйДокументНовыхЦен.Область(Область.Верх - 1, Область.Лево, Область.Низ - 1, Область.Право);
				ОблВР.Значение 		= "";
				ОблВР.Гиперссылка 	= Ложь;
				//ОблВР.Расшифровка.Вставить("ИндивидуальныйРасчет", "ИР");
				
			Иначе
				
				пСтрТабл 	= Неопределено;
				МасСтр 		= ТаблицаУстановкиЦен.НайтиСтроки(Новый Структура("АналитикаСумм,ДополнительнаяАналитика", пРасш.АналитикаСумм, пРасш.ДопАналитика));
				Если МасСтр.Количество() > 0 Тогда
					пСтрТабл = МасСтр[0];
				КонецЕсли;
				
				ОблЦена = ТабличныйДокументНовыхЦен.Область(Область.Верх - 1, Область.Лево - 3, Область.Низ - 1, Область.Право - 3);
				ОблЦена.Защита 		= Ложь;
				ОблЦена.Значение 	= ?(пСтрТабл = Неопределено, 0, пСтрТабл.Цена);
				//ОблЦена.Расшифровка.Вставить("ИндивидуальныйРасчет", "");
				
				ОблМинЦена = ТабличныйДокументНовыхЦен.Область(Область.Верх, Область.Лево - 2, Область.Низ, Область.Право - 2);
				ОблМинЦена.Защита 	= Ложь;
				ОблМинЦена.Значение = ?(пСтрТабл = Неопределено, 0, пСтрТабл.МинимальнаяЦена);
				//ОблМинЦена.Расшифровка.Вставить("ИндивидуальныйРасчет", "");
				
				ОблВР = ТабличныйДокументНовыхЦен.Область(Область.Верх - 1, Область.Лево, Область.Низ - 1, Область.Право);
				ОблВР.Значение 		= ?(пСтрТабл = Неопределено, "", ?(пСтрТабл.ВидРасчета = ПредопределенноеЗначение("Перечисление.ВидыРасчетаЦен.Процент"), "%", ""));
				ОблВР.Гиперссылка 	= Истина;
				//ОблВР.Расшифровка.Вставить("ИндивидуальныйРасчет", "");
				
			КонецЕсли;
			
		ИначеЕсли пРасш.Свойство("ЭтоВидРасчета") Тогда
			
			СтандартнаяОбработка = Ложь;
			
			Если пРасш.ИндивидуальныйРасчет <> "ИР" Тогда
				Если Область.Значение = "%" Тогда
					Область.Значение = "";
				Иначе
					Область.Значение = "%";
				КонецЕсли;
				
				ОблЦена = ТабличныйДокументНовыхЦен.Область(Область.Верх, Область.Лево - 3, Область.Низ, Область.Право - 3);
				Если Область.Значение = "%" Тогда
					ОблЦена.Формат 					= "ЧДЦ=3";
					ОблЦена.ФорматРедактирования 	= "ЧДЦ=3";
				Иначе //Если Область.Значение = "" Тогда
					ОблЦена.Формат 					= "ЧДЦ=2";
					ОблЦена.ФорматРедактирования 	= "ЧДЦ=2";
				КонецЕсли;
				
				ЗаполнитьСтрокуТаблицыУстановкиЦен(пРасш, Область.Значение);
			КонецЕсли;
			
		ИначеЕсли пРасш.Свойство("ЭтоЗначение") Тогда
						
			Если пРасш.ИндивидуальныйРасчет = "ИР" Тогда
				СтандартнаяОбработка = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

