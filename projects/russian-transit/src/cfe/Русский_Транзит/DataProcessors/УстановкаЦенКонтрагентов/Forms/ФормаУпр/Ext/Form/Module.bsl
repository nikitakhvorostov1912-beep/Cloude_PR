&НаСервере
Процедура ЗаполнитьТаблицуУстановкиЦен()
	
	ТаблицаУстановкиЦен.Очистить();
	
	пШиринаТаблицы = ТабличныйДокументНовыхЦен.ШиринаСтраницы;
	пВысотаТаблицы = ТабличныйДокументНовыхЦен.ВысотаСтраницы;
	
	Для ИндВ=1 По пВысотаТаблицы Цикл
		Для ИндШ=1 По пШиринаТаблицы Цикл
			
			пОбл 	= ТабличныйДокументНовыхЦен.Область(ИндШ, ИндВ, ИндШ, ИндВ);
			пРасш 	= пОбл.Расшифровка;
			Если ТипЗнч(пРасш) = Тип("Структура") Тогда
				Если пРасш.Свойство("АналитикаСумм") Тогда
					
					МасСтр = ТаблицаУстановкиЦен.НайтиСтроки(Новый Структура("АналитикаСумм,ДополнительнаяАналитика", пРасш.АналитикаСумм, пРасш.ДопАналитика));
					Если МасСтр.Количество() = 0 Тогда
						НовСтр = ТаблицаУстановкиЦен.Добавить();
						НовСтр.АналитикаСумм 			= пРасш.АналитикаСумм;
						НовСтр.ДополнительнаяАналитика 	= пРасш.ДопАналитика;
						НовСтр.КлючАналитик 			= пРасш.АналитикаСумм.Владелец;
					Иначе
						НовСтр = МасСтр[0];
					КонецЕсли;
					
					Если пРасш.Свойство("ЭтоЗначение") Тогда
						НовСтр.Цена 				= пОбл.Значение;
					ИначеЕсли пРасш.Свойство("ЭтоМинимальнаяЦена") Тогда
						НовСтр.МинимальнаяЦена 		= пОбл.Значение;
					ИначеЕсли пРасш.Свойство("ЭтоИндивидуальныйРасчет") Тогда
						//Если пОбл.Значение = "ИР" Тогда
						//	НовСтр.ИндивидуальныйРасчет = Истина;
						//Иначе
						//	НовСтр.ИндивидуальныйРасчет = Ложь;
						//КонецЕсли;
					Иначе  //Если пРасш.ЭтоВидРасчета Тогда
						Если пОбл.Значение = "%" Тогда
							НовСтр.ВидРасчета 		= Перечисления.ВидыРасчетаЦен.Процент;
						Иначе
							НовСтр.ВидРасчета 		= Перечисления.ВидыРасчетаЦен.Число;
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

