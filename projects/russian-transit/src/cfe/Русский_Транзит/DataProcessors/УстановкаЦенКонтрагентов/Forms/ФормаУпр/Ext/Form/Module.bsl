
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Контрагент") Тогда
		ПолученныйКонтрагент = Параметры.Контрагент;
	КонецЕсли;

	// Доработка START {Передача СпецЦены из документа} {2026-04-12}
	Если Параметры.Свойство("СпецЦены") Тогда
		Объект.СпецЦены = Параметры.СпецЦены;
	КонецЕсли;
	// Доработка END

	Если ПолученныйКонтрагент <> Справочники.Контрагенты.ПустаяСсылка() тогда
		ЗаполнитьНастройкиПоУмолчаниюНаСервере();
	КонецЕсли;

	Объект.Организация = Справочники.Организации.ПолучитьОрганизациюПоУмолчанию();
	Объект.УслугаОрганизации = ПредопределенноеЗначение("Перечисление.ТипыУслугОрганизации.ОсновнаяУслуга");

	// Доработка START {Скрыть ОформлениеТД из выпадающего списка — услуга не используется отдельно} {2026-04-04}
	Элементы.УслугаОрганизации.РежимВыбораИзСписка = Истина;
	Для Каждого ЭлементПеречисления Из Перечисления.ТипыУслугОрганизации Цикл
		Если ЭлементПеречисления <> Перечисления.ТипыУслугОрганизации.ОформлениеТД Тогда
			Элементы.УслугаОрганизации.СписокВыбора.Добавить(ЭлементПеречисления);
		КонецЕсли;
	КонецЦикла;
	// Доработка END

	ПриСозданииФормыОбработкиНаСервере(Отказ, СтандартнаяОбработка);

	// Доработка START {Изменить тариф: применить контрагента ПОСЛЕ загрузки сохранённых настроек} {2026-04-12}
	Если ЗначениеЗаполнено(ПолученныйКонтрагент) Тогда
		Объект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].ПравоеЗначение = ПолученныйКонтрагент;
		Объект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].Использование = Истина;
		ЗаполнитьТаблицуНаСервере();
	КонецЕсли;
	// Доработка END

КонецПроцедуры

&НаСервере
Процедура ПриСозданииФормыОбработкиНаСервере(Отказ, СтандартнаяОбработка=Истина)
	
	Перем НастройкаКомпоновщикаНастроек;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПарамСохранения = ДоработкиОбщегоНазначенияСервер.ХранилищеОбщихНастроекЗагрузить("УстановкаЦенКонтрагентовВМашинахС2024",,,,);
	//ПарамСохранения = Неопределено;
	
	УстановитьПривилегированныйРежим(Ложь);
	                
	ОбъектГл = РеквизитФормыВЗначение("Объект");
	пСхемаКомпоновкиДанных 	= ОбъектГл.ПолучитьМакет("КомпоновкаСеткиКонтрагентов");
	
	//КомпоновщикНастроек
	АдресДляКомпоновщикаНастроек = ПоместитьВоВременноеХранилище(пСхемаКомпоновкиДанных, УникальныйИдентификатор);
	ИсточникНастроек 		= Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресДляКомпоновщикаНастроек); 
	Объект.КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
		
	Если ТипЗнч(ПарамСохранения) = Тип("Структура") Тогда
		
		ПарамСохранения.Свойство("НастройкаКомпоновщикаНастроек"			, НастройкаКомпоновщикаНастроек);
		Если ТипЗнч(НастройкаКомпоновщикаНастроек) = Тип("НастройкиКомпоновкиДанных") Тогда
			Объект.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкаКомпоновщикаНастроек);
		Иначе
			Объект.КомпоновщикНастроек.ЗагрузитьНастройки(пСхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		КонецЕсли;
		
		ПарамСохранения.Свойство("Организация", Объект.Организация);
		
		Если Объект.ГруппаСтранНачалаТранзита = Неопределено ИЛИ Объект.ГруппаСтранНачалаТранзита = Справочники.СтранаОформления.ПустаяСсылка() Тогда
			Объект.ГруппаСтранНачалаТранзита = Справочники.ГруппыСтран.ПустаяСсылка();
		КонецЕсли;
		
		пУслугаОрганизации 		= Неопределено;
		пДопУслугаОрганизации 	= Неопределено;
		ПарамСохранения.Свойство("УслугаОрганизации"				, пУслугаОрганизации);
		ПарамСохранения.Свойство("ДополнительнаяУслугаОрганизации"	, пДопУслугаОрганизации);
		ПарамСохранения.Свойство("ТипУслуги"						, Объект.ТипУслуги);
		ПарамСохранения.Свойство("ГруппаКодовУКТЗЕД"				, Объект.ГруппаКодовУКТЗЕД);
		ПарамСохранения.Свойство("СпецЦены"							, Объект.СпецЦены);
		// Доработка START {Упрощение СпецЦены: загрузка СпецСетка из настроек} {2026-04-12}
		ПарамСохранения.Свойство("СпецСетка"						, Объект.СпецСетка);
		Если ЗначениеЗаполнено(Объект.СпецСетка) Тогда
			РеквизитыСетки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.СпецСетка,
				"СубконтоСпецЦены, СубконтоСпецЦены2, СубконтоСпецЦены3");
			Объект.СубконтоСпецЦены = РеквизитыСетки.СубконтоСпецЦены;
			Объект.СубконтоСпецЦены2 = РеквизитыСетки.СубконтоСпецЦены2;
			Объект.СубконтоСпецЦены3 = РеквизитыСетки.СубконтоСпецЦены3;
		КонецЕсли;
		// Доработка END

	Иначе
		Если ПолученныйКонтрагент = Справочники.Контрагенты.ПустаяСсылка() тогда 
			Объект.КомпоновщикНастроек.ЗагрузитьНастройки(пСхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		КонецЕсли;
	КонецЕсли;
	
	Объект.НаДату = ТекущаяДатаСеанса(); // Аудит 2026-04-04

	//ЗаполнитьПараметрыКомпоновщика();


КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Доработка START {Упрощение СпецЦены: единое поле СпецСетка} {2026-04-12}
	Элементы.СпецСетка.Видимость = Объект.СпецЦены;
	// Доработка END

	// Доработка START {Изменить тариф: автовыбор контрагента из документа и показ сетки} {2026-04-12}
	Если ЗначениеЗаполнено(ПолученныйКонтрагент)
		И Объект.СписокКонтрагентов.Количество() > 0 Тогда
		Для Каждого СтрСписка Из Объект.СписокКонтрагентов Цикл
			Если СтрСписка.Значение = ПолученныйКонтрагент Тогда
				Элементы.СписокКонтрагентов.ТекущаяСтрока = СтрСписка.ПолучитьИдентификатор();
				СписокКонтрагентовПриАктивизацииСтроки(Элементы.СписокКонтрагентов);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// Доработка END

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиНаСервере()
		
	Если Объект.ГруппаСтранНачалаТранзита = Неопределено ИЛИ Объект.ГруппаСтранНачалаТранзита = Справочники.СтранаОформления.ПустаяСсылка() Тогда
		Объект.ГруппаСтранНачалаТранзита = Справочники.ГруппыСтран.ПустаяСсылка();
	КонецЕсли;
		
	ПарамСохранения = Новый Структура;
	ПарамСохранения.Вставить("НастройкаКомпоновщикаНастроек"	, Объект.КомпоновщикНастроек.ПолучитьНастройки());
	ПарамСохранения.Вставить("Организация"						, Объект.Организация);
	ПарамСохранения.Вставить("УслугаОрганизации"				, Объект.УслугаОрганизации);
	ПарамСохранения.Вставить("ДополнительнаяУслугаОрганизации"	, Объект.ДополнительнаяУслугаОрганизации);
	ПарамСохранения.Вставить("ГруппаСтранНачалаТранзита"		, Объект.ГруппаСтранНачалаТранзита);
	ПарамСохранения.Вставить("ТипУслуги"						, Объект.ТипУслуги);
	ПарамСохранения.Вставить("ГруппаКодовУКТЗЕД"				, Объект.ГруппаКодовУКТЗЕД);
	ПарамСохранения.Вставить("СпецЦены"							, Объект.СпецЦены);
	// Доработка START {Упрощение СпецЦены: сохранение СпецСетка} {2026-04-12}
	ПарамСохранения.Вставить("СпецСетка"						, Объект.СпецСетка);
	// Доработка END

	УстановитьПривилегированныйРежим(Истина);
	// Доработка START {Аудит: раскомментировано сохранение настроек} {2026-04-05}
	ДоработкиОбщегоНазначенияСервер.ХранилищеОбщихНастроекСохранить("УстановкаЦенКонтрагентовВМашинахС2024",,ПарамСохранения,,);
	// Доработка END
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПерезаполнитьТаблицуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьТаблицу();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокКонтрагентов(Команда)
	
	Если Объект.СписокКонтрагентов.Количество() <> 0 Тогда
		
		ТекстВопроса = НСтр("ru='Список будет перезаполнен. Продолжить?';uk='Список будет перезаполнен. Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ВопросПерезаполнитьТаблицуЗавершение", ЭтаФорма);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ЗаполнитьТаблицу();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицу()
	
	ЗаполнитьТаблицуНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	
	ЗаписатьНастройкиНаСервере();
	
	ОбъектГл 			= РеквизитФормыВЗначение("Объект");
	ТаблицаОбработки 	= Новый ТаблицаЗначений;
			
	пСхемаКомпоновкиДанных 	= ОбъектГл.ПолучитьМакет("КомпоновкаСеткиКонтрагентов");
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(пСхемаКомпоновкиДанных, Объект.КомпоновщикНастроек.ПолучитьНастройки(), , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ПроцессорВывода.УстановитьОбъект(ТаблицаОбработки);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Объект.СписокКонтрагентов.Очистить();
	
	Для каждого Стр Из ТаблицаОбработки Цикл
		НовСтр = Объект.СписокКонтрагентов.Добавить();
		НовСтр.Значение = Стр.Контрагент;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНовыеЦеныНаСервере(ОповеститьКлиентаПоEmail=Ложь)
	
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	ТекДата 		= ТекущаяДатаСеанса(); // Аудит 2026-04-04
	
	Если Элементы.СтраницыЦены.ТекущаяСтраница = Элементы.СтраницаСетка Тогда
		
		Если Объект.ГруппаСтранНачалаТранзита = Неопределено ИЛИ Объект.ГруппаСтранНачалаТранзита = Справочники.СтранаОформления.ПустаяСсылка() Тогда
			Объект.ГруппаСтранНачалаТранзита = Справочники.ГруппыСтран.ПустаяСсылка();
		КонецЕсли;
		
		// Доработка START {Аудит: один набор записей на контрагента вместо N транзакций} {2026-04-05}
		ВидРасчетаИР = Перечисления.ВидыРасчетаЦен.Число;

		// Доработка START {Аудит качества: общая транзакция на всех контрагентов — атомарная запись} {2026-04-09}
		НачатьТранзакцию();
		Попытка
			Для каждого ЭлСК Из Объект.СписокКонтрагентов Цикл

				Если НЕ ЭлСК.Пометка Тогда
					Продолжить;
				КонецЕсли;

				// Один набор на контрагента: очистка + все строки за одну запись
				НабЗап = РегистрыСведений.ТарифныеСеткиОбеспечения.СоздатьНаборЗаписей();
				НабЗап.Отбор.Период.Установить(Объект.НаДату);
				НабЗап.Отбор.Контрагент.Установить(ЭлСК.Значение);
				НабЗап.Отбор.СпецЦены.Установить(Объект.СпецЦены);
				НабЗап.Отбор.СубконтоСпецЦены.Установить(Объект.СубконтоСпецЦены);
				НабЗап.Отбор.СубконтоСпецЦены2.Установить(Объект.СубконтоСпецЦены2);
				// Доработка START {FR-008: СубконтоСпецЦены3} {2026-04-09}
				НабЗап.Отбор.СубконтоСпецЦены3.Установить(Объект.СубконтоСпецЦены3);
				// Доработка END

				Для каждого СтрЦ Из ТаблицаУстановкиЦен Цикл
					НовЗап = НабЗап.Добавить();
					НовЗап.Период 						= Объект.НаДату;
					НовЗап.Контрагент 					= ЭлСК.Значение;
					НовЗап.АналитикаСумм 				= СтрЦ.АналитикаСумм;
					НовЗап.ДополнительнаяАналитика 		= СтрЦ.ДополнительнаяАналитика;
					НовЗап.КлючАналитик 				= СтрЦ.КлючАналитик;
					НовЗап.СпецЦены 					= Объект.СпецЦены;
					НовЗап.СубконтоСпецЦены 			= Объект.СубконтоСпецЦены;
					НовЗап.СубконтоСпецЦены2 			= Объект.СубконтоСпецЦены2;
					// Доработка START {FR-008: СубконтоСпецЦены3} {2026-04-09}
					НовЗап.СубконтоСпецЦены3 			= Объект.СубконтоСпецЦены3;
					// Доработка END
					Если СтрЦ.ИндивидуальныйРасчет Тогда
						НовЗап.Цена 					= 0;
						НовЗап.ВидРасчета 				= ВидРасчетаИР;
					Иначе
						НовЗап.Цена 					= СтрЦ.Цена;
						НовЗап.ВидРасчета 				= СтрЦ.ВидРасчета;
					КонецЕсли;
					НовЗап.МинимальнаяЦена 				= СтрЦ.МинимальнаяЦена;
					НовЗап.Валюта						= ВалютаСетки;
					НовЗап.Ответственный 				= ТекПользователь;
					НовЗап.ДатаУстановки 				= ТекДата;
				КонецЦикла;

				НабЗап.Записать(Истина);

			КонецЦикла;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОбщегоНазначения.СообщитьПользователю("Ошибка записи тарифных сеток: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		// Доработка END
		// Доработка END	
		
		Если ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Контрагент"			, ТекущийКонтрагент);
			СтруктураПараметров.Вставить("Организация"			, Объект.Организация);
			СтруктураПараметров.Вставить("УслугаОрганизации"	, Объект.УслугаОрганизации);
			СтруктураПараметров.Вставить("СтранаНачалаТранзита"	, Объект.ГруппаСтранНачалаТранзита);
			СтруктураПараметров.Вставить("ГруппаКодовУКТЗЕД"	, Объект.ГруппаКодовУКТЗЕД);
			СтруктураПараметров.Вставить("СпецЦены"				, Объект.СпецЦены);
			СтруктураПараметров.Вставить("ТипУслуги"			, Объект.ТипУслуги);
			СтруктураПараметров.Вставить("СубконтоСпецЦены"		, Объект.СубконтоСпецЦены);
		СтруктураПараметров.Вставить("СубконтоСпецЦены2"	, Объект.СубконтоСпецЦены2);
			// Доработка START {FR-008: СубконтоСпецЦены3} {2026-04-09}
			СтруктураПараметров.Вставить("СубконтоСпецЦены3"	, Объект.СубконтоСпецЦены3);
			// Доработка END

			ТабличныйДокументДанныхКонтрагента = ПолучитьТабличныйДокументДанныхКонтрагента(СтруктураПараметров);
		Иначе
			ТабличныйДокументДанныхКонтрагента = Неопределено;
		КонецЕсли;
		//ЗаполнитьТаблицуНаСервере();

	ИначеЕсли Элементы.СтраницыЦены.ТекущаяСтраница = Элементы.СтраницаУслуги Тогда
		
		// Доработка START {Аудит качества: общая транзакция на все услуги — атомарная запись} {2026-04-09}
		НачатьТранзакцию();
		Попытка
			Для каждого СтрЦУ Из Объект.ЦенообразованиеУслуги Цикл

				Если НЕ СтрЦУ.Выбран Тогда
					Продолжить;
				КонецЕсли;

				Если Объект.ТипУслуги = 0 Тогда //Основные услуги
					НабЗап = РегистрыСведений.ЦенообразованиеКодовCMR.СоздатьНаборЗаписей();
					НабЗап.Отбор.Период.Установить(Объект.НаДату);
					НабЗап.Отбор.Контрагент.Установить(СтрЦУ.Контрагент);
					НабЗап.Отбор.УслугаОрганизации.Установить(Объект.УслугаОрганизации);

					НовЗап = НабЗап.Добавить();
					НовЗап.Период 						= Объект.НаДату;
					НовЗап.Контрагент 					= СтрЦУ.Контрагент;
					НовЗап.УслугаОрганизации 			= Объект.УслугаОрганизации;

					Если Элементы.ЦенообразованиеУслугиЦенаУслугиНовая.Видимость Тогда
						НовЗап.ЦенаУслуги 				= СтрЦУ.ЦенаУслугиНовая;
					КонецЕсли;

					Если Элементы.ЦенообразованиеУслугиЦенаЗаПервуюCMRНовая.Видимость Тогда
						НовЗап.ЦенаЗаПервуюCMR 			= СтрЦУ.ЦенаЗаПервуюCMRНовая;
					КонецЕсли;

					Если Элементы.ЦенообразованиеУслугиЦенаЗаДополнительнуюCMRНовая.Видимость Тогда
						НовЗап.ЦенаЗаДополнительнуюCMR 	= СтрЦУ.ЦенаЗаДополнительнуюCMRНовая;
					КонецЕсли;

					Если Элементы.ЦенообразованиеУслугиЦенаЗаДополнительныйКодНовая.Видимость Тогда
						НовЗап.ЦенаЗаДополнительныйКод 	= СтрЦУ.ЦенаЗаДополнительныйКодНовая;
					КонецЕсли;

					Если Элементы.ЦенообразованиеУслугиКоличествоБесплатныхКодовНовое.Видимость Тогда
						НовЗап.КоличествоБесплатныхКодов= СтрЦУ.КоличествоБесплатныхКодовНовое;
					КонецЕсли;
				Иначе //Если Объект.ТипУслуги = 1 Тогда //Дополнительные услуги
					НабЗап = РегистрыСведений.ЦенообразованиеДополнительныеУслуги.СоздатьНаборЗаписей();
					НабЗап.Отбор.Период.Установить(Объект.НаДату);
					НабЗап.Отбор.Контрагент.Установить(СтрЦУ.Контрагент);
					НабЗап.Отбор.Организация.Установить(Объект.Организация);
					НабЗап.Отбор.УслугаОрганизации.Установить(Объект.ДополнительнаяУслугаОрганизации);

					НовЗап = НабЗап.Добавить();
					НовЗап.Период 						= Объект.НаДату;
					НовЗап.Контрагент 					= СтрЦУ.Контрагент;
					НовЗап.Организация 					= Объект.Организация;
					НовЗап.УслугаОрганизации 			= Объект.ДополнительнаяУслугаОрганизации;
					НовЗап.ЦенаУслуги 					= СтрЦУ.ЦенаУслугиНовая;
				КонецЕсли;

				НовЗап.Валюта 							= СтрЦУ.ВалютаЦеныНовая;
				НовЗап.Ответственный 					= ТекПользователь;
				НовЗап.ДатаУстановки 					= ТекДата;

				НабЗап.Записать(Истина);

			КонецЦикла;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОбщегоНазначения.СообщитьПользователю("Ошибка записи цен услуг: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		// Доработка END
		
		ТекущийКонтрагентУслуги = Неопределено;
		ЗаполнитьТаблицуУслугиНаСервере(Истина);
		
	Иначе  //пустая
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНовыеЦены(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.НаДату) Тогда
		ПоказатьПредупреждение(, "Укажите дату, на которую следует установить новые цены.");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ПоказатьПредупреждение(, "Укажите Организация.");
		Возврат;
	КонецЕсли;
	
	Если Элементы.СтраницыЦены.ТекущаяСтраница = Элементы.СтраницаСетка Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.УслугаОрганизации) Тогда
			ПоказатьПредупреждение(, "Укажите услугу.");
			Возврат;
		КонецЕсли;
		
		Если ПринципалЕвросоюза
				И (Объект.ГруппаСтранНачалаТранзита = Неопределено ИЛИ Объект.ГруппаСтранНачалаТранзита.Пустая()) Тогда
			ПоказатьПредупреждение(, "Укажите группу стран (или страну) начала транзита.");
			Возврат;
		КонецЕсли;
		
		Если ТаблицаУстановкиЦен.Количество() = 0 Тогда
			ПоказатьПредупреждение(, "Новые цены не установлены.");
			Возврат;
		Иначе
			СеткаЗаполнялась = Ложь;
			Для каждого СтрЦ Из ТаблицаУстановкиЦен Цикл
				Если СтрЦ.Цена > 0 ИЛИ СтрЦ.ИндивидуальныйРасчет Тогда
					СеткаЗаполнялась = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ СеткаЗаполнялась Тогда
				ПоказатьПредупреждение(, "Новые цены не установлены.");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если Объект.СписокКонтрагентов.Количество() = 0 Тогда
			ПоказатьПредупреждение(, "Выберите контрагентов для заполнения цен.");
			Возврат;
		Иначе
			КонтрагентыЗаполнены = Ложь;
			Для каждого ЭлСК Из Объект.СписокКонтрагентов Цикл
				Если ЭлСК.Пометка Тогда
					КонтрагентыЗаполнены = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ КонтрагентыЗаполнены Тогда
				ПоказатьПредупреждение(, "Выберите контрагентов для заполнения цен.");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВалютаСетки) Тогда
			ПоказатьПредупреждение(, "Укажите валюту сетки.");
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Элементы.СтраницыЦены.ТекущаяСтраница = Элементы.СтраницаУслуги Тогда
		
		Если Объект.ТипУслуги = 0 Тогда // Основные услуги
			Если НЕ ЗначениеЗаполнено(Объект.УслугаОрганизации) Тогда
				ПоказатьПредупреждение(, "Укажите услугу.");
				Возврат;
			КонецЕсли;
		Иначе //Если Объект.ТипУслуги = 1 Тогда //Дополнительные услуги
			Если НЕ ЗначениеЗаполнено(Объект.ДополнительнаяУслугаОрганизации) Тогда
				ПоказатьПредупреждение(, "Укажите доп. услугу.");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если Объект.ЦенообразованиеУслуги.Количество() = 0 Тогда
			ПоказатьПредупреждение(, "Новые цены не установлены.");
			Возврат;
		Иначе
			ХотьОдинВыбран 			= Ложь;
			ЕстьНезаполненныеВалюты = Ложь;
			Для каждого СтрЦУ Из Объект.ЦенообразованиеУслуги Цикл
				Если СтрЦУ.Выбран Тогда
					ХотьОдинВыбран = Истина;
					Если НЕ ЗначениеЗаполнено(СтрЦУ.ВалютаЦеныНовая) Тогда
						ЕстьНезаполненныеВалюты = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ ХотьОдинВыбран Тогда
				ПоказатьПредупреждение(, "Выберите контрагентов для заполнения цен.");
				Возврат;
			КонецЕсли;
			
			Если ЕстьНезаполненныеВалюты Тогда
				ПоказатьПредупреждение(, "Есть строки с незаполненной валютой цены.");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Если Объект.ОповеститьКлиентаПоEmail Тогда 
		ТекстВопроса = НСтр("ru='Оповестить клиента об изменении цен по E-mail?';uk='Сповістити клієнта про зміну цін по E-mail?'");
		Оповещение = Новый ОписаниеОповещения("ОтправлятьПоЭлектроннойПочтеВопрос", ЭтаФорма);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаписатьНовыеЦеныНаСервере(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗаголовокФормы()
	
	ТекстЗаголовкаФормы 	= "Установка цен контрагентов";
	
	Если ЗначениеЗаполнено(Объект.УслугаОрганизации) Тогда
		ТекстЗаголовкаФормы = ТекстЗаголовкаФормы + ": " + СокрЛП(Объект.УслугаОрганизации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстЗаголовкаФормы = ТекстЗаголовкаФормы + " (" + СокрЛП(Объект.Организация) + ")";
	КонецЕсли;
	
	ЭтаФорма.Заголовок = ТекстЗаголовкаФормы;
	
КонецПроцедуры

