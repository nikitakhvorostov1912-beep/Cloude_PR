&НаСервере
Процедура ИзменитьДанныеЦен(пЧисло, СтруктураПараметров)
	
	пШиринаТаблицы 		= ТабличныйДокументНовыхЦен.ШиринаСтраницы;
	пВысотаТаблицы 		= ТабличныйДокументНовыхЦен.ВысотаСтраницы;
	
	пМенятьЦены 		= СтруктураПараметров.Цены;
	пМенятьНаЗначение 	= СтруктураПараметров.Значение;
	
	Для ИндВ=1 По пВысотаТаблицы Цикл
		Для ИндШ=1 По пШиринаТаблицы Цикл
			
			пОбл 	= ТабличныйДокументНовыхЦен.Область(ИндШ, ИндВ, ИндШ, ИндВ);
			пРасш 	= пОбл.Расшифровка;
			Если ТипЗнч(пРасш) = Тип("Структура") Тогда
				Если пРасш.Свойство("АналитикаСумм") И пРасш.Свойство("ЭтоЗначение") Тогда
					
					МасСтр = ТаблицаУстановкиЦен.НайтиСтроки(Новый Структура("АналитикаСумм,ДополнительнаяАналитика", пРасш.АналитикаСумм, пРасш.ДопАналитика));
					Если МасСтр.Количество() > 0 Тогда
						СтрТЦ = МасСтр[0];
						
						Если СтрТЦ.ВидРасчета = Перечисления.ВидыРасчетаЦен.Число Тогда
							Если пМенятьЦены Тогда
								ТекЦена = пОбл.Значение;
								Если пМенятьНаЗначение Тогда
									НовЦена 	= ТекЦена + пЧисло;
								Иначе
									пПроц 		= Окр(ТекЦена * пЧисло / 100, 2);
									НовЦена 	= ТекЦена + пПроц;
								КонецЕсли;
								
								пОбл.Значение 	= НовЦена;
								СтрТЦ.Цена 		= НовЦена;
							КонецЕсли;
						Иначе //Если СтрТЦ.ВидРасчета = Перечисления.ВидыРасчетаЦен.Процент Тогда
							Если НЕ пМенятьЦены Тогда
								
								ТекЦена 		= пОбл.Значение;
								НовЦена 		= ТекЦена + пЧисло;
								
								пОбл.Значение 	= НовЦена;
								СтрТЦ.Цена 		= НовЦена;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

