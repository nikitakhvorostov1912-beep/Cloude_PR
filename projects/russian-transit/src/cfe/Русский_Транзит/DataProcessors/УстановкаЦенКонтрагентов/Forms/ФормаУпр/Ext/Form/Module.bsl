&НаКлиенте
Процедура ОтметитьКонтрагентовПоТекущейСетке(Команда)
	
	СтрокаСп = Элементы.СписокКонтрагентов.ТекущиеДанные;
	Если СтрокаСп = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите контрагента");
		Возврат;
	Иначе
		пКонтрагент = СтрокаСп.Значение;
	КонецЕсли;
	
	Если Объект.ГруппаСтранНачалаТранзита = Неопределено ИЛИ Объект.ГруппаСтранНачалаТранзита = ПредопределенноеЗначение("Справочник.СтранаОформления.ПустаяСсылка") Тогда
		Объект.ГруппаСтранНачалаТранзита = ПредопределенноеЗначение("Справочник.ГруппыСтран.ПустаяСсылка");
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Контрагент"			, пКонтрагент);
	СтруктураПараметров.Вставить("Принципал"			, Объект.Организация);
	СтруктураПараметров.Вставить("УслугаОрганизации"	, Объект.УслугаОрганизации);
	СтруктураПараметров.Вставить("СтранаНачалаТранзита"	, Объект.ГруппаСтранНачалаТранзита);
	СтруктураПараметров.Вставить("ГруппаКодовУКТЗЕД"	, Объект.ГруппаКодовУКТЗЕД);
	СтруктураПараметров.Вставить("СпецЦены"				, Объект.СпецЦены);
	СтруктураПараметров.Вставить("СубконтоСпецЦены"		, Объект.СубконтоСпецЦены);
	СтруктураПараметров.Вставить("СубконтоСпецЦены2"	, Объект.СубконтоСпецЦены2);
	// Доработка START {FR-008: СубконтоСпецЦены3} {2026-04-09}
	СтруктураПараметров.Вставить("СубконтоСпецЦены3"	, Объект.СубконтоСпецЦены3);
	// Доработка END

	пТекстПредупреждения = "";
	ОтметитьКонтрагентовПоТекущейСеткеНаСервере(СтруктураПараметров, пТекстПредупреждения);
	
	Если пТекстПредупреждения <> "" Тогда
		ПоказатьПредупреждение(, пТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтметитьКонтрагентовПоТекущейСеткеНаСервере(СтруктураПараметров, пТекстПредупреждения)
	
	ТаблицаДанныхДляСравнения = Неопределено;
	//РегистрыСведений.ЦенообразованиеСетка.СеткаКотрагентаДляСравнения(СтруктураПараметров);
	Если ТаблицаДанныхДляСравнения = Неопределено Тогда
		пТекстПредупреждения = "Нет данных для сравнения";
		Возврат;
	КонецЕсли;
	
	Если ТаблицаДанныхДляСравнения.Количество() = 0 Тогда
		пТекстПредупреждения = "Нет данных для сравнения";
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураПараметров.Свойство("Ключ") Тогда
		пТекстПредупреждения = "Нет данных для сравнения";
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦенообразованиеСеткаСрезПоследних.Период,
		|	ЦенообразованиеСеткаСрезПоследних.Контрагент,
		|	ЦенообразованиеСеткаСрезПоследних.АналитикаСумм,
		|	ЦенообразованиеСеткаСрезПоследних.ДополнительнаяАналитика,
		|	ЦенообразованиеСеткаСрезПоследних.Цена,
		|	ЦенообразованиеСеткаСрезПоследних.ВидРасчета,
		|	ЦенообразованиеСеткаСрезПоследних.ИндивидуальныйРасчет,
		|	ЦенообразованиеСеткаСрезПоследних.МинимальнаяЦена,
		|	ЦенообразованиеСеткаСрезПоследних.Валюта
		|ПОМЕСТИТЬ ВремВТ
		|ИЗ
		|	РегистрСведений.ТарифныеСеткиОбеспечения.СрезПоследних(
		|			,
		|			КлючАналитик = &Ключ
		|				И Контрагент В (&СписокКонтрагентов)
		|				И Контрагент <> &Контрагент
		|				И СпецЦены = &СпецЦены) КАК ЦенообразованиеСеткаСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремВТ.Контрагент КАК Контрагент,
		|	МАКСИМУМ(ВремВТ.Период) КАК Период
		|ПОМЕСТИТЬ МаксимумПериодВТ
		|ИЗ
		|	ВремВТ КАК ВремВТ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВремВТ.Контрагент
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контрагент,
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремВТ.АналитикаСумм,
		|	ВремВТ.ДополнительнаяАналитика,
		|	ВремВТ.Цена,
		|	ВремВТ.ВидРасчета,
		|	ВремВТ.ИндивидуальныйРасчет,
		|	ВремВТ.МинимальнаяЦена,
		|	ВремВТ.Контрагент КАК Контрагент,
		|	ВремВТ.Валюта
		|ИЗ
		|	ВремВТ КАК ВремВТ
		|ГДЕ
		|	(ВремВТ.Контрагент, ВремВТ.Период) В
		|			(ВЫБРАТЬ
		|				МаксимумПериодВТ.Контрагент,
		|				МаксимумПериодВТ.Период
		|			ИЗ
		|				МаксимумПериодВТ КАК МаксимумПериодВТ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВремВТ.АналитикаСумм.ЗначениеАналитики,
		|	ВремВТ.АналитикаСумм.ПорядокСортировкиВКлючеАналитик,
		|	ВремВТ.ДополнительнаяАналитика.ПорядокСортировкиВКлючеАналитик,
		|	ВремВТ.ДополнительнаяАналитика.ЗначениеАналитики
		|ИТОГИ ПО
		|	Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВремВТ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ МаксимумПериодВТ";
	
	Запрос.УстановитьПараметр("ГруппаСтранНачалаТранзита"	, СтруктураПараметров.ГруппаСтранНачалаТранзита);
	Запрос.УстановитьПараметр("ГруппаКодовУКТЗЕД"			, СтруктураПараметров.ГруппаКодовУКТЗЕД);
	Запрос.УстановитьПараметр("Ключ"						, СтруктураПараметров.Ключ);
	Запрос.УстановитьПараметр("Контрагент"					, СтруктураПараметров.Контрагент);
	Запрос.УстановитьПараметр("Организация"					, СтруктураПараметров.ПринципалУстановкиЦен);
	Запрос.УстановитьПараметр("СписокКонтрагентов"			, Объект.СписокКонтрагентов);
	Запрос.УстановитьПараметр("УслугаОрганизации"			, СтруктураПараметров.УслугаОрганизации);
	Запрос.УстановитьПараметр("СпецЦены"					, СтруктураПараметров.СпецЦены);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКонтрагент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МаксИнд = ТаблицаДанныхДляСравнения.Количество() - 1;
	
	МассивОтмеченных = Новый Массив;
	МассивОтмеченных.Добавить(СтруктураПараметров.Контрагент);
	
	Пока ВыборкаКонтрагент.Следующий() Цикл
		
		ЦеныОтличаются = Ложь;
		
		Выборка = ВыборкаКонтрагент.Выбрать();
		
		Инд = 0;
		Пока Выборка.Следующий() Цикл
			
			Если Инд > МаксИнд Тогда
				ЦеныОтличаются = Истина;
				Прервать;
			КонецЕсли;
			
			СтрЭталон = ТаблицаДанныхДляСравнения[Инд];
			
			Если Выборка.АналитикаСумм <> СтрЭталон.АналитикаСумм
					ИЛИ Выборка.ДополнительнаяАналитика <> СтрЭталон.ДопАналитика
					ИЛИ Выборка.Цена <> СтрЭталон.Цена
					ИЛИ Выборка.МинимальнаяЦена <> СтрЭталон.МинимальнаяЦена
					ИЛИ Выборка.ВидРасчета <> СтрЭталон.ВидРасчета
					ИЛИ Выборка.Валюта <> СтрЭталон.Валюта
					ИЛИ Выборка.ИндивидуальныйРасчет <> СтрЭталон.ИндивидуальныйРасчет Тогда
				ЦеныОтличаются = Истина;
				Прервать;
			КонецЕсли;
				
			Инд = Инд + 1;
			
		КонецЦикла;
		
		Если НЕ ЦеныОтличаются Тогда
			МассивОтмеченных.Добавить(ВыборкаКонтрагент.Контрагент);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ЭлСп Из Объект.СписокКонтрагентов Цикл
		ЭлСп.Пометка = (МассивОтмеченных.Найти(ЭлСп.Значение) <> Неопределено);
	КонецЦикла;
	
	пТекстПредупреждения = "Отмечено " + Формат(МассивОтмеченных.Количество(), "ЧГ=0") + " контрагентов";
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьКонтрагентовПоТекущимЦенам(Команда)
	
	Если Объект.ЦенообразованиеУслуги.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Заполните таблицу и выберите строку");
		Возврат;
	КонецЕсли;
	
	СтрокаТЧ = Элементы.ЦенообразованиеУслуги.ТекущиеДанные;
	Если СтрокаТЧ = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку в таблице");
		Возврат;
	КонецЕсли;
	
	МассивКолонокДляСверки = Новый Массив;
	
	Если Объект.ТипУслуги = 0 Тогда // Основные услуги
		Если Объект.УслугаОрганизации = ПредопределенноеЗначение("Перечисление.ТипыУслугОрганизации.ЭПИ")
				ИЛИ Объект.УслугаОрганизации = ПредопределенноеЗначение("Перечисление.ТипыУслугОрганизации.ЭПИTIR")
				ИЛИ Объект.УслугаОрганизации = ПредопределенноеЗначение("Перечисление.ТипыУслугОрганизации.ЭТД")
				ИЛИ Объект.УслугаОрганизации = ПредопределенноеЗначение("Перечисление.ТипыУслугОрганизации.T1_Услуга") Тогда
			МассивКолонокДляСверки.Добавить("ЦенаЗаПервуюCMRТекущая");
			МассивКолонокДляСверки.Добавить("ЦенаЗаДополнительнуюCMRТекущая");
			МассивКолонокДляСверки.Добавить("ЦенаЗаДополнительныйКодТекущая");
			МассивКолонокДляСверки.Добавить("КоличествоБесплатныхКодовТекущее");
			МассивКолонокДляСверки.Добавить("ВалютаЦеныТекущая");
		Иначе
			МассивКолонокДляСверки.Добавить("ЦенаУслугиТекущая");
			МассивКолонокДляСверки.Добавить("ЦенаЗаПервуюCMRТекущая");
			МассивКолонокДляСверки.Добавить("ЦенаЗаДополнительнуюCMRТекущая");
			МассивКолонокДляСверки.Добавить("ЦенаЗаДополнительныйКодТекущая");
			МассивКолонокДляСверки.Добавить("КоличествоБесплатныхКодовТекущее");
			МассивКолонокДляСверки.Добавить("ВалютаЦеныТекущая");
		КонецЕсли;
	Иначе //Если Объект.ТипУслуги = 1 Тогда // Дополнительные услуги
		МассивКолонокДляСверки.Добавить("ЦенаУслугиТекущая");
	КонецЕсли;
	
	Для каждого Стр Из Объект.ЦенообразованиеУслуги Цикл
		
		Если Стр.Контрагент = СтрокаТЧ.Контрагент Тогда
			Стр.Выбран = Истина;
			Продолжить;
		КонецЕсли;
		
		ЦеныОтличаются = Ложь;
		Для каждого КолСверки Из МассивКолонокДляСверки Цикл
			Если Стр[КолСверки] <> СтрокаТЧ[КолСверки] Тогда
				ЦеныОтличаются = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Стр.Выбран = (НЕ ЦеныОтличаются);
		
	КонецЦикла;
	
	ПоказатьПредупреждение(, "Отмечено " + Формат(Объект.ЦенообразованиеУслуги.НайтиСтроки(Новый Структура("Выбран", Истина)).Количество(), "ЧГ=0") + " контрагентов");
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОтмеченныхСетка(Команда)
	
	ТекстВопроса = НСтр("ru='Вы уверены, что хотите удалить отмеченных контрагентов из списка?';uk='Вы уверены, что хотите удалить отмеченных контрагентов из списка?'");
	Оповещение = Новый ОписаниеОповещения("ВопросУдалитьОтмеченныхЗавершение", ЭтаФорма, Новый Структура("Сетка", Истина));
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОтмеченных(Команда)
	
	ТекстВопроса = НСтр("ru='Вы уверены, что хотите удалить отмеченных контрагентов из таблицы?';uk='Вы уверены, что хотите удалить отмеченных контрагентов из таблицы?'");
	Оповещение = Новый ОписаниеОповещения("ВопросУдалитьОтмеченныхЗавершение", ЭтаФорма, Новый Структура("Сетка", Ложь));
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУдалитьОтмеченныхЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ДополнительныеПараметры.Сетка Тогда
			
			Всего = Объект.СписокКонтрагентов.Количество();
			Для Инд=1 По Всего Цикл
				Эл = Объект.СписокКонтрагентов[Всего - Инд];
				Если Эл.Пометка Тогда
					Объект.СписокКонтрагентов.Удалить(Эл);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			Всего = Объект.ЦенообразованиеУслуги.Количество();
			Для Инд=1 По Всего Цикл
				Поз = Всего - Инд;
				Стр = Объект.ЦенообразованиеУслуги[Поз];
				Если Стр.Выбран Тогда
					Объект.ЦенообразованиеУслуги.Удалить(Поз);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦеныУОтмеченныхПоЦенамТекущего(Команда)
	
	СтрокаШаблон = Элементы.ЦенообразованиеУслуги.ТекущиеДанные;
	Если СтрокаШаблон = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку");
		Возврат;
	КонецЕсли;
	
	Для каждого Стр Из Объект.ЦенообразованиеУслуги Цикл
		
		Если (НЕ Стр.Выбран) ИЛИ Стр = СтрокаШаблон Тогда
			Продолжить;
		КонецЕсли;
		
		Стр.ЦенаУслугиНовая 				= СтрокаШаблон.ЦенаУслугиНовая;
		Стр.ЦенаЗаПервуюCMRНовая 			= СтрокаШаблон.ЦенаЗаПервуюCMRНовая;
		Стр.ЦенаЗаДополнительнуюCMRНовая 	= СтрокаШаблон.ЦенаЗаДополнительнуюCMRНовая;
		Стр.ЦенаЗаДополнительныйКодНовая 	= СтрокаШаблон.ЦенаЗаДополнительныйКодНовая;
		Стр.КоличествоБесплатныхКодовНовое 	= СтрокаШаблон.КоличествоБесплатныхКодовНовое;
		Стр.ВалютаЦеныНовая					= СтрокаШаблон.ВалютаЦеныНовая;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СпецЦеныПриИзменении(Элемент)
	
	ТекКонтрагент = Неопределено;
	
	СтрокаСп = Элементы.СписокКонтрагентов.ТекущиеДанные;
	Если СтрокаСп <> Неопределено Тогда
		ТекКонтрагент = СтрокаСп.Значение;
	КонецЕсли;
	
	// Доработка START {Упрощение СпецЦены: единое поле СпецСетка} {2026-04-12}
	Элементы.СпецСетка.Видимость = Объект.СпецЦены;
	Если НЕ Объект.СпецЦены Тогда
		Объект.СпецСетка = Неопределено;
		Объект.СубконтоСпецЦены = Неопределено;
		Объект.СубконтоСпецЦены2 = Неопределено;
		Объект.СубконтоСпецЦены3 = Неопределено;
	КонецЕсли;
	// Доработка END

	Если ТекКонтрагент <> Неопределено И Не Объект.СпецЦены Тогда
			
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Контрагент"			, ТекКонтрагент);
		СтруктураПараметров.Вставить("Организация"			, Объект.Организация);
		СтруктураПараметров.Вставить("УслугаОрганизации"	, Объект.УслугаОрганизации);
		СтруктураПараметров.Вставить("СтранаНачалаТранзита"	, Объект.ГруппаСтранНачалаТранзита);
		СтруктураПараметров.Вставить("ГруппаКодовУКТЗЕД"	, Объект.ГруппаКодовУКТЗЕД);
		СтруктураПараметров.Вставить("СпецЦены"				, Объект.СпецЦены);
		СтруктураПараметров.Вставить("ТипУслуги"			, Объект.ТипУслуги);
		СтруктураПараметров.Вставить("СубконтоСпецЦены"		, Объект.СубконтоСпецЦены);
		СтруктураПараметров.Вставить("СубконтоСпецЦены2"	, Объект.СубконтоСпецЦены2);
		// Доработка START {FR-008: СубконтоСпецЦены3} {2026-04-09}
		СтруктураПараметров.Вставить("СубконтоСпецЦены3"	, Объект.СубконтоСпецЦены3);
		// Доработка END
		
		ТабличныйДокументДанныхКонтрагента = ПолучитьТабличныйДокументДанныхКонтрагента(СтруктураПараметров);
	
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПустуюСсылку()
	
	возврат Справочники.ТаможенныеПункты.ПустаяСсылка();	

КонецФункции


// Доработка START {Упрощение СпецЦены: единый обработчик СпецСетка вместо 3 субконто} {2026-04-12}
&НаСервереБезКонтекста
Функция ПолучитьСубконтоСпецСетки(СпецСетка)

	Если НЕ ЗначениеЗаполнено(СпецСетка) Тогда
		Возврат Новый Структура("СубконтоСпецЦены, СубконтоСпецЦены2, СубконтоСпецЦены3",
			Неопределено, Неопределено, Неопределено);
	КонецЕсли;

	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СпецСетка,
		"СубконтоСпецЦены, СубконтоСпецЦены2, СубконтоСпецЦены3");

КонецФункции

&НаКлиенте
Процедура СпецСеткаПриИзменении(Элемент)

	РеквизитыСетки = ПолучитьСубконтоСпецСетки(Объект.СпецСетка);
	Объект.СубконтоСпецЦены = РеквизитыСетки.СубконтоСпецЦены;
	Объект.СубконтоСпецЦены2 = РеквизитыСетки.СубконтоСпецЦены2;
	Объект.СубконтоСпецЦены3 = РеквизитыСетки.СубконтоСпецЦены3;

	ТекКонтрагент = Неопределено;
	СтрокаСп = Элементы.СписокКонтрагентов.ТекущиеДанные;
	Если СтрокаСп <> Неопределено Тогда
		ТекКонтрагент = СтрокаСп.Значение;
	КонецЕсли;

	Если ТекКонтрагент <> Неопределено Тогда

		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Контрагент"			, ТекКонтрагент);
