// Доработка START {Копирование сетки - форма выбора с превью} {2026-04-05}
&НаКлиенте
Процедура ЗаполнитьИзТекущегоКонтрагента(Команда)

	Если Объект.ГруппаСтранНачалаТранзита = Неопределено
		ИЛИ Объект.ГруппаСтранНачалаТранзита = ПредопределенноеЗначение("Справочник.СтранаОформления.ПустаяСсылка") Тогда
		Объект.ГруппаСтранНачалаТранзита = ПредопределенноеЗначение("Справочник.ГруппыСтран.ПустаяСсылка");
	КонецЕсли;

	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("Организация",			Объект.Организация);
	СтруктураНастроек.Вставить("УслугаОрганизации",		Объект.УслугаОрганизации);
	СтруктураНастроек.Вставить("СтранаНачалаТранзита",	Объект.ГруппаСтранНачалаТранзита);
	СтруктураНастроек.Вставить("ГруппаКодовУКТЗЕД",	Объект.ГруппаКодовУКТЗЕД);
	СтруктураНастроек.Вставить("СпецЦены",				Объект.СпецЦены);
	СтруктураНастроек.Вставить("ТипУслуги",				Объект.ТипУслуги);
	СтруктураНастроек.Вставить("СубконтоСпецЦены",		Объект.СубконтоСпецЦены);
	СтруктураНастроек.Вставить("СубконтоСпецЦены2",		Объект.СубконтоСпецЦены2);
	СтруктураНастроек.Вставить("СубконтоСпецЦены3",		Объект.СубконтоСпецЦены3);
	// Доработка START {Упрощение СпецЦены: передача СпецСетка} {2026-04-12}
	СтруктураНастроек.Вставить("СпецСетка",				Объект.СпецСетка);
	// Доработка END

	ПараметрыФормы = Новый Структура("СтруктураНастроек", СтруктураНастроек);
	ОписаниеОповещения = Новый ОписаниеОповещения("СкопироватьСеткуОтКонтрагентаЗавершение", ЭтаФорма);

	ОткрытьФорму("Обработка.УстановкаЦенКонтрагентов.Форма.ВыборИсточникаСетки",
		ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКонтрагентовССеткойНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Контрагент КАК Контрагент,
	|	Т.Контрагент.Наименование КАК Наименование,
	|	КОЛИЧЕСТВО(*) КАК Строк
	|ИЗ
	|	РегистрСведений.ТарифныеСеткиОбеспечения.СрезПоследних КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.Контрагент,
	|	Т.Контрагент.Наименование
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Результат = Запрос.Выполнить().Выгрузить();

	СписокИсточников = Новый СписокЗначений;
	Для Каждого Стр Из Результат Цикл
		СписокИсточников.Добавить(Стр.Контрагент, Стр.Наименование + " (" + Формат(Стр.Строк, "ЧН=0; ЧГ=") + " строк)");
	КонецЦикла;

	Возврат СписокИсточников;

КонецФункции

&НаКлиенте
Процедура СкопироватьСеткуОтКонтрагентаЗавершение(КонтрагентИсточник, ДополнительныеПараметры) Экспорт

	Если КонтрагентИсточник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Прямое чтение из регистра + отображение в табличном документе
	КоличествоСтрок = СкопироватьСеткуИзРегистраНаСервере(КонтрагентИсточник);

	Если КоличествоСтрок = 0 Тогда
		ПоказатьПредупреждение(, "У контрагента """ + КонтрагентИсточник
			+ """ нет тарифной сетки с текущими настройками.");
	КонецЕсли;

КонецПроцедуры

// Доработка START {Копирование сетки - прямой запрос к регистру + отображение} {2026-04-05}
&НаСервере
Функция СкопироватьСеткуИзРегистраНаСервере(КонтрагентИсточник)

	ТаблицаУстановкиЦен.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.АналитикаСумм КАК АналитикаСумм,
	|	Т.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
	|	Т.КлючАналитик КАК КлючАналитик,
	|	Т.Цена КАК Цена,
	|	Т.ВидРасчета КАК ВидРасчета,
	|	Т.ИндивидуальныйРасчет КАК ИндивидуальныйРасчет,
	|	Т.МинимальнаяЦена КАК МинимальнаяЦена
	|ИЗ
	|	РегистрСведений.ТарифныеСеткиОбеспечения.СрезПоследних(
	|		&НаДату,
	|		Контрагент = &Контрагент
	|			И СпецЦены = &СпецЦены
	|			И СубконтоСпецЦены = &СубконтоСпецЦены
	|			И СубконтоСпецЦены2 = &СубконтоСпецЦены2
	|			И СубконтоСпецЦены3 = &СубконтоСпецЦены3
	|	) КАК Т"; // Доработка {FR-008: СубконтоСпецЦены3} {2026-04-09}: добавлено условие СубконтоСпецЦены3

	Запрос.УстановитьПараметр("НаДату", Объект.НаДату);
	Запрос.УстановитьПараметр("Контрагент", КонтрагентИсточник);
	Запрос.УстановитьПараметр("СпецЦены", Объект.СпецЦены);
	Запрос.УстановитьПараметр("СубконтоСпецЦены", Объект.СубконтоСпецЦены);
	Запрос.УстановитьПараметр("СубконтоСпецЦены2", Объект.СубконтоСпецЦены2);
	// Доработка START {FR-008: СубконтоСпецЦены3} {2026-04-09}
	Запрос.УстановитьПараметр("СубконтоСпецЦены3", Объект.СубконтоСпецЦены3);
	// Доработка END

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		НовСтр = ТаблицаУстановкиЦен.Добавить();
		НовСтр.АналитикаСумм			= Выборка.АналитикаСумм;
		НовСтр.ДополнительнаяАналитика	= Выборка.ДополнительнаяАналитика;
		НовСтр.КлючАналитик				= Выборка.КлючАналитик;
		НовСтр.Цена						= Выборка.Цена;
		НовСтр.ВидРасчета				= Выборка.ВидРасчета;
		НовСтр.ИндивидуальныйРасчет		= Выборка.ИндивидуальныйРасчет;
		НовСтр.МинимальнаяЦена			= Выборка.МинимальнаяЦена;
	КонецЦикла;

	// Обновить табличный документ для визуального контроля пользователем
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Контрагент",			КонтрагентИсточник);
	СтруктураПараметров.Вставить("Организация",			Объект.Организация);
	СтруктураПараметров.Вставить("УслугаОрганизации",	Объект.УслугаОрганизации);
	СтруктураПараметров.Вставить("СтранаНачалаТранзита", Объект.ГруппаСтранНачалаТранзита);
	СтруктураПараметров.Вставить("ГруппаКодовУКТЗЕД",	Объект.ГруппаКодовУКТЗЕД);
	СтруктураПараметров.Вставить("СпецЦены",			Объект.СпецЦены);
	СтруктураПараметров.Вставить("ТипУслуги",			Объект.ТипУслуги);
	СтруктураПараметров.Вставить("СубконтоСпецЦены",	Объект.СубконтоСпецЦены);
	СтруктураПараметров.Вставить("СубконтоСпецЦены2",	Объект.СубконтоСпецЦены2);
	// Доработка START {FR-008: СубконтоСпецЦены3} {2026-04-09}
	СтруктураПараметров.Вставить("СубконтоСпецЦены3",	Объект.СубконтоСпецЦены3);
	// Доработка END
	ТабличныйДокументНовыхЦен = ПолучитьТабличныйДокументДанныхКонтрагента(
		СтруктураПараметров, Ложь, Ложь, " ");

	Возврат ТаблицаУстановкиЦен.Количество();

