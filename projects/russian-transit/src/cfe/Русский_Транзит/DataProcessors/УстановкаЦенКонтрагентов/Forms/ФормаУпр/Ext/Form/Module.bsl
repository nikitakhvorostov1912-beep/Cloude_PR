&НаСервере
Процедура ЗаполнитьТаблицуУслугиНаСервере(ТекущийСписокКонтрагентов=Ложь)
	
	Если ТекущийСписокКонтрагентов Тогда
		ТаблицаПометок 		= Объект.ЦенообразованиеУслуги.Выгрузить(, "Контрагент,Выбран");
		пСписокКонтрагентов = ТаблицаПометок.ВыгрузитьКолонку("Контрагент");
	Иначе
		ОбъектГл 			= РеквизитФормыВЗначение("Объект");
		ТаблицаОбработки 	= Новый ТаблицаЗначений;
		
		СхемаКомпоновкиДанных 	= ОбъектГл.ПолучитьМакет("КомпоновкаСеткиКонтрагентов");
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Объект.КомпоновщикНастроек.ПолучитьНастройки(), , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		
		ПроцессорВывода.УстановитьОбъект(ТаблицаОбработки);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
		пСписокКонтрагентов = ТаблицаОбработки.ВыгрузитьКолонку("Контрагент");
	КонецЕсли;
	
	Если Объект.ТипУслуги = 0 Тогда //Основные услуги
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЛОЖЬ КАК Выбран,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК Период,
			|	Контрагенты.Ссылка КАК Контрагент,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.ЦенаУслуги, 0) КАК ЦенаУслугиТекущая,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.ЦенаЗаПервуюCMR, 0) КАК ЦенаЗаПервуюCMRТекущая,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.ЦенаЗаДополнительнуюCMR, 0) КАК ЦенаЗаДополнительнуюCMRТекущая,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.ЦенаЗаДополнительныйКод, 0) КАК ЦенаЗаДополнительныйКодТекущая,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.КоличествоБесплатныхКодов, 0) КАК КоличествоБесплатныхКодовТекущее,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютаЦеныТекущая,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютаЦеныНовая
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦенообразованиеКодовCMR.СрезПоследних(
			|				,
			|				УслугаОрганизации = &УслугаОрганизации
			|					И Контрагент В (&СписокКонтрагентов)) КАК ЦенообразованиеУслугиСрезПоследних
			|		ПО Контрагенты.Ссылка = ЦенообразованиеУслугиСрезПоследних.Контрагент
			|ГДЕ
			|	Контрагенты.Ссылка В(&СписокКонтрагентов)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Контрагенты.Наименование";
		
		Запрос.УстановитьПараметр("СписокКонтрагентов"	, пСписокКонтрагентов);
		Запрос.УстановитьПараметр("Организация"			, Объект.Организация);
		Запрос.УстановитьПараметр("УслугаОрганизации"	, Объект.УслугаОрганизации);
	Иначе //Если Объект.ТипУслуги = 1 Тогда //Дополнительные услуги
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЛОЖЬ КАК Выбран,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК Период,
			|	Контрагенты.Ссылка КАК Контрагент,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.ЦенаУслуги, 0) КАК ЦенаУслугиТекущая,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютаЦеныТекущая,
			|	ЕСТЬNULL(ЦенообразованиеУслугиСрезПоследних.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютаЦеныНовая
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦенообразованиеДополнительныеУслуги.СрезПоследних(
			|				,
			|				Организация = &Организация
			|					И УслугаОрганизации = &УслугаОрганизации
			|					И Контрагент В (&СписокКонтрагентов)) КАК ЦенообразованиеУслугиСрезПоследних
			|		ПО Контрагенты.Ссылка = ЦенообразованиеУслугиСрезПоследних.Контрагент
			|ГДЕ
			|	Контрагенты.Ссылка В(&СписокКонтрагентов)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Контрагенты.Наименование";
		
		Запрос.УстановитьПараметр("СписокКонтрагентов"	, пСписокКонтрагентов);
		Запрос.УстановитьПараметр("Организация"			, Объект.Организация);
		Запрос.УстановитьПараметр("УслугаОрганизации"	, Объект.ДополнительнаяУслугаОрганизации);
	КонецЕсли;	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Объект.ЦенообразованиеУслуги.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		НовСтр = Объект.ЦенообразованиеУслуги.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
		
		Если ТекущийСписокКонтрагентов Тогда
			СтрТП = ТаблицаПометок.Найти(НовСтр.Контрагент, "Контрагент");
			НовСтр.Выбран = СтрТП.Выбран;
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

