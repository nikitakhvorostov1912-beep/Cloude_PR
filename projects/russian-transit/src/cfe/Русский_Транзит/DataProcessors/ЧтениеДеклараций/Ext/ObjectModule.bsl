#Область ПарсингXML

// Заполняет ТЧ из XML-файла Сигмы
Функция ЗаполнитьИзXML(ФайлОбработки) Экспорт

	// Проверка на дубль файла
	Если ПроверитьФайл(ФайлОбработки) Тогда
		Возврат "Пропущен";
	КонецЕсли;

	НовыйФайл = Новый ЧтениеТекста(ФайлОбработки, КодировкаТекста.UTF8);
	СтрокаXML = НовыйФайл.Прочитать();
	НовыйФайл.Закрыть();

	// Удаляем префиксы пространств имён
	СтрокаXML = СтрЗаменить(СтрокаXML, "cat_ru:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "tci:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "/tci:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "/cat_ru:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "app:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "/app:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "RUScat_ru:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "catESAD_cu:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "RUDECLcat:", "");

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);

	Считанное = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	СериализованныйДокумент = ОбъектXDTOВСтруктуру(Считанное);

	Если НЕ СериализованныйДокумент.Body.Signature.Object.Свойство("TransitInfo") Тогда
		Возврат "Пропущен";
	КонецЕсли;

	TransitInfo = СериализованныйДокумент.Body.Signature.Object.TransitInfo;
	Header = TransitInfo.Header;
	Consigment = TransitInfo.Consigment;
	DocumentID = TransitInfo.DocumentID;

	// Дедупликация по DocumentID в ТЧ обработки
	ОтборСтрок = Новый Структура("DocumentID", DocumentID);
	НайденныеСтроки = Декларация.НайтиСтроки(ОтборСтрок);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат "Пропущен";
	КонецЕсли;

	НоваяСтрокаТЧ = Декларация.Добавить();
	НоваяСтрокаТЧ.DocumentID = DocumentID;
	НоваяСтрокаТЧ.Файл = ФайлОбработки;

	// Номер ГТД
	TDNumber = Header.TDNumber;
	НоваяСтрокаТЧ.НомерГТД = TDNumber.CustomsCode + "/"
		+ СтрЗаменить(TDNumber.RegistrationDate, "-", "") + "/"
		+ TDNumber.GTDNumber;

	// Статус транзита
	ЗаполнитьСтатусТранзита(НоваяСтрокаТЧ, TransitInfo.StatusName);

	// Комментарий — содержит email в решётках и возможно флаг #1#
	Комментарий = ?(TransitInfo.Свойство("Comment"), TransitInfo.Comment, "");
	НоваяСтрокаТЧ.Комментарий = Комментарий;

	// Парсинг email из решёток: #client@email.com#
	Email = ИзвлечьEmailИзКомментария(Комментарий);

	// Проверка флага «чужое обеспечение» #1#
	ЧужоеОбеспечение = СтрНайти(Комментарий, "#1#") > 0;
	НоваяСтрокаТЧ.ЧужоеОбеспечение = ЧужоеОбеспечение;

	// Перевозчик — прямой поиск по наименованию
	НоваяСтрокаТЧ.Перевозчик = НайтиИлиСоздатьПеревозчика(Header);

	// Декларант — поиск по наименованию из XML
	НоваяСтрокаТЧ.Декларант = НайтиДекларанта(TransitInfo);

	// Контрагент (Заказчик) — алгоритм 4.1 по ТЗ:
	// 1) Парсим email из Comment
	// 2) Ищем в КонтактнаяИнформация
	// 3) Если не нашли — ищем по наименованию OrganizationName
	НоваяСтрокаТЧ.Контрагент = ИдентифицироватьЗаказчика(Email, Consigment);

	// Принципал — поиск по наименованию
	НоваяСтрокаТЧ.Принципал = НайтиПринципала(Consigment);

	// ИНН/КПП контрагента из XML (для подсказки при ручном сопоставлении)
	Попытка
		Если Consigment.Consignee.Свойство("INNID") Тогда
			НоваяСтрокаТЧ.ИННКонтрагента = Consigment.Consignee.INNID;
		КонецЕсли;
		Если Consigment.Consignee.Свойство("KPPID") Тогда
			НоваяСтрокаТЧ.КППКонтрагента = Consigment.Consignee.KPPID;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Пункты отправления и назначения
	ЗаполнитьПункты(НоваяСтрокаТЧ, Header, TransitInfo);

	// Транспортные средства
	ЗаполнитьТранспортныеСредства(TransitInfo);

	// Товарные позиции и коды CMR
	ЗаполнитьТовары(НоваяСтрокаТЧ, DocumentID, Consigment);

	// CMR-документы
	ЗаполнитьCMR(НоваяСтрокаТЧ, Consigment);

	// Обеспечение (гарантия)
	ЗаполнитьОбеспечение(НоваяСтрокаТЧ, TransitInfo);

	// Дата оформления
	НоваяСтрокаТЧ.ДатаОформления = ?(TransitInfo.Свойство("TransitStampDateTime"),
		XMLЗначение(Тип("Дата"), TransitInfo.TransitStampDateTime),
		ТекущаяДатаСеанса());

	Возврат "Обработан";

КонецФункции

#КонецОбласти

#Область ИдентификацияКонтрагентов

// Алгоритм 4.1 по ТЗ: Идентификация Заказчика по E-mail
Функция ИдентифицироватьЗаказчика(Email, Consigment)

	Контрагент = Справочники.Контрагенты.ПустаяСсылка();

	// Шаг 1: Поиск по email в стандартном регистре КонтактнаяИнформация (БСП)
	Если ЗначениеЗаполнено(Email) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтактнаяИнформация.Объект КАК Контрагент
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Представление ПОДОБНО &Email
		|	И КонтактнаяИнформация.Тип = &ТипEmail";
		Запрос.УстановитьПараметр("Email", "%" + Email + "%");
		Запрос.УстановитьПараметр("ТипEmail", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Если ТипЗнч(Выборка.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
				Контрагент = Выборка.Контрагент;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Шаг 2: Если не нашли по email — пробуем по наименованию
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Попытка
			Если Consigment.Consignee.Свойство("OrganizationName") Тогда
				Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(
					Consigment.Consignee.OrganizationName);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Контрагент;

КонецФункции

// Извлекает email из текста Comment, обрамлённый решётками #email@domain.com#
Функция ИзвлечьEmailИзКомментария(Комментарий)

	Email = "";
	ПозицияСобаки = СтрНайти(Комментарий, "@");
	Если ПозицияСобаки = 0 Тогда
		Возврат Email;
	КонецЕсли;

	// Ищем email в решётках: #...@...#
	ПозНачала = 0;
	ПозКонца = 0;
	Для Индекс = 1 По СтрДлина(Комментарий) Цикл
		Символ = Сред(Комментарий, Индекс, 1);
		Если Символ = "#" Тогда
			Если ПозНачала = 0 Тогда
				ПозНачала = Индекс;
			Иначе
				ПозКонца = Индекс;
				// Проверяем что между решётками есть @
				Фрагмент = Сред(Комментарий, ПозНачала + 1, ПозКонца - ПозНачала - 1);
				Если СтрНайти(Фрагмент, "@") > 0 И НЕ Фрагмент = "1" Тогда
					Email = СокрЛП(Фрагмент);
					Возврат Email;
				КонецЕсли;
				ПозНачала = 0;
				ПозКонца = 0;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Email;

КонецФункции

Функция НайтиИлиСоздатьПеревозчика(Header)

	Перевозчик = Справочники.Перевозчики.ПустаяСсылка();
	Если НЕ Header.Carrier.Свойство("OrganizationName") Тогда
		Возврат Перевозчик;
	КонецЕсли;

	ИмяПеревозчика = Header.Carrier.OrganizationName;
	Перевозчик = Справочники.Перевозчики.НайтиПоНаименованию(ИмяПеревозчика);

	Если НЕ ЗначениеЗаполнено(Перевозчик) Тогда
		НовыйПеревозчик = Справочники.Перевозчики.СоздатьЭлемент();
		НовыйПеревозчик.Наименование = ИмяПеревозчика;
		Попытка
			НовыйПеревозчик.Записать();
			Перевозчик = НовыйПеревозчик.Ссылка;
		Исключение
			ЗаписьЖурналаРегистрации("ЧтениеДеклараций.Перевозчик",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"Не удалось создать перевозчика: " + ИмяПеревозчика + " | " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Возврат Перевозчик;

КонецФункции

Функция НайтиДекларанта(TransitInfo)

	Декларант = Справочники.Декларанты.ПустаяСсылка();
	Попытка
		Если TransitInfo.Свойство("DeclarantDetails")
			И TransitInfo.DeclarantDetails.Свойство("OrganizationName") Тогда

			ИмяДекларанта = TransitInfo.DeclarantDetails.OrganizationName;
			Декларант = Справочники.Декларанты.НайтиПоНаименованию(ИмяДекларанта);

			Если НЕ ЗначениеЗаполнено(Декларант) Тогда
				НовыйДекларант = Справочники.Декларанты.СоздатьЭлемент();
				НовыйДекларант.Наименование = ИмяДекларанта;
				НовыйДекларант.Записать();
				Декларант = НовыйДекларант.Ссылка;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.Декларант",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Ошибка поиска декларанта: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Декларант;

