#КонецОбласти

#Область Пункты

Процедура ЗаполнитьПункты(НоваяСтрокаТЧ, Header, TransitInfo)

	// Страна начала транзита
	НоваяСтрокаТЧ.СтранаНачалаТранзита = Header.DepartureCountryCode;

	// Пункт отправления
	КодТаможниОтправления = ?(TransitInfo.Свойство("CustomsCode"), TransitInfo.CustomsCode, "");
	НоваяСтрокаТЧ.КодТаможниОтправления = КодТаможниОтправления;

	Если ЗначениеЗаполнено(КодТаможниОтправления) Тогда
		НоваяСтрокаТЧ.ПунктОтправления = НайтиТаможенныйПункт(КодТаможниОтправления);
	КонецЕсли;

	// Если пункт не найден по коду таможни — ищем по стране
	Если НЕ ЗначениеЗаполнено(НоваяСтрокаТЧ.ПунктОтправления)
		И НЕ Header.DepartureCountryCode = "RU" Тогда
		СтранаОтправления = Справочники.СтранаОформления.НайтиПоКоду(Header.DepartureCountryCode);
		Если ЗначениеЗаполнено(СтранаОтправления) Тогда
			НоваяСтрокаТЧ.ПунктОтправления = СтранаОтправления.ТаможенныйПунктПоУмолчанию;
		КонецЕсли;
	КонецЕсли;

	// Пункт назначения
	Попытка
		Если TransitInfo.Свойство("DestinationPlace") Тогда
			КодПунктаНазначения = "";
			Если TransitInfo.DestinationPlace.Свойство("Code") Тогда
				КодПунктаНазначения = TransitInfo.DestinationPlace.Code;
			КонецЕсли;

			Если ЗначениеЗаполнено(КодПунктаНазначения) Тогда
				НоваяСтрокаТЧ.ПунктНазначения = НайтиТаможенныйПункт(КодПунктаНазначения);
			КонецЕсли;

			// Если не нашли по коду — ищем по наименованию
			Если НЕ ЗначениеЗаполнено(НоваяСтрокаТЧ.ПунктНазначения)
				И TransitInfo.DestinationPlace.Свойство("OfficeName") Тогда
				НоваяСтрокаТЧ.ПунктНазначения = Справочники.ТаможенныеПункты.НайтиПоНаименованию(
					TransitInfo.DestinationPlace.OfficeName);
			КонецЕсли;

			// Если не нашли — пробуем создать через customs.gov.ru
			Если НЕ ЗначениеЗаполнено(НоваяСтрокаТЧ.ПунктНазначения) Тогда
				Если ЗначениеЗаполнено(КодПунктаНазначения) Тогда
					НоваяСтрокаТЧ.ПунктНазначения = СоздатьТаможенныйПунктПоКоду(КодПунктаНазначения);
				КонецЕсли;
			КонецЕсли;

			// Записываем ненайденные пункты
			Если НЕ ЗначениеЗаполнено(НоваяСтрокаТЧ.ПунктНазначения) Тогда
				НоваяСтрокаПунктов = НеНайденныеПункты.Добавить();
				НоваяСтрокаПунктов.ПунктНазначения = ?(TransitInfo.DestinationPlace.Свойство("OfficeName"),
					TransitInfo.DestinationPlace.OfficeName, "");
				НоваяСтрокаПунктов.Код = КодПунктаНазначения;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.Пункты",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Ошибка заполнения пунктов: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Ищет таможенный пункт по коду — сначала в справочнике, затем создаёт через customs.gov.ru
Функция НайтиТаможенныйПункт(Код)

	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат Справочники.ТаможенныеПункты.ПустаяСсылка();
	КонецЕсли;

	Пункт = Справочники.ТаможенныеПункты.НайтиПоКоду(Код);
	Возврат Пункт;

КонецФункции

// Создаёт таможенный пункт через парсинг customs.gov.ru
// Защита от дублей: перед созданием повторно проверяем справочник
Функция СоздатьТаможенныйПунктПоКоду(Код)

	Если НЕ ЗначениеЗаполнено(Код) ИЛИ Код = "RU" Тогда
		Возврат Справочники.ТаможенныеПункты.ПустаяСсылка();
	КонецЕсли;

	// Повторная проверка перед HTTP-запросом (защита от дублей)
	Пункт = Справочники.ТаможенныеПункты.НайтиПоКоду(Код);
	Если ЗначениеЗаполнено(Пункт) Тогда
		Возврат Пункт;
	КонецЕсли;

	Попытка
		ssl = Новый ЗащищенноеСоединениеOpenSSL();
		URL = "registers/customs-apparatus?code=" + Код + "&name=&city=";
		Сервис = Новый HTTPСоединение("customs.gov.ru",,,,,, ssl);

		Запрос = Новый HTTPЗапрос(URL);
		Результат = Сервис.Получить(Запрос);
		Сервис = Неопределено;

		Если Результат.КодСостояния <> 200 Тогда
			Возврат Справочники.ТаможенныеПункты.ПустаяСсылка();
		КонецЕсли;

		Страница = Результат.ПолучитьТелоКакСтроку("UTF-8");
		Див = "<div class=" + Символ(34) + "info-card__title" + Символ(34) + ">";
		ДивИтем = СтрЗаменить(Див, "info-card__title", "info-card__item-info");

		Наименование = СокрЛП(ПоискБлока(Страница, Див));
		КодПункта = СокрЛП(ПоискБлока(Страница, ДивИтем, "Код таможенноо органа"));

		Если НЕ ЗначениеЗаполнено(Наименование) Тогда
			Возврат Справочники.ТаможенныеПункты.ПустаяСсылка();
		КонецЕсли;

		// Финальная проверка: может уже создан другим потоком
		ПунктФинальный = Справочники.ТаможенныеПункты.НайтиПоКоду(?(ЗначениеЗаполнено(КодПункта), КодПункта, Код));
		Если ЗначениеЗаполнено(ПунктФинальный) Тогда
			Возврат ПунктФинальный;
		КонецЕсли;

		НовыйТП = Справочники.ТаможенныеПункты.СоздатьЭлемент();
		НовыйТП.Наименование = Наименование;
		НовыйТП.Код = ?(ЗначениеЗаполнено(КодПункта), КодПункта, Код);
		НовыйТП.КодПункта = НовыйТП.Код;
		НовыйТП.Город = СокрЛП(ПоискБлока(Страница, ДивИтем, "Город"));
		НовыйТП.Адрес = СокрЛП(ПоискБлока(Страница, ДивИтем, "Адрес таможенного органа"));
		НовыйТП.Индекс = СокрЛП(ПоискБлока(Страница, ДивИтем, "Почтовый индекс"));

		НовыйТП.Записать();
		Возврат НовыйТП.Ссылка;
	Исключение
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.СозданиеПункта",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Не удалось создать таможенный пункт (код: " + Код + "): " + ОписаниеОшибки());
		Возврат Справочники.ТаможенныеПункты.ПустаяСсылка();
	КонецПопытки;

КонецФункции

Функция ПоискБлока(ДанныеПоиска, Блок, ВоспомогательнаяСтрока = "")
	Если ВоспомогательнаяСтрока = "" Тогда
		ПозицияНачала = СтрНайти(ДанныеПоиска, Блок);
	Иначе
		ПозицияНачала = СтрНайти(ДанныеПоиска, Блок,, СтрНайти(ДанныеПоиска, ВоспомогательнаяСтрока));
	КонецЕсли;
	Если ПозицияНачала = 0 Тогда
		Возврат "";
	КонецЕсли;
	ПозицияКонца = СтрНайти(ДанныеПоиска, "</div>",, ПозицияНачала);
	Если ПозицияКонца = 0 Тогда
		Возврат "";
	КонецЕсли;
	Наименование = Сред(ДанныеПоиска, ПозицияНачала, ПозицияКонца - ПозицияНачала);
	Наименование = СокрЛП(СтрЗаменить(Наименование, Блок, ""));
	Возврат Наименование;
КонецФункции

#КонецОбласти

#Область ТранспортИТовары

Процедура ЗаполнитьТранспортныеСредства(TransitInfo)

	Если НЕ TransitInfo.Header.Transport.Свойство("TransportMeans") Тогда
		Возврат;
	КонецЕсли;

	МассивТС = TransitInfo.Header.Transport.TransportMeans;
	Если ТипЗнч(МассивТС) <> Тип("Массив") Тогда
		ВременныйМассив = Новый Массив;
		ВременныйМассив.Добавить(МассивТС);
		МассивТС = ВременныйМассив;
	КонецЕсли;

	Для Каждого ТС Из МассивТС Цикл
		ТипТС = ?(ТС.Свойство("TransportKindCode"), ТС.TransportKindCode, "");
		Регион = ?(ТС.Свойство("TransportMeansNationalityCode"), ТС.TransportMeansNationalityCode, "");
		НомерТС = ?(ТС.Свойство("TransportIdentifier"),
			СтрЗаменить(ТС.TransportIdentifier + Регион, " ", ""), "");

		Транспорт = Справочники.ТранспортныеСредства.НайтиПоНаименованию(НомерТС);
		Если НЕ ЗначениеЗаполнено(Транспорт) Тогда
			НовоеТС = Справочники.ТранспортныеСредства.СоздатьЭлемент();
			НовоеТС.Наименование = НомерТС;
			НовоеТС.Код = НомерТС;
			НовоеТС.Тип = Справочники.ТипыТранспортныхСредств.НайтиПоКоду(Лев(ТипТС, 2));
			Попытка
				НовоеТС.Записать();
				Транспорт = НовоеТС.Ссылка;
			Исключение
				ЗаписьЖурналаРегистрации("ЧтениеДеклараций.ТС",
					УровеньЖурналаРегистрации.Предупреждение,,,
					"Не удалось создать ТС: " + НомерТС + " | " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

		НоваяСтрокаТС = ТранспортныеСредства.Добавить();
		НоваяСтрокаТС.ТранспортноеСредство = Транспорт;
		НоваяСтрокаТС.DocumentID = TransitInfo.DocumentID;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТовары(НоваяСтрокаТЧ, DocumentID, Consigment)

	Товары = Consigment.GoodsItem;
	Если ТипЗнч(Товары) <> Тип("Массив") Тогда
		ВременныйМассив = Новый Массив;
		ВременныйМассив.Добавить(Consigment.GoodsItem);
		Товары = ВременныйМассив;
	КонецЕсли;

	СуммаДокумента = 0;
	ПоследняяВалюта = Справочники.Валюты.ПустаяСсылка();

	Для Каждого Товар Из Товары Цикл
		НоваяСтрТов = КодыCMR.Добавить();
		НоваяСтрТов.DocumentID = DocumentID;
		НоваяСтрТов.КодТНВЭД = Товар.TNVEDCode;

		Если ТипЗнч(Товар.GoodsDescription) = Тип("Массив") Тогда
			Для Каждого Позиция Из Товар.GoodsDescription Цикл
				НоваяСтрТов.Наименование = НоваяСтрТов.Наименование + "/" + Позиция;
			КонецЦикла;
		Иначе
			НоваяСтрТов.Наименование = Товар.GoodsDescription;
		КонецЕсли;

		Попытка
			НоваяСтрТов.Сумма = Число(Товар.InvoicedCost);
		Исключение
			НоваяСтрТов.Сумма = 0;
		КонецПопытки;

		НоваяСтрТов.Валюта = ?(Товар.Свойство("InvoicedCurrencyCode"),
			Справочники.Валюты.НайтиПоНаименованию(Товар.InvoicedCurrencyCode),
			?(Товар.Свойство("CurrencyCode"),
				Справочники.Валюты.НайтиПоНаименованию(Товар.CurrencyCode),
				Справочники.Валюты.ПустаяСсылка()));

		СуммаДокумента = СуммаДокумента + НоваяСтрТов.Сумма;
		ПоследняяВалюта = НоваяСтрТов.Валюта;
	КонецЦикла;

	НоваяСтрокаТЧ.СуммаДокумента = СуммаДокумента;
	НоваяСтрокаТЧ.ВалютаДокумента = ПоследняяВалюта;

КонецПроцедуры

Процедура ЗаполнитьCMR(НоваяСтрокаТЧ, Consigment)

	Если НЕ Consigment.Свойство("ProducedDocument") Тогда
		Возврат;
	КонецЕсли;

	ДокументыФайла = Consigment.ProducedDocument;
	Если ТипЗнч(ДокументыФайла) <> Тип("Массив") Тогда
		ВременныйМассив = Новый Массив;
		ВременныйМассив.Добавить(Consigment.ProducedDocument);
		ДокументыФайла = ВременныйМассив;
	КонецЕсли;

	CMR = "";
	Для Каждого Док Из ДокументыФайла Цикл
		Если Док.DocumentKind = "02015" Тогда
			CMR = Док.PrDocumentNumber;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	НоваяСтрокаТЧ.НомераCMR = CMR;
	НоваяСтрокаТЧ.КоличествоCMR = ?(CMR <> "", 1, 0);

КонецПроцедуры

Процедура ЗаполнитьОбеспечение(НоваяСтрокаТЧ, TransitInfo)

	Если НЕ TransitInfo.Свойство("Guarantee") Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Гарантия = TransitInfo.Guarantee;
		НоваяСтрокаТЧ.СуммаОбеспечения = Число(
			Гарантия.TransitGuaranteeDocDetails.GuaranteeAmount.RUSAmount);
		НоваяСтрокаТЧ.ВалютаОбеспечения = Справочники.Валюты.НайтиПоНаименованию(
			Гарантия.TransitGuaranteeDocDetails.GuaranteeAmount.RUSCurrencyCode);
	Исключение
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.Обеспечение",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Ошибка чтения обеспечения: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура ЗаполнитьСтатусТранзита(НоваяСтрокаТЧ, СтатусИмя)

	Если СтатусИмя = "TR_ALLOWED" Тогда
		НоваяСтрокаТЧ.СтатусТранзита = Перечисления.СтатусыТранзита.ТранзитРазрешен;
	ИначеЕсли СтатусИмя = "TR_REVOKED" Тогда
		НоваяСтрокаТЧ.СтатусТранзита = Перечисления.СтатусыТранзита.Аннулирован;
	ИначеЕсли СтатусИмя = "TR_COMPLETED_W_RESERVATION" Тогда
		НоваяСтрокаТЧ.СтатусТранзита = Перечисления.СтатусыТранзита.ВыполненИЗарезервирован;
	ИначеЕсли СтатусИмя = "TR_COMPLETED" Тогда
		НоваяСтрокаТЧ.СтатусТранзита = Перечисления.СтатусыТранзита.Выполнен;
	ИначеЕсли СтатусИмя = "TD_REVOKED" Тогда
		НоваяСтрокаТЧ.СтатусТранзита = Перечисления.СтатусыТранзита.Отменено;
	ИначеЕсли СтатусИмя = "TR_ISSUE_DENIED" Тогда
		НоваяСтрокаТЧ.СтатусТранзита = Перечисления.СтатусыТранзита.Отказано;
	ИначеЕсли СтатусИмя = "TR_TERMINATED" Тогда
		НоваяСтрокаТЧ.СтатусТранзита = Перечисления.СтатусыТранзита.ПрекращеноДосрочно;
	Иначе
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.Статус",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Неизвестный статус транзита: " + СтатусИмя);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СозданиеДокументов

Процедура СоздатьДокументыНаСервере()

	Для Каждого Строка Из Декларация Цикл

		РезультатЗаполнения = Новый Структура("Ошибка, Статус, СчитанныйФайл, Документ");

		// Проверка существования документа по DocumentID + НомерГТД
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ссылка
		|ИЗ
		|	Документ.ОперацияПоПоручительству КАК Д
		|ГДЕ
		|	Д.ВнешнийИдентификатор = &DocumentID
		|	И Д.НомерГТД = &НомерГТД";
		Запрос.УстановитьПараметр("НомерГТД", Строка.НомерГТД);
		Запрос.УстановитьПараметр("DocumentID", Строка.DocumentID);

		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			НовыйДокумент = РезультатЗапроса.Выгрузить()[0].Ссылка.ПолучитьОбъект();
		Иначе
			НовыйДокумент = Документы.ОперацияПоПоручительству.СоздатьДокумент();
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(НовыйДокумент, Строка);
		НовыйДокумент.ВнешнийИдентификатор = Строка.DocumentID;
		НовыйДокумент.Дата = Строка.ДатаОформления;
		НовыйДокумент.Бабулево = Истина;

		// Алгоритм 6.0: Чужое обеспечение
		Если Строка.ЧужоеОбеспечение Тогда
			НовыйДокумент.ОплатыУслуг.Очистить();
			НовыйДокумент.ДополнительныеУслуги.Очистить();
			НовыйДокумент.Оплата = 0;
			НовыйДокумент.СтатусОперации = Перечисления.СтатусыОпераций.Обработан;
		Иначе
			НовыйДокумент.СтатусОперации = Перечисления.СтатусыОпераций.ВРаботе;
		КонецЕсли;

		// Заполнение ТЧ КодыCMR по DocumentID
		НовыйДокумент.КодыCMR.Очистить();
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ *
		|ПОМЕСТИТЬ ВТ_Таблица
		|ИЗ &Таблица КАК Таблица
		|ГДЕ Таблица.DocumentID = &DocumentID
		|;
		|ВЫБРАТЬ * ИЗ ВТ_Таблица";
		Запрос.УстановитьПараметр("Таблица", КодыCMR.Выгрузить());
		Запрос.УстановитьПараметр("DocumentID", Строка.DocumentID);

		Попытка
			Результат = Запрос.Выполнить().Выбрать();
			Пока Результат.Следующий() Цикл
				ЦМР = НовыйДокумент.КодыCMR.Добавить();
				ЦМР.НомерCMR = Строка.НомераCMR;
				ЦМР.Валюта = Результат.Валюта;
				ЦМР.КоличествоКодов = Результат.КоличествоКодов;
				ЦМР.Цена = ?(Результат.КоличествоКодов = 0, 0, Результат.Сумма / Результат.КоличествоКодов);
			КонецЦикла;
		Исключение
			ЗаписьЖурналаРегистрации("ЧтениеДеклараций.КодыCMR",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"Ошибка заполнения КодыCMR для " + Строка.DocumentID + ": " + ОписаниеОшибки());
		КонецПопытки;

		// Заполнение ТС
		Запрос.УстановитьПараметр("Таблица", ТранспортныеСредства.Выгрузить());
		Попытка
			Результат = Запрос.Выполнить().Выгрузить();
			Если Результат.Количество() > 0 Тогда
				НовыйДокумент.ОсновноеТС = Результат[0].ТранспортноеСредство;
				Если Результат.Количество() > 1 Тогда
					НовыйДокумент.ДополнительноеТС = Результат[1].ТранспортноеСредство;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Запись документа
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			Ошибка = СформироватьТекстОшибок(НовыйДокумент);
			РезультатЗаполнения.Ошибка = Ошибка;
		Исключение
			Попытка
				НовыйДокумент.Записать();
			Исключение
				ЗаписьЖурналаРегистрации("ЧтениеДеклараций.ЗаписьДокумента",
					УровеньЖурналаРегистрации.Ошибка,,,
					"Не удалось записать документ " + Строка.НомерГТД + ": " + ОписаниеОшибки());
			КонецПопытки;
			РезультатЗаполнения.Ошибка = "Ошибка записи: " + ОписаниеОшибки();
		КонецПопытки;

		РезультатЗаполнения.СчитанныйФайл = Строка.Файл;
		РезультатЗаполнения.Документ = НовыйДокумент.Ссылка;
		ЗаписатьРезультатЧтения(РезультатЗаполнения);

	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьРезультатЧтения(РезультатЗаполнения)

	НаборЗаписей = РегистрыСведений.ПрочитанныеДекларации.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(РезультатЗаполнения.Документ);
	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(НаборЗаписей[0], РезультатЗаполнения);
	Иначе
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, РезультатЗаполнения);
	КонецЕсли;

	НаборЗаписей.Записать();

КонецПроцедуры

Функция СформироватьТекстОшибок(Док)

	ТекстОшибки = "Не удалось записать по причине: ";
	ЕстьОшибки = Ложь;

	Если НЕ ЗначениеЗаполнено(Док.Перевозчик) Тогда
		ТекстОшибки = ТекстОшибки + "не заполнен перевозчик, ";
		ЕстьОшибки = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Док.Контрагент) Тогда
		ТекстОшибки = ТекстОшибки + "не заполнен контрагент, ";
		ЕстьОшибки = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Док.ПунктОтправления) Тогда
		ТекстОшибки = ТекстОшибки + "не заполнен пункт отправления, ";
		ЕстьОшибки = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Док.ПунктНазначения) Тогда
		ТекстОшибки = ТекстОшибки + "не заполнен пункт назначения, ";
		ЕстьОшибки = Истина;
	КонецЕсли;

	Если Док.СуммаОбеспечения = 0 Тогда
		ТекстОшибки = ТекстОшибки + "не заполнена сумма обеспечения, ";
		ЕстьОшибки = Истина;
	КонецЕсли;

	Если ЕстьОшибки Тогда
		Возврат Лев(ТекстОшибки, СтрДлина(ТекстОшибки) - 2) + ".";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область Вспомогательное

Функция ПроверитьФайл(Файл)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Файл
	|ИЗ
	|	РегистрСведений.ПрочитанныеДекларации
	|ГДЕ
	|	Файл = &Файл";
	Запрос.УстановитьПараметр("Файл", Файл);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

Функция ОбъектXDTOВСтруктуру(ОбъектXDTO, ПараметрыПреобразования = Неопределено) Экспорт

	Структура = Новый Структура;
	ТипОбъектаXDTO = ОбъектXDTO.Тип();

	Для Каждого Свойство Из ОбъектXDTO.Свойства() Цикл

		ИмяСвойства = Свойство.Имя;
		ЗначениеСвойства = ОбъектXDTO[ИмяСвойства];

		Если ТипЗнч(ЗначениеСвойства) = Тип("ОбъектXDTO") Тогда
			Структура.Вставить(ИмяСвойства, ОбъектXDTOВСтруктуру(ЗначениеСвойства, ПараметрыПреобразования));

		ИначеЕсли ТипЗнч(ЗначениеСвойства) = Тип("СписокXDTO") Тогда
			Структура.Вставить(ИмяСвойства, Новый Массив);
			Для Индекс = 0 По ЗначениеСвойства.Количество() - 1 Цикл
				ЭлементСписка = ЗначениеСвойства.Получить(Индекс);
				Если ТипЗнч(ЭлементСписка) = Тип("ОбъектXDTO") Тогда
					Структура[ИмяСвойства].Добавить(ОбъектXDTOВСтруктуру(ЭлементСписка, ПараметрыПреобразования));
				Иначе
					Структура[ИмяСвойства].Добавить(ЭлементСписка);
				КонецЕсли;
			КонецЦикла;

		Иначе
			Структура.Вставить(ИмяСвойства, ЗначениеСвойства);

			Если ПараметрыПреобразования <> Неопределено
				И ПараметрыПреобразования.НайтиИдентификаторы
				И Свойство.Тип = ПараметрыПреобразования.ТипUUID Тогда
				РезультатПоиска = ПараметрыПреобразования.ТипыИдентификаторов[ТипОбъектаXDTO];
				Если РезультатПоиска <> Неопределено
					И РезультатПоиска.ИмяПоля = ИмяСвойства Тогда
					ПараметрыПреобразования.Идентификаторы[РезультатПоиска.ИмяТаблицы].Вставить(
						ЗначениеСвойства, РезультатПоиска.ПустоеЗначение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат Структура;

КонецФункции

#КонецОбласти

// Доработка START {SS-3 2026-04-20}: единая точка чтения credentials API Сигмы
// из ХранилищеОбщихНастроек. Используется общий ключ "НастройкиВыгрузки" с владельцем
// "Интерсофт" — тот же, что пишет APIСигма.epf (СохранитьНастройкиНаСервере).
// Структура: КодДоступа (строка), КодУчастника (строка).
Функция ЗагрузитьНастройкиСигмы()
	Попытка
		СтруктураНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
			"НастройкиВыгрузки", , , , "Интерсофт");
	Исключение
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.Credentials",
			УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Если СтруктураНастроек = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("КодДоступа, КодУчастника", "", "");
	Если ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		Если СтруктураНастроек.Свойство("КодДоступа") Тогда
			Результат.КодДоступа = СтруктураНастроек.КодДоступа;
		КонецЕсли;
		Если СтруктураНастроек.Свойство("КодУчастника") Тогда
			Результат.КодУчастника = СтруктураНастроек.КодУчастника;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Результат.КодДоступа) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;
КонецФункции
