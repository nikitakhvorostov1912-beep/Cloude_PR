// Доработка START {Полная переработка модуля по ТЗ «Интеграция Сигма-Софт и 1С:УТ»} {2026-04-01}
// Ключевые изменения:
// - Парсинг email из Comment через решётки #email@example.com#
// - Поиск контрагента по email через РС.КонтактнаяИнформация (стандарт БСП)
// - Обработка флага #1# (чужое обеспечение)
// - Дедупликация включена
// - Очистка ТЧ перед загрузкой
// - Логирование всех ошибок в ЖурналРегистрации
// - Защита от дублей таможенных пунктов

Функция СведенияОВнешнейОбработке() Экспорт

	ПредставлениеКоманды = "Синхронизация СигмаСофт";
	ИдентификаторКоманды = "СинхронизацияСигма";

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке(СтандартныеПодсистемыСервер.ВерсияБиблиотеки());
	ПараметрыРегистрации.Информация = "Импорт операций из Сигма-Софт";
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "2.0";
	ПараметрыРегистрации.БезопасныйРежим = Истина;

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = ПредставлениеКоманды;
	Команда.Идентификатор = ИдентификаторКоманды;
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;

	Разрешение = РаботаВБезопасномРежиме.РазрешениеНаИспользованиеКаталогаВременныхФайлов(Истина, Истина, "Для чтения XML-файлов Сигмы");
	ПараметрыРегистрации.Разрешения.Добавить(Разрешение);

	Разрешение = РаботаВБезопасномРежиме.РазрешениеНаИспользованиеИнтернетРесурса("HTTPS", "customs.gov.ru", 443, "Для поиска таможенных пунктов");
	ПараметрыРегистрации.Разрешения.Добавить(Разрешение);

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "Настроить и выполнить вручную";
	Команда.Идентификатор = "НастроитьИВыполнитьЗадачиВручную";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Истина;

	Возврат ПараметрыРегистрации;

КонецФункции

Процедура ВыполнитьКоманду(ИмяКоманды, ПараметрыВыполнения) Экспорт

	Если ИмяКоманды = "СинхронизацияСигма" Тогда
		ВыполнитьСинхронизацию(ПараметрыВыполнения);
	КонецЕсли;

КонецПроцедуры

#Область Синхронизация

Процедура ВыполнитьСинхронизацию(ПараметрыВыполнения)

	// Очищаем ТЧ перед загрузкой
	Декларация.Очистить();
	КодыCMR.Очистить();
	ТранспортныеСредства.Очистить();
	НеНайденныеПункты.Очистить();

	// Режим 1: REST API Сигмы (приоритетный)
	Успех = ЗагрузитьЧерезAPISigma();

	// Режим 2: Файловый каталог (fallback)
	Если НЕ Успех Тогда
		ЗагрузитьИзФайловогоКаталога();
	КонецЕсли;

	// Создание документов из загруженных данных
	Если Декларация.Количество() > 0 Тогда
		СоздатьДокументыНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область APIСигмы

// Загрузка операций через REST API edapi.sigma-soft.ru
// Endpoint 36: api/v1/report/getreportggi — полный отчёт по операциям
Функция ЗагрузитьЧерезAPISigma()

	АдресСервера = "edapi.sigma-soft.ru";
	// Доработка START {SS-3 2026-04-20}: credentials вынесены из кода в ХранилищеОбщихНастроек.
	// Код доступа и код участника загружаются из тех же настроек, что использует
	// APIСигма.epf (ключ "НастройкиВыгрузки" / владелец "Интерсофт").
	НастройкиСигмы = ЗагрузитьНастройкиСигмы();
	Если НастройкиСигмы = Неопределено ИЛИ НЕ ЗначениеЗаполнено(НастройкиСигмы.КодДоступа) Тогда
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.API",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Настройки API Сигмы не заполнены. Откройте APIСигма.epf, введите Код доступа и participantcode.");
		Возврат Ложь;
	КонецЕсли;
	КодДоступа = НастройкиСигмы.КодДоступа;
	КодУчастника = НастройкиСигмы.КодУчастника;
	// Доработка END
	РазмерСтраницы = 200; // максимум API

	// Шаг 1: Авторизация (plain text код доступа)
	Токен = АвторизацияSigma(АдресСервера, КодДоступа);
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.API",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Не удалось авторизоваться в API Сигмы. Переключаюсь на файловый каталог.");
		Возврат Ложь;
	КонецЕсли;

	// Шаг 2: Получить последнюю дату синхронизации
	ДатаНачала = ПолучитьДатуПоследнейСинхронизации();
	ДатаОкончания = ТекущаяДатаСеанса();

	// Шаг 3: Постраничная загрузка getreportggi
	СчётчикОбработано = 0;
	НомерСтраницы = 1;
	КоличествоСтраниц = 0;

	Пока Истина Цикл
		ДанныеОперации = ПолучитьОтчётGGI(АдресСервера, Токен, ДатаНачала, ДатаОкончания, КодУчастника, НомерСтраницы);

		Если ДанныеОперации = Неопределено ИЛИ ДанныеОперации.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		КоличествоСтраниц = КоличествоСтраниц + 1;

		// Шаг 4: Обработка каждой операции на странице
		Для Каждого Операция Из ДанныеОперации Цикл
			Попытка
				ЗаполнитьИзAPIОперации(Операция, АдресСервера, Токен);
				СчётчикОбработано = СчётчикОбработано + 1;
			Исключение
				ЗаписьЖурналаРегистрации("ЧтениеДеклараций.API.Операция",
					УровеньЖурналаРегистрации.Ошибка,,,
					"Ошибка обработки операции: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;

		// Если получили меньше максимума — это последняя страница
		Если ДанныеОперации.Количество() < РазмерСтраницы Тогда
			Прервать;
		КонецЕсли;

		НомерСтраницы = НомерСтраницы + 1;
	КонецЦикла;

	ЗаписьЖурналаРегистрации("ЧтениеДеклараций.API",
		УровеньЖурналаРегистрации.Информация,,,
		"API Сигмы: загружено " + СчётчикОбработано + " операций за " + КоличествоСтраниц + " стр. за период "
		+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy"));

	Возврат СчётчикОбработано > 0;

КонецФункции

// Доработка START {Авторизация: plain text код доступа вместо JSON login/password} {2026-04-02}
Функция АвторизацияSigma(АдресСервера, Знач КодДоступа, Знач НеИспользуется = "")

	Попытка
		ssl = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение(АдресСервера, 443,,,,, ssl);

		Запрос = Новый HTTPЗапрос("/api/v1/auth/login");
		Запрос.УстановитьТелоИзСтроки(КодДоступа, КодировкаТекста.UTF8);
		Запрос.Заголовки.Вставить("Content-Type", "text/plain");

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

		Если Ответ.КодСостояния = 200 Тогда
			Токен = Ответ.ПолучитьТелоКакСтроку("UTF-8");
			Возврат СокрЛП(Токен);
		Иначе
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");
			ЗаписьЖурналаРегистрации("ЧтениеДеклараций.API.Auth",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"Ошибка авторизации (код " + Ответ.КодСостояния + "): " + ТелоОтвета);
			Возврат "";
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.API.Auth",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Исключение при авторизации: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;

КонецФункции
// Доработка END

// Доработка START {participantcode в URL, числовые параметры, CSV-парсинг resData} {2026-04-02}
Функция ПолучитьОтчётGGI(АдресСервера, Токен, ДатаНачала, ДатаОкончания, КодУчастника = "", НомерСтраницы = 1)

	Попытка
		ssl = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение(АдресСервера, 443,,,,, ssl);

		// participantcode — query-параметр URL (не body!)
		СтрокаURL = "/api/v1/report/getreportggi?participantcode=" + КодУчастника;

		// Параметры body — числовые значения без кавычек
		ТелоЗапроса = "{""datebegin"":""" + Формат(ДатаНачала, "ДФ=yyyy-MM-dd") + ""","
			+ """dateend"":""" + Формат(ДатаОкончания, "ДФ=yyyy-MM-dd") + ""","
			+ """withgoods"":1,"
			+ """pagenum"":" + Формат(НомерСтраницы, "ЧГ=") + ","
			+ """quantity"":200,"
			+ """fields"":""DUTYAMOUNT;CURRENCYCODE;GUARANTOR_SHORTNAME;GUARANTOR_INN;"
			+ "PROVIDER_SHORTNAME;PROVIDER_INN;DECLARANT_SHORTNAME;DECLARANT_INN;"
			+ "CARRIER_REGCODE;TSNUMBERS;TRANSPORTDOCUMENT_ID;GUARANTEEDOCUMENT_IDC;"
			+ "ARRIVALCUSTOMSCODE;ARRIVALCUSTOMSOFFICENAME;DEPATURECUSTOMSCODE;DEPATURECUSTOMSOFFICENAME;"
			+ "GCA_TARIFFAMOUNT;GCA_TARIFFDISTANCE;TRANSPORTMODECODE;"
			+ "TDOC_NAME;TDOC_NUMBER;TDOC_DATE;CDOC_NAME;CDOC_NUMBER;CDOC_DATE;"
			+ "TRANSITOPENDATE;GRN;MSS_ID;BDT_DATECRT;BDT_DATEMOD;BDT_COMMENTS;"
			+ "GOODSNUMERIC;GOODSTNVEDCODE;GOODSDESCRIPTION;GOODSQUANTITY;GROSSWEIGHTQUANTITY;"
			+ "INVOICEDCOST;SPEC_FIO""}";

		Запрос = Новый HTTPЗапрос(СтрокаURL);
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Запрос.Заголовки.Вставить("Accept", "application/json");
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации("ЧтениеДеклараций.API.GGI",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"Ошибка getreportggi (код " + Ответ.КодСостояния + "): "
				+ Ответ.ПолучитьТелоКакСтроку("UTF-8"));
			Возврат Неопределено;
		КонецЕсли;

		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");

		// Парсим JSON-обёртку
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		ОтветСтруктура = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		Если НЕ (ОтветСтруктура.Свойство("resCode") И ОтветСтруктура.resCode = 0) Тогда
			ЗаписьЖурналаРегистрации("ЧтениеДеклараций.API.GGI",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"API вернул ошибку: resCode=" + ОтветСтруктура.resCode
				+ ", resDescription=" + ОтветСтруктура.resDescription);
			Возврат Неопределено;
		КонецЕсли;

		// resData — CSV-строка с разделителем ";" и переводами строк \r\n
		// Первая строка — заголовки, остальные — данные
		Возврат РазобратьCSVОтвет(ОтветСтруктура.resData);

	Исключение
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.API.GGI",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Исключение при запросе getreportggi: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Разбирает CSV-строку из resData в массив структур
// Формат: "заголовок1";"заголовок2"\r\n"значение1";"значение2"\r\n...
Функция РазобратьCSVОтвет(СтрокаCSV)

	Результат = Новый Массив;

	Если НЕ ЗначениеЗаполнено(СтрокаCSV) Тогда
		Возврат Результат;
	КонецЕсли;

	// Разбиваем по строкам (CSV использует \r\n)
	Строки = СтрРазделить(СтрокаCSV, Символы.ВК + Символы.ПС, Ложь);
	Если Строки.Количество() < 2 Тогда
		Возврат Результат;
	КонецЕсли;

	// Первая строка — заголовки
	Заголовки = РазобратьCSVСтроку(Строки[0]);

	// Остальные строки — данные
	Для Индекс = 1 По Строки.Количество() - 1 Цикл
		ТекСтрока = СокрЛП(Строки[Индекс]);
		Если НЕ ЗначениеЗаполнено(ТекСтрока) Тогда
			Продолжить;
		КонецЕсли;

		Значения = РазобратьCSVСтроку(ТекСтрока);
		Запись = Новый Структура;

		Для К = 0 По Заголовки.ВГраница() Цикл
			// Убираем скобки из заголовка: "Сумма обеспечения (DUTYAMOUNT)" → "DUTYAMOUNT"
			ИмяПоля = Заголовки[К];
			ПозОткр = СтрНайти(ИмяПоля, "(");
			ПозЗакр = СтрНайти(ИмяПоля, ")");
			Если ПозОткр > 0 И ПозЗакр > ПозОткр Тогда
				ИмяПоля = Сред(ИмяПоля, ПозОткр + 1, ПозЗакр - ПозОткр - 1);
			КонецЕсли;
			ИмяПоля = СокрЛП(ИмяПоля);

			Если К <= Значения.ВГраница() Тогда
				Запись.Вставить(ИмяПоля, Значения[К]);
			Иначе
				Запись.Вставить(ИмяПоля, "");
			КонецЕсли;
		КонецЦикла;

		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разбирает одну CSV-строку по разделителю ";", убирая кавычки
Функция РазобратьCSVСтроку(Строка)

	Результат = Новый Массив;
	Поля = СтрРазделить(Строка, ";");
	Для Каждого Поле Из Поля Цикл
		Значение = СокрЛП(Поле);
		// Убираем обрамляющие кавычки
		Если СтрДлина(Значение) >= 2
			И Лев(Значение, 1) = """"
			И Прав(Значение, 1) = """" Тогда
			Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
		КонецЕсли;
		Результат.Добавить(Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции
// Доработка END

// Заполняет строку ТЧ Декларация из данных API-операции
Процедура ЗаполнитьИзAPIОперации(Операция, АдресСервера, Токен)

	DocumentID = ?(Операция.Свойство("MSS_ID"), Операция.MSS_ID, "");

	// Дедупликация
	Если НЕ ЗначениеЗаполнено(DocumentID) Тогда
		Возврат;
	КонецЕсли;

	ОтборСтрок = Новый Структура("DocumentID", DocumentID);
	Если Декларация.НайтиСтроки(ОтборСтрок).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	НоваяСтрокаТЧ = Декларация.Добавить();
	НоваяСтрокаТЧ.DocumentID = DocumentID;
	НоваяСтрокаТЧ.Файл = "API:" + DocumentID;

	// Номер ГТД (GRN = Global Reference Number)
	НоваяСтрокаТЧ.НомерГТД = ?(Операция.Свойство("GRN"), Операция.GRN, "");

	// Комментарий и парсинг email / флага #1#
	Комментарий = ?(Операция.Свойство("BDT_COMMENTS"), Операция.BDT_COMMENTS, "");
	НоваяСтрокаТЧ.Комментарий = Комментарий;
	Email = ИзвлечьEmailИзКомментария(Комментарий);
	НоваяСтрокаТЧ.ЧужоеОбеспечение = СтрНайти(Комментарий, "#1#") > 0;

	// Контрагент — алгоритм 4.1 по ТЗ
	ЗаказчикНаименование = ?(Операция.Свойство("PROVIDER_SHORTNAME"), Операция.PROVIDER_SHORTNAME, "");
	НоваяСтрокаТЧ.Контрагент = ИдентифицироватьЗаказчикаAPI(Email, ЗаказчикНаименование);

	// ИНН контрагента для подсказки
	НоваяСтрокаТЧ.ИННКонтрагента = ?(Операция.Свойство("PROVIDER_INN"), Операция.PROVIDER_INN, "");

	// Принципал
	ПринципалИмя = ?(Операция.Свойство("GUARANTOR_SHORTNAME"), Операция.GUARANTOR_SHORTNAME, "");
	Если ЗначениеЗаполнено(ПринципалИмя) Тогда
		НоваяСтрокаТЧ.Принципал = Справочники.Принципалы.НайтиПоНаименованию(ПринципалИмя);
	КонецЕсли;

	// Декларант
	ДекларантИмя = ?(Операция.Свойство("DECLARANT_SHORTNAME"), Операция.DECLARANT_SHORTNAME, "");
	Если ЗначениеЗаполнено(ДекларантИмя) Тогда
		НоваяСтрокаТЧ.Декларант = Справочники.Декларанты.НайтиПоНаименованию(ДекларантИмя);
	КонецЕсли;

	// Перевозчик
	ПеревозчикКод = ?(Операция.Свойство("CARRIER_REGCODE"), Операция.CARRIER_REGCODE, "");
	Если ЗначениеЗаполнено(ПеревозчикКод) Тогда
		НоваяСтрокаТЧ.Перевозчик = Справочники.Перевозчики.НайтиПоКоду(ПеревозчикКод);
		Если НЕ ЗначениеЗаполнено(НоваяСтрокаТЧ.Перевозчик) Тогда
			НоваяСтрокаТЧ.Перевозчик = Справочники.Перевозчики.НайтиПоНаименованию(ПеревозчикКод);
		КонецЕсли;
	КонецЕсли;

	// Пункт отправления
	КодОтправления = ?(Операция.Свойство("DEPATURECUSTOMSCODE"), Операция.DEPATURECUSTOMSCODE, "");
	НоваяСтрокаТЧ.КодТаможниОтправления = КодОтправления;
	Если ЗначениеЗаполнено(КодОтправления) Тогда
		НоваяСтрокаТЧ.ПунктОтправления = НайтиТаможенныйПункт(КодОтправления);
	КонецЕсли;

	// Пункт назначения
	КодНазначения = ?(Операция.Свойство("ARRIVALCUSTOMSCODE"), Операция.ARRIVALCUSTOMSCODE, "");
	Если ЗначениеЗаполнено(КодНазначения) Тогда
		НоваяСтрокаТЧ.ПунктНазначения = НайтиТаможенныйПункт(КодНазначения);
	КонецЕсли;

	// Обеспечение
	Попытка
		НоваяСтрокаТЧ.СуммаОбеспечения = Число(?(Операция.Свойство("DUTYAMOUNT"), Операция.DUTYAMOUNT, "0"));
		КодВалюты = ?(Операция.Свойство("CURRENCYCODE"), Операция.CURRENCYCODE, "RUB");
		НоваяСтрокаТЧ.ВалютаОбеспечения = Справочники.Валюты.НайтиПоНаименованию(КодВалюты);
	Исключение
	КонецПопытки;

	// Расстояние из тарифа
	Попытка
		НоваяСтрокаТЧ.Расстояние = Число(?(Операция.Свойство("GCA_TARIFFDISTANCE"), Операция.GCA_TARIFFDISTANCE, "0"));
	Исключение
	КонецПопытки;

	// Транспортный документ — CMR
	НомерCMR = ?(Операция.Свойство("TDOC_NUMBER"), Операция.TDOC_NUMBER, "");
	НоваяСтрокаТЧ.НомераCMR = НомерCMR;
	НоваяСтрокаТЧ.КоличествоCMR = ?(НомерCMR <> "", 1, 0);

	// Транспортные средства
	НомераТС = ?(Операция.Свойство("TSNUMBERS"), Операция.TSNUMBERS, "");
	Если ЗначениеЗаполнено(НомераТС) Тогда
		МассивНомеров = СтрРазделить(НомераТС, ",;/ ");
		Для Каждого НомерТС Из МассивНомеров Цикл
			Если ЗначениеЗаполнено(СокрЛП(НомерТС)) Тогда
				НоваяСтрокаТС = ТранспортныеСредства.Добавить();
				НоваяСтрокаТС.DocumentID = DocumentID;
				Транспорт = Справочники.ТранспортныеСредства.НайтиПоНаименованию(СокрЛП(НомерТС));
				НоваяСтрокаТС.ТранспортноеСредство = Транспорт;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Товары (если withgoods=1)
	Если Операция.Свойство("GOODSTNVEDCODE") Тогда
		НоваяСтрТов = КодыCMR.Добавить();
		НоваяСтрТов.DocumentID = DocumentID;
		НоваяСтрТов.КодТНВЭД = Операция.GOODSTNVEDCODE;
		НоваяСтрТов.Наименование = ?(Операция.Свойство("GOODSDESCRIPTION"), Операция.GOODSDESCRIPTION, "");
		Попытка
			НоваяСтрТов.Сумма = Число(?(Операция.Свойство("INVOICEDCOST"), Операция.INVOICEDCOST, "0"));
		Исключение
		КонецПопытки;
	КонецЕсли;

	// Дата оформления
	Попытка
		Если Операция.Свойство("TRANSITOPENDATE") И ЗначениеЗаполнено(Операция.TRANSITOPENDATE) Тогда
			НоваяСтрокаТЧ.ДатаОформления = XMLЗначение(Тип("Дата"), Операция.TRANSITOPENDATE);
		ИначеЕсли Операция.Свойство("BDT_DATECRT") И ЗначениеЗаполнено(Операция.BDT_DATECRT) Тогда
			НоваяСтрокаТЧ.ДатаОформления = XMLЗначение(Тип("Дата"), Операция.BDT_DATECRT);
		Иначе
			НоваяСтрокаТЧ.ДатаОформления = ТекущаяДатаСеанса();
		КонецЕсли;
	Исключение
		НоваяСтрокаТЧ.ДатаОформления = ТекущаяДатаСеанса();
	КонецПопытки;

	// Оператор (FIO)
	НоваяСтрокаТЧ.Оператор = ?(Операция.Свойство("SPEC_FIO"), Операция.SPEC_FIO, "");

КонецПроцедуры

// Идентификация заказчика из данных API
Функция ИдентифицироватьЗаказчикаAPI(Email, Наименование)

	Контрагент = Справочники.Контрагенты.ПустаяСсылка();

	// Шаг 1: По email через КонтактнаяИнформация
	Если ЗначениеЗаполнено(Email) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтактнаяИнформация.Объект КАК Контрагент
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Представление ПОДОБНО &Email
		|	И КонтактнаяИнформация.Тип = &ТипEmail";
		Запрос.УстановитьПараметр("Email", "%" + Email + "%");
		Запрос.УстановитьПараметр("ТипEmail", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Если ТипЗнч(Выборка.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
				Возврат Выборка.Контрагент;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Шаг 2: По наименованию
	Если ЗначениеЗаполнено(Наименование) Тогда
		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(Наименование);
	КонецЕсли;

	Возврат Контрагент;

КонецФункции

Функция ПолучитьДатуПоследнейСинхронизации()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	МАКСИМУМ(ПрочитанныеДекларации.Период) КАК МаксДата
	|ИЗ
	|	РегистрСведений.ПрочитанныеДекларации КАК ПрочитанныеДекларации";

	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Если ЗначениеЗаполнено(Выборка.МаксДата) Тогда
			Возврат Выборка.МаксДата;
		КонецЕсли;
	КонецЕсли;

	// Если нет записей — за последние 6 месяцев
	Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -6);

КонецФункции

