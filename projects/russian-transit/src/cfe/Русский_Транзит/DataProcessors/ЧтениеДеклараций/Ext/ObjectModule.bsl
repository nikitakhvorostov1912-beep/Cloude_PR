// Fallback: загрузка из файлового каталога (старый режим)
Процедура ЗагрузитьИзФайловогоКаталога()

	// Пробуем Windows-путь, затем Linux-путь
	МассивПутей = Новый Массив;
	МассивПутей.Добавить("\\is-srv1c-02\share\ким\РусскийТранзит Дубликатор");
	МассивПутей.Добавить("/mnt/hdd2/share/ким/РусскийТранзит Дубликатор");

	ИмяКаталога = "";
	Для Каждого Путь Из МассивПутей Цикл
		Файл = Новый Файл(Путь);
		Если Файл.Существует() Тогда
			ИмяКаталога = Путь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(ИмяКаталога) Тогда
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.Файлы",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Файловый каталог Сигмы недоступен. Проверены пути: "
			+ МассивПутей[0] + ", " + МассивПутей[1]);
		Возврат;
	КонецЕсли;

	МассивФайлов = НайтиФайлы(ИмяКаталога, "*.xml", Истина);

	Если МассивФайлов.Количество() = 0 Тогда
		ЗаписьЖурналаРегистрации("ЧтениеДеклараций.Файлы",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"XML-файлы не найдены в каталоге: " + ИмяКаталога);
		Возврат;
	КонецЕсли;

	СчётчикОбработано = 0;
	СчётчикПропущено = 0;

	Для Каждого ЭлементФайл Из МассивФайлов Цикл
		Попытка
			Результат = ЗаполнитьИзXML(ЭлементФайл.ПолноеИмя);
			Если Результат = "Пропущен" Тогда
				СчётчикПропущено = СчётчикПропущено + 1;
			Иначе
				СчётчикОбработано = СчётчикОбработано + 1;
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ЧтениеДеклараций.Файлы",
				УровеньЖурналаРегистрации.Ошибка,,,
				"Ошибка обработки файла: " + ЭлементФайл.ПолноеИмя + " | " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ЗаписьЖурналаРегистрации("ЧтениеДеклараций.Файлы",
		УровеньЖурналаРегистрации.Информация,,,
		"Файлы: обработано " + СчётчикОбработано + ", пропущено " + СчётчикПропущено);

КонецПроцедуры

