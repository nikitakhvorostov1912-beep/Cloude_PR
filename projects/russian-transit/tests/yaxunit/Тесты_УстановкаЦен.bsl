// Тесты обработки УстановкаЦенКонтрагентов — запись тарифов, валидация
// Фреймворк: YAxUnit
// Критичность: CRITICAL — ошибки записи тарифов = неправильные цены у клиентов

#Область ОписаниеТестов

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТест("ТестЗаписьТарифнойСеткиВТранзакции")
		.ДобавитьТест("ТестОткатТранзакцииПриОшибке")
		.ДобавитьТест("ТестСоздатьОбработкуУстановкиЦен")
		.ДобавитьТест("ТестНаличиеРеквизитовОбработки")
		.ДобавитьТест("ТестВалидацияДатыПередЗаписью");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестЗаписьТарифнойСеткиВТранзакции() Экспорт

	// Дано: контрагент для теста
	Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Грифон");
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ЮТест.Пропустить("Контрагент Грифон не найден");
		Возврат;
	КонецЕсли;

	// Когда: записываем тестовую запись в транзакции и откатываем
	ТестоваяДата = Дата(2099, 1, 1); // далёкая дата чтобы не конфликтовать

	НачатьТранзакцию();
	Попытка
		НабЗап = РегистрыСведений.ТарифныеСеткиОбеспечения.СоздатьНаборЗаписей();
		НабЗап.Отбор.Период.Установить(ТестоваяДата);
		НабЗап.Отбор.Контрагент.Установить(Контрагент);

		НовЗап = НабЗап.Добавить();
		НовЗап.Период = ТестоваяДата;
		НовЗап.Контрагент = Контрагент;
		НовЗап.Цена = 999;

		НабЗап.Записать(Истина);

		// Тогда: запись прошла
		НабЗапПроверка = РегистрыСведений.ТарифныеСеткиОбеспечения.СоздатьНаборЗаписей();
		НабЗапПроверка.Отбор.Период.Установить(ТестоваяДата);
		НабЗапПроверка.Отбор.Контрагент.Установить(Контрагент);
		НабЗапПроверка.Прочитать();

		ЮТест.ОжидаетЧто(НабЗапПроверка.Количество()).Больше(0);

		ОтменитьТранзакцию(); // ОТКАТ — данные не останутся
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ТестОткатТранзакцииПриОшибке() Экспорт

	// Дано: начинаем транзакцию
	ТестоваяДата = Дата(2099, 1, 2);

	НачатьТранзакцию();
	Попытка
		НабЗап = РегистрыСведений.ТарифныеСеткиОбеспечения.СоздатьНаборЗаписей();
		НабЗап.Отбор.Период.Установить(ТестоваяДата);

		НовЗап = НабЗап.Добавить();
		НовЗап.Период = ТестоваяДата;
		НовЗап.Цена = 111;

		НабЗап.Записать(Истина);

		// Имитируем ошибку
		ВызватьИсключение "Тестовая ошибка для проверки отката";
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;

	// Тогда: данные НЕ должны остаться после отката
	НабЗапПроверка = РегистрыСведений.ТарифныеСеткиОбеспечения.СоздатьНаборЗаписей();
	НабЗапПроверка.Отбор.Период.Установить(ТестоваяДата);
	НабЗапПроверка.Прочитать();

	ЮТест.ОжидаетЧто(НабЗапПроверка.Количество()).Равно(0);

КонецПроцедуры

Процедура ТестСоздатьОбработкуУстановкиЦен() Экспорт

	// Дано/Когда: создаём обработку
	Обработка = Обработки.УстановкаЦенКонтрагентов.Создать();

	// Тогда: обработка создана
	ЮТест.ОжидаетЧто(Обработка <> Неопределено).Равно(Истина);

КонецПроцедуры

Процедура ТестНаличиеРеквизитовОбработки() Экспорт

	// Дано: метаданные обработки
	МетаОбр = Метаданные.Обработки.УстановкаЦенКонтрагентов;

	// Тогда: ключевые реквизиты существуют
	ОбязательныеРеквизиты = Новый Массив;
	ОбязательныеРеквизиты.Добавить("Организация");
	ОбязательныеРеквизиты.Добавить("НаДату");
	ОбязательныеРеквизиты.Добавить("СпецЦены");
	ОбязательныеРеквизиты.Добавить("СубконтоСпецЦены");
	ОбязательныеРеквизиты.Добавить("СубконтоСпецЦены2");
	ОбязательныеРеквизиты.Добавить("СубконтоСпецЦены3");
	ОбязательныеРеквизиты.Добавить("ТипУслуги");

	Для Каждого ИмяРекв Из ОбязательныеРеквизиты Цикл
		НайденныйРекв = МетаОбр.Реквизиты.Найти(ИмяРекв);
		ЮТест.ОжидаетЧто(НайденныйРекв <> Неопределено)
			.Равно(Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ТестВалидацияДатыПередЗаписью() Экспорт

	// Дано: пустая дата
	НаДату = Дата(1, 1, 1);

	// Тогда: дата не заполнена
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(НаДату)).Равно(Ложь);

	// Дано: корректная дата
	НаДатуКорректная = ТекущаяДатаСеанса();

	// Тогда: дата заполнена
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(НаДатуКорректная)).Равно(Истина);

КонецПроцедуры

#КонецОбласти
