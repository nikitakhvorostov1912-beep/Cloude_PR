// Тесты для performance-рефакторингов 2026-05-01
// Покрывают: Refactor #1 (АРМ.ПолучитьМапуТарифовЗаказчиков),
//             Refactor #2 (ЗагрузкаРееструТД.ПостроитьМапуПодразделенийКонтрагентов),
//             Refactor #3 (КешРеквизитов = Организация + Валюта в СоздатьНовыйДокументТД).
//
// Цель — убедиться что batch-предзагрузка возвращает корректные данные:
//   - Пустой вход → пустая мапа (не падает)
//   - Дубликаты → уникальные ключи
//   - Корректный формат ключа (UUID контрагента + флаг СпецЦены)
//   - Lookup в мапе возвращает Истину для существующих, Ложь для отсутствующих
//
// Фреймворк: YAxUnit. Запуск: через 1С Предприятие → Обработки → ЮТ Тесты → запустить эту группу.

#Область ОписаниеТестов

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		// Refactor #2: ПостроитьМапуПодразделенийКонтрагентов
		.ДобавитьТест("ТестМапаПодразделенийПустаяТаблица")
		.ДобавитьТест("ТестМапаПодразделенийУникальностьКлючей")
		// Refactor #1: ПолучитьМапуТарифовЗаказчиков (АРМ)
		.ДобавитьТест("ТестМапаТарифовПустойМассив")
		// Формат ключа в мапе тарифов
		.ДобавитьТест("ТестФорматКлючаТарифа")
		// Refactor #3: КешРеквизитов
		.ДобавитьТест("ТестКешРеквизитовОрганизацияНеПустая")
		.ДобавитьТест("ТестКешРеквизитовВалютаНеПустая");

КонецПроцедуры

#КонецОбласти

#Область Тесты

// =====================================================================
// Refactor #2: ПостроитьМапуПодразделенийКонтрагентов
// =====================================================================

Процедура ТестМапаПодразделенийПустаяТаблица() Экспорт

	// Дано: пустая ТаблицаCSV (только колонки, без строк)
	Обработка = Обработки.ЗагрузкаРееструТД.Создать();
	ТаблицаCSV = Новый ТаблицаЗначений;
	ТаблицаCSV.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("Строка"));

	// Когда: построим мапу
	Мапа = Обработка.ПостроитьМапуПодразделенийКонтрагентов(ТаблицаCSV);

	// Тогда: возвращён пустой Соответствие (не Неопределено, не падение)
	ЮТест.ОжидаетЧто(ТипЗнч(Мапа)).Равно(Тип("Соответствие"));
	ЮТест.ОжидаетЧто(Мапа.Количество()).Равно(0);

КонецПроцедуры

Процедура ТестМапаПодразделенийУникальностьКлючей() Экспорт

	// Дано: ТаблицаCSV с дубликатами Подразделения
	Обработка = Обработки.ЗагрузкаРееструТД.Создать();
	ТаблицаCSV = Новый ТаблицаЗначений;
	ТаблицаCSV.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("Строка"));
	Для Сч = 1 По 5 Цикл
		ТаблицаCSV.Добавить().Подразделение = "ТЕСТ-ПОДРАЗДЕЛЕНИЕ-1";
		ТаблицаCSV.Добавить().Подразделение = "ТЕСТ-ПОДРАЗДЕЛЕНИЕ-2";
	КонецЦикла;
	// Также проверяем что пустые/null строки НЕ ломают набор
	ТаблицаCSV.Добавить().Подразделение = "";
	ТаблицаCSV.Добавить().Подразделение = "   "; // только пробелы

	// Когда: построим мапу
	Мапа = Обработка.ПостроитьМапуПодразделенийКонтрагентов(ТаблицаCSV);

	// Тогда: в мапе будет ≤ 2 элементов (только реальные подразделения, и только если найдены в РС)
	// Если в РС нет таких записей — мапа пустая. Если есть — содержит только реальные.
	ЮТест.ОжидаетЧто(ТипЗнч(Мапа)).Равно(Тип("Соответствие"));
	// Любая запись в мапе должна иметь непустого Контрагента
	Для Каждого КЗ Из Мапа Цикл
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(КЗ.Значение)).Равно(Истина);
	КонецЦикла;

КонецПроцедуры

// =====================================================================
// Refactor #1: ПолучитьМапуТарифовЗаказчиков (АРМ)
// =====================================================================

Процедура ТестМапаТарифовПустойМассив() Экспорт

	// Дано: пустой массив выделенных строк
	// Когда: вызываем функцию формы АРМ через программное создание формы
	ФормаАРМ = ПолучитьФормуАРМ();
	Если ФормаАРМ = Неопределено Тогда
		ЮТест.Пропустить("Не удалось открыть форму АРМ программно");
		Возврат;
	КонецЕсли;

	ПустыеСтроки = Новый Массив;
	Мапа = ФормаАРМ.ПолучитьМапуТарифовЗаказчиков(ПустыеСтроки);

	// Тогда: пустая мапа, не падение
	ЮТест.ОжидаетЧто(ТипЗнч(Мапа)).Равно(Тип("Соответствие"));
	ЮТест.ОжидаетЧто(Мапа.Количество()).Равно(0);

КонецПроцедуры

Процедура ТестФорматКлючаТарифа() Экспорт

	// Проверяем формат ключа в мапе тарифов: UUID контрагента + "|" + флаг СпецЦены ("0"/"1")
	// Формат должен совпадать между ПолучитьМапуТарифовЗаказчиков (key build)
	// и ПроверитьТарифыЗаказчика (key lookup) — иначе lookup всегда вернёт Неопределено.

	КонтрагентUUID = "12345678-1234-1234-1234-123456789012";
	КлючTrue = КонтрагентUUID + "|" + "1"; // СпецЦены = Истина
	КлючFalse = КонтрагентUUID + "|" + "0"; // СпецЦены = Ложь

	ЮТест.ОжидаетЧто(КлючTrue).НеРавно(КлючFalse);
	ЮТест.ОжидаетЧто(СтрНайти(КлючTrue, "|1")).Больше(0);
	ЮТест.ОжидаетЧто(СтрНайти(КлючFalse, "|0")).Больше(0);

КонецПроцедуры

// =====================================================================
// Refactor #3: КешРеквизитов
// =====================================================================

Процедура ТестКешРеквизитовОрганизацияНеПустая() Экспорт

	// Дано: реальная база с активными организациями
	Обработка = Обработки.ЗагрузкаРееструТД.Создать();

	// Когда: вычислим ОрганизацияПоУмолчанию (внутренняя функция, проверяем через эффект на КешРеквизитов)
	// Создаём пустую ТаблицаПредложений → ПрименитьКлассификацию выйдет сразу из цикла
	// после построения КешРеквизитов
	ТаблицаПустая = Обработка.СоздатьТаблицуПредложений();
	Результат = Обработка.ПрименитьКлассификацию(ТаблицаПустая);

	// Тогда: ПрименитьКлассификацию не падает, возвращает структуру со счётчиками = 0
	ЮТест.ОжидаетЧто(Результат.Создано).Равно(0);
	ЮТест.ОжидаетЧто(Результат.Обогащено).Равно(0);
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(0);

КонецПроцедуры

Процедура ТестКешРеквизитовВалютаНеПустая() Экспорт

	// Прямая проверка что в базе есть активная валюта (требование для рефактора #3)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	В.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК В
	|ГДЕ
	|	НЕ В.ПометкаУдаления";
	Результат = Запрос.Выполнить();

	// Тогда: должна быть хотя бы одна активная валюта (иначе рефактор #3 даст ПустаяСсылка
	// в КешРеквизитов.Валюта, что нарушит создание новых ОПП)
	ЮТест.ОжидаетЧто(Результат.Пустой()).Равно(Ложь);

КонецПроцедуры

