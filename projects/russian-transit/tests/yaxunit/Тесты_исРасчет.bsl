// Тесты модуля исРасчет — расчёт цен по тарифным сеткам
// Фреймворк: YAxUnit
// Критичность: HIGH — ошибки расчёта = неправильные суммы в документах

#Область ОписаниеТестов

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТест("ТестРасчётОбеспеченияГрифон")
		.ДобавитьТест("ТестРасчётОбеспеченияПустойКонтрагент")
		.ДобавитьТест("ТестРасчётCMRБазовый")
		.ДобавитьТест("ТестРасчётОформленияТД")
		.ДобавитьТест("ТестАгентскоеВознаграждение25Процентов")
		.ДобавитьТест("ТестАгентскоеВознаграждениеКастомныйПроцент")
		.ДобавитьТест("ТестРасчётЛегковыеАвто")
		.ДобавитьТест("ТестРасстояниеМеждуПунктами");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестРасчётОбеспеченияГрифон() Экспорт

	// Дано: контрагент Грифон, известное расстояние, сумма обеспечения
	Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Грифон");

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ЮТест.Пропустить("Контрагент Грифон не найден в базе");
		Возврат;
	КонецЕсли;

	// Когда: получаем тарифную сетку Грифон
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Цена КАК Цена,
	|	Т.АналитикаСумм КАК АналитикаСумм
	|ИЗ
	|	РегистрСведений.ТарифныеСеткиОбеспечения.СрезПоследних(, Контрагент = &Контрагент) КАК Т";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	РезультатЗапроса = Запрос.Выполнить();

	// Тогда: записи должны существовать
	ЮТест.ОжидаетЧто(РезультатЗапроса.Пустой()).Равно(Ложь);

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	ЮТест.ОжидаетЧто(Выборка.Цена)
		.БольшеИлиРавно(0);

КонецПроцедуры

Процедура ТестРасчётОбеспеченияПустойКонтрагент() Экспорт

	// Дано: пустой контрагент
	// Когда: пытаемся получить тариф
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ТарифныеСеткиОбеспечения.СрезПоследних(, Контрагент = &Контрагент) КАК Т";
	Запрос.УстановитьПараметр("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	РезультатЗапроса = Запрос.Выполнить();

	// Тогда: результат должен быть пустым (не упасть с ошибкой)
	ЮТест.ОжидаетЧто(РезультатЗапроса.Пустой()).Равно(Истина);

КонецПроцедуры

Процедура ТестРасчётCMRБазовый() Экспорт

	// Дано: контрагент с ценообразованием CMR
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ц.Контрагент КАК Контрагент,
	|	Ц.ЦенаЗаПервуюCMR КАК ЦенаЗаПервуюCMR,
	|	Ц.ЦенаЗаДополнительнуюCMR КАК ЦенаЗаДополнительнуюCMR
	|ИЗ
	|	РегистрСведений.ЦенообразованиеКодовCMR.СрезПоследних КАК Ц
	|ГДЕ
	|	Ц.ЦенаЗаПервуюCMR > 0";
	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		ЮТест.Пропустить("Нет данных ценообразования CMR в базе");
		Возврат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	// Тогда: цена за первую CMR > 0, дополнительную >= 0
	ЮТест.ОжидаетЧто(Выборка.ЦенаЗаПервуюCMR).Больше(0);
	ЮТест.ОжидаетЧто(Выборка.ЦенаЗаДополнительнуюCMR).БольшеИлиРавно(0);

КонецПроцедуры

Процедура ТестРасчётОформленияТД() Экспорт

	// Дано: есть тарифы оформления ТД
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Контрагент КАК Контрагент,
	|	Т.Ставка КАК Ставка
	|ИЗ
	|	РегистрСведений.ТарифыОформленияТД.СрезПоследних КАК Т
	|ГДЕ
	|	Т.Ставка > 0";
	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		ЮТест.Пропустить("Нет данных тарифов ТД в базе");
		Возврат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	// Тогда: ставка ТД > 0
	ЮТест.ОжидаетЧто(Выборка.Ставка).Больше(0);

КонецПроцедуры

Процедура ТестАгентскоеВознаграждение25Процентов() Экспорт

	// Дано: Оплата = 1000, процент = 0 (должен стать 25% по умолчанию)
	Оплата = 1000;
	Процент = 0;

	// Когда: применяем логику по умолчанию
	Если Процент = 0 Тогда
		Процент = 25;
	КонецЕсли;
	АгентскоеВознаграждение = Оплата * Процент / 100;

	// Тогда: 25% от 1000 = 250
	ЮТест.ОжидаетЧто(АгентскоеВознаграждение).Равно(250);

КонецПроцедуры

Процедура ТестАгентскоеВознаграждениеКастомныйПроцент() Экспорт

	// Дано: Оплата = 2000, процент = 15 (кастомный)
	Оплата = 2000;
	Процент = 15;

	// Когда: процент уже задан — не трогаем
	Если Процент = 0 Тогда
		Процент = 25;
	КонецЕсли;
	АгентскоеВознаграждение = Оплата * Процент / 100;

	// Тогда: 15% от 2000 = 300
	ЮТест.ОжидаетЧто(АгентскоеВознаграждение).Равно(300);

КонецПроцедуры

Процедура ТестРасчётЛегковыеАвто() Экспорт

	// Дано: код вида ТС содержит "легков"
	КодВидаТС = "Легковой автомобиль";

	// Когда: проверяем функцию определения
	ЭтоЛегковой = СтрНайти(НРег(Строка(КодВидаТС)), "легков") > 0;

	// Тогда: должен определиться как легковой
	ЮТест.ОжидаетЧто(ЭтоЛегковой).Равно(Истина);

	// Дано: грузовой
	КодВидаТСГрузовой = "Грузовой автомобиль";
	ЭтоЛегковойГрузовой = СтрНайти(НРег(Строка(КодВидаТСГрузовой)), "легков") > 0;

	// Тогда: НЕ легковой
	ЮТест.ОжидаетЧто(ЭтоЛегковойГрузовой).Равно(Ложь);

КонецПроцедуры

Процедура ТестРасстояниеМеждуПунктами() Экспорт

	// Дано: два таможенных пункта
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Р.ПунктОтправления КАК ПунктОтправления,
	|	Р.ПунктНазначения КАК ПунктНазначения,
	|	Р.Расстояние КАК Расстояние
	|ИЗ
	|	РегистрСведений.РасстоянияМеждуТаможеннымиПунктами КАК Р
	|ГДЕ
	|	Р.Расстояние > 0";
	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		ЮТест.Пропустить("Нет данных расстояний в базе");
		Возврат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	// Тогда: расстояние > 0 и <= 10000 (разумный диапазон в км)
	ЮТест.ОжидаетЧто(Выборка.Расстояние).Больше(0);
	ЮТест.ОжидаетЧто(Выборка.Расстояние).Меньше(10000);

КонецПроцедуры

#КонецОбласти
