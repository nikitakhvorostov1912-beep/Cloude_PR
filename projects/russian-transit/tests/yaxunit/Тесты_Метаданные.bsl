// Тесты метаданных расширения Русский_Транзит — регрессия структуры
// Фреймворк: YAxUnit
// Критичность: HIGH — ломка метаданных = расширение не загрузится

#Область ОписаниеТестов

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТест("ТестНаличиеОбъектовРасширения")
		.ДобавитьТест("ТестИзмеренияТарифныхСеток")
		.ДобавитьТест("ТестИзмеренияЦенообразованияCMR")
		.ДобавитьТест("ТестРеквизитыДокумента")
		.ДобавитьТест("ТестТабличныеЧастиДокумента")
		.ДобавитьТест("ТестПеречисленияСтатусов")
		.ДобавитьТест("ТестПеречисленияТиповУчета");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестНаличиеОбъектовРасширения() Экспорт

	// Все ключевые объекты расширения должны существовать
	ЮТест.ОжидаетЧто(Метаданные.Документы.Найти("ОперацияПоПоручительству") <> Неопределено)
		.Равно(Истина);

	ЮТест.ОжидаетЧто(Метаданные.Обработки.Найти("УстановкаЦенКонтрагентов") <> Неопределено)
		.Равно(Истина);

	ЮТест.ОжидаетЧто(Метаданные.РегистрыСведений.Найти("ТарифныеСеткиОбеспечения") <> Неопределено)
		.Равно(Истина);

	ЮТест.ОжидаетЧто(Метаданные.РегистрыСведений.Найти("ЦенообразованиеКодовCMR") <> Неопределено)
		.Равно(Истина);

	ЮТест.ОжидаетЧто(Метаданные.РегистрыСведений.Найти("РасстоянияМеждуТаможеннымиПунктами") <> Неопределено)
		.Равно(Истина);

	ЮТест.ОжидаетЧто(Метаданные.РегистрыСведений.Найти("ТарифыОформленияТД") <> Неопределено)
		.Равно(Истина);

КонецПроцедуры

Процедура ТестИзмеренияТарифныхСеток() Экспорт

	// Регистр ТарифныеСеткиОбеспечения — ключевые измерения
	МетаРег = Метаданные.РегистрыСведений.ТарифныеСеткиОбеспечения;

	ОбязательныеИзмерения = Новый Массив;
	ОбязательныеИзмерения.Добавить("Контрагент");
	ОбязательныеИзмерения.Добавить("АналитикаСумм");
	ОбязательныеИзмерения.Добавить("ДополнительнаяАналитика");
	ОбязательныеИзмерения.Добавить("КлючАналитик");
	ОбязательныеИзмерения.Добавить("СпецЦены");
	ОбязательныеИзмерения.Добавить("СубконтоСпецЦены");
	ОбязательныеИзмерения.Добавить("СубконтоСпецЦены2");
	ОбязательныеИзмерения.Добавить("СубконтоСпецЦены3");

	Для Каждого ИмяИзм Из ОбязательныеИзмерения Цикл
		НайденноеИзм = МетаРег.Измерения.Найти(ИмяИзм);
		Если НайденноеИзм = Неопределено Тогда
			НайденноеИзм = МетаРег.Ресурсы.Найти(ИмяИзм);
		КонецЕсли;
		Если НайденноеИзм = Неопределено Тогда
			НайденноеИзм = МетаРег.Реквизиты.Найти(ИмяИзм);
		КонецЕсли;
		ЮТест.ОжидаетЧто(НайденноеИзм <> Неопределено)
			.Равно(Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ТестИзмеренияЦенообразованияCMR() Экспорт

	МетаРег = Метаданные.РегистрыСведений.ЦенообразованиеКодовCMR;

	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("Контрагент");
	ОбязательныеПоля.Добавить("УслугаОрганизации");
	ОбязательныеПоля.Добавить("ЦенаЗаПервуюCMR");
	ОбязательныеПоля.Добавить("ЦенаЗаДополнительнуюCMR");

	Для Каждого ИмяПоля Из ОбязательныеПоля Цикл
		Найдено = МетаРег.Измерения.Найти(ИмяПоля);
		Если Найдено = Неопределено Тогда
			Найдено = МетаРег.Ресурсы.Найти(ИмяПоля);
		КонецЕсли;
		ЮТест.ОжидаетЧто(Найдено <> Неопределено)
			.Равно(Истина);
	КонецЦикла;

КонецПроцедуры

