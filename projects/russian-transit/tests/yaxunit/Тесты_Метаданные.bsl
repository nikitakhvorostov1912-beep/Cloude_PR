Процедура ТестПеречисленияСтатусов() Экспорт

	// Все используемые значения перечисления должны существовать
	ЮТест.ОжидаетЧто(Перечисления.СтатусыОпераций.НеИдентифицирован).Заполнено();
	ЮТест.ОжидаетЧто(Перечисления.СтатусыОпераций.НеРассчитан).Заполнено();
	ЮТест.ОжидаетЧто(Перечисления.СтатусыОпераций.ТребуетРучнойКорректировки).Заполнено();
	ЮТест.ОжидаетЧто(Перечисления.СтатусыОпераций.Обработан).Заполнено();
	ЮТест.ОжидаетЧто(Перечисления.СтатусыОпераций.ГотовоКОплате).Заполнено();
	ЮТест.ОжидаетЧто(Перечисления.СтатусыОпераций.Завершен).Заполнено();
	ЮТест.ОжидаетЧто(Перечисления.СтатусыОпераций.Аннулирован).Заполнено();

КонецПроцедуры

Процедура ТестПеречисленияТиповУчета() Экспорт

	// Типы учёта клиентов
	МетаПеречисление = Метаданные.Перечисления.Найти("ТипыУчетаКлиентов");
	ЮТест.ОжидаетЧто(МетаПеречисление <> Неопределено).Равно(Истина);

КонецПроцедуры

#КонецОбласти
