Процедура ТестМапаПодразделенийСДанными() Экспорт

	Обработка = Обработки.ЗагрузкаРееструТД.Создать();
	ТаблицаCSV = Новый ТаблицаЗначений;
	ТаблицаCSV.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("Строка"));
	ТаблицаCSV.Добавить().Подразделение = "Центральный офис";
	ТаблицаCSV.Добавить().Подразделение = "Трейд Солюшнс";
	ТаблицаCSV.Добавить().Подразделение = "Центральный офис"; // дубль
	ТаблицаCSV.Добавить().Подразделение = ""; // пустое — должно отфильтроваться

	Мапа = Обработка.ПостроитьМапуПодразделенийКонтрагентов(ТаблицаCSV);
	// Если в РС нет записей для этих подразделений — мапа пустая.
	// Если есть — мапа содержит уникальные значения.
	ЮТест.ОжидаетЧто(ТипЗнч(Мапа)).Равно(Тип("Соответствие"));
	// Любая запись должна иметь непустого Контрагента.
	Для Каждого КЗ Из Мапа Цикл
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(КЗ.Значение)).Равно(Истина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Тесты_ПолныйPipeline

Процедура ТестПолныйПарсингЭталонногоCSV() Экспорт

	// Smoke-test: парсер не падает на эталонном файле и даёт ожидаемый расклад.
	ПутьКФайлу = "C:\Users\Khvorostov\Downloads\Telegram Desktop\1-7 марто ЭТД (2).csv";
	Файл = Новый Файл(ПутьКФайлу);
	Если НЕ Файл.Существует() Тогда
		ЮТест.Пропустить("Эталонный файл не найден: " + ПутьКФайлу);
		Возврат;
	КонецЕсли;

	Обработка = Обработки.ЗагрузкаРееструТД.Создать();
	ТаблицаCSV = Обработка.ПрочитатьCSVФайл(ПутьКФайлу);

	// На эталоне — 437 строк (по скриншоту формы и проверке через MCP).
	ЮТест.ОжидаетЧто(ТаблицаCSV.Количество()).Равно(437);

	// У всех должны быть заполнены ключевые поля.
	КолСДатой = 0;
	КолСРегНомером = 0;
	Для Каждого Стр Из ТаблицаCSV Цикл
		Если ЗначениеЗаполнено(Стр.ДатаВыпуска) Тогда
			КолСДатой = КолСДатой + 1;
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.РегНомерТД) Тогда
			КолСРегНомером = КолСРегНомером + 1;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(КолСДатой).Равно(437);
	ЮТест.ОжидаетЧто(КолСРегНомером).Равно(437);

	// Сопоставление с БД.
	Предложения = Обработка.СопоставитьСДокументами(ТаблицаCSV);
	КолКомплекс = 0;
	КолНоваяТД = 0;
	Для Каждого Стр Из Предложения Цикл
		Если Стр.Категория = "Комплекс" Тогда КолКомплекс = КолКомплекс + 1;
		ИначеЕсли Стр.Категория = "НоваяТД" Тогда КолНоваяТД = КолНоваяТД + 1;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(КолКомплекс + КолНоваяТД).Равно(437);
	// На текущей БД — 359 Комплекс + 78 НоваяТД (могут поменяться при обогащении!).
	// Проверяем что хоть что-то нашлось в обеих категориях.
	ЮТест.ОжидаетЧто(КолКомплекс > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(КолНоваяТД > 0).Равно(Истина);

КонецПроцедуры

#КонецОбласти
