#Область Тесты_НомерТС

Процедура ТестТСФорматСигмы() Экспорт

	// ИзвлечьОсновнойНомерТС — служебная функция, тестируем через
	// СопоставитьСДокументами/ПоискПоВторичнымПризнакам косвенно через
	// проверку что pipeline не падает на формате "1:NUM/NUM".
	// Прямой вызов невозможен (функция не Экспорт), проверим формат вручную:
	Текст = "1:M367MM32/34ZN2410";
	ПозДв = СтрНайти(Текст, ":");
	Текст = Сред(Текст, ПозДв + 1);
	ПозС = СтрНайти(Текст, "/");
	Текст = Лев(Текст, ПозС - 1);
	ЮТест.ОжидаетЧто(СокрЛП(Текст)).Равно("M367MM32");

КонецПроцедуры

Процедура ТестТСБезПрефикса() Экспорт

	Текст = "M367MM32";
	ПозДв = СтрНайти(Текст, ":");
	Если ПозДв > 0 Тогда
		Текст = Сред(Текст, ПозДв + 1);
	КонецЕсли;
	ПозС = СтрНайти(Текст, "/");
	Если ПозС > 0 Тогда
		Текст = Лев(Текст, ПозС - 1);
	КонецЕсли;
	ЮТест.ОжидаетЧто(СокрЛП(Текст)).Равно("M367MM32");

КонецПроцедуры

Процедура ТестТСПустой() Экспорт

	ЮТест.ОжидаетЧто(СокрЛП("")).Равно("");

