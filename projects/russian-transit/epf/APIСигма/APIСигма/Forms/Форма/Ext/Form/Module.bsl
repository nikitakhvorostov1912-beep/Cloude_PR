Функция ЗагрузитьОперацииИзSigmaSoft() 
	
	Результат = Новый Структура("Успешно, TaskID, Ошибка");
	Результат.Успешно = Ложь;
	Результат.TaskID = "";
	Результат.Ошибка = "";
	
	BASE_URL = "edapi.sigma-soft.ru";
	Путь = "/api/v1/report/getreportggi";
	
	Попытка
		Соединение = Новый HTTPСоединение(BASE_URL, , , , , , Новый ЗащищенноеСоединениеOpenSSL());
		Для каждого Строка Из Объект.Декларация Цикл        
			// Подготавливаем тело запроса
			ТелоЗапроса = Новый Структура;
			ParticipantCode = Строка.Комментарий; 
			// Указываем только нужные поля (все из отчёта)
			//Поля = "MSS_DOCREGNUMBER;CARRIER_REGCODE;TDOC_NUMBER;TDOC_DATE;DUTYAMOUNT;GCA_TARIFFDISTANCE;GCA_TARIFFAMOUNT;TRANSPORTDOCUMENT_ID";
			//ТелоЗапроса.Вставить("fields", Поля);
			
			// Создаём запрос
			HTTPЗапрос = Новый HTTPЗапрос(Путь);
			HTTPЗапрос.УстановитьТелоИзСтроки(ЗначениеВJSON(ТелоЗапроса));
			HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
			HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
			HTTPЗапрос.Заголовки.Вставить("participantcode", "102773905066681");
			HTTPЗапрос.Заголовки.Вставить("datebegin", Формат(НачальнаяДата, "ДФ=yyyy-MM-dd"));
			HTTPЗапрос.Заголовки.Вставить("dateend", Формат(КонечнаяДата, "ДФ=yyyy-MM-dd"));
			HTTPЗапрос.Заголовки.Вставить("withgoods", 1);
			HTTPЗапрос.Заголовки.Вставить("quantity", 200);
			
			// Выполняем
			Ответ = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
			
			Если Ответ.КодСостояния = 200 Тогда
				Данные = JSONВЗначение(Ответ.ПолучитьТелоКакСтроку());
				Если Данные.resCode = 0 Тогда
					Результат.TaskID = Данные.resData;
					Результат.Успешно = Истина;
				Иначе
					Результат.Ошибка = "Ошибка API: " + Данные.resDescription;
				КонецЕсли;
			Иначе
				Результат.Ошибка = "HTTP ошибка: " + Ответ.КодСостояния + ". Тело: " + Ответ.ПолучитьТелоКакСтроку();
			КонецЕсли;
		КонецЦикла;
	Исключение
		Результат.Ошибка = "Исключение: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;	
КонецФункции

Функция HTTPЗапрос(Соединение, Метод, URL, ТелоЗапроса, Заголовки)
	Запрос = Новый HTTPЗапрос(URL);
	Для Каждого Пара Из Заголовки Цикл
		Запрос.Заголовки.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	
	Если Метод = "POST" И ТелоЗапроса <> "" Тогда
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	КонецЕсли;
	Результат = Соединение.ВызватьHTTPМетод(Метод,Запрос);
	Код = Результат.КодСостояния;
	Возврат Результат;
КонецФункции




Функция ЗначениеВJSON(Значение) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, Значение);
	
	Возврат ЗаписьJSON.Закрыть(); 
	
КонецФункции

Функция JSONВЗначение(СтрокаJSON) Экспорт
	
	Если Не ЗначениеЗаполнено(СтрокаJSON) Или СтрокаJSON = "[]" Тогда
		Возврат Новый Массив();
	КонецЕсли;
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Возврат ПрочитатьJSON(ЧтениеJSON, Истина);
	
КонецФункции

// Доработка START {Восстановлена старая быстрая загрузка + группировка вторым этапом} {2026-04-05}
&НаСервере
Процедура СоздатьДокументыНаСервере()
	СчётчикСоздано = 0;
	СчётчикОбновлено = 0;
	СчётчикОшибок = 0;

	// Доработка START {Мягкое предупреждение о пустых расстояниях} {2026-04-10}
	// Документы создаются даже без расстояния — пользователь заполняет его вручную
	// в самом документе. При записи документа расстояние автоматически сохраняется
	// в регистр РасстоянияМеждуТаможеннымиПунктами через РасстояниеПриИзменении.
	// При следующих загрузках из API известные маршруты подтянутся автоматом.
	СчётчикПустогоРасстояния = 0;
	Для Каждого Строка Из Объект.Декларация Цикл
		Если Строка.Расстояние = 0
			И ЗначениеЗаполнено(Строка.ПунктОтправления)
			И ЗначениеЗаполнено(Строка.ПунктНазначения) Тогда
			СчётчикПустогоРасстояния = СчётчикПустогоРасстояния + 1;
		КонецЕсли;
	КонецЦикла;
	// Доработка END

	// Подготовка: Соответствие КодыCMR по НомерСтрокиДекларации
	КартаCMR = Новый Соответствие;
	Для Каждого СтрCMR Из Объект.КодыCMR Цикл
		Кл = СтрCMR.НомерСтрокиДекларации;
		Если КартаCMR[Кл] = Неопределено Тогда
			КартаCMR[Кл] = Новый Массив;
		КонецЕсли;
		КартаCMR[Кл].Добавить(СтрCMR);
	КонецЦикла;

	// ЭТАП 1: Создание документов (старая логика, 1 строка = 1 документ)
	Для Каждого Строка Из Объект.Декларация Цикл
		Попытка
			Если ЗначениеЗаполнено(Строка.НомерГТД) Тогда
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка Из Документ.ОперацияПоПоручительству ГДЕ НомерГТД = &НомерГТД");
				Запрос.УстановитьПараметр("НомерГТД", Строка.НомерГТД);
			ИначеЕсли ЗначениеЗаполнено(Строка.DocumentID) Тогда
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка Из Документ.ОперацияПоПоручительству ГДЕ ВнешнийИдентификатор = &ВнешнийИдентификатор");
				Запрос.УстановитьПараметр("ВнешнийИдентификатор", Строка.DocumentID);
			Иначе
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка Из Документ.ОперацияПоПоручительству ГДЕ ЛОЖЬ");
			КонецЕсли;
			Результат = Запрос.Выполнить();

			ЭтоНовый = Результат.Пустой();
			Если ЭтоНовый Тогда
				Док = Документы.ОперацияПоПоручительству.СоздатьДокумент();
			Иначе
				Док = Результат.Выгрузить()[0].Ссылка.ПолучитьОбъект();
			КонецЕсли;

			ЗаполнитьЗначенияСвойств(Док, Строка);
			Док.ВнешнийИдентификатор = Строка.DocumentID;
			Если НЕ ЗначениеЗаполнено(Док.СтатусОперации) Тогда
				Док.СтатусОперации = Перечисления.СтатусыОпераций.НеРассчитан;
			КонецЕсли;

			// КодыCMR: из Соответствия (построено до цикла)
			Док.КодыCMR.Очистить();
			МассивCMR = КартаCMR[Строка.НомерСтроки];
			Если МассивCMR <> Неопределено Тогда
				Для Каждого ИсхCMR Из МассивCMR Цикл
					НовCMR = Док.КодыCMR.Добавить();
					ЗаполнитьЗначенияСвойств(НовCMR, ИсхCMR);
				КонецЦикла;
			КонецЕсли;

			// Доработка START {Задача 4: ДанныеДокументов — минимум 1 строка из шапки} {2026-04-10}
			Док.ДанныеДокументов.Очистить();
			НоваяДД = Док.ДанныеДокументов.Добавить();
			НоваяДД.НомерГТД = Док.НомерГТД;
			НоваяДД.СуммаОбеспечения = Док.СуммаОбеспечения;
			НоваяДД.Валюта = Док.ВалютаОбеспечения;
			НоваяДД.Расстояние = Док.Расстояние;
			НоваяДД.Контрагент = Док.Контрагент;
			НоваяДД.Декларант = Док.Декларант;
			НоваяДД.Ответственный = Док.Ответственный;
			НоваяДД.ПунктОтправления = Док.ПунктОтправления;
			НоваяДД.ПунктНазначения = Док.ПунктНазначения;
			НоваяДД.СтатусТранзита = Док.СтатусТранзита;
			НоваяДД.ДатаЗавершения = Док.ДатаЗавершения;
			НоваяДД.СрокТранзита = Док.СрокТранзита;
			НоваяДД.УникальныйИдентификатор = ?(ЗначениеЗаполнено(Док.ВнешнийИдентификатор), Док.ВнешнийИдентификатор, Док.НомерГТД);
			// Доработка END

			Если ЗначениеЗаполнено(Строка.ДатаОформления) Тогда
				Док.Дата = Строка.ДатаОформления;
			ИначеЕсли НЕ ЗначениеЗаполнено(Док.Дата) Тогда
				Док.Дата = ТекущаяДатаСеанса();
			КонецЕсли;
			НоваяДД.ДатаОформления = Док.Дата;

			Док.Записать();

			Если ЭтоНовый Тогда
				СчётчикСоздано = СчётчикСоздано + 1;
			Иначе
				СчётчикОбновлено = СчётчикОбновлено + 1;
			КонецЕсли;
		Исключение
			СчётчикОшибок = СчётчикОшибок + 1;
			Сообщить("Ошибка документа [" + Строка.НомерГТД + "]: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Сообщить("Этап 1 — загрузка: создано " + СчётчикСоздано + ", обновлено " + СчётчикОбновлено + ", ошибок " + СчётчикОшибок);

	// Доработка START {Информирование о пустых расстояниях} {2026-04-10}
	Если СчётчикПустогоРасстояния > 0 Тогда
		Сообщить(
			"ВНИМАНИЕ: в " + СчётчикПустогоРасстояния + " стр. не заполнено Расстояние."
			+ " Документы созданы, но расчёт цен будет неполным."
			+ " Откройте документы и заполните поле «Расстояние» —"
			+ " значения автоматически сохранятся в регистр"
			+ " и подставятся при следующих загрузках.");
	КонецЕсли;
	// Доработка END

	// ЭТАП 2: Группировка по ТС+Контрагент+Дата
	СгруппироватьДокументы();
КонецПроцедуры

// Группировка: объединяет документы с одинаковым ТС+Контрагент+Дата в один
&НаСервере
Процедура СгруппироватьДокументы()

	ДатаНач = НачалоДня(НачальнаяДата);
	ДатаКон = КонецДня(КонечнаяДата);

	// Диагностика: сколько документов в диапазоне
	ЗапросДиаг = Новый Запрос;
	ЗапросДиаг.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Док.Ссылка) КАК Всего,
	|	СУММА(ВЫБОР КОГДА Док.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И Док.ОсновноеТС <> ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК СЗаполненнымиПолями,
	|	СУММА(ВЫБОР КОГДА Док.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезКонтрагента,
	|	СУММА(ВЫБОР КОГДА Док.ОсновноеТС = ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезТС
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ Док.ПометкаУдаления";
	ЗапросДиаг.УстановитьПараметр("ДатаНачала", ДатаНач);
	ЗапросДиаг.УстановитьПараметр("ДатаОкончания", ДатаКон);
	ТабДиаг = ЗапросДиаг.Выполнить().Выгрузить();
	Если ТабДиаг.Количество() > 0 Тогда
		Сообщить("══════════════════════════════════════════════════════");
		Сообщить("ЭТАП 2 — ДИАГНОСТИКА (" + Формат(НачальнаяДата, "ДФ=dd.MM.yyyy") + " — " + Формат(КонечнаяДата, "ДФ=dd.MM.yyyy") + "):");
		Сообщить("  Всего документов: " + ТабДиаг[0].Всего);
		Сообщить("  С заполненным ТС+Контрагент (кандидаты): " + ТабДиаг[0].СЗаполненнымиПолями);
		Сообщить("  Без контрагента: " + ТабДиаг[0].БезКонтрагента);
		Сообщить("  Без ТС: " + ТабДиаг[0].БезТС);
	КонецЕсли;

	// Найти группы документов для объединения
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.ОсновноеТС КАК ТС,
	|	Док.ОсновноеТС.Наименование КАК ТСНаим,
	|	Док.Контрагент КАК Контрагент,
	|	Док.Контрагент.Наименование КАК КонтрагентНаим,
	|	НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) КАК ДатаДень,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) КАК Кол
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ Док.ПометкаУдаления
	|	И Док.ОсновноеТС <> ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка)
	|	И Док.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	Док.ОсновноеТС,
	|	Док.ОсновноеТС.Наименование,
	|	Док.Контрагент,
	|	Док.Контрагент.Наименование,
	|	НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ)
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) > 1";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНач);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаКон);

	РезультатГрупп = Запрос.Выполнить();
	Если РезультатГрупп.Пустой() Тогда
		Сообщить("  ГРУППЫ НЕ НАЙДЕНЫ — у каждого ТС+Контрагент+Дата только 1 документ.");
		Сообщить("══════════════════════════════════════════════════════");
		Возврат;
	КонецЕсли;

	// Показать найденные группы
	ТабГрупп = РезультатГрупп.Выгрузить();
	Сообщить("  Найдено групп для объединения: " + ТабГрупп.Количество());
	Для Инд = 0 По Мин(ТабГрупп.Количество() - 1, 19) Цикл // первые 20
		Стр = ТабГрупп[Инд];
		Сообщить("    [" + (Инд+1) + "] ТС=" + Стр.ТСНаим + " | " + Стр.КонтрагентНаим + " | " + Формат(Стр.ДатаДень, "ДФ=dd.MM.yyyy") + " → " + Стр.Кол + " док.");
	КонецЦикла;
	Сообщить("══════════════════════════════════════════════════════");

	СчГрупп = 0;
	СчОбъединено = 0;
	СчПомечено = 0;

	ВыборкаГрупп = РезультатГрупп.Выбрать();
	Пока ВыборкаГрупп.Следующий() Цикл
		// Найти все документы этой группы
		ЗапросДоки = Новый Запрос;
		ЗапросДоки.Текст =
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ОперацияПоПоручительству КАК Док
		|ГДЕ
		|	Док.ОсновноеТС = &ТС
		|	И Док.Контрагент = &Контрагент
		|	И НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) = &ДатаДень
		|	И НЕ Док.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата";
		ЗапросДоки.УстановитьПараметр("ТС", ВыборкаГрупп.ТС);
		ЗапросДоки.УстановитьПараметр("Контрагент", ВыборкаГрупп.Контрагент);
		ЗапросДоки.УстановитьПараметр("ДатаДень", ВыборкаГрупп.ДатаДень);

		ТаблицаДоков = ЗапросДоки.Выполнить().Выгрузить();
		Если ТаблицаДоков.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		// Первый = мастер, остальные = доноры
		МастерДок = ТаблицаДоков[0].Ссылка.ПолучитьОбъект();
		// Доработка START {Задача 4: Сохранить КодыCMR мастера до очистки — кеш объектов 1С вернёт очищенную ТЧ} {2026-04-09}
		КодыCMRМастера = МастерДок.КодыCMR.Выгрузить();
		// Доработка END
		МастерДок.ДанныеДокументов.Очистить();
		МастерДок.КодыCMR.Очистить();

		Для Каждого СтрДок Из ТаблицаДоков Цикл
			ТекДок = СтрДок.Ссылка.ПолучитьОбъект();
			ИД = ?(ЗначениеЗаполнено(ТекДок.ВнешнийИдентификатор), ТекДок.ВнешнийИдентификатор, ТекДок.НомерГТД);

			// Добавить строку в ДанныеДокументов мастера
			НоваяДД = МастерДок.ДанныеДокументов.Добавить();
			НоваяДД.НомерГТД = ТекДок.НомерГТД;
			НоваяДД.СуммаОбеспечения = ТекДок.СуммаОбеспечения;
			НоваяДД.Валюта = ТекДок.ВалютаОбеспечения;
			НоваяДД.Расстояние = ТекДок.Расстояние;
			НоваяДД.Контрагент = ТекДок.Контрагент;
			НоваяДД.Декларант = ТекДок.Декларант;
			НоваяДД.Ответственный = ТекДок.Ответственный;
			НоваяДД.ПунктОтправления = ТекДок.ПунктОтправления;
			НоваяДД.ПунктНазначения = ТекДок.ПунктНазначения;
			НоваяДД.СтатусТранзита = ТекДок.СтатусТранзита;
			НоваяДД.ДатаОформления = ТекДок.Дата;
			// Доработка START {Копировать даты завершения и срока в ДанныеДокументов} {2026-04-07}
			НоваяДД.ДатаЗавершения = ТекДок.ДатаЗавершения;
			НоваяДД.СрокТранзита = ТекДок.СрокТранзита;
			// Доработка END
			НоваяДД.УникальныйИдентификатор = ИД;

			// Перенести КодыCMR
			// Доработка START {Задача 4: Для мастера — из сохранённой копии, иначе кеш вернёт пустую ТЧ} {2026-04-09}
			Если СтрДок.Ссылка = ТаблицаДоков[0].Ссылка Тогда
				ИсточникCMR = КодыCMRМастера;
			Иначе
				ИсточникCMR = ТекДок.КодыCMR;
			КонецЕсли;
			Для Каждого СтрCMR Из ИсточникCMR Цикл
			// Доработка END
				НовCMR = МастерДок.КодыCMR.Добавить();
				ЗаполнитьЗначенияСвойств(НовCMR, СтрCMR);
				НовCMR.УникальныйИдентификатор = ИД;
			КонецЦикла;

			// Пометить донора на удаление (кроме мастера)
			Если СтрДок.Ссылка <> ТаблицаДоков[0].Ссылка Тогда
				ТекДок.ПометкаУдаления = Истина;
				Попытка
					ТекДок.Записать();
					СчПомечено = СчПомечено + 1;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;

		// Записать мастер-документ
		Попытка
			МастерДок.Записать();
			СчГрупп = СчГрупп + 1;
			СчОбъединено = СчОбъединено + ТаблицаДоков.Количество();
		Исключение
			Сообщить("Ошибка группировки [" + ВыборкаГрупп.ТС + "]: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Сообщить("Этап 2 — группировка: " + СчОбъединено + " документов → " + СчГрупп + " групп, помечено на удаление: " + СчПомечено);
КонецПроцедуры
// Доработка END

&НаКлиенте
Процедура СоздатьДокументы(Команда)
	СоздатьДокументыНаСервере();
КонецПроцедуры

// Доработка START {Диагностика + отдельная группировка} {2026-04-05}
&НаКлиенте
Процедура ДиагностикаГруппировки(Команда)
	ДиагностикаГруппировкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДиагностикаГруппировкиНаСервере()
	ДатаНач = НачалоДня(НачальнаяДата);
	ДатаКон = КонецДня(КонечнаяДата);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Док.Ссылка) КАК Всего,
	|	СУММА(ВЫБОР КОГДА Док.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК СКонтрагентом,
	|	СУММА(ВЫБОР КОГДА Док.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезКонтрагента,
	|	СУММА(ВЫБОР КОГДА Док.ОсновноеТС = ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезТС
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ Док.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНач);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаКон);
	Таб = Запрос.Выполнить().Выгрузить();

	Сообщить("══════════ ДИАГНОСТИКА ГРУППИРОВКИ ══════════");
	Сообщить("Период: " + Формат(НачальнаяДата, "ДФ=dd.MM.yyyy") + " — " + Формат(КонечнаяДата, "ДФ=dd.MM.yyyy"));
	Если Таб.Количество() > 0 Тогда
		Сообщить("Всего документов (без удалённых): " + Таб[0].Всего);
		Сообщить("  С контрагентом: " + Таб[0].СКонтрагентом);
		Сообщить("  Без контрагента: " + Таб[0].БезКонтрагента);
		Сообщить("  Без ТС: " + Таб[0].БезТС);
	КонецЕсли;

	// Группы для объединения
	ЗапросГруппы = Новый Запрос;
	ЗапросГруппы.Текст =
	"ВЫБРАТЬ
	|	Док.ОсновноеТС.Наименование КАК ТС,
	|	Док.Контрагент.Наименование КАК Контрагент,
	|	НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) КАК Дата,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) КАК Кол
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ Док.ПометкаУдаления
	|	И Док.ОсновноеТС <> ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка)
	|	И Док.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	Док.ОсновноеТС.Наименование,
	|	Док.Контрагент.Наименование,
	|	НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ)
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) > 1
	|УПОРЯДОЧИТЬ ПО
	|	Кол УБЫВ";
	ЗапросГруппы.УстановитьПараметр("ДатаНачала", ДатаНач);
	ЗапросГруппы.УстановитьПараметр("ДатаОкончания", ДатаКон);
	ТабГрупп = ЗапросГруппы.Выполнить().Выгрузить();

	Если ТабГрупп.Количество() = 0 Тогда
		Сообщить("ГРУПП НЕ НАЙДЕНО — каждый ТС+Контрагент+Дата уникален.");
		// Показать ТОП-10 ТС (с контрагентом) чтобы понять распределение
		ЗапросТС = Новый Запрос;
		ЗапросТС.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 10
		|	Док.ОсновноеТС.Наименование КАК ТС,
		|	Док.Контрагент.Наименование КАК Контрагент,
		|	НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) КАК Дата,
		|	КОЛИЧЕСТВО(Док.Ссылка) КАК Кол
		|ИЗ
		|	Документ.ОперацияПоПоручительству КАК Док
		|ГДЕ
		|	Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И НЕ Док.ПометкаУдаления
		|	И Док.ОсновноеТС <> ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка)
		|	И Док.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|СГРУППИРОВАТЬ ПО
		|	Док.ОсновноеТС.Наименование,
		|	Док.Контрагент.Наименование,
		|	НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ)
		|УПОРЯДОЧИТЬ ПО
		|	ТС";
		ЗапросТС.УстановитьПараметр("ДатаНачала", ДатаНач);
		ЗапросТС.УстановитьПараметр("ДатаОкончания", ДатаКон);
		ТабТС = ЗапросТС.Выполнить().Выгрузить();
		Сообщить("Примеры одиночных (ТС+Контрагент+Дата = 1 док):");
		Для Каждого Стр Из ТабТС Цикл
			Сообщить("  ТС=" + Стр.ТС + " | " + Стр.Контрагент + " | " + Формат(Стр.Дата, "ДФ=dd.MM.yyyy") + " → " + Стр.Кол);
		КонецЦикла;
	Иначе
		ИтогоДоков = 0;
		Сообщить("НАЙДЕНО ГРУПП: " + ТабГрупп.Количество());
		Для Каждого Стр Из ТабГрупп Цикл
			Сообщить("  ТС=" + Стр.ТС + " | " + Стр.Контрагент + " | " + Формат(Стр.Дата, "ДФ=dd.MM.yyyy") + " → " + Стр.Кол + " док.");
			ИтогоДоков = ИтогоДоков + Стр.Кол;
		КонецЦикла;
		Сообщить("ИТОГО: " + ИтогоДоков + " документов → " + ТабГрупп.Количество() + " групп");
	КонецЕсли;
	Сообщить("══════════════════════════════════════════════");
КонецПроцедуры

&НаКлиенте
Процедура Сгруппировать(Команда)
	СгруппироватьДокументы();
КонецПроцедуры
// Доработка END

// Доработка START {Удаление документов за период — непосредственное} {2026-04-02}
&НаКлиенте
Процедура УдалитьДокументыЗаПериод(Команда)
	Ответ = Вопрос("УДАЛИТЬ БЕЗВОЗВРАТНО все документы ""Операция по поручительству"" за "
		+ Формат(НачальнаяДата, "ДФ=dd.MM.yyyy") + " - " + Формат(КонечнаяДата, "ДФ=dd.MM.yyyy") + "?",
		РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УдалитьДокументыЗаПериодНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьДокументыЗаПериодНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	Документ.ОперацияПоПоручительству КАК Д
	|ГДЕ
	|	Д.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(НачальнаяДата));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(КонечнаяДата));

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Удалено = 0;
	Ошибок = 0;
	Пока Выборка.Следующий() Цикл
		Попытка
