// Доработка START {П-08 Ручной ввод расстояния → автосохранение маршрута в РС} {2026-04-10}
// Когда пользователь вручную правит Расстояние и указаны оба пункта — пишем маршрут
// в регистр РасстоянияМеждуТаможеннымиПунктами, чтобы при следующей загрузке
// API с Расстояние=0 fallback подставил уже известное значение автоматически.
&НаКлиенте
Процедура ДекларацияРасстояниеПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Декларация.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущаяСтрока.Расстояние > 0
		И ЗначениеЗаполнено(ТекущаяСтрока.ПунктОтправления)
		И ЗначениеЗаполнено(ТекущаяСтрока.ПунктНазначения) Тогда
		СохранитьРасстояниеВРегистрНаСервере(
			ТекущаяСтрока.ПунктОтправления,
			ТекущаяСтрока.ПунктНазначения,
			ТекущаяСтрока.Расстояние);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьРасстояниеВРегистрНаСервере(ПунктОтправления, ПунктНазначения, Расстояние)
	НаборЗаписей = РегистрыСведений.РасстоянияМеждуТаможеннымиПунктами.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПунктОтправления.Установить(ПунктОтправления);
	НаборЗаписей.Отбор.ПунктНазначения.Установить(ПунктНазначения);
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.ПунктОтправления = ПунктОтправления;
	НоваяЗапись.ПунктНазначения = ПунктНазначения;
	НоваяЗапись.Расстояние = Расстояние;
	НоваяЗапись.ДатаЗаписи = ТекущаяДатаСеанса();
	Попытка
		НоваяЗапись.Ответсвенный = Пользователи.ТекущийПользователь();
	Исключение
		ЗаписьЖурналаРегистрации(
			"АПИСигма.СохранениеМаршрута",
			УровеньЖурналаРегистрации.Информация,,,
			"Реквизит Ответственный не заполнен: " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		НаборЗаписей.Записать();
		ЗаписьЖурналаРегистрации(
			"АПИСигма.СохранениеМаршрута",
			УровеньЖурналаРегистрации.Информация,,,
			"Сохранён маршрут " + ПунктОтправления + " → " + ПунктНазначения + " = " + Расстояние + " км");
	Исключение
		ЗаписьЖурналаРегистрации(
			"АПИСигма.СохранениеМаршрута",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка сохранения маршрута: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
// Доработка END

&НаКлиенте
Процедура ОтправитьЗапрос(Команда)
	// Доработка START {Фикс дубликатов при повторной загрузке} {2026-04-10}
	Объект.Декларация.Очистить();
	// Доработка END
	АутентификацияЭДСигма(Объект.КодДоступа);
	ПолучитьОтчетПоДополнениям();
КонецПроцедуры

&НаСервере
Функция СчитываниеФайлов()
	
	ИмяКаталога = "\\is-srv1c-02\share\ким\РусскийТранзит Дубликатор";
	
	Маска = "*.xml"; // Только файлы с расширением xml
	МассивФайлов = НайтиФайлы(ИмяКаталога, Маска, Истина);
	Счетчик = 0;
	Если МассивФайлов.Количество() > 0 Тогда          
		Для Каждого ЭлементФайл Из МассивФайлов Цикл             
			Если Счетчик < 100 Тогда 
				ЗаполнитьИзXML(ЭлементФайл.ПолноеИмя);
				Счетчик = Счетчик+1;
			Иначе
				Прервать;
			КонецЕсли;	
		КонецЦикла;               
	Иначе
