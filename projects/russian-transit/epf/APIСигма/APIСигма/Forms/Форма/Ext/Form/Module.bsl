#Область Вспомогательное
Функция Редактировать(Строка)
	Если Лев(Строка,1) = Символ(34) Тогда
		Строка = Прав(Строка,СтрДлина(Строка)-1);
	КонецЕсли;
	Если Прав(Строка,1) = Символ(34) Тогда
		Строка = Лев(Строка,СтрДлина(Строка)-1);
	КонецЕсли;	
	Возврат Строка
КонецФункции

// Доработка START {Дата с временем: "16.03.2026 0:50:50" → Дата} {2026-04-02}
Функция ПреобразоватьДату(Строка)
	Попытка
		Если НЕ ЗначениеЗаполнено(СокрЛП(Строка)) Тогда
			Возврат '00010101';
		КонецЕсли;

		// Отсекаем время если есть: "16.03.2026 0:50:50" → "16.03.2026"
		ЧастиДатыВремя = СтрРазделить(СокрЛП(Строка), " ");
		ДатаСтр = ЧастиДатыВремя[0];

		Массив = СтрРазделить(ДатаСтр, ".");
		Если Массив.Количество() >= 3 Тогда
			Возврат Дата(Массив[2] + Массив[1] + Массив[0]);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат '00010101';
КонецФункции
