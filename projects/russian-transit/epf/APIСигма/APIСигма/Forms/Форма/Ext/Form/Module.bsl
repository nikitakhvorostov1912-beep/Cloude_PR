&НаСервереБезКонтекста
Функция ЗаполнитьПодразделенияНаСервере()

	// Список подразделений из docx "Расчёты и учёт клиентов"
	// Ключ = uso_name (как предположительно в API), Значение = часть наименования контрагента
	Подразделения = Новый Соответствие;
	Подразделения.Вставить("Трейд Солюшнс", "Трейд Солюшнс");
	Подразделения.Вставить("БТБ39", "БТБ39");
	Подразделения.Вставить("ВЛАДОЛИ", "ВЛАДОЛИ");
	Подразделения.Вставить("Партнер Востока", "Партнер Востока");
	Подразделения.Вставить("Алеста-Транзит", "Алеста");
	Подразделения.Вставить("Транзитный Оператор", "Транзитный Оператор");
	Подразделения.Вставить("ЕТБ-Бел", "ЕТБ");
	Подразделения.Вставить("Арнейс", "Арнейс");
	Подразделения.Вставить("СПЕГАТ", "СПЕГАТ");
	Подразделения.Вставить("ТАРГА", "ТАРГА");
	Подразделения.Вставить("ВЭД ЮГ", "ВЭД ЮГ");
	Подразделения.Вставить("Арнейс логистик", "Арнейс");
	Подразделения.Вставить("Рене-Логистика", "Рене");
	Подразделения.Вставить("FGL", "FGL");
	Подразделения.Вставить("Интерлайн", "Интерлайн");

	Добавлено = 0;
	НеНайдено = 0;
	Пропущено = 0;
	ОшибкиТекст = "";

	Для Каждого Элемент Из Подразделения Цикл
		ИмяПодразделения = Элемент.Ключ;
		ПоискКонтрагента = Элемент.Значение;

		// Проверяем — уже есть в регистре?
		СтруктураОтбора = Новый Структура("ПодразделениеСигма", ИмяПодразделения);
		Существующие = РегистрыСведений.СоответствияПодразделенийКонтрагентам.Получить(СтруктураОтбора);
		Если ЗначениеЗаполнено(Существующие.Контрагент) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		// Ищем контрагента по наименованию
		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ПоискКонтрагента, Истина);
		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
			// Попробуем частичный поиск
			Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ПоискКонтрагента);
		КонецЕсли;

		Если ЗначениеЗаполнено(Контрагент) Тогда
			МенеджерЗаписи = РегистрыСведений.СоответствияПодразделенийКонтрагентам.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ПодразделениеСигма = ИмяПодразделения;
			МенеджерЗаписи.Контрагент = Контрагент;
			МенеджерЗаписи.Записать();
			Добавлено = Добавлено + 1;
		Иначе
			НеНайдено = НеНайдено + 1;
			ОшибкиТекст = ОшибкиТекст + "
			|" + ИмяПодразделения + " → контрагент """ + ПоискКонтрагента + """ не найден";
		КонецЕсли;
	КонецЦикла;

	Результат = "Подразделения: добавлено " + Добавлено
		+ ", пропущено (уже есть) " + Пропущено
		+ ", не найден контрагент " + НеНайдено;

	Если ЗначениеЗаполнено(ОшибкиТекст) Тогда
		Результат = Результат + "
		|Не найдены:" + ОшибкиТекст
		+ "
		|Добавьте этих контрагентов в 1С или скорректируйте имена в регистре вручную.";
	КонецЕсли;

	Возврат Результат;

КонецФункции
// Доработка END

#КонецОбласти

#Область ПарсингСтраницыТаможни
//Функция получает страницу и ищет в ней элементы связанные с таможенным пунктом которого нет в ИС
Функция СпарситьСтраницу(Код, Наименование)
	ssl = Новый ЗащищенноеСоединениеOpenSSL();                      
	URL = "registers/customs-apparatus?";
	ПараметрыЗапроса  = "code=" + Код +"&name=&city=";
	URL =URL + ПараметрыЗапроса;
	Сервис = Новый HTTPСоединение("customs.gov.ru",,,, ,, ssl);
	Если Сервис <> Неопределено Тогда
		Запрос = Новый HTTPЗапрос(URL);
		Результат = Сервис.Получить(Запрос);
		Сервис 	  = Неопределено;		
		Если Результат.КодСостояния = 200 Тогда
			Страница = Результат.ПолучитьТелоКакСтроку("UTF-8");
			Див = "<div class="+Символ(34) + "info-card__title" +Символ(34) +">";
			ДивИтем = СтрЗаменить(Див,"info-card__title","info-card__item-info");
			СтруктураТП = Новый Структура("КодПункта, Код, Наименование, Город, Индекс, Адрес, Телефон");
			НовыйТП = Справочники.ТаможенныеПункты.СоздатьЭлемент();
			Попытка
				СтруктураТП.Наименование = ПоискБлока(Страница, Див);
				СтруктураТП.Город = ПоискБлока(Страница, ДивИтем,"Город");
				СтруктураТП.Код =  ПоискБлока(Страница, ДивИтем,"Код таможенноо органа");
				СтруктураТП.КодПункта = СтруктураТП.Код; 
				СтруктураТП.Адрес = ПоискБлока(Страница, ДивИтем,"Адрес таможенного органа");
				СтруктураТП.Телефон = ПоискБлока(Страница, ДивИтем,"Телефон");
				СтруктураТП.Индекс =  ПоискБлока(Страница, ДивИтем,"Почтовый индекс");
				ЗаполнитьЗначенияСвойств(НовыйТП,СтруктураТП);	
			Исключение
				НовыйТП.Наименование = Наименование;
				НовыйТП.Код = Код;
			КонецПопытки;
			
			Попытка
				НовыйТП.Записать();
				Возврат НовыйТП.Ссылка;
			Исключение
				Сообщить("Не удалось записать новый таможенный пункт: " + СтруктураТП.Наименование);
			КонецПопытки;	
			//НовыйТП.Наименование = Наименование;
			//НовыйТП.Код = Код;
			//НовыйТП.КодПункта = Код;
			//НовыйТП.Адрес = Адрес;
			
		Иначе
			ТекстОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		КонецЕсли;	
	КонецЕсли;	
КонецФункции

Функция ПоискБлока(ДанныеПоиска, Блок, ВоспомогательнаяСтрока = "")
	Если ВоспомогательнаяСтрока = "" Тогда
		ПозицияНачала = СтрНайти(ДанныеПоиска,Блок);
	Иначе
		ПозицияНачала = СтрНайти(ДанныеПоиска,Блок,,СтрНайти(ДанныеПоиска,ВоспомогательнаяСтрока));
	КонецЕсли;
	ПозицияКонца=  СтрНайти(ДанныеПоиска,"</div>",,ПозицияНачала);
	Наименование = Сред(ДанныеПоиска, ПозицияНачала, ПозицияКонца - ПозицияНачала);
	Наименование = СокрЛП(СтрЗаменить(Наименование,Блок,""));
	Возврат Наименование;
КонецФункции
