// Доработка START {CRITICAL #6: Расширено хранилище настроек — все credentials через ХранилищеОбщихНастроек} {2026-04-09}
&НаСервере
Процедура СохранитьНастройкиНаСервере()
	// Читаем текущее хранилище чтобы сохранить ранее записанный КодУчастника
	ТекущиеНастройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиВыгрузки",,,,"Интерсофт");
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("Токен", Токен);
	ПараметрыЗакрытия.Вставить("Логин", Логин);
	ПараметрыЗакрытия.Вставить("Пароль", Пароль);
	ПараметрыЗакрытия.Вставить("КодДоступа", Объект.КодДоступа);
	// Доработка START {SS-3 2026-04-20}: сохраняем существующий КодУчастника, если был задан ранее
	Если ТекущиеНастройки <> Неопределено И ТипЗнч(ТекущиеНастройки) = Тип("Структура")
		И ТекущиеНастройки.Свойство("КодУчастника") Тогда
		ПараметрыЗакрытия.Вставить("КодУчастника", ТекущиеНастройки.КодУчастника);
	КонецЕсли;
	// Доработка END
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("НастройкиВыгрузки", , ПараметрыЗакрытия,,"Интерсофт");
КонецПроцедуры

&НаСервере
Функция ЗагрузитьНастройки()
	Попытка
		СтруктураНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиВыгрузки",,,,"Интерсофт");
		Если СтруктураНастроек <> Неопределено Тогда
			Если СтруктураНастроек.Свойство("Токен") Тогда
				Токен = СтруктураНастроек.Токен;
			КонецЕсли;
			Если СтруктураНастроек.Свойство("Логин") Тогда
				Логин = СтруктураНастроек.Логин;
			КонецЕсли;
			Если СтруктураНастроек.Свойство("Пароль") Тогда
				Пароль = СтруктураНастроек.Пароль;
			КонецЕсли;
			Если СтруктураНастроек.Свойство("КодДоступа") Тогда
				Объект.КодДоступа = СтруктураНастроек.КодДоступа;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("APIСигма.ЗагрузкаНастроек",
			УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
	КонецПопытки;

КонецФункции

// Доработка START {SS-3 2026-04-20}: единая точка получения participantcode —
// при первом запуске сохраняет дефолтное значение в ХранилищеОбщихНастроек,
// далее возвращает сохранённое. Устраняет хардкод в теле ПолучитьОтчетПоДополнениям.
&НаСервере
Функция ПолучитьКодУчастника()
	КодПоУмолчанию = "102773905066681";
	Попытка
		Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиВыгрузки",,,,"Интерсофт");
		Если Настройки <> Неопределено И ТипЗнч(Настройки) = Тип("Структура")
			И Настройки.Свойство("КодУчастника") И ЗначениеЗаполнено(Настройки.КодУчастника) Тогда
			Возврат Настройки.КодУчастника;
		КонецЕсли;

		// Первый запуск — сохраняем дефолт как стартовое значение
		НовыеНастройки = ?(Настройки <> Неопределено И ТипЗнч(Настройки) = Тип("Структура"),
			Настройки, Новый Структура);
		НовыеНастройки.Вставить("КодУчастника", КодПоУмолчанию);
		ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить(
			"НастройкиВыгрузки", , НовыеНастройки, , "Интерсофт");
	Исключение
		ЗаписьЖурналаРегистрации("APIСигма.ЧтениеКодаУчастника",
			УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
	КонецПопытки;
	Возврат КодПоУмолчанию;
КонецФункции
// Доработка END


Функция ЗаполнитьИзXML(ФайлОбработки) Экспорт
	//Если такой файл уже прочитан то он пропускается
	//Если ПроверитьФайл(ФайлОбработки) Тогда
	//	Возврат "";
	//КонецЕсли; /api/v1/agreem/epdocuments
	
	
	НовыйФайл = Новый ЧтениеТекста(ФайлОбработки, КодировкаТекста.UTF8);
	СтрокаXML = НовыйФайл.Прочитать();
	НовыйФайл.Закрыть();
	
	// Удаляем префиксы
	СтрокаXML = СтрЗаменить(СтрокаXML, "cat_ru:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "tci:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "/tci:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "/cat_ru:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "app:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "/app:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "RUScat_ru:", ""); 
	СтрокаXML = СтрЗаменить(СтрокаXML, "catESAD_cu:", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "RUDECLcat:", "");
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	
	Считанное = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	СериализованныйДокумент = ОбъектXDTOВСтруктуру(Считанное);
	
	Если СериализованныйДокумент.Body.Signature.Object.Свойство("TransitInfo") Тогда
		
		
		TransitInfo = СериализованныйДокумент.Body.Signature.Object.TransitInfo;
		//Header = TransitInfo.Header;
		//Consigment = TransitInfo.Consigment;
		
		// 4. Проверка на дубль по DocumentID
		DocumentID = TransitInfo.DocumentID;
		//Запрос = Новый Запрос;
		//Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Декларация.Ссылка
		//               |ИЗ Обработка.Декларация КАК Декларация
		//               |ГДЕ Декларация.DocumentID = &DocumentID";
		//Запрос.УстановитьПараметр("DocumentID", DocumentID);
		//Результат = Запрос.Выполнить().Выгрузить();
		//Если Результат.Количество() > 0 Тогда
		//    // Документ уже существует, пропускаем или обновляем
		//    Возврат Неопределено; // или можно обновить существующую строку
		//КонецЕсли;
		
		// 5. Создание строки в основной ТЧ
		НоваяСтрокаТЧ = Объект.Декларация.Добавить();
		
		// --- Заполнение основных реквизитов ---
		НоваяСтрокаТЧ.DocumentID = DocumentID;
		НоваяСтрокаТЧ.Комментарий = СериализованныйДокумент.Header.EDHeader.ParticipantID;
		
	КонецЕсли;		
КонецФункции

Функция ОбъектXDTOВСтруктуру(ОбъектXDTO, ПараметрыПреобразования = Неопределено) Экспорт
	
	Структура      = Новый Структура;
	ТипОбъектаXDTO = ОбъектXDTO.Тип();
	
	Для Каждого Свойство Из ОбъектXDTO.Свойства() Цикл
		
		ИмяСвойства      = Свойство.Имя;
		ЗначениеСвойства = ОбъектXDTO[ИмяСвойства];
		
		Если ТипЗнч(ЗначениеСвойства) = Тип("ОбъектXDTO") Тогда
			
			Структура.Вставить(ИмяСвойства, ОбъектXDTOВСтруктуру(ЗначениеСвойства, ПараметрыПреобразования));
			
		ИначеЕсли ТипЗнч(ЗначениеСвойства) = Тип("СписокXDTO") Тогда
			
			Структура.Вставить(ИмяСвойства, Новый Массив);
			Для Индекс = 0 По ЗначениеСвойства.Количество() - 1 Цикл
				
				ЭлементСписка = ЗначениеСвойства.Получить(Индекс);
				Если ТипЗнч(ЭлементСписка) = Тип("ОбъектXDTO") Тогда
					Структура[ИмяСвойства].Добавить(ОбъектXDTOВСтруктуру(ЭлементСписка, ПараметрыПреобразования));
				Иначе
					Структура[ИмяСвойства].Добавить(ЭлементСписка);
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Структура.Вставить(ИмяСвойства, ЗначениеСвойства);
			
			Если ПараметрыПреобразования <> Неопределено
				И ПараметрыПреобразования.НайтиИдентификаторы
				И Свойство.Тип = ПараметрыПреобразования.ТипUUID Тогда
				
				РезультатПоиска = ПараметрыПреобразования.ТипыИдентификаторов[ТипОбъектаXDTO];
				Если РезультатПоиска <> Неопределено
					И РезультатПоиска.ИмяПоля = ИмяСвойства Тогда
					ПараметрыПреобразования.Идентификаторы[РезультатПоиска.ИмяТаблицы].Вставить(ЗначениеСвойства, РезультатПоиска.ПустоеЗначение);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции


// Доработка START {Content-Type: text/plain, токен без JSONВЗначение} {2026-04-02}
Функция АутентификацияЭДСигма(КодДоступа)

	URL = "edapi.sigma-soft.ru";
	ПутьКМетоду = "/api/v1/auth/login";

	Попытка
		Прокси = Новый ИнтернетПрокси(Ложь); // не использовать системный прокси
		HTTPСоед = Новый HTTPСоединение(URL, 443,,,Прокси, 30, Новый ЗащищенноеСоединениеOpenSSL);

		HTTPЗапрос = Новый HTTPЗапрос(ПутьКМетоду);
		HTTPЗапрос.УстановитьТелоИзСтроки(КодДоступа, КодировкаТекста.UTF8);
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "text/plain");

		Ответ = HTTPСоед.ВызватьHTTPМетод("POST", HTTPЗапрос);

		Если Ответ.КодСостояния = 200 Тогда
			// JWT-токен — plain string, НЕ JSON
			Токен = СокрЛП(Ответ.ПолучитьТелоКакСтроку());
			СохранитьНастройкиНаСервере();
		Иначе
			Сообщить("Ошибка авторизации (" + Ответ.КодСостояния + "): " + Ответ.ПолучитьТелоКакСтроку());
		КонецЕсли;
	Исключение
		Сообщить("Исключение авторизации: " + ОписаниеОшибки());
	КонецПопытки;

КонецФункции
// Доработка END

Функция ПолучитьДанные()
	
	Для Каждого Строка Из Объект.Декларация Цикл
		URL = "edapi.sigma-soft.ru";
		Путь = "api/v1/agreem/getdocbody";
		
		// Формируем строку запроса с параметрами
		ПараметрыЗапроса = "?envelopeguid=" + Строка.DocumentID
		+ "&Kind=1"
		+ "&participantcode="+ Строка.Комментарий;
		
		ПолныйПуть = Путь + ПараметрыЗапроса;
		
		Прокси = Новый ИнтернетПрокси(Ложь);
		HTTPСоед = Новый HTTPСоединение(URL, 443,,,Прокси, 30, Новый ЗащищенноеСоединениеOpenSSL);

		HTTPЗапрос = Новый HTTPЗапрос(ПолныйПуть);
		HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
		
		Ответ = HTTPСоед.Получить(HTTPЗапрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			// Ответ — это не JSON, а двоичные данные (XML или HTML)
			// Поэтому не нужно вызывать JSONВЗначение
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
			Возврат ТелоОтвета;
			
		ИначеЕсли Ответ.КодСостояния = 401 Тогда
			// Повторная аутентификация
			РезАутент = АутентификацияЭДСигма(Объект.КодДоступа);
			Если РезАутент.Успешно Тогда
				Токен = РезАутент.Токен;
				// Возможно, стоит повторить запрос, но для простоты — выходим
			КонецЕсли;
			Сообщить("Ошибка авторизации при получении тела документа");
			Возврат Неопределено;
			
		Иначе
			Сообщить("Ошибка получения тела документа. Код: " + Ответ.КодСостояния + ". Тело: " + Ответ.ПолучитьТелоКакСтроку());
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецФункции	

// Доработка START {Пагинация + убрать participantcode из body} {2026-04-02}
// Доработка START {SS-3 2026-04-20}: participantcode берётся из ХранилищеОбщихНастроек.
// Первый запуск записывает значение по умолчанию (102773905066681) и сохраняет — дальше
// работает по данным из хранилища, ротация через меняем значение в настройках.
Функция ПолучитьОтчетПоДополнениям()

	participantcode = ПолучитьКодУчастника();
	URL = "edapi.sigma-soft.ru";
	Путь = "/api/v1/report/getreportggi?participantcode=" + participantcode;
	РазмерСтраницы = 200;
	НомерСтраницы = 1;
	ВсегоЗагружено = 0;
	БылаПовторнаяАвторизация = Ложь; // Аудит 2026-04-04: защита от бесконечного цикла

	Пока Истина Цикл
		// Body — только даты и параметры (participantcode в URL!)
		// Доработка START {API фильтрует по BDT_DATECRT, расширяем назад чтобы захватить по TRANSITOPENDATE} {2026-04-10}
		ДатаНачалаAPI = НачальнаяДата - 14 * 86400; // -14 дней (макс. разрыв создание→выпуск = 10 дней)
		// Доработка END
		ТелоЗапроса = Новый Структура;
		ТелоЗапроса.Вставить("datebegin", Формат(ДатаНачалаAPI, "ДФ=yyyy-MM-dd"));
		ТелоЗапроса.Вставить("dateend", Формат(КонечнаяДата, "ДФ=yyyy-MM-dd"));
		ТелоЗапроса.Вставить("withgoods", 1);
		ТелоЗапроса.Вставить("pagenum", НомерСтраницы);
		ТелоЗапроса.Вставить("quantity", РазмерСтраницы);

		Попытка
			Прокси = Новый ИнтернетПрокси(Ложь);
			HTTPСоед = Новый HTTPСоединение(URL, 443,,,Прокси, 60, Новый ЗащищенноеСоединениеOpenSSL);
			HTTPЗапрос = Новый HTTPЗапрос(Путь);
			HTTPЗапрос.УстановитьТелоИзСтроки(ЗначениеВJSON(ТелоЗапроса));
			HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
			HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
			Ответ = HTTPСоед.ВызватьHTTPМетод("POST", HTTPЗапрос);

			Если Ответ.КодСостояния = 200 Тогда
				ОтветJSON = JSONВЗначение(Ответ.ПолучитьТелоКакСтроку());

				Если ОтветJSON["resCode"] = 0 Тогда
					Данные = ОтветJSON["resData"];

					// Пустой ответ = все страницы загружены
					Если НЕ ЗначениеЗаполнено(Данные) Тогда
						Прервать;
					КонецЕсли;

					Попытка
						ДоЗагрузки = Объект.Декларация.Количество();
						// Передаём CSV-строку напрямую (без записи в файл)
						ЗаполнитьТабличнуюЧастьИзCSV(Данные);
						ПослеЗагрузки = Объект.Декларация.Количество();
						Сообщить("Стр." + НомерСтраницы + ": +" + (ПослеЗагрузки - ДоЗагрузки) + " операций (всего " + ПослеЗагрузки + ")");
					Исключение
						Сообщить("Ошибка стр." + НомерСтраницы + ": " + ОписаниеОшибки());
					КонецПопытки;

					// Считаем загруженные операции
					ВсегоЗагружено = Объект.Декларация.Количество();
					// НЕ прерываем по количеству — API может вернуть 199 вместо 200
					// Прерываем только когда API вернёт пустой resData (выше по коду)
				Иначе
					Сообщить("API ошибка: " + ОтветJSON["resDescription"]);
					Прервать;
				КонецЕсли;

			// Доработка START {Аудит 2026-04-04: защита от бесконечного цикла при 401}
			ИначеЕсли Ответ.КодСостояния = 401 И НомерСтраницы = 1 И НЕ БылаПовторнаяАвторизация Тогда
				АутентификацияЭДСигма(Объект.КодДоступа);
				БылаПовторнаяАвторизация = Истина;
				Продолжить; // повторить эту же страницу
			// Доработка END
			Иначе
				Сообщить("HTTP ошибка: " + Ответ.КодСостояния);
				Прервать;
			КонецЕсли;
		Исключение
			Сообщить("Исключение на стр." + НомерСтраницы + ": " + ОписаниеОшибки());
			Прервать;
		КонецПопытки;

		НомерСтраницы = НомерСтраницы + 1;
	КонецЦикла;

	Сообщить("Загружено " + ВсегоЗагружено + " операций за " + (НомерСтраницы) + " стр.");

КонецФункции
// Доработка END

// Доработка START {Парсинг CSV из строки без файла — убирает проблему \r\r\n} {2026-04-02}
Функция ЗаполнитьТабличнуюЧастьИзCSV(ДанныеCSV)
	НомерСтрокиДекларации = 0;
	CMR = Неопределено;
	МассивСтатусов = Новый Массив;
	СчётчикОшибокПарсинга = 0;
	СчётчикКороткихСтрок = 0;

	// Нормализуем переносы строк: \r\n → \n, затем \r → \n
	Текст = СтрЗаменить(ДанныеCSV, Символ(13) + Символ(10), Символ(10));
	Текст = СтрЗаменить(Текст, Символ(13), Символ(10));

	// Разбиваем на строки по \n
	МассивСтрок = СтрРазделить(Текст, Символ(10));

	// Склейка многострочных CSV-полей (переносы внутри кавычек)
	МассивПолныхСтрок = Новый Массив;
	ТекущаяСтрока = "";

	// Пропускаем заголовок (строка 0) — он уже разобран выше
	Для Инд = 1 По МассивСтрок.ВГраница() Цикл
		Стр = МассивСтрок[Инд];
		Если НЕ ЗначениеЗаполнено(СокрЛП(Стр)) Тогда
			Продолжить; // пустые строки пропускаем
		КонецЕсли;
		Если ТекущаяСтрока = "" Тогда
			ТекущаяСтрока = Стр;
		Иначе
			ТекущаяСтрока = ТекущаяСтрока + " " + Стр;
		КонецЕсли;

		КоличествоКавычек = 0;
		Для Сч = 1 По СтрДлина(ТекущаяСтрока) Цикл
			Если Сред(ТекущаяСтрока, Сч, 1) = Символ(34) Тогда
				КоличествоКавычек = КоличествоКавычек + 1;
			КонецЕсли;
		КонецЦикла;

		Если КоличествоКавычек % 2 = 0 Тогда
			МассивПолныхСтрок.Добавить(ТекущаяСтрока);
			ТекущаяСтрока = "";
		КонецЕсли;
	КонецЦикла;

	Если ТекущаяСтрока <> "" Тогда
		МассивПолныхСтрок.Добавить(ТекущаяСтрока);
	КонецЕсли;
	// Доработка END

	Для СчСтрок = 0 По МассивПолныхСтрок.ВГраница() Цикл
		Попытка
		СтрокаДанных = МассивПолныхСтрок[СчСтрок];
		// Доработка START {CSV-парсер с учётом ";" внутри кавычек} {2026-04-02}
		// СтрРазделить не учитывает кавычки → индексы сдвигаются если поле содержит ";"
		СтрокаДанныхМассив = РазобратьCSVСтроку(СтрокаДанных);
		// Доработка END	
		
		Если СтрокаДанныхМассив.Количество() > 98 Тогда
			// [98] = GOODSNUMERIC: "1" = первый товар операции → создать документ
			// Пустой GOODSNUMERIC = операция без товарной части → тоже создать документ
			// Иначе → строка ТНВЭД (код товара)
			ЗначениеGOODS = Редактировать(СтрокаДанныхМассив[98]);
			Если ЗначениеGOODS = "1"
				ИЛИ (ЗначениеGOODS = "" И Число(Редактировать(СтрокаДанныхМассив[0])) > 0) Тогда

				// Доработка START {Пост-фильтр по дате выпуска TRANSITOPENDATE [60]} {2026-04-10}
				// API фильтрует по BDT_DATECRT, отсекаем строки вне диапазона пользователя по дате выпуска
				Попытка
					ДатаВыпускаФильтр = ПреобразоватьДату(Редактировать(СтрокаДанныхМассив[60]));
				Исключение
					ДатаВыпускаФильтр = '00010101';
				КонецПопытки;
				Если НЕ ЗначениеЗаполнено(ДатаВыпускаФильтр) ИЛИ ДатаВыпускаФильтр = '00010101'
					ИЛИ ДатаВыпускаФильтр < НачалоДня(НачальнаяДата)
					ИЛИ ДатаВыпускаФильтр > КонецДня(КонечнаяДата) Тогда
					Продолжить;
				КонецЕсли;
				// Доработка END

				НоваяСтрока = Объект.Декларация.Добавить();
				НоваяСтрока.СуммаОбеспечения = Число(Редактировать(СтрокаДанныхМассив[0]));
				НоваяСтрока.ВалютаОбеспечения = Справочники.Валюты.НайтиПоНаименованию(Редактировать(СтрокаДанныхМассив[1]));
				
				НоваяСтрока.Принципал = Справочники.Принципалы.НайтиПоНаименованию(Редактировать(СтрокаДанныхМассив[4]));
				Если Не ЗначениеЗаполнено(НоваяСтрока.Принципал) Тогда
					НоваяСтрока.Принципал = СоздатьПринципала(Редактировать(СтрокаДанныхМассив[4]));
				КонецЕсли;	
				НоваяСтрока.Декларант = ?(Справочники.Контрагенты.НайтиПоНаименованию(Редактировать(СтрокаДанныхМассив[14])) = 
				Справочники.Контрагенты.ПустаяСсылка(), 
				Справочники.Декларанты.НайтиПоНаименованию(Редактировать(СтрокаДанныхМассив[14])),
				Справочники.Контрагенты.НайтиПоНаименованию(Редактировать(СтрокаДанныхМассив[14])));
				
				Если не ЗначениеЗаполнено(НоваяСтрока.Декларант) И Отладка Тогда
					НоваяСтрока.Декларант = СоздатьДекларанта(Редактировать(СтрокаДанныхМассив[14]));
					//ВернутьКонтрагента(Редактировать(СтрокаДанныхМассив[15]),Редактировать(СтрокаДанныхМассив[16]),Редактировать(СтрокаДанныхМассив[14]));	
				КонецЕсли;
				НоваяСтрока.Перевозчик = Справочники.Перевозчики.НайтиПоНаименованию(Редактировать(СтрокаДанныхМассив[18]));
				Если не ЗначениеЗаполнено(НоваяСтрока.Перевозчик) И Отладка Тогда
					НоваяСтрока.Перевозчик = СоздатьПеревозчика(Редактировать(СтрокаДанныхМассив[18]));
				КонецЕсли;
				
				
				НоваяСтрока.Организация = Справочники.Организации.ПолучитьОрганизациюПоУмолчанию();
				МассивТС = СтрРазделить(Редактировать(СтрокаДанныхМассив[22]),"/");
				// Доработка START {П-06: нормализация кода ТС — справочник хранит без пробелов} {2026-04-10}
				// Почему: в Справочник.ТранспортныеСредства код (ГосНомер) хранится без пробелов
				// ("BMWX7M60I", "К738РК125"), а API отдаёт с пробелами ("BMW X7 M60I").
				// Без нормализации НайтиПоКоду возвращал пусто → создание дубля → ошибка уникальности
				// в Записать() → Попытка глушила исключение → ОсновноеТС оставалось пустым.
				КодОсновногоТС = СтрЗаменить(СокрЛП(Редактировать(МассивТС[0])), " ", "");
				НоваяСтрока.ОсновноеТС = Справочники.ТранспортныеСредства.НайтиПоКоду(КодОсновногоТС);
				Если МассивТС.Количество() > 1 Тогда
					КодДопТС = СтрЗаменить(СокрЛП(Редактировать(МассивТС[1])), " ", "");
					НоваяСтрока.ДополнительноеТС = Справочники.ТранспортныеСредства.НайтиПоКоду(КодДопТС);
					Если Не ЗначениеЗаполнено(НоваяСтрока.ДополнительноеТС) И НЕ ПустаяСтрока(КодДопТС) Тогда
						ТранспортДоп = Справочники.ТранспортныеСредства.СоздатьЭлемент();
						ТранспортДоп.Код = КодДопТС;
						ТранспортДоп.Наименование = Редактировать(МассивТС[1]); // читаемое наим — с пробелами
						Попытка
							ТранспортДоп.Записать();
							НоваяСтрока.ДополнительноеТС = ТранспортДоп.Ссылка;
						Исключение
							// дубль по ГосНомеру или другая ошибка — не блокируем загрузку
						КонецПопытки;
					КонецЕсли;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(НоваяСтрока.ОсновноеТС) И НЕ ПустаяСтрока(КодОсновногоТС) Тогда
					Транспорт = Справочники.ТранспортныеСредства.СоздатьЭлемент();
					Транспорт.Код = КодОсновногоТС;                              // без пробелов (консистентно с базой)
					Транспорт.Наименование = Редактировать(МассивТС[0]);         // читаемое наим — с пробелами
					Попытка
						Транспорт.Записать();
						НоваяСтрока.ОсновноеТС = Транспорт.Ссылка;
					Исключение
						// дубль по ГосНомеру или другая ошибка — не блокируем загрузку
					КонецПопытки;
				КонецЕсли;
				// Доработка END
				НоваяСтрока.ТранспортныеСредства = Редактировать(СтрокаДанныхМассив[22]);
				Попытка
					НоваяСтрока.Расстояние = Число(СтрЗаменить(Редактировать(СтрокаДанныхМассив[35]), " ", ""));
				Исключение
					НоваяСтрока.Расстояние = 0;
				КонецПопытки;
				//Пункты таможни
				НоваяСтрока.ПунктНазначения = ?(Справочники.ТаможенныеПункты.НайтиПоКоду(Редактировать(СтрокаДанныхМассив[25])) =
				Справочники.ТаможенныеПункты.ПустаяСсылка(),Справочники.ТаможенныеПункты.НайтиПоНаименованию(Редактировать(СтрокаДанныхМассив[26])),
				Справочники.ТаможенныеПункты.НайтиПоКоду(Редактировать(СтрокаДанныхМассив[25])));
				НоваяСтрока.КодТаможниОтправления = (Редактировать(СтрокаДанныхМассив[28]));
				НоваяСтрока.ПунктОтправления = ?(Справочники.ТаможенныеПункты.НайтиПоКоду(Редактировать(СтрокаДанныхМассив[28])) =
				Справочники.ТаможенныеПункты.ПустаяСсылка(),Справочники.ТаможенныеПункты.НайтиПоНаименованию(Редактировать(СтрокаДанныхМассив[29])),
				Справочники.ТаможенныеПункты.НайтиПоКоду(Редактировать(СтрокаДанныхМассив[28])));
				//Попытка
				Если Не ЗначениеЗаполнено(НоваяСтрока.ПунктНазначения) Тогда
					НоваяСтрока.ПунктНазначения = СпарситьСтраницу(Редактировать(СтрокаДанныхМассив[25]),Редактировать(СтрокаДанныхМассив[26]) );
				КонецЕсли;
				Если Не ЗначениеЗаполнено(НоваяСтрока.ПунктОтправления) Тогда
					НоваяСтрока.ПунктОтправления = СпарситьСтраницу(Редактировать(СтрокаДанныхМассив[28]),Редактировать(СтрокаДанныхМассив[29]));
				КонецЕсли;
				//Исключение
				//КонецПопытки;

				// Доработка START {П-08 Fallback расстояния из РС при Расстояние=0} {2026-04-10}
				// Сигма для легковых авто и «своего хода» возвращает 0 → ищем в регистре
				// РасстоянияМеждуТаможеннымиПунктами по паре (ПунктОтправления, ПунктНазначения).
				// Если там пусто — оставляем 0, строка будет подсвечена красным,
				// а при СоздатьДокументы будет ошибка пользователю со списком недостающих маршрутов.
				Если НоваяСтрока.Расстояние = 0
					И ЗначениеЗаполнено(НоваяСтрока.ПунктОтправления)
					И ЗначениеЗаполнено(НоваяСтрока.ПунктНазначения) Тогда
					РасстоянияИзРегистра = РегистрыСведений.РасстоянияМеждуТаможеннымиПунктами.СоздатьНаборЗаписей();
					РасстоянияИзРегистра.Отбор.ПунктОтправления.Установить(НоваяСтрока.ПунктОтправления);
					РасстоянияИзРегистра.Отбор.ПунктНазначения.Установить(НоваяСтрока.ПунктНазначения);
					РасстоянияИзРегистра.Прочитать();
					Если РасстоянияИзРегистра.Количество() > 0 Тогда
						НоваяСтрока.Расстояние = РасстоянияИзРегистра[0].Расстояние;
					КонецЕсли;
				КонецЕсли;
				// Доработка END
				НоваяСтрока.СтатусТранзита = ВернутьСтатус(Редактировать(СтрокаДанныхМассив[59]));
				///выявление статусов				
				//Если МассивСтатусов.Найти(Редактировать(СтрокаДанныхМассив[59])) = Неопределено Тогда
				//	 МассивСтатусов.Добавить(Редактировать(СтрокаДанныхМассив[59]));
				//	 Сообщить(Редактировать(СтрокаДанныхМассив[59]));
				// КонецЕсли;	
				///конец				 
				
				// [75] = MSS_GUARANTEEREGNUM (рег. номер дополнения) — ключ дедупликации
				НоваяСтрока.НомерГТД = Редактировать(СтрокаДанныхМассив[75]);
				// [97] = EGD_ID — уникальный ID операции (fallback для пустых рег.номеров)
				НоваяСтрока.DocumentID = Редактировать(СтрокаДанныхМассив[97]);
				// Доработка START {П-04: НомераCMR = TDOC_NUMBER [38], не MSS_DECLREGNUM [76]} {2026-04-07}
				НоваяСтрока.НомераCMR = Редактировать(СтрокаДанныхМассив[38]);
				НоваяСтрока.НомерЭТД = Редактировать(СтрокаДанныхМассив[76]);
				// Доработка END
				НоваяСтрока.Комментарий = Редактировать(СтрокаДанныхМассив[84]);

				// [96] = uso_name — подразделение декларанта в Сигме (маппится на контрагента)
				ПодразделениеСигма = СокрЛП(Редактировать(СтрокаДанныхМассив[96]));

				НоваяСтрока.Контрагент = ВернутьКонтрагента(Редактировать(СтрокаДанныхМассив[84]), ПодразделениеСигма);
				НоваяСтрока.Ответственный  = Справочники.Пользователи.НайтиПоНаименованию((Редактировать(СтрокаДанныхМассив[87])));
				Если Не ЗначениеЗаполнено(НоваяСтрока.Ответственный) Тогда
					Пользователь = Справочники.Пользователи.СоздатьЭлемент();
					Пользователь.Наименование = Редактировать(СтрокаДанныхМассив[87]);
					Попытка
						Пользователь.Записать();
						НоваяСтрока.Ответственный = Пользователь.Ссылка;
					Исключение
					КонецПопытки;
				КонецЕсли;
				
				// Доработка START {Дата документа = дата выпуска (TRANSITOPENDATE), не создания} {2026-04-07}
				// [60] = TRANSITOPENDATE (дата выпуска / начало транзита) — основная дата
				// [52] = BDT_DATECRT (дата создания дополнения) — fallback
				// [85] = BDT_CANCEL (аннулировано) — флаг отмены
				// [62] = TRANSITFACTENDDATE (дата завершения транзита) — информационно
				Попытка
					ДатаВыпуска = ПреобразоватьДату(Редактировать(СтрокаДанныхМассив[60]));
					ДатаСоздания = ПреобразоватьДату(Редактировать(СтрокаДанныхМассив[52]));

					// Приоритет: дата выпуска → дата создания
					Если ЗначениеЗаполнено(ДатаВыпуска) И ДатаВыпуска <> '00010101' Тогда
						НоваяСтрока.ДатаОформления = ДатаВыпуска;
					ИначеЕсли ЗначениеЗаполнено(ДатаСоздания) И ДатаСоздания <> '00010101' Тогда
						НоваяСтрока.ДатаОформления = ДатаСоздания;
					КонецЕсли;
				Исключение
				КонецПопытки;

				// BDT_CANCEL [85] — аннулирование обрабатывается через СтатусТранзита (строка 464)
				// Колонки Аннулировано нет в ТЧ Декларация → значение не сохраняется
				// TODO: при необходимости — добавить колонку или использовать СтатусТранзита

				// Срок использования [2] = VALIDITYDATE
				// Доработка START {П-05: дублировать запись в оба реквизита — Срок (кир.) + Cрок (лат.)} {2026-04-10}
				// На форме выводится поле Декларация.СрокИспользования (кириллическая С, id=379)
				// Модуль раньше писал только в CрокИспользованияДополнения (латинская C, id=391) — пользователь видел пустое поле
				Попытка
					СрокИсп = ПреобразоватьДату(Редактировать(СтрокаДанныхМассив[2]));
					НоваяСтрока.CрокИспользованияДополнения = СрокИсп; // legacy (латинская C)
					НоваяСтрока.СрокИспользования = СрокИсп;           // поле формы (кириллическая С)
				Исключение
				КонецПопытки;
				// Доработка END

				// Доработка START {Парсинг ДатаЗавершения и СрокТранзита из API} {2026-04-07}
				// [62] = TRANSITFACTENDDATE (дата фактического завершения транзита)
				Попытка
					НоваяСтрока.ДатаЗавершения = ПреобразоватьДату(Редактировать(СтрокаДанныхМассив[62]));
				Исключение
				КонецПопытки;
				// СрокТранзита = VALIDITYDATE [2] (совпадает с CрокИспользованияДополнения)
				НоваяСтрока.СрокТранзита = НоваяСтрока.CрокИспользованияДополнения;
				// Доработка END
				//НоваяСтрока.ДатаСоздания =
				CMR = Объект.КодыCMR.Добавить();
				CMR.НомерДополнения = Редактировать(СтрокаДанныхМассив[75]);
				CMR.НомерСтрокиДекларации = НоваяСтрока.НомерСтроки;
				НомерСтрокиДекларации = CMR.НомерСтрокиДекларации;
				// Доработка START {П-04: НомерCMR = TDOC_NUMBER [38], ЭТД = MSS_DECLREGNUM [76]} {2026-04-07}
				CMR.НомерCMR = Редактировать(СтрокаДанныхМассив[38]);
				CMR.ЭТД = Редактировать(СтрокаДанныхМассив[76]);
				CMR.ПТД = Редактировать(СтрокаДанныхМассив[76]);
				// Доработка END
				Если СтрокаДанныхМассив.Количество() > 106 Тогда
					CMR.Валюта = Справочники.Валюты.НайтиПоНаименованию(Редактировать(СтрокаДанныхМассив[106]));
				КонецЕсли;

				Если СтрокаДанныхМассив.Количество() > 89 Тогда
					CMR.УИН = Редактировать(СтрокаДанныхМассив[89]);
				КонецЕсли;
				Попытка
					Если СтрокаДанныхМассив.Количество() > 105 Тогда
						CMR.Цена = Число(Редактировать(СтрокаДанныхМассив[105]));
					КонецЕсли;
					//CMR.Цена = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ТекущаяДата(),
				Исключение
					
				КонецПопытки;
				
			Иначе
				ТНВЭД = Объект.КодыТНВЭД.Добавить();
				ТНВЭД.НомерСтрокиДекларации	= НомерСтрокиДекларации;
				ТНВЭД.Код = Редактировать(СтрокаДанныхМассив[98]);
				Если CMR <> Неопределено Тогда
					CMR.КоличествоКодов = CMR.КоличествоКодов + 1;
				КонецЕсли;
			КонецЕсли;
		// Доработка START {Лог коротких строк} {2026-04-02}
		Иначе
			СчётчикКороткихСтрок = СчётчикКороткихСтрок + 1;
		// Доработка END
		КонецЕсли;
		Исключение
			// Доработка START {Лог ошибок парсинга} {2026-04-02}
			СчётчикОшибокПарсинга = СчётчикОшибокПарсинга + 1;
			Сообщить("Ошибка строки CSV #" + СчСтрок + ": " + ОписаниеОшибки());
			// Доработка END
		КонецПопытки;

	КонецЦикла;

	// Доработка START {Итоги парсинга} {2026-04-02}
	Если СчётчикОшибокПарсинга > 0 ИЛИ СчётчикКороткихСтрок > 0 Тогда
		Сообщить("Парсинг CSV: ошибок=" + СчётчикОшибокПарсинга + ", коротких строк (< 99 колонок)=" + СчётчикКороткихСтрок);
	КонецЕсли;
	// Доработка END

КонецФункции

// Доработка START {Правильный CSV-парсер: ";" внутри кавычек не разделяет поля} {2026-04-02}
Функция РазобратьCSVСтроку(Строка)
	Результат = Новый Массив;
	ТекущееПоле = "";
	ВнутриКавычек = Ложь;
	ПропуститьСледующий = Ложь;
	Длина = СтрДлина(Строка);

	Для Поз = 1 По Длина Цикл
		Если ПропуститьСледующий Тогда
			ПропуститьСледующий = Ложь;
			Продолжить;
		КонецЕсли;

		ТекСимвол = Сред(Строка, Поз, 1);

		Если ТекСимвол = Символ(34) Тогда
			// Экранированная кавычка "" → одна кавычка в значении
			Если ВнутриКавычек И Поз < Длина И Сред(Строка, Поз + 1, 1) = Символ(34) Тогда
				ТекущееПоле = ТекущееПоле + Символ(34);
				ПропуститьСледующий = Истина;
			Иначе
				ВнутриКавычек = НЕ ВнутриКавычек;
			КонецЕсли;
		ИначеЕсли ТекСимвол = ";" И НЕ ВнутриКавычек Тогда
			Результат.Добавить(ТекущееПоле);
			ТекущееПоле = "";
		Иначе
			ТекущееПоле = ТекущееПоле + ТекСимвол;
		КонецЕсли;
	КонецЦикла;

	Результат.Добавить(ТекущееПоле);
	Возврат Результат;
КонецФункции
// Доработка END

