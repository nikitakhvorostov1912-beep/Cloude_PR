Функция ВернутьСтатус(Статус)
	Если Статус = "Аннулировано специалистом" Тогда
		Возврат Перечисления.СтатусыТранзита.АннулированоСпециалистом;

	ИначеЕсли Статус = "Процедура таможенного транзита завершена" Тогда
		Возврат Перечисления.СтатусыТранзита.ТранзитЗавершен;

	ИначеЕсли Статус = "Дополнение заключено" Тогда
		Возврат Перечисления.СтатусыТранзита.ДополнениеЗаключено;

	ИначеЕсли Статус = "Дополнение зарегистрировано" Тогда
		Возврат Перечисления.СтатусыТранзита.ДополнениеЗарегистрировано;

	// Доработка START {П-07 Статусы Сигмы: нормализация и логирование} {2026-04-10}
	ИначеЕсли Статус = "Средства разрезервированы"
		Или Статус = "Средства по дополнению разрезервированы" Тогда
		Возврат Перечисления.СтатусыТранзита.СредстваРазрезервированы;
	// Доработка END

	ИначеЕсли Статус = "Товар по процедуре ТД не выпущен" Тогда
		Возврат Перечисления.СтатусыТранзита.ТоварНеВыпущен;

	ИначеЕсли Статус = "Товар по процедуре ТД выпущен" Тогда
		Возврат Перечисления.СтатусыТранзита.ТоварВыпущен;

	ИначеЕсли Статус = "Процедура таможенного транзита завершена с оговорками" Тогда
		Возврат Перечисления.СтатусыТранзита.ТранзитЗавершенСОговорками;

	ИначеЕсли Статус = "В заключении Дополнения отказано" Тогда
		Возврат Перечисления.СтатусыТранзита.ВЗаключенииДополненияОтказано;

	// Доработка START {П-07 Статусы Сигмы: явный возврат + лог} {2026-04-10}
	ИначеЕсли Статус = "Дополнение отправлено" Тогда
		Возврат Перечисления.СтатусыТранзита.ДополнениеОтправлено;

	ИначеЕсли Статус = "Отказано в приеме дополнения" Тогда
		Возврат Перечисления.СтатусыТранзита.ОтказаноВПриемеДополнения;

	Иначе
		ЗаписьЖурналаРегистрации(
			"АПИСигма.НеизвестныйСтатус",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Неизвестный статус транзита от API Сигмы: """ + Статус + """");
		Возврат Перечисления.СтатусыТранзита.ПустаяСсылка();
	// Доработка END

	КонецЕсли;
КонецФункции
// Доработка START {Поиск контрагента: КИ + uso_name подразделение} {2026-04-03}
#Область РазборПочты

// Главная функция поиска контрагента.
// Приоритет: 1) Email из комментария → КонтактнаяИнформация контрагентов/партнёров
//            2) Подразделение Сигмы (uso_name) → РС СоответствияПодразделенийКонтрагентам
//            3) Не найден → подробный лог в ЖурналРегистрации для ручной привязки
Функция ВернутьКонтрагента(Представление, ПодразделениеСигма = "")

	// --- ШАГ 1: Извлечь email из комментария ---
	Email = ИзвлечьEmailИзРешёток(Представление);

	Если ЗначениеЗаполнено(Email) Тогда
		EmailДляПоиска = НРег(СокрЛП(Email));

		// Поиск по КонтактнойИнформации контрагентов и партнёров
		Контрагент = НайтиКонтрагентаПоEmailВ1С(EmailДляПоиска);
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Возврат Контрагент;
		КонецЕсли;

		// Email есть, но не найден в КИ → логируем
		ЗаписьЖурналаРегистрации("APIСигма.EmailНеНайден",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Email: " + Email + " | Подразделение: " + ПодразделениеСигма
			+ " | Действие: добавьте этот email в КонтактнуюИнформацию контрагента в 1С");
	КонецЕсли;

	// --- ШАГ 2: Подразделение Сигмы (uso_name) → контрагент через РС ---
	Если ЗначениеЗаполнено(ПодразделениеСигма) Тогда
		// Запрос к РС СоответствияПодразделенийКонтрагентам (точная ссылка, не по имени)
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СоответствияПодразделений.Контрагент КАК Контрагент
		|ИЗ
		|	РегистрСведений.СоответствияПодразделенийКонтрагентам КАК СоответствияПодразделений
		|ГДЕ
		|	СоответствияПодразделений.ПодразделениеСигма = &Подразделение";
		Запрос.УстановитьПараметр("Подразделение", СокрЛП(ПодразделениеСигма));
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Контрагент = РезультатЗапроса.Выгрузить()[0].Контрагент;
			Если ЗначениеЗаполнено(Контрагент) Тогда
				Возврат Контрагент;
			КонецЕсли;
		КонецЕсли;

		// Не нашли в РС → логируем (всегда, даже если email был но не совпал)
		// Доработка START {Аудит P-5: лог писался только при пустом email, теперь всегда} {2026-04-05}
		ЗаписьЖурналаРегистрации("APIСигма.КонтрагентНеНайден",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Email: " + ?(ЗначениеЗаполнено(Email), Email, "<пусто>")
			+ " | Подразделение: " + ?(ЗначениеЗаполнено(ПодразделениеСигма), ПодразделениеСигма, "<пусто>")
			+ " | Действие: добавьте email в КонтактнуюИнформацию или запись в РС Соответствия подразделений");
		// Доработка END
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Поиск контрагента по email в КонтактнойИнформации 1С (3 способа)
Функция НайтиКонтрагентаПоEmailВ1С(EmailДляПоиска)

	Запрос = Новый Запрос;

	// 1. Контрагенты.КонтактнаяИнформация.Представление
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НРЕГ(КИ.Представление) ПОДОБНО &Email";
	Запрос.УстановитьПараметр("Email", "%" + EmailДляПоиска + "%");
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
	КонецЕсли;

	// 2. Партнеры.КонтактнаяИнформация → Контрагент партнёра
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКИ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Контрагенты.Партнер = ПартнерыКИ.Ссылка
	|ГДЕ
	|	НРЕГ(ПартнерыКИ.Представление) ПОДОБНО &Email";
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
	КонецЕсли;

	// 3. ЗначенияПолей (JSON-формат БСП 3.1+)
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НРЕГ(КИ.ЗначенияПолей) ПОДОБНО &Email";
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Извлекает email между # и #, без самих решёток
Функция ИзвлечьEmailИзРешёток(Текст)
	ПозПервой = СтрНайти(Текст, "#");
	Если ПозПервой = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПозВторой = СтрНайти(Текст, "#",, ПозПервой + 1);
	Если ПозВторой = 0 Тогда
		Возврат "";
	КонецЕсли;

	Фрагмент = СокрЛП(Сред(Текст, ПозПервой + 1, ПозВторой - ПозПервой - 1));

	// Проверяем что это email (содержит @), а не флаг #1#
	Если СтрНайти(Фрагмент, "@") > 0 Тогда
		Возврат Фрагмент;
	КонецЕсли;

	Возврат "";
КонецФункции
// Доработка END

Функция НайтиПОСпецСимволу(Представление)
	СпецСимвол = СтрНайти(Представление,"@");
	НачалоПочты = СтрНайти(Представление," ",НаправлениеПоиска.СКонца, СпецСимвол);
	КонецПочты =  СтрНайти(Представление," ",, СпецСимвол);
	Если КонецПочты =0 Тогда
		КонецПочты = СтрДлина(Представление);
	КонецЕсли;	
	Почта = СокрЛП(Сред(Представление,НачалоПочты,КонецПочты-НачалоПочты +1));
	Возврат СтрЗаменить(Почта,"#","");
КонецФункции

